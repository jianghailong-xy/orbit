+  chat: chat({ stage: 'HANDLING' }),
+};
+
+/** Task-scoped, the owner's: the third failure of a task, which the clock handed over. */
+const ESCALATED_TASK: ProjectOpenItemRow = {
+  ...LANDING,
+  itemId: '34ZTaskFailedItem0001',
