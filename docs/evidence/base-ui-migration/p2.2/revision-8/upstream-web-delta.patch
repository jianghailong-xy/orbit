+};
+
+function settled(
+  row: ProjectOpenItemRow,
+  outcome: NonNullable<ProjectOpenItemRow['outcome']>,
+  ended: Partial<OpenItemChat>,
+): ProjectOpenItemRow {
+  return {
+    ...row,
+    escalateAt: null,
+    delivery: { state: 'NOT_REQUIRED', sessionId: null, at: null },
+    actions: [],
+    handling: null,
+    outcome,
+    chat: chat(ended),
