+
+const HANDLING_PROMOTION: ProjectOpenItemRow = {
+  ...PROMOTION,
+  handling: {
+    sessionId: COORDINATOR,
+    userId: null,
+    reason: 'main’s merge-check baseline was repaired',
+    startedAt: at(MINUTE),
+    jobId: '34ZRecheckJob00000001',
