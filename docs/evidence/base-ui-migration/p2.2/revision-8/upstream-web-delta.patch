+    expect(promotionEventLine(candidate({ state: 'CONFIRMED' }))).toEqual({ text: 'Merge into main confirmed', tone: 'working' });
+    expect(promotionEventLine(candidate({ state: 'BLOCKED', conflicts: ['a.go', 'b.go'] })))
