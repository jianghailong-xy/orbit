+    expect(old).not.toContain('</button>');
+
+    const missing = render([{ seq: 1, type: 'error', payload: { message: 'DSH_NOT_INSTALLED: DeepSeek Harness 0.2.0-rc.2 is not installed in Orbit&#x27;s version directory' } }]);
