    "node_modules/@base-ui/react/utils/popups/popupStoreUtils.mjs": {
      "sha256": "4e594c53e4c693c328aa3dc1dd6e84318ef4c1921fc252234b1a345cfc11ddeb",
      "lines": [
        {
          "line": 404,
          "text": "export function useOpenStateTransitions(open, store, onUnmount, animateInitialOpen) {"
        },
        {
          "line": 405,
          "text": "  const {"
        },
        {
          "line": 406,
          "text": "    mounted,"
        },
        {
          "line": 407,
          "text": "    setMounted,"
        },
        {
          "line": 408,
          "text": "    transitionStatus"
        },
        {
          "line": 409,
          "text": "  } = useTransitionStatus(open, false, false, animateInitialOpen);"
        },
        {
          "line": 410,
          "text": "  const preventUnmountingOnClose = store.useState('preventUnmountingOnClose');"
        },
        {
          "line": 411,
          "text": "  // Opening starts a new close cycle. Clear during render so the close-completion hook below"
        },
        {
          "line": 412,
          "text": "  // reads the synchronized value on the same pass."
        },
        {
          "line": 413,
          "text": "  const syncedPreventUnmountingOnClose = open ? false : preventUnmountingOnClose;"
        },
        {
          "line": 414,
          "text": "  store.useSyncedValues({"
        },
        {
          "line": 415,
          "text": "    mounted,"
        },
        {
          "line": 416,
          "text": "    transitionStatus,"
        },
        {
          "line": 417,
          "text": "    preventUnmountingOnClose: syncedPreventUnmountingOnClose"
        },
        {
          "line": 418,
          "text": "  });"
        },
        {
          "line": 419,
          "text": "  const forceUnmount = useStableCallback(() => {"
        },
        {
          "line": 420,
          "text": "    setMounted(false);"
        },
        {
          "line": 421,
          "text": "    store.update({"
        },
        {
          "line": 422,
          "text": "      activeTriggerId: null,"
        },
        {
          "line": 423,
          "text": "      activeTriggerElement: null,"
        },
        {
          "line": 424,
          "text": "      mounted: false,"
        },
        {
          "line": 425,
          "text": "      preventUnmountingOnClose: false"
        },
        {
          "line": 426,
          "text": "    });"
        },
        {
          "line": 427,
          "text": "    onUnmount?.();"
        },
        {
          "line": 428,
          "text": "    store.context.onOpenChangeComplete?.(false);"
        },
        {
          "line": 429,
          "text": "  });"
        },
        {
          "line": 430,
          "text": "  useOpenChangeComplete({"
        },
        {
          "line": 431,
          "text": "    enabled: mounted && !open && !syncedPreventUnmountingOnClose,"
        },
        {
          "line": 432,
          "text": "    open,"
        },
        {
          "line": 433,
          "text": "    ref: store.context.popupRef,"
        },
        {
          "line": 434,
          "text": "    onComplete() {"
        },
        {
          "line": 435,
          "text": "      if (!open) {"
        },
        {
          "line": 436,
          "text": "        forceUnmount();"
        },
        {
          "line": 437,
          "text": "      }"
        },
        {
          "line": 438,
          "text": "    }"
        },
        {
          "line": 439,
          "text": "  });"
        },
        {
          "line": 440,
          "text": "  return {"
        },
        {
          "line": 441,
          "text": "    forceUnmount,"
        },
        {
          "line": 442,
          "text": "    transitionStatus"
        },
        {
          "line": 443,
          "text": "  };"
        }
      ]
    },
    "node_modules/@base-ui/react/internals/useOpenChangeComplete.mjs": {
      "sha256": "c7e2ecac88c4e2185f221f8f35344f22ec8d8ed0acfcc977ddf6e17014956f2c",
      "lines": [
        {
          "line": 1,
          "text": "'use client';"
        },
        {
          "line": 2,
          "text": ""
        },
        {
          "line": 3,
          "text": "import * as React from 'react';"
        },
        {
          "line": 4,
          "text": "import { useStableCallback } from '@base-ui/utils/useStableCallback';"
        },
        {
          "line": 5,
          "text": "import { useAnimationsFinished } from \"./useAnimationsFinished.mjs\";"
        },
        {
          "line": 6,
          "text": ""
        },
        {
          "line": 7,
          "text": "/**"
        },
        {
          "line": 8,
          "text": " * Calls the provided function when the CSS open/close animation or transition completes."
        },
        {
          "line": 9,
          "text": " */"
        },
        {
          "line": 10,
          "text": "export function useOpenChangeComplete(parameters) {"
        },
        {
          "line": 11,
          "text": "  const {"
        },
        {
          "line": 12,
          "text": "    enabled = true,"
        },
        {
          "line": 13,
          "text": "    open,"
        },
        {
          "line": 14,
          "text": "    ref,"
        },
        {
          "line": 15,
          "text": "    batch = false,"
        },
        {
          "line": 16,
          "text": "    onComplete: onCompleteParam"
        },
        {
          "line": 17,
          "text": "  } = parameters;"
        },
        {
          "line": 18,
          "text": "  const onComplete = useStableCallback(onCompleteParam);"
        },
        {
          "line": 19,
          "text": "  const runOnceAnimationsFinish = useAnimationsFinished(ref, open, batch);"
        },
        {
          "line": 20,
          "text": "  React.useEffect(() => {"
        },
        {
          "line": 21,
          "text": "    if (!enabled) {"
        },
        {
          "line": 22,
          "text": "      return undefined;"
        },
        {
          "line": 23,
          "text": "    }"
        },
        {
          "line": 24,
          "text": "    const abortController = new AbortController();"
        },
        {
          "line": 25,
          "text": "    runOnceAnimationsFinish(onComplete, abortController.signal);"
        },
        {
          "line": 26,
          "text": "    return () => {"
        },
        {
          "line": 27,
          "text": "      abortController.abort();"
        },
        {
          "line": 28,
          "text": "    };"
        },
        {
          "line": 29,
          "text": "  }, [enabled, open, onComplete, runOnceAnimationsFinish]);"
        },
        {
          "line": 30,
          "text": "}"
        }
      ]
    },
