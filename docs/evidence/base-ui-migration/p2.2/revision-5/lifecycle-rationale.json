          "text": "    }"
        },
        {
          "line": 208,
          "text": "  };"
        },
        {
          "line": 209,
          "text": "  unlock = () => {"
        },
        {
          "line": 210,
          "text": "    if (this.lockCount === 0 && this.restore) {"
        },
        {
          "line": 211,
          "text": "      this.restore?.();"
        },
        {
          "line": 212,
          "text": "      this.restore = null;"
        },
        {
          "line": 213,
          "text": "    }"
        },
        {
          "line": 214,
          "text": "  };"
        },
        {
          "line": 215,
          "text": "  lock(referenceElement) {"
        }
