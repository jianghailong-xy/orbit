  "reason": "Dialog close unmount is driven by completion of the actual CSS exit. Scroll lock cleanup uses a zero-delay task when open becomes false and can occur before unmount. Preserve Esc-relative timings; start the unchanged short 100ms cleanup allowance at observed popup removal/hidden, not keydown and not the later Playwright polling checkpoint. This is a test synchronization allowance, not a product SLA.",
  "retainedChecks": [
    "inner-close parent lock",
    "each layer focus/visibility",
    "original first read after hidden/focus",
    "final unlocked state",
    "trusted native input produces page displacement within 250ms",
    "focus still returned after scrolling"
  ],
  "controls": [
    "150ms render scheduling + actual 200ms CSS exit with timely release: must accept",
    "release 150ms after actual removal: must reject",
    "residual lock: must reject and native input must not move page"
  ],
