+                    ContentUnavailableView("Couldn't load sessions", systemImage: "exclamationmark.bubble",
+                                           description: Text(failure))
+                } else {
+                    ContentUnavailableView("No sessions", systemImage: "bubble.left.and.bubble.right")
+                }
