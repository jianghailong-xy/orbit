+  env.IS_REACT_ACT_ENVIRONMENT = false;
+  try { await vi.waitFor(assertion, { timeout: 20_000, interval: 20 }); }
+  finally { env.IS_REACT_ACT_ENVIRONMENT = true; }
+  await act(async () => {});
+};
+async function settle(): Promise<void> {
+  for (let i = 0; i < 4; i += 1) {
