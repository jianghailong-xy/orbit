+        }
+        .toolbar {
+            if rowNavigation == .selection {
+                ToolbarItem(placement: .topBarLeading) {
+                    Button { app.leaveProjectSessions(address.projectID) } label: {
+                        Label("Back", systemImage: "chevron.backward")
