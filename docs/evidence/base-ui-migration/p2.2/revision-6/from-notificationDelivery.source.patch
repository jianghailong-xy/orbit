+    await expect(page.getByRole('menuitem', { name: 'Codex' })).toBeVisible();
+    samples[system] = { enter: await capture(page) };
+    if (system === 'orbit') {
+      const box = await page.locator(selector).boundingBox();
+      expect(box.x).toBeGreaterThanOrEqual(0);
