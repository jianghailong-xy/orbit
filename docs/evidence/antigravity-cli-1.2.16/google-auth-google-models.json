{
  "probe": "google-models",
  "agy_version": "1.2.16",
  "argv": [
    "<TMP>/bin/agy",
    "--gemini_dir=<TMP>/runs/google-models/gemini",
    "--log-file=/dev/null",
    "models"
  ],
  "stdin_is_tty": false,
  "stdout_is_tty": false,
  "stdin_action": "EOF immediately",
  "ssh_environment": false,
  "dbus": "nonexistent isolated socket",
  "duration_seconds": 0.399,
  "forced_stop": false,
  "exit_code": 1,
  "stdout": "",
