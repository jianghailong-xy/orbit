+func TestDshRealOrbitMCPTimeoutBefore(t *testing.T) {
+	h := newDshRealHarness(t, "default", true)
+	h.model.plans = []dshPlan{
+		{tool: "mcp__orbit__task_create", args: map[string]interface{}{"title": "P4 held task", "description": "synthetic",
+			"completionCriterion": "EVIDENCE_JUDGMENT", "acceptanceCriteria": "synthetic"}},
+		{text: "P4 held answer"},
+	}
+	h.start()
+	h.send("t1", "message", "File a task.")
+	done := h.settled("t1")
+	_, result := h.toolResult("t1", "mcp__orbit__task_create")
+	card := h.waitCard(1)
+	h.cp.decide(card.ID, "ALLOWED")
+	for i := 0; i < 300 && len(h.cp.seen("POST", "/api/runner/tasks")) == 0; i++ {
+		time.Sleep(50 * time.Millisecond)
+	}
+	created := h.cp.seen("POST", "/api/runner/tasks")
+	t.Logf("turn=%s modelSaw status=%v content=%q; created after approval=%d", done.Status, result["status"], firstString(result, "content"), len(created))
+	h.end()
+	h.evidence(t.Name(), map[string]interface{}{"toolStatus": result["status"], "modelSaw": firstString(result, "content"), "tasksCreatedAfterApproval": len(created)})
+}
