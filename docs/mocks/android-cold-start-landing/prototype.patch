+/** iOS `AgentSessionRow.compactRow`: the title with the live mark and the time on its right, and one line under it. Long press is the
+ * row's menu, as on iOS; there is no ⋮. */
+@OptIn(ExperimentalFoundationApi::class)
+@Composable
+internal fun CompactSessionRow(session: DirectorySession, machine: String?, live: Boolean, onOpen: () -> Unit, onOptions: () -> Unit) {
+    val muted = MaterialTheme.colorScheme.onSurfaceVariant
+    val recaps = LocalSessionRecaps.current
+    val line = remember(session, recaps, live) { SessionLine.make(session, live = live, recaps = recaps) }
+    val generating = session.isGenerating
+    Column(Modifier.fillMaxWidth()
+        .combinedClickable(role = Role.Button, onLongClickLabel = "Options for ${session.name}", onLongClick = onOptions, onClick = onOpen)
+        .padding(horizontal = 16.dp, vertical = 11.dp), verticalArrangement = Arrangement.spacedBy(3.dp)) {
+        Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            Text(session.name, Modifier.weight(1f), maxLines = 1, overflow = TextOverflow.Ellipsis, style = MaterialTheme.typography.bodyLarge)
+            when {
+                session.pendingApprovals > 0 -> Box(Modifier.size(7.dp).background(LocalOrbitColors.current.needsYou, CircleShape))
+                generating -> CircularProgressIndicator(Modifier.size(14.dp), color = muted, strokeWidth = 1.5.dp)
+                session.runningBgJobCount > 0 -> Icon(painterResource(R.drawable.ic_terminal), null, Modifier.size(14.dp).alpha(0.7f), tint = muted)
+            }
+            // A working row says so with its spinner, not with a column of "just now".
+            if (!generating) (session.lastTurnAt ?: session.createdAt)?.let { WikiDate.relative(it, Instant.now()) }?.let {
+                Text(it, style = MaterialTheme.typography.labelMedium, color = muted, maxLines = 1, softWrap = false)
+            }
+        }
+        Text(ClaudeRegion.heldWords(session.regionHeld, machine) ?: line.text, maxLines = 1, overflow = TextOverflow.Ellipsis,
+            style = MaterialTheme.typography.bodyMedium, color = when (line.tone) {
+                SessionLine.Tone.APPROVAL, SessionLine.Tone.WARNING -> LocalOrbitColors.current.needsYou
+                SessionLine.Tone.RUNNING -> MaterialTheme.colorScheme.primary
+                else -> muted
+            })
+    }
+}
