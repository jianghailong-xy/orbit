+        Text(folder.name, Modifier.weight(1f), maxLines = 1, overflow = TextOverflow.Ellipsis, style = MaterialTheme.typography.bodyLarge)
+        when {
+            waiting > 0 -> Text("$waiting", Modifier.background(LocalOrbitColors.current.needsYou, CircleShape).padding(horizontal = 6.dp),
+                style = MaterialTheme.typography.labelSmall, color = Color.Black)
+            sessions.any { it.isGenerating } -> CircularProgressIndicator(Modifier.size(14.dp), color = muted, strokeWidth = 1.5.dp)
+        }
+        Text("${sessions.size}", style = MaterialTheme.typography.labelMedium, color = muted)
+        Icon(painterResource(R.drawable.ic_chevron_forward), null, Modifier.size(14.dp), tint = muted.copy(alpha = 0.6f))
+    }
+}
+
+/** iOS's field at the foot of the list, in a thumb's reach. */
+@Composable
+internal fun BottomSearchField(query: String, onQuery: (String) -> Unit, modifier: Modifier = Modifier) {
+    val muted = MaterialTheme.colorScheme.onSurfaceVariant
+    Surface(modifier.fillMaxWidth().padding(start = 20.dp, end = 20.dp, top = 26.dp, bottom = 10.dp).height(50.dp), shape = CircleShape,
+        color = MaterialTheme.colorScheme.surfaceContainerHigh, border = BorderStroke(0.5.dp, muted.copy(alpha = 0.25f)), shadowElevation = 6.dp) {
+        Row(Modifier.fillMaxSize().padding(horizontal = 16.dp), verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+            Icon(painterResource(R.drawable.ic_search), null, Modifier.size(20.dp), tint = MaterialTheme.colorScheme.onSurface)
+            Box(Modifier.weight(1f), contentAlignment = Alignment.CenterStart) {
+                if (query.isEmpty()) Text("Search sessions", style = MaterialTheme.typography.bodyLarge, color = muted, maxLines = 1)
+                BasicTextField(query, onQuery, Modifier.fillMaxWidth().testTag("session-search"), singleLine = true,
+                    textStyle = MaterialTheme.typography.bodyLarge.copy(color = MaterialTheme.colorScheme.onSurface),
+                    cursorBrush = SolidColor(MaterialTheme.colorScheme.primary))
+            }
+            if (query.isNotEmpty()) IconButton({ onQuery("") }, Modifier.size(28.dp)) { Icon(painterResource(R.drawable.ic_clear), "Clear") }
+        }
+    }
+}
+
+@Composable
+internal fun BottomSearchVisibility(visible: Boolean, content: @Composable () -> Unit) {
+    AnimatedVisibility(visible, enter = slideInVertically { it } + fadeIn(), exit = slideOutVertically { it } + fadeOut()) {
+        val surface = MaterialTheme.colorScheme.surface
+        Box(Modifier.fillMaxWidth().background(Brush.verticalGradient(0f to surface.copy(alpha = 0f), 0.45f to surface.copy(alpha = 0.92f), 1f to surface))) { content() }
+    }
+}
+
+/** iOS `sessionOptionsMenu`: what the bar's ≡ holds on a phone — the scope, the tag filter and grouping, a new folder and the settings. */
+@Composable
+internal fun SessionOptionsMenu(view: SessionView, tags: List<Tag>, tag: String?, byTag: Boolean, isFolder: Boolean,
+    onView: (SessionView) -> Unit, onTag: (String?) -> Unit, onByTag: (Boolean) -> Unit, onNewFolder: () -> Unit, onSettings: () -> Unit, settingsLabel: String) {
+    var open by remember { mutableStateOf(false) }
+    var tagsOpen by remember { mutableStateOf(false) }
+    Box {
+        IconButton(onClick = { open = true; tagsOpen = false }) {
+            Icon(painterResource(if (tag == null) R.drawable.ic_filter else R.drawable.ic_filter_on), "Session scope, ${view.label}")
+        }
+        DropdownMenu(open, onDismissRequest = { open = false }) {
+            @Composable fun tick(on: Boolean) { if (on) Icon(painterResource(R.drawable.ic_check), null, Modifier.size(20.dp)) else Spacer(Modifier.size(20.dp)) }
+            if (tagsOpen) {
+                DropdownMenuItem(text = { Text("All") }, leadingIcon = { tick(tag == null) }, onClick = { onTag(null); open = false })
+                tags.forEach { t -> DropdownMenuItem(text = { Text(t.name) }, leadingIcon = { tick(tag == t.id) }, onClick = { onTag(t.id); open = false }) }
+            } else {
+                SessionView.entries.forEach { option ->
+                    DropdownMenuItem(text = { Text(option.label) }, leadingIcon = { tick(view == option) }, onClick = { onView(option); open = false })
+                }
+                if (tags.isNotEmpty()) {
+                    HorizontalDivider()
+                    DropdownMenuItem(text = { Text("Filter by Tag") }, leadingIcon = { Icon(painterResource(R.drawable.ic_tag), null, Modifier.size(20.dp)) },
+                        trailingIcon = { Icon(painterResource(R.drawable.ic_chevron_forward), null, Modifier.size(14.dp)) }, onClick = { tagsOpen = true })
+                    DropdownMenuItem(text = { Text("Group by Tag") }, leadingIcon = { tick(byTag) }, onClick = { onByTag(!byTag); open = false })
+                }
+                HorizontalDivider()
+                if (!isFolder && view != SessionView.TRASH) DropdownMenuItem(text = { Text("New Folder…") },
+                    leadingIcon = { Icon(painterResource(R.drawable.ic_folder_plus), null, Modifier.size(20.dp)) }, onClick = { onNewFolder(); open = false })
+                DropdownMenuItem(text = { Text(settingsLabel) }, leadingIcon = { Icon(painterResource(R.drawable.ic_settings), null, Modifier.size(20.dp)) },
+                    onClick = { onSettings(); open = false })
+            }
+        }
+    }
+}
