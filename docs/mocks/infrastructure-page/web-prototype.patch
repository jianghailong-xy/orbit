+++ b/src/web/src/components/ComputeOverview.tsx
@@ -0,0 +1,125 @@
+// PROTOTYPE for the Runners + Providers merge mockups — not for landing.
+import { Link } from 'react-router-dom';
+import { Button } from 'antd';
+import { encodeId } from '../lib/idCodec';
+import type { ProviderRow } from '../lib/providerAdmin';
+import type { ProviderPool } from '../lib/providerPools';
+import { ENGINE_PRESET } from '../lib/sessionProviderChoices';
+import { ProviderTile } from './ProviderGallery';
+import { ENGINE_NAME } from './RunnerSignIn';
+import type { Runner } from './TasksSidePanel';
+
+const CSS = `
+.cp-attn{margin-top:18px;border:1px solid color-mix(in srgb,var(--warning) 35%,transparent);background:color-mix(in srgb,var(--warning) 7%,var(--bg-raised));border-radius:12px;padding:4px 14px}
+.cp-attn-row{display:flex;align-items:center;gap:10px;padding:9px 0;font-size:13px;color:var(--text-1)}
+.cp-attn-row+.cp-attn-row{border-top:1px solid color-mix(in srgb,var(--warning) 18%,transparent)}
+.cp-attn-dot{width:7px;height:7px;border-radius:50%;background:var(--warning);flex:none}
+.cp-attn-dot.off{background:var(--text-4)}
+.cp-attn-row .cp-sub{color:var(--text-3);font-size:12px}
+.cp-attn-row > :last-child{margin-left:auto}
+.cp-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
+.cp-tile{border:1px solid var(--border);border-radius:12px;background:var(--bg-raised);padding:12px 14px;display:flex;gap:12px;align-items:flex-start;min-width:0}
+.cp-tile.none{background:var(--bg-subtle)}
+.cp-tile-main{min-width:0;flex:1}
+.cp-tile-name{display:flex;align-items:center;gap:8px;font-weight:600;font-size:13.5px;color:var(--text-1)}
+.cp-state{font-size:11px;font-weight:600;padding:1px 7px;border-radius:999px;background:color-mix(in srgb,var(--success,#22a06b) 14%,transparent);color:var(--success,#1f8a5b)}
+.cp-state.none{background:var(--bg-hover,#eef0f3);color:var(--text-3)}
+.cp-src{margin-top:6px;display:flex;flex-direction:column;gap:3px;font-size:12px;color:var(--text-2)}
+.cp-src span b{font-weight:600;color:var(--text-1)}
+.cp-src .cp-dim{color:var(--text-4)}
+.cp-add{display:flex;flex-direction:column;gap:1px;padding:3px 0;max-width:300px}
+.cp-add b{font-weight:600}
+.cp-add span{font-size:12px;color:var(--text-3)}
+`;
+
+const ENGINES = ['claude', 'codex', 'kimi', 'antigravity'] as const;
+
+export function ComputeAttention({ runners }: { runners: Runner[] }) {
+  const items: { key: string; dot?: 'off'; text: React.ReactNode; sub?: string; action: React.ReactNode }[] = [];
+  for (const r of runners) {
+    const name = r.displayName || r.name;
+    if (!r.online) {
+      items.push({
+        key: `${r.id}-off`,
+        dot: 'off',
+        text: <><b>{name}</b> is offline</>,
+        sub: 'Last seen yesterday · its subscriptions are unavailable until it’s back',
+        action: <Link to={`/runners/${encodeId(r.id)}`}><Button size="small">Details</Button></Link>,
+      });
+      continue;
+    }
+    for (const e of r.engines ?? []) {
+      if (e.installed && e.auth === 'no') {
+        items.push({
+          key: `${r.id}-${e.engine}`,
+          text: <><b>{ENGINE_NAME[e.engine as keyof typeof ENGINE_NAME] ?? e.engine}</b> is signed out on <b>{name}</b></>,
+          sub: 'Sessions there can’t use it',
+          action: <Button size="small" type="primary">Sign in</Button>,
+        });
+      }
+    }
+  }
+  if (!items.length) return null;
+  return (
+    <>
+      <style>{CSS}</style>
+      <div className="cp-attn">
+        {items.map((i) => (
+          <div className="cp-attn-row" key={i.key}>
+            <span className={`cp-attn-dot${i.dot ? ' off' : ''}`} />
+            <span>{i.text} <span className="cp-sub">· {i.sub}</span></span>
+            {i.action}
+          </div>
+        ))}
+      </div>
+    </>
+  );
+}
+
+export function ComputeOverview({ runners, keys, pools }: { runners: Runner[]; keys: ProviderRow[]; pools: ProviderPool[] }) {
+  return (
+    <div className="re-sec">
+      <style>{CSS}</style>
+      <div className="re-sec-head">
+        <h3>What your agents can run on</h3>
+        <span className="re-sec-sub">Every engine, and everything that can pay for it right now.</span>
+      </div>
+      <div className="cp-grid">
+        {ENGINES.map((engine) => {
+          const subs: string[] = [];
+          for (const r of runners.filter((x) => x.online)) {
+            const e = (r.engines ?? []).find((x) => x.engine === engine);
+            if (!e?.installed) continue;
+            const n = e.accounts?.length ? e.accounts.filter((a) => a.auth === 'yes').length : e.auth === 'yes' ? 1 : 0;
+            if (n) subs.push(`${r.displayName || r.name}${n > 1 ? ` ×${n}` : ''}`);
+          }
+          const k = keys.filter((p) => p.enabled && p.runtime === engine);
+          const pl = pools.filter((p) => (p.engine ?? 'claude') === engine);
+          const ready = subs.length + k.length + pl.length > 0;
+          return (
+            <div className={`cp-tile${ready ? '' : ' none'}`} key={engine}>
+              <ProviderTile slug={ENGINE_PRESET[engine] ?? engine} label={ENGINE_NAME[engine as keyof typeof ENGINE_NAME]} size={30} />
+              <div className="cp-tile-main">
+                <div className="cp-tile-name">
+                  {ENGINE_NAME[engine as keyof typeof ENGINE_NAME]}
+                  <span className={`cp-state${ready ? '' : ' none'}`}>{ready ? 'Ready' : 'Not set up'}</span>
+                </div>
+                <div className="cp-src">
+                  {ready ? (
+                    <>
+                      {subs.length > 0 && <span><b>Subscription</b> · {subs.join(', ')}</span>}
+                      {k.length > 0 && <span><b>API key</b> · {k.map((p) => p.label).join(', ')}</span>}
+                      {pl.length > 0 && <span><b>Pool</b> · {pl.map((p) => p.label).join(', ')}</span>}
+                    </>
+                  ) : (
+                    <span className="cp-dim">No machine signed in, no key. <a className="re-link">Install on a machine</a> or <a className="re-link">connect a key</a>.</span>
+                  )}
+                </div>
+              </div>
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
