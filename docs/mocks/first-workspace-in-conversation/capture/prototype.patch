diff -ruN today/src/web/src/components/MachineSetupCard.tsx new/src/web/src/components/MachineSetupCard.tsx
--- today/src/web/src/components/MachineSetupCard.tsx	1970-01-01 08:00:00.000000000 +0800
+++ new/src/web/src/components/MachineSetupCard.tsx	2026-10-31 15:09:22.359223552 +0800
@@ -0,0 +1,230 @@
+import { CheckCircleFilled, DesktopOutlined } from '@ant-design/icons';
+import { useQuery } from '@tanstack/react-query';
+import { useEffect, useState } from 'react';
+import type { LoginEngine } from '@orbit/shared';
+import { api } from '../api';
+import { RunnerSignIn } from './RunnerSignIn';
+import { Button } from './ui/Button';
+import { Input } from './ui/Input';
+import { Radio, RadioGroup } from './ui/Radio';
+
+// PROTOTYPE for docs/mocks/first-workspace-in-conversation. A machine with no workspace gets this card
+// in its new-session draft, where the engine hero stands for a machine that has one. It holds the two
+// steps only the owner can take: where sessions work (the folder they may read and change) and the
+// coding CLI they run on. Whatever is sent waits for both; the workspace is made from the folder as
+// that first message starts its session.
+
+const ENGINE_NAME: Record<string, string> = {
+  claude: 'Claude Code', codex: 'Codex', kimi: 'Kimi Code', antigravity: 'Antigravity', cursor: 'Cursor CLI',
+};
+const LOGIN_ENGINES = ['claude', 'codex', 'kimi', 'antigravity', 'cursor'];
+
+interface DirProbe { path: string; exists: boolean; isGit: boolean; branch?: string | null }
+export interface SetupRunner {
+  id: string;
+  name: string;
+  displayName?: string | null;
+  online?: boolean;
+  reposRoot?: string | null;
+  engines?: { engine: string; installed?: boolean; auth?: string }[] | null;
+  /** Prototype fields: where `orbit register` ran, what the runner saw there, and its home. */
+  registerDir?: string | null;
+  registerDirProbe?: DirProbe | null;
+  homeDir?: string | null;
+}
+
+const tilde = (path: string, home?: string | null) =>
+  home && (path === home || path.startsWith(`${home}/`)) ? `~${path.slice(home.length)}` : path;
+const basename = (path: string) => path.replace(/\/+$/, '').split('/').pop() || path;
+
+function verdict(p: DirProbe | null | undefined, machine: string): { text: string; tone: 'ok' | 'warn' | 'bad' | 'wait' } {
+  if (!p) return { text: `Checking on ${machine}…`, tone: 'wait' };
+  if (!p.exists) return { text: `No such directory on ${machine}.`, tone: 'bad' };
+  if (!p.isGit) return { text: 'Found · not a git repository — sessions will share it instead of isolating.', tone: 'warn' };
+  return { text: `Found · git repository${p.branch ? ` · ${p.branch}` : ''}`, tone: 'ok' };
+}
+
+type Choice = 'suggested' | 'new' | 'other';
+
+export function MachineSetupCard({
+  runner,
+  engine,
+  onEngine,
+  onUseApiKey,
+}: {
+  runner: SetupRunner;
+  engine: LoginEngine;
+  onEngine?: (engine: LoginEngine) => void;
+  onUseApiKey?: () => void;
+}) {
+  const machine = runner.displayName || runner.name;
+  const home = runner.homeDir ?? null;
+  // The folder `orbit register` ran in is offered only when it is a project of its own: the installer
+  // runs there, which is the home directory more often than not, and the whole home is no default.
+  const suggested =
+    runner.registerDir && runner.registerDir !== home && runner.registerDir !== '/' ? runner.registerDir : null;
+  const [choice, setChoice] = useState<Choice>(suggested ? 'suggested' : 'new');
+  const [newName, setNewName] = useState('');
+  const [other, setOther] = useState('');
+  const [picked, setPicked] = useState<{ path: string; probe: DirProbe | null } | null>(null);
+  const reposRoot = runner.reposRoot ?? (home ? `${home}/orbit-repos` : '~/orbit-repos');
+
+  // A typed path is checked on the machine before anything is made (prototype route; see the board's
+  // server column). Debounced like the Claude history lookup the workspace form already makes.
+  const [asked, setAsked] = useState('');
+  useEffect(() => {
+    const t = setTimeout(() => setAsked(other.trim()), 400);
+    return () => clearTimeout(t);
+  }, [other]);
+  const probe = useQuery({
+    queryKey: ['probe-dir', runner.id, asked],
+    queryFn: () => api<DirProbe>(`/runners/${runner.id}/probe-dir?path=${encodeURIComponent(asked)}`),
+    enabled: choice === 'other' && !!asked,
+  });
+
+  const signedIn = runner.engines?.find((e) => e.engine === engine)?.auth === 'yes';
+  const others = (runner.engines ?? [])
+    .filter((e) => e.installed && e.engine !== engine && LOGIN_ENGINES.includes(e.engine))
+    .map((e) => e.engine as LoginEngine);
+  const offline = runner.online === false;
+
+  const candidate =
+    choice === 'suggested' && suggested
+      ? { path: suggested, probe: runner.registerDirProbe ?? null }
+      : choice === 'new'
+        ? newName.trim() ? { path: `${reposRoot}/${newName.trim()}`, probe: null } : null
+        : other.trim() && probe.data?.exists ? { path: other.trim(), probe: probe.data } : null;
+  const ready = !!picked && signedIn;
+
+  return (
+    <div className="msc" data-proto="machine-setup">
+      <div className="msc-head">
+        <span className="msc-head-icon"><DesktopOutlined /></span>
+        <div>
+          <div className="msc-title">Set up {machine}</div>
+          <div className="msc-sub">
+            Pick where it works and sign in a coding CLI. Anything you send waits until both are done.
+          </div>
+        </div>
+      </div>
+
+      {offline && (
+        <div className="msc-offline">{machine} is offline. It can’t check folders or sign in until it’s back.</div>
+      )}
+
+      <div className="msc-step" data-step="folder">
+        {picked ? <CheckCircleFilled className="msc-num done" /> : <span className="msc-num">1</span>}
+        <div>
+          {picked ? (
+            <div className="msc-done-line">
+              <span className="msc-step-title">Folder</span>
+              <span className="msc-path">{tilde(picked.path, home)}</span>
+              <span className="msc-meta">
+                {picked.probe ? verdict(picked.probe, machine).text.replace(/^Found · /, '') : 'new folder · created as the session starts'}
+              </span>
+              <button className="msc-change" type="button" onClick={() => setPicked(null)}>Change</button>
+            </div>
+          ) : (
+            <>
+              <div className="msc-step-title">Folder</div>
+              <div className="msc-step-help">
+                Where on {machine} should sessions work? They can read and change everything in it.
+              </div>
+              <RadioGroup<Choice> className="msc-options" value={choice} onValueChange={setChoice} disabled={offline}>
+                {suggested && (
+                  <Radio value="suggested" className="msc-option">
+                    <span className="msc-path">{tilde(suggested, home)}</span>
+                    <span className={`msc-verdict ${verdict(runner.registerDirProbe, machine).tone}`}>
+                      {verdict(runner.registerDirProbe, machine).text}
+                    </span>
+                    <span className="msc-meta">Where you ran orbit register</span>
+                  </Radio>
+                )}
+                <Radio value="new" className="msc-option">
+                  <span className="msc-option-title">A new folder</span>
+                  {choice === 'new' && (
+                    <Input
+                      className="msc-input"
+                      size="small"
+                      prefix={<span className="msc-prefix">{tilde(reposRoot, home)}/</span>}
+                      placeholder="name"
+                      value={newName}
+                      onChange={(e) => setNewName(e.target.value)}
+                    />
+                  )}
+                  <span className="msc-meta">Starts empty. Ask for a clone or a new project in your first message.</span>
+                </Radio>
+                <Radio value="other" className="msc-option">
+                  <span className="msc-option-title">Another folder on {machine}</span>
+                  {choice === 'other' && (
+                    <>
+                      <Input
+                        className="msc-input msc-path-input"
+                        size="small"
+                        placeholder={home ? `${home}/…` : '/path/to/project'}
+                        value={other}
+                        onChange={(e) => setOther(e.target.value)}
+                      />
+                      {asked && (
+                        <span className={`msc-verdict ${verdict(probe.data, machine).tone}`}>
+                          {verdict(probe.data, machine).text}
+                        </span>
+                      )}
+                    </>
+                  )}
+                </Radio>
+              </RadioGroup>
+              <Button
+                className="msc-use"
+                variant="primary"
+                size="small"
+                disabled={!candidate || offline}
+                onClick={() => candidate && setPicked(candidate)}
+              >
+                Use this folder
+              </Button>
+            </>
+          )}
+        </div>
+      </div>
+
+      <div className="msc-step" data-step="engine">
+        {signedIn ? <CheckCircleFilled className="msc-num done" /> : <span className="msc-num">2</span>}
+        <div>
+          {signedIn ? (
+            <div className="msc-done-line">
+              <span className="msc-step-title">{ENGINE_NAME[engine]}</span>
+              <span className="msc-meta">signed in on {machine}</span>
+            </div>
+          ) : (
+            <>
+              <div className="msc-step-title">Sign in {ENGINE_NAME[engine]} on {machine}</div>
+              <div className="msc-step-help">
+                Sessions run on the coding CLIs signed in on that machine, and spend its subscription.
+              </div>
+              {!offline && <RunnerSignIn runnerId={runner.id} engine={engine} onUseApiKey={onUseApiKey} />}
+              {others.length > 0 && onEngine && (
+                <div className="msc-alt">
+                  {others.map((e, i) => (
+                    <span key={e}>
+                      {i > 0 && ' · '}
+                      <button className="msc-change" type="button" onClick={() => onEngine(e)}>
+                        Use {ENGINE_NAME[e]} instead
+                      </button>
+                    </span>
+                  ))}
+                </div>
+              )}
+            </>
+          )}
+        </div>
+      </div>
+
+      <div className={`msc-foot${ready ? ' ready' : ''}`}>
+        {ready && picked
+          ? `Ready. Send a task — Orbit adds the workspace “${basename(picked.path)}” for ${tilde(picked.path, home)} as it starts.`
+          : 'Nothing is created until you send. You can rename the workspace or change these later.'}
+      </div>
+    </div>
+  );
+}
