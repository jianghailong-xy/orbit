+const CLI_NAME: Record<string, string> = { claude: 'Claude Code', codex: 'Codex', kimi: 'Kimi Code', antigravity: 'Antigravity', cursor: 'Cursor CLI' };
+
 function signedOutItems(
   runner: AttentionRunner,
   workspaces: ReadonlyArray<AttentionWorkspace>,
 ): AttentionItem[] {
