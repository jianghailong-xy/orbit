+/* PROTOTYPE (docs/mocks/owner-answer-sent-card) ─────────────────────────────────────────────────
+   A: the owner's answer handed to the coordinator, as a delivery card on the reader's side — the
+   shape the exception item, the task's start and another session's message already take (.oic,
+   .tsc, .smc) — in green, so it never reads as the blue question card above it. */
+.oa-card-wrap {
+  display: flex;
+  justify-content: flex-end;
+  margin: 8px 0;
+}
+.oa-card {
+  width: min(560px, 88%);
+  padding: 10px 12px;
+  border: 1px solid var(--success-border);
+  border-radius: 12px;
+  background: color-mix(in srgb, var(--success-bg) 60%, var(--bg-raised));
+  color: var(--text-1);
+}
+.oa-card.is-queued {
+  border-style: dashed;
+}
+.oa-card-head {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  color: var(--success);
+  font-weight: 600;
+}
+.oa-card-mark {
+  flex: none;
+  display: inline-flex;
+}
+.oa-card-time {
+  margin-left: auto;
+  flex: none;
+  color: var(--text-3);
+  font-size: 12px;
+  font-weight: 400;
+}
+.oa-card-to {
+  margin-top: 4px;
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+  color: var(--text-3);
+  font-size: 12.5px;
+}
+.oa-card-answer {
+  display: flex;
+  align-items: baseline;
+  gap: 6px;
+  margin-top: 2px;
+  font-size: 14px;
+}
+.oa-card-tick {
+  flex: none;
+  color: var(--success);
+}
+.oa-card-undelivered {
+  margin-top: 4px;
+  color: var(--warning);
+  font-size: 12px;
+}
+.oa-card-raw {
+  margin-top: 8px;
+  padding-top: 6px;
+  border-top: 1px solid var(--success-border);
+  font-size: 12px;
+}
+.oa-card-raw summary {
+  color: var(--text-2);
+  cursor: pointer;
+}
+.oa-card-raw pre {
+  max-height: 320px;
+  margin: 6px 0 0;
+  padding: 8px;
+  overflow: auto;
+  border-radius: 6px;
+  background: var(--fill-inset);
+  font-size: 11px;
+  white-space: pre-wrap;
+  word-break: break-word;
+}
+.oa-card-queued {
+  margin-top: 6px;
+}
+.oa-card-queued .chat-queued-meta {
+  flex-wrap: wrap;
+  justify-content: flex-start;
+  row-gap: 2px;
+}
+/* B: nothing in the stream — the question's card says where its answer went. */
+.oa-merged {
+  height: 6px;
+}
+.answered-question-open.is-sent {
+  gap: 12px;
+}
+.answered-question-sent {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-width: 0;
+  color: var(--success);
+  font-weight: 500;
+}
+.answered-question-open-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  flex: none;
+}
+/* C: a card in the question card's own shape, full width under it, white and green instead of blue. */
+.oa-twin {
+  margin: 8px 0;
+}
+.oa-twin-card {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  padding: 12px 14px;
+  border: 1px solid var(--success-border);
+  border-radius: 10px;
+  background: var(--bg-raised);
+  list-style: none;
+  cursor: pointer;
+}
+.oa-twin-card::-webkit-details-marker {
+  display: none;
+}
+.oa-twin.is-queued .oa-twin-card {
+  border-style: dashed;
+}
+.oa-twin-head {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.oa-twin-icon {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  flex: none;
+  width: 22px;
+  height: 22px;
+  border-radius: 6px;
+  background: var(--success-bg);
+  color: var(--success);
+  font-size: 12px;
+}
+.oa-twin-heading {
+  min-width: 0;
+  font-weight: 600;
+  font-size: 15px;
+}
+.oa-twin-time {
+  margin-left: auto;
+  flex: none;
+  font-size: 12px;
+  color: var(--text-3);
+}
+.oa-twin-to {
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+  font-size: 12.5px;
+  line-height: 1.55;
+  color: var(--text-3);
+}
+.oa-twin-answer {
+  display: flex;
+  align-items: baseline;
+  gap: 6px;
+  font-size: 14px;
+  color: var(--text-1);
+}
+.oa-twin-tick {
+  flex: none;
+  color: var(--success);
+}
+.oa-twin-open {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding-top: 8px;
+  border-top: 1px solid var(--success-border);
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--success);
+}
+.oa-twin-caret {
+  transition: transform 0.15s ease;
+}
+.oa-twin-fold[open] .oa-twin-caret {
+  transform: rotate(90deg);
+}
+.oa-twin-told {
+  margin-top: 6px;
+  font-size: 12px;
+}
+.oa-twin-told pre {
+  max-height: 320px;
+  margin: 0;
+  padding: 8px;
+  overflow: auto;
+  border-radius: 6px;
+  background: var(--fill-inset);
+  font-size: 11px;
+  white-space: pre-wrap;
+  word-break: break-word;
+}
