diff --git a/src/web/src/lib/sessionMessage.ts b/src/web/src/lib/sessionMessage.ts
index 3ae735e..2a02617 100644
--- a/src/web/src/lib/sessionMessage.ts
+++ b/src/web/src/lib/sessionMessage.ts
@@ -47,3 +47,28 @@ export function sessionMessageTitle(card: SessionMessageCard): string {
 export function sessionMessageSticky(card: SessionMessageCard, text: string): { label: string; text: string } {
   return { label: `${SESSION_MESSAGE_FROM} ${sessionMessageTitle(card)}`, text };
 }
+
+const SESSION_MESSAGE_BLOCK = /<orbit-session-message\b([^>]*)>([\s\S]*?)<\/orbit-session-message>/;
+const NARROWER = /The sender runs in (\S+), which is narrower than this session's (\S+)\./;
+const MODE_LABEL: Record<string, string> = {
+  default: 'Default', plan: 'Plan', acceptEdits: 'Accept Edits', auto: 'Auto', dontAsk: "Don't Ask", bypassPermissions: 'Bypass',
+};
+
+/**
+ * A session message's recorded note with its own block taken out: the card already says everything
+ * that block tells the agent (who sent it, its task, the request), so only what else delivery
+ * appended is left to fold. What the card does not otherwise say — that the sender runs narrower
+ * than this session — comes back as `narrower`, a line for the card's foot.
+ */
+export function splitSessionMessageNote(note: string | null | undefined): { rest: string; narrower: string | null } {
+  if (!note) return { rest: '', narrower: null };
+  const m = SESSION_MESSAGE_BLOCK.exec(note);
+  if (!m) return { rest: note, narrower: null };
+  const n = NARROWER.exec(m[2]);
+  const label = (mode: string) => MODE_LABEL[mode] ?? mode;
+  return {
+    rest: note.replace(m[0], '').trim(),
+    narrower: n ? `${SESSION_MESSAGE_NARROWER_PREFIX} ${label(n[1])}, narrower than this session's ${label(n[2])}: not taken as your approval` : null,
+  };
+}
+export const SESSION_MESSAGE_NARROWER_PREFIX = 'Sender runs in';
