@@ -0,0 +1,303 @@
+// MOCK (scratch tree only): the parts a shared key pool adds to the pool page — its people, its
+// rules, the way an OpenAI API key joins it, and the dialog that adds one.
+import { Button, Checkbox, Input, Modal, Radio, Segmented, Select, Switch } from 'antd';
+import {
+  CheckCircleFilled,
+  EllipsisOutlined,
+  ExclamationCircleFilled,
+  UserAddOutlined,
+  WarningFilled,
+} from '@ant-design/icons';
+import type { PoolPerson, ProviderPool } from '../lib/providerPools';
+import { OwnerAvatar } from './AccountPools';
+import { ProviderTile } from './ProviderGallery';
+import './pool-mock.css';
+
+const plural = (n: number, one: string) => `${n} ${one}${n === 1 ? '' : 's'}`;
+
+/** Who is in the pool: what each has put in, and how much of this window's use was theirs. */
+export function PoolPeopleCard({ pool }: { pool: ProviderPool }) {
+  const people = pool.people ?? [];
+  const admin = pool.viewerRole === 'Admin';
+  return (
+    <div className="re-card pool-card pool-sub-sec" data-mk="people-card">
+      <div className="re-head">
+        <span className="re-runner">
+          Members<span className="pool-head-count">{people.length}</span>
+        </span>
+        <span className="re-head-sp" />
+        <span className="pool-head-note">Share of this month’s use</span>
+        {admin && (
+          <Button size="small" icon={<UserAddOutlined />} data-mk="add-members">
+            Add members
+          </Button>
+        )}
+      </div>
+      {people.map((p) => (
+        <PersonRow key={p.name} person={p} canManage={admin && !p.you} />
+      ))}
+    </div>
+  );
+}
+
+function PersonRow({ person, canManage }: { person: PoolPerson; canManage: boolean }) {
+  return (
+    <div className="pool-person" data-mk={`person-${person.name.split(' ')[0].toLowerCase()}`}>
+      <div className="pool-person-id">
+        <OwnerAvatar owner={person} />
+        <div style={{ minWidth: 0 }}>
+          <div className="pool-person-name">
+            <span>{person.name}</span>
+            {person.you && <span className="pool-you">you</span>}
+            {person.role === 'Admin' && <span className="re-chip">ADMIN</span>}
+          </div>
+          <div className={`pool-person-meta${person.keys ? '' : ' none'}`}>
+            {person.keys ? plural(person.keys, 'key') : 'No key'} · {plural(person.sessions, 'session')}
+          </div>
+        </div>
+      </div>
+      <div className="pool-share">
+        <span className="runner-util">
+          <span className="runner-util-fill" style={{ width: `${person.share}%` }} />
+        </span>
+        <span className="pool-share-pct">{person.share}%</span>
+      </div>
+      <div className="pool-person-more">{canManage && <EllipsisOutlined aria-label={`Manage ${person.name}`} />}</div>
+    </div>
+  );
+}
+
+/** The two rules an admin sets. Everyone else reads them. */
+export function PoolRulesCard({ pool }: { pool: ProviderPool }) {
+  const admin = pool.viewerRole === 'Admin';
+  return (
+    <div className="re-card pool-card pool-sub-sec" data-mk="rules-card">
+      <div className="re-head">
+        <span className="re-runner">Rules</span>
+        <span className="re-head-sp" />
+        {!admin && <span className="pool-head-note">Set by the pool’s admins</span>}
+      </div>
+      <div className="pool-rule">
+        <div>
+          <div className="pool-rule-t">Members can add keys</div>
+          <div className="pool-rule-h">
+            Anyone in {pool.label} can put an OpenAI API key in. Off: only admins can.
+          </div>
+        </div>
+        <Switch checked={!!pool.membersCanAdd} disabled={!admin} />
+      </div>
+      <div className="pool-rule" data-mk="rule-own">
+        <div>
+          <div className="pool-rule-t">Own key first</div>
+          <div className="pool-rule-h">
+            A member’s sessions start on a key they added while it has room, then move on to the
+            others’.
+          </div>
+        </div>
+        <Switch checked={!!pool.ownKeyFirst} disabled={!admin} />
+      </div>
+    </div>
+  );
+}
+
+export type AddStep = 'consent' | 'form' | 'done' | 'dup';
+
+/** Putting one's own API key in: what that means, the two fields that add it, and how it ended. */
+export function AddKeyModal({ pool, step, me }: { pool: ProviderPool; step: AddStep; me: PoolPerson }) {
+  const people = pool.people?.length ?? 0;
+  const named = `${me.name.split(' ')[0].toLowerCase()}-org-1`;
+  const footer =
+    step === 'consent' ? (
+      <>
+        <Button>Cancel</Button>
+        <Button type="primary" data-mk="consent-go">
+          Continue
+        </Button>
+      </>
+    ) : step === 'form' ? (
+      <>
+        <Button>Cancel</Button>
+        <Button type="primary" data-mk="add-key-go">
+          Add key
+        </Button>
+      </>
+    ) : step === 'dup' ? (
+      <>
+        <Button>Close</Button>
+        <Button type="primary">Add another key</Button>
+      </>
+    ) : (
+      <Button type="primary">Done</Button>
+    );
+  return (
+    <Modal open width={500} title={`Add a key to ${pool.label}`} footer={footer} onCancel={() => {}}>
+      {step === 'consent' && (
+        <div data-mk="add-consent">
+          <div className="pa-lead">Paste an OpenAI API key to put in this pool.</div>
+          <ul className="pa-facts">
+            <li>
+              <b>Everyone in {pool.label} can run sessions on it</b> — {people} people. Their sessions
+              spend this key’s budget.
+            </li>
+            <li>
+              <b>The key stays on the Orbit server.</b> It never goes to a runner — runners get a
+              session token, not the key — and nobody in the pool sees it or its full value.
+            </li>
+            <li>
+              <b>Take it out, or replace it, any time.</b> Its usage shows on this page for everyone
+              in the pool.
+            </li>
+          </ul>
+          <div className="pa-risk" data-mk="add-risk">
+            <WarningFilled />
+            <span>
+              <b>Keys can’t be resold.</b> Everything run with this key is billed to its account, and
+              the person who adds it is responsible for it.
+            </span>
+          </div>
+        </div>
+      )}
+      {step === 'form' && (
+        <div data-mk="add-form">
+          <div className="pa-lead">Name it, paste it, and set what the others may spend on it.</div>
+          <label className="np-field">
+            <span className="np-field-l">Name</span>
+            <Input value={named} />
+          </label>
+          <div className="np-field">
+            <span className="np-field-l">Key</span>
+            <Input.Password value="sk-proj-9tRkQm2Zx8VbN4Lc7Hd39E4D" readOnly />
+            <div className="np-field-h">
+              Checked once, then only its fingerprint (<b>sk-…9E4D</b>) is shown — the key itself
+              stays on the Orbit server.
+            </div>
+          </div>
+          <div className="np-field">
+            <span className="np-field-l">Limit</span>
+            <Input prefix="$" suffix="a month" value="50" />
+            <div className="np-field-h">
+              Others in {pool.label} can spend up to this on the key each month. Your own sessions
+              aren’t limited by it.
+            </div>
+          </div>
+        </div>
+      )}
+      {step === 'done' && (
+        <div data-mk="add-done">
+          <div className="pa-done">
+            <CheckCircleFilled />
+            <div>
+              <div className="pa-done-t">{named} is in {pool.label}</div>
+              <div className="pa-done-s">
+                <b>sk-…9E4D</b> · ready for the next session. Only you and the pool’s admins can
+                replace it.
+              </div>
+            </div>
+          </div>
+          <div className="pa-acct">
+            <OwnerAvatar owner={me} />
+            <div>
+              <div className="pa-acct-t">{named}</div>
+              <div className="pa-acct-s">
+                {me.name} · sk-…9E4D · only its fingerprint is ever shown
+              </div>
+            </div>
+          </div>
+        </div>
+      )}
+      {step === 'dup' && (
+        <div className="pa-done pa-dup" data-mk="add-dup">
+          <ExclamationCircleFilled />
+          <div>
+            <div className="pa-done-t">This key is already in {pool.label}</div>
+            <div className="pa-done-s">
+              Wikova added it. The same key twice doesn’t add budget — add a different one.
+            </div>
+          </div>
+        </div>
+      )}
+    </Modal>
+  );
+}
+
+/** Making a pool: which engine, what it's called, who else is in it. */
+export function NewPoolModal() {
+  const person = (name: string, color: string) => ({
+    value: name,
+    label: (
+      <span style={{ display: 'inline-flex', alignItems: 'center', gap: 6 }}>
+        <OwnerAvatar owner={{ name, color }} size={16} />
+        {name}
+      </span>
+    ),
+  });
+  const people = [person('Zhang Min', '#16a34a'), person('Chen Yu', '#db2777'), person('Lin Wei', '#ea580c')];
+  return (
+    <Modal
+      open
+      width={520}
+      title="New account pool"
+      onCancel={() => {}}
+      footer={
+        <>
+          <Button>Cancel</Button>
+          <Button type="primary">Create pool</Button>
+        </>
+      }
+    >
+      <div className="np-field" data-mk="new-engine">
+        <span className="np-field-l">Engine</span>
+        <Segmented
+          className="np-engine"
+          value="codex"
+          options={[
+            {
+              value: 'claude',
+              label: (
+                <>
+                  <ProviderTile slug="anthropic" label="Claude" size={16} /> Claude
+                </>
+              ),
+            },
+            {
+              value: 'codex',
+              label: (
+                <>
+                  <ProviderTile slug="openai" label="Codex" size={16} /> Codex
+                </>
+              ),
+            },
+          ]}
+        />
+        <div className="np-field-h">
+          A Codex pool holds OpenAI API keys — each person pastes their own once the pool exists. A
+          Claude pool is made of your Anthropic API keys.
+        </div>
+      </div>
+      <label className="np-field">
+        <span className="np-field-l">Name</span>
+        <Input value="Team Codex" />
+      </label>
+      <div className="np-field" data-mk="new-who">
+        <span className="np-field-l">Who can use it</span>
+        <Radio.Group value="shared">
+          <Radio value="me">Just me</Radio>
+          <Radio value="shared">Me and people I add</Radio>
+        </Radio.Group>
+        <Select
+          mode="multiple"
+          style={{ width: '100%', marginTop: 10 }}
+          value={['Zhang Min', 'Chen Yu', 'Lin Wei']}
+          options={people}
+          optionLabelProp="label"
+        />
+        <div className="np-field-h">
+          They see it on their Providers page and in the session picker, and can start sessions on it.
+        </div>
+        <Checkbox checked style={{ marginTop: 8 }}>
+          They can add their own keys
+        </Checkbox>
+      </div>
+    </Modal>
+  );
+}
