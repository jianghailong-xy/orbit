+/* MOCK (scratch tree only): what a shared account pool adds. Tokens come from index.css. */
+
+/* People are circles with an initial — the Team mock's mark. */
+.pool-av {
+  display: inline-flex;
+  flex: none;
+  align-items: center;
+  justify-content: center;
+  border-radius: 50%;
+  color: #fff;
+  font-weight: 600;
+  line-height: 1;
+}
+.pool-you {
+  flex: none;
+  margin-left: 6px;
+  font-size: 12px;
+  font-weight: 400;
+  color: var(--text-3);
+}
+
+/* The head: the engine's mark before the name, SHARED after it, the people at the right. */
+.pool-card .re-toggle .provider-tile {
+  flex: none;
+  margin-right: 2px;
+}
+.re-chip.pool-shared-chip {
+  margin-left: 0;
+  background: var(--brand-tint);
+  color: var(--brand);
+}
+.pool-people {
+  display: inline-flex;
+  align-items: center;
+  flex: none;
+  margin-right: 6px;
+}
+.pool-people .pool-av {
+  box-shadow: 0 0 0 2px var(--bg-raised, #fff);
+}
+.pool-people .pool-av + .pool-av {
+  margin-left: -5px;
+}
+
+/* ── the pool page: its people and its rules ─────────────────────────────────────────────── */
+.pool-page-title {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+}
+.pool-page-title .page-title {
+  margin-bottom: 0;
+}
+.pool-sub-sec {
+  margin-top: 16px;
+}
+.pool-card .re-head .pool-head-count {
+  font-size: 12px;
+  font-weight: 400;
+  color: var(--text-3);
+  margin-left: 6px;
+}
+.pool-head-note {
+  font-size: 11.5px;
+  color: var(--text-3);
+  white-space: nowrap;
+}
+.pool-person {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(160px, 240px) 28px;
+  align-items: center;
+  gap: 14px;
+  padding: 10px 14px;
+}
+.pool-person + .pool-person {
+  border-top: 1px solid var(--border-subtle);
+}
+.pool-person-id {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-width: 0;
+}
+.pool-person-name {
+  display: flex;
+  align-items: center;
+  min-width: 0;
+  font-size: 13.5px;
+  font-weight: 500;
+  color: var(--text-1);
+}
+.pool-person-name > span:first-child {
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.pool-person-meta {
+  font-size: 12px;
+  color: var(--text-3);
+}
+.pool-person-accts {
+  font-size: 12.5px;
+  color: var(--text-2);
+}
+.pool-person-accts.none {
+  color: var(--text-3);
+}
+.pool-share {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  font-size: 12px;
+  color: var(--text-2);
+  font-variant-numeric: tabular-nums;
+}
+.pool-share .runner-util {
+  flex: 1;
+  margin-top: 0;
+}
+.pool-share-pct {
+  width: 32px;
+  text-align: right;
+}
+.pool-person-more {
+  color: var(--text-3);
+  text-align: center;
+}
+.pool-rule {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 24px;
+  padding: 12px 14px;
+}
+.pool-rule + .pool-rule {
+  border-top: 1px solid var(--border-subtle);
+}
+.pool-rule-t {
+  font-size: 13.5px;
+  color: var(--text-1);
+}
+.pool-rule-h {
+  font-size: 12px;
+  line-height: 1.55;
+  color: var(--text-3);
+}
+.pool-danger-row {
+  display: flex;
+  gap: 8px;
+  align-items: center;
+}
+.pool-danger-note {
+  font-size: 12px;
+  color: var(--text-3);
+}
+
+/* ── "Add my account" ────────────────────────────────────────────────────────────────────── */
+.pa-lead {
+  font-size: 13px;
+  color: var(--text-2);
+  line-height: 1.6;
+  margin: 2px 0 12px;
+}
+.pa-facts {
+  margin: 0 0 14px;
+  padding: 10px 12px 10px 30px;
+  border-radius: 8px;
+  background: var(--bg-sunken);
+  font-size: 12.5px;
+  line-height: 1.65;
+  color: var(--text-2);
+}
+.pa-facts li + li {
+  margin-top: 4px;
+}
+.pa-facts b {
+  color: var(--text-1);
+  font-weight: 600;
+}
+.pa-risk {
+  display: flex;
+  gap: 8px;
+  align-items: flex-start;
+  margin: 0 0 4px;
+  padding: 8px 10px;
+  border: 1px solid var(--warning-border, #f5d6a3);
+  border-radius: 8px;
+  background: var(--warning-tint, #fff8ec);
+  font-size: 12.5px;
+  line-height: 1.55;
+  color: var(--text-2);
+}
+.pa-risk .anticon {
+  margin-top: 3px;
+  color: var(--warning);
+}
+.pa-step {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin: 0 0 12px;
+  font-size: 12px;
+  color: var(--text-3);
+}
+.pa-step b {
+  color: var(--text-2);
+  font-weight: 600;
+}
+.pa-done {
+  display: flex;
+  gap: 12px;
+  align-items: flex-start;
+  padding: 4px 0 8px;
+}
+.pa-done-t {
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--text-1);
+}
+.pa-done-s {
+  font-size: 12.5px;
+  color: var(--text-3);
+  line-height: 1.6;
+}
+.pa-done .anticon {
+  font-size: 22px;
+  color: var(--success, #16a34a);
+  margin-top: 2px;
+}
+.pa-dup .anticon {
+  color: var(--warning);
+}
+.pa-acct {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin: 10px 0 2px;
+  padding: 10px 12px;
+  border: 1px solid var(--border);
+  border-radius: 8px;
+}
+.pa-acct-t {
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--text-1);
+}
+.pa-acct-s {
+  font-size: 12px;
+  color: var(--text-3);
+}
+
+/* ── New pool ────────────────────────────────────────────────────────────────────────────── */
+.np-field {
+  display: block;
+  margin: 0 0 14px;
+}
+.np-field-l {
+  display: block;
+  margin: 0 0 6px;
+  font-size: 13px;
+  color: var(--text-2);
+}
+.np-field-h {
+  margin-top: 6px;
+  font-size: 12px;
+  line-height: 1.55;
+  color: var(--text-3);
+}
+.np-engine .ant-segmented-item-label {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+}
+
+@media (max-width: 700px) {
+  .pool-person {
+    grid-template-columns: minmax(0, 1fr) 28px;
+    row-gap: 6px;
+  }
+  .pool-person > :nth-child(2) {
+    grid-column: 1;
+    grid-row: 2;
+    padding-left: 38px;
+  }
+  .pool-person > :nth-child(3) {
+    grid-column: 2;
+    grid-row: 1;
+  }
+  .pool-head-note {
+    display: none;
+  }
+  .pool-rule {
+    gap: 14px;
+  }
+}
+
+/* The section head carries a way to make another pool. */
+.pool-sec-head {
+  display: flex;
+  align-items: baseline;
+  gap: 10px;
+}
+.pool-sec-head .pool-new {
+  margin-left: auto;
+  align-self: center;
+  flex: none;
+}
+.pool-sec-head h3 {
+  white-space: nowrap;
+}
+.ant-modal-close {
+  outline: none !important;
+  box-shadow: none !important;
+}
+
+/* Phone: the people stack is desktop-only (.pool-wide), the head's name must survive; a row's
+   actions sit at the right edge of their own line; the members' head note drops under the title. */
+@media (max-width: 700px) {
+  .pool-people {
+    display: none;
+  }
+  .pool-row .re-act,
+  .pool-detail .pool-row .re-act {
+    grid-column: 1 / -1;
+    margin-top: -4px;
+  }
+  .pool-sub-sec .re-head {
+    flex-wrap: wrap;
+    row-gap: 2px;
+  }
+  .pool-sub-sec .pool-head-note {
+    display: block;
+    order: 5;
+    width: 100%;
+  }
+  .re-chip.pool-shared-chip {
+    flex: none;
+  }
+}
+@media (max-width: 700px) {
+  /* The pool's name outranks the chip on a phone head; the pool's own page carries SHARED. */
+  .pool-card .re-toggle .pool-shared-chip {
+    display: none;
+  }
+}
