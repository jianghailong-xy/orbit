@@ -0,0 +1,283 @@
+// MOCK (scratch tree only): the parts a shared account pool adds to the pool page — its people, its
+// rules, the way an account joins it, and the dialog that makes one.
+import { Button, Checkbox, Input, Modal, Radio, Segmented, Select, Switch } from 'antd';
+import {
+  CheckCircleFilled,
+  EllipsisOutlined,
+  ExclamationCircleFilled,
+  ExportOutlined,
+  LoadingOutlined,
+  UserAddOutlined,
+  WarningFilled,
+} from '@ant-design/icons';
+import type { PoolPerson, ProviderPool } from '../lib/providerPools';
+import { OwnerAvatar } from './AccountPools';
+import { ProviderTile } from './ProviderGallery';
+import './pool-mock.css';
+
+const plural = (n: number, one: string) => `${n} ${one}${n === 1 ? '' : 's'}`;
+
+/** Who is in the pool: what each has put in, and how much of this week's use was theirs. */
+export function PoolPeopleCard({ pool }: { pool: ProviderPool }) {
+  const people = pool.people ?? [];
+  const admin = pool.viewerRole === 'Admin';
+  return (
+    <div className="re-card pool-card pool-sub-sec" data-mk="people-card">
+      <div className="re-head">
+        <span className="re-runner">
+          Members<span className="pool-head-count">{people.length}</span>
+        </span>
+        <span className="re-head-sp" />
+        <span className="pool-head-note">Share of this week’s use</span>
+        {admin && (
+          <Button size="small" icon={<UserAddOutlined />} data-mk="add-members">
+            Add members
+          </Button>
+        )}
+      </div>
+      {people.map((p) => (
+        <PersonRow key={p.name} person={p} canManage={admin && !p.you} />
+      ))}
+    </div>
+  );
+}
+
+function PersonRow({ person, canManage }: { person: PoolPerson; canManage: boolean }) {
+  return (
+    <div className="pool-person" data-mk={`person-${person.name.split(' ')[0].toLowerCase()}`}>
+      <div className="pool-person-id">
+        <OwnerAvatar owner={person} />
+        <div style={{ minWidth: 0 }}>
+          <div className="pool-person-name">
+            <span>{person.name}</span>
+            {person.you && <span className="pool-you">you</span>}
+            {person.role === 'Admin' && <span className="re-chip">ADMIN</span>}
+          </div>
+          <div className={`pool-person-meta${person.accounts ? '' : ' none'}`}>
+            {person.accounts ? plural(person.accounts, 'account') : 'No account'} ·{' '}
+            {plural(person.sessions, 'session')}
+          </div>
+        </div>
+      </div>
+      <div className="pool-share">
+        <span className="runner-util">
+          <span className="runner-util-fill" style={{ width: `${person.share}%` }} />
+        </span>
+        <span className="pool-share-pct">{person.share}%</span>
+      </div>
+      <div className="pool-person-more">{canManage && <EllipsisOutlined aria-label={`Manage ${person.name}`} />}</div>
+    </div>
+  );
+}
+
+/** The two rules an admin sets. Everyone else reads them. */
+export function PoolRulesCard({ pool }: { pool: ProviderPool }) {
+  const admin = pool.viewerRole === 'Admin';
+  return (
+    <div className="re-card pool-card pool-sub-sec" data-mk="rules-card">
+      <div className="re-head">
+        <span className="re-runner">Rules</span>
+        <span className="re-head-sp" />
+        {!admin && <span className="pool-head-note">Set by the pool’s admins</span>}
+      </div>
+      <div className="pool-rule">
+        <div>
+          <div className="pool-rule-t">Members can add accounts</div>
+          <div className="pool-rule-h">
+            Anyone in {pool.label} can put their own Codex account in. Off: only admins can.
+          </div>
+        </div>
+        <Switch checked={!!pool.membersCanAdd} disabled={!admin} />
+      </div>
+      <div className="pool-rule" data-mk="rule-own">
+        <div>
+          <div className="pool-rule-t">Own account first</div>
+          <div className="pool-rule-h">
+            A member’s sessions start on their own account while it has room, then move on to the
+            others’.
+          </div>
+        </div>
+        <Switch checked={!!pool.ownFirst} disabled={!admin} />
+      </div>
+    </div>
+  );
+}
+
+export type AddStep = 'consent' | 'code' | 'done' | 'dup';
+
+/** Putting one's own ChatGPT account in: what that means, the device sign-in, and how it ended. */
+export function AddAccountModal({ pool, step, me }: { pool: ProviderPool; step: AddStep; me: PoolPerson }) {
+  const people = pool.people?.length ?? 0;
+  const footer =
+    step === 'consent' ? (
+      <>
+        <Button>Cancel</Button>
+        <Button type="primary" data-mk="consent-go">
+          Sign in with ChatGPT
+        </Button>
+      </>
+    ) : step === 'code' ? (
+      <Button>Cancel</Button>
+    ) : step === 'dup' ? (
+      <>
+        <Button>Close</Button>
+        <Button type="primary">Use another account</Button>
+      </>
+    ) : (
+      <Button type="primary">Done</Button>
+    );
+  return (
+    <Modal open width={500} title={`Add your Codex account to ${pool.label}`} footer={footer} onCancel={() => {}}>
+      {step === 'consent' && (
+        <div data-mk="add-consent">
+          <div className="pa-lead">Sign in with the ChatGPT account you want to put in this pool.</div>
+          <ul className="pa-facts">
+            <li>
+              <b>Everyone in {pool.label} can run sessions on it</b> — {people} people. Their sessions
+              spend this account’s Codex usage.
+            </li>
+            <li>
+              <b>The sign-in stays on the Orbit server.</b> It never goes to a runner, and nobody in the
+              pool sees it or the account’s email.
+            </li>
+            <li>
+              <b>Take it out, or sign it in again, any time.</b> Its usage shows on this page for
+              everyone in the pool.
+            </li>
+          </ul>
+          <div className="pa-risk" data-mk="add-risk">
+            <WarningFilled />
+            <span>OpenAI’s terms don’t allow an account to be shared. An account used this way can be suspended.</span>
+          </div>
+        </div>
+      )}
+      {step === 'code' && (
+        <div className="rsi" style={{ marginTop: 0 }} data-mk="add-code">
+          <a className="rsi-open" href="#">
+            <ExportOutlined /> Open the sign-in page
+          </a>
+          <div className="rsi-hint">
+            Sign in <b>with the account you’re adding</b>, then enter this one-time code:
+          </div>
+          <div className="rsi-usercode">QX7M-4TZPK</div>
+          <div className="rsi-row">
+            <LoadingOutlined /> Waiting for you to approve it…
+          </div>
+          <div className="rsi-hint">The code works for 15 minutes. You can close this — the sign-in finishes on its own.</div>
+        </div>
+      )}
+      {step === 'done' && (
+        <div data-mk="add-done">
+          <div className="pa-done">
+            <CheckCircleFilled />
+            <div>
+              <div className="pa-done-t">{me.name} · Plus is in {pool.label}</div>
+              <div className="pa-done-s">It’s ready for the next session. Only you can take it out or sign it in again.</div>
+            </div>
+          </div>
+          <div className="pa-acct">
+            <OwnerAvatar owner={me} />
+            <div>
+              <div className="pa-acct-t">{me.name} · Plus</div>
+              <div className="pa-acct-s">lin.wei@wikova.test · ChatGPT Plus · only you see the email</div>
+            </div>
+          </div>
+        </div>
+      )}
+      {step === 'dup' && (
+        <div className="pa-done pa-dup" data-mk="add-dup">
+          <ExclamationCircleFilled />
+          <div>
+            <div className="pa-done-t">This ChatGPT account is already in {pool.label}</div>
+            <div className="pa-done-s">
+              Zhang Min put it in. Signing in twice doesn’t add usage — sign in with a different
+              account.
+            </div>
+          </div>
+        </div>
+      )}
+    </Modal>
+  );
+}
+
+/** Making a pool: which engine, what it's called, who else is in it. */
+export function NewPoolModal() {
+  const person = (name: string, color: string) => ({
+    value: name,
+    label: (
+      <span style={{ display: 'inline-flex', alignItems: 'center', gap: 6 }}>
+        <OwnerAvatar owner={{ name, color }} size={16} />
+        {name}
+      </span>
+    ),
+  });
+  const people = [person('Zhang Min', '#16a34a'), person('Chen Yu', '#db2777'), person('Lin Wei', '#ea580c')];
+  return (
+    <Modal
+      open
+      width={520}
+      title="New account pool"
+      onCancel={() => {}}
+      footer={
+        <>
+          <Button>Cancel</Button>
+          <Button type="primary">Create pool</Button>
+        </>
+      }
+    >
+      <div className="np-field" data-mk="new-engine">
+        <span className="np-field-l">Engine</span>
+        <Segmented
+          className="np-engine"
+          value="codex"
+          options={[
+            {
+              value: 'claude',
+              label: (
+                <>
+                  <ProviderTile slug="anthropic" label="Claude" size={16} /> Claude
+                </>
+              ),
+            },
+            {
+              value: 'codex',
+              label: (
+                <>
+                  <ProviderTile slug="openai" label="Codex" size={16} /> Codex
+                </>
+              ),
+            },
+          ]}
+        />
+        <div className="np-field-h">
+          A Codex pool holds ChatGPT sign-ins, kept by the Orbit server — each person signs theirs in
+          once the pool exists. A Claude pool is made of your Claude API keys.
+        </div>
+      </div>
+      <label className="np-field">
+        <span className="np-field-l">Name</span>
+        <Input value="Team Codex" />
+      </label>
+      <div className="np-field" data-mk="new-who">
+        <span className="np-field-l">Who can use it</span>
+        <Radio.Group value="shared">
+          <Radio value="me">Just me</Radio>
+          <Radio value="shared">Me and people I add</Radio>
+        </Radio.Group>
+        <Select
+          mode="multiple"
+          style={{ width: '100%', marginTop: 10 }}
+          value={['Zhang Min', 'Chen Yu', 'Lin Wei']}
+          options={people}
+          optionLabelProp="label"
+        />
+        <div className="np-field-h">
+          They see it on their Providers page and in the session picker, and can start sessions on it.
+        </div>
+        <Checkbox checked style={{ marginTop: 8 }}>
+          They can add their own accounts
+        </Checkbox>
+      </div>
+    </Modal>
+  );
+}
