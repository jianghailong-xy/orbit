# No trailing slash: also ignore a symlink named node_modules (a worktree may
# symlink it to the main checkout). With a slash, git tracks such symlinks and a
# later checkout clobbers the real deps with a self-referential link.
node_modules
dist/
dist-bin/
build/
# Several apiserver test tsconfigs emit BESIDE `build/` rather than into it, because their specs
# spawn children that require a tree compiled from a DIFFERENT include set (see the
# tsconfig.project-*.json files). `build/` does not match any of those names, so running the
# documented auxiliary build commands used to leave a few hundred untracked .js/.map files in the
# worktree — and one `git add -A` then committed two of those trees, 200 generated files, into a
# branch. Every `build-project-*` output directory is listed here for that reason: the ignore list
# is what keeps a documented build step from becoming a diff.
build-project-reconcile-faults/
build-project-event-faults/
build-project-blocker/
build-project-decision/
coverage/
tmp/
*.log
*.tsbuildinfo

# env
.env
.env.local
.env.*.local

# runner local state
.orbit/

# claude worktrees
.claude/worktrees/

# prisma local db
*.db

# postgres bind-mount data
/data/

# os
.DS_Store
Thumbs.db

# go build artifact (a bare `go build` in src/runner-go; real builds -> dist-bin/)
/src/runner-go/orbit

# swift / swiftpm build output (macOS client under src/macos/*) — generated, not source
.build/
.swiftpm/
DerivedData/

# session upload artifacts the app drops into the worktree (inputs, not source)
/orbit-uploads/

.rebase-pc/
