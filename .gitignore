# No trailing slash: also ignore a symlink named node_modules (a worktree may
# symlink it to the main checkout). With a slash, git tracks such symlinks and a
# later checkout clobbers the real deps with a self-referential link.
node_modules
dist/
dist-bin/
build/
# Two apiserver test tsconfigs emit beside `build/` rather than into it, because their specs spawn
# children that require a tree compiled from a DIFFERENT include set (see
# tsconfig.project-reconcile-faults.json and tsconfig.project-event-faults.json). `build/` does not
# match either name, so running the documented fault-injection commands used to leave a few hundred
# untracked .js/.map files in the worktree.
build-project-reconcile-faults/
build-project-event-faults/
coverage/
tmp/
*.log
*.tsbuildinfo

# env
.env
.env.local
.env.*.local

# runner local state
.orbit/

# claude worktrees
.claude/worktrees/

# prisma local db
*.db

# postgres bind-mount data
/data/

# os
.DS_Store
Thumbs.db

# go build artifact (a bare `go build` in src/runner-go; real builds -> dist-bin/)
/src/runner-go/orbit

# swift / swiftpm build output (macOS client under src/macos/*) — generated, not source
.build/
.swiftpm/
DerivedData/

# session upload artifacts the app drops into the worktree (inputs, not source)
/orbit-uploads/

.rebase-pc/

# repo-local offline toolchains (Go for runner builds in sandboxed/offline environments)
/.tools/
