    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Deadlocks and conflicts / s",
      "datasource": {
        "type": "prometheus",
        "uid": "orbit-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "orbit-prometheus"
          },
          "expr": "sum(rate(pg_stat_database_deadlocks{datname=\"orbit\"}[5m]))",
          "legendFormat": "deadlocks",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "orbit-prometheus"
          },
          "expr": "sum(rate(pg_stat_database_conflicts{datname=\"orbit\"}[5m]))",
          "legendFormat": "recovery conflicts",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
