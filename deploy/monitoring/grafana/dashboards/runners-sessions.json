    {
      "id": 9,
      "type": "stat",
      "title": "Fleet gauges readable",
      "description": "0 when an apiserver could not read the four gauges from the database.",
      "datasource": {
        "type": "prometheus",
        "uid": "orbit-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "orbit-prometheus"
          },
          "expr": "min(orbit_fleet_gauges_up)",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
