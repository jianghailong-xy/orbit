{
  "uid": "orbit-runners",
  "title": "Orbit runners & sessions",
  "description": "Runners, sessions and tasks, read from the database by each apiserver and combined with max.",
  "tags": [
    "orbit"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/orbit-overview"
    },
    {
      "title": "Runners & sessions",
      "type": "link",
      "url": "/d/orbit-runners"
    },
    {
      "title": "Database",
      "type": "link",
      "url": "/d/orbit-database"
    },
    {
      "title": "Host",
      "type": "link",
      "url": "/d/orbit-host"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Online",
      "description": "Heard from in the last 90 seconds.",
      "datasource": {
        "type": "prometheus",
        "uid": "orbit-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "orbit-prometheus"
          },
          "expr": "max(orbit_runners{state=\"online\"})",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
