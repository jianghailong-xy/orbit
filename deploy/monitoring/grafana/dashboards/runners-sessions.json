    {
      "id": 4,
      "type": "stat",
      "title": "Oldest heartbeat",
      "description": "Near 30 s when healthy; past 90 s a runner counts as silent.",
      "datasource": {
        "type": "prometheus",
        "uid": "orbit-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "orbit-prometheus"
          },
          "expr": "max(orbit_runner_oldest_heartbeat_age_seconds)",
