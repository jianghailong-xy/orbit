# The link gateway's settings where it sits behind this deployment's own web gateway (RUNNER_LINK_URL=same-origin;
# docs/self-hosting.md, "Runner link"). docker-compose.yml reads this file where .env names it in RUNNER_LINK_ENV_FILE.

# Its port is reached over this project's network only, from the web gateway, which carries the deployment's own TLS
# where it has one (gateway/nginx.conf, location /runner-link).
LINK_TLS_MODE=off

# Every runner reaches it from one address, the web gateway's, so its limit on new connections per address is a limit on
# them all: as high as its limit across all clients (LINK_HANDSHAKE_RATE, LINK_HANDSHAKE_BURST), which stays.
LINK_IP_RATE=200
LINK_IP_BURST=400
