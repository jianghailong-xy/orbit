+package rbd
+
+import (
+	"reflect"
+	"testing"
+)
+
+func TestXfsReflinkArgs(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name            string
+		reflink         string
+		supportsReflink bool
+		want            []string
+		wantErr         bool
+	}{
+		{"default with support", "", true, []string{"-m", "reflink=0"}, false},
+		{"default without support", "", false, nil, false},
+		{"disabled with support", xfsReflinkDisabled, true, []string{"-m", "reflink=0"}, false},
+		{"disabled without support", xfsReflinkDisabled, false, nil, false},
+		{"enabled", xfsReflinkEnabled, false, []string{"-m", "reflink=1"}, false},
+		{"auto", xfsReflinkAuto, true, nil, false},
+		{"invalid", "yes", true, nil, true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Parallel()
+
+			got, err := xfsReflinkArgs(tt.reflink, tt.supportsReflink)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("xfsReflinkArgs(%q, %v) error = %v, wantErr %v",
+					tt.reflink, tt.supportsReflink, err, tt.wantErr)
+			}
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("xfsReflinkArgs(%q, %v) = %v, want %v",
+					tt.reflink, tt.supportsReflink, got, tt.want)
+			}
+		})
+	}
+}
