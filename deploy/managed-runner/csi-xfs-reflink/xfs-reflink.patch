+// Values of the StorageClass "reflink" parameter for XFS volumes.
+const (
+	xfsReflinkAuto     = "auto"
+	xfsReflinkEnabled  = "enabled"
+	xfsReflinkDisabled = "disabled"
+)
+
+// xfsReflinkArgs returns the mkfs.xfs arguments that the StorageClass "reflink"
+// parameter asks for. The empty value and "disabled" keep the upstream behavior,
+// reflink=0, when mkfs.xfs accepts the argument. "enabled" forces reflink=1; the
+// node's kernel must support mounting reflink filesystems. "auto" passes nothing
+// and leaves the mkfs.xfs default (reflink=1 since xfsprogs 5.1).
+func xfsReflinkArgs(reflink string, supportsReflink bool) ([]string, error) {
+	switch reflink {
+	case "", xfsReflinkDisabled:
+		if supportsReflink {
+			return []string{"-m", "reflink=0"}, nil
+		}
+
+		return nil, nil
+	case xfsReflinkEnabled:
+		return []string{"-m", "reflink=1"}, nil
+	case xfsReflinkAuto:
+		return nil, nil
+	default:
+		return nil, fmt.Errorf("invalid reflink value %q: use %q, %q or %q",
+			reflink, xfsReflinkEnabled, xfsReflinkDisabled, xfsReflinkAuto)
+	}
+}
