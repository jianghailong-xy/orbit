# Optional TEST template only: the Pod the managed runner manager creates for one generation of one
# user's runner. src/apiserver/src/managed-runners/managed-runner-resources.ts builds exactly this,
# and its spec compares the two. Replace every __...__ value from an authorized environment record.
# Never apply it by hand in place of the manager: the single-Pod admission guard
# (admission/pod-admission-webhook.template.json) refuses it unless the manager reserved its
# generation, and must be installed before any managed PVC is usable.
# Uses an EXISTING per-user PVC; installs no Ceph/CSI/StorageClass or server infrastructure.
apiVersion: v1
kind: Pod
metadata:
  name: __FIXED_USER_POD_NAME__
  namespace: __AUTHORIZED_TEST_NAMESPACE__
  labels:
    app.kubernetes.io/name: orbit-managed-runner
    orbit-test-environment: __TEST_ENVIRONMENT_ID__
  annotations:
    orbit.dev/owner-id: __OWNER_UUID__
    orbit.dev/runner-id: __RUNNER_UUID__
    # The generation the manager reserved for this Pod; the runner reads it back below.
    orbit.dev/generation: "__RESERVED_GENERATION__"
    orbit.dev/pvc-uid: __DATA_PVC_UID__
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  enableServiceLinks: false
  hostNetwork: false
  hostPID: false
  hostIPC: false
  terminationGracePeriodSeconds: 240
  securityContext:
    seccompProfile:
      type: RuntimeDefault
  initContainers:
    - name: private-volume-directories
      image: __RUNNER_IMAGE_AT_SHA256_DIGEST__
      args: [init-volume]
      securityContext:
        runAsUser: 0
        runAsGroup: 0
        runAsNonRoot: false
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop: [ALL]
          add: [CHOWN, FOWNER, DAC_OVERRIDE]
      resources:
        requests:
          cpu: __INIT_CPU_REQUEST__
          memory: __INIT_MEMORY_REQUEST__
        limits:
          cpu: __INIT_CPU_LIMIT__
          memory: __INIT_MEMORY_LIMIT__
      volumeMounts:
        - name: user-state
          mountPath: /var/lib/orbit
        - name: temporary
          mountPath: /tmp
  containers:
    - name: runner
      image: __RUNNER_IMAGE_AT_SHA256_DIGEST__
      args: [run]
      securityContext:
        runAsUser: 10001
        runAsGroup: 10001
        runAsNonRoot: true
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop: [ALL]
      env:
        - name: ORBIT_RUNNER_SERVER_URL
          value: __AUTHORIZED_TEST_ORBIT_HTTPS_URL__
        - name: ORBIT_RUNNER_NAME
          value: __STABLE_USER_RUNNER_NAME__
        - name: ORBIT_RUNNER_MAX_CONCURRENT
          value: "__AUTHORIZED_SESSION_CONCURRENCY__"
        # The runner row the manager created. The entrypoint refuses a volume or config of another.
        - name: ORBIT_RUNNER_EXPECTED_ID
          value: __RUNNER_UUID__
        # This generation's credential, issued by the manager; never an enrollment token.
        - name: ORBIT_RUNNER_CREDENTIAL_FILE
          value: /run/orbit-bootstrap/token
        # Which instance this is, as the API server recorded it. The entrypoint checks the generation
        # against the bootstrap Secret's, and `orbit run` sends both with every request; the control
        # plane accepts the credential from this generation and Pod UID only.
        - name: ORBIT_MANAGED_RUNNER_GENERATION
          valueFrom:
            fieldRef:
              fieldPath: "metadata.annotations['orbit.dev/generation']"
        - name: ORBIT_MANAGED_RUNNER_POD_UID
          valueFrom:
            fieldRef:
              fieldPath: metadata.uid
        # Supply an explicitly authorized test model credential separately; this template
        # deliberately contains no model key, kubeconfig, Ceph key, or account-home mount.
      resources:
        requests:
          cpu: __RUNNER_CPU_REQUEST__
          memory: __RUNNER_MEMORY_REQUEST__
        limits:
          cpu: __RUNNER_CPU_LIMIT__
          memory: __RUNNER_MEMORY_LIMIT__
      volumeMounts:
        - name: user-state
          mountPath: /var/lib/orbit
        - name: temporary
          mountPath: /tmp
        - name: bootstrap
          mountPath: /run/orbit-bootstrap
          readOnly: true
  volumes:
    - name: user-state
      persistentVolumeClaim:
        claimName: __EXISTING_PER_USER_TEST_PVC__
    - name: temporary
      emptyDir:
        sizeLimit: __AUTHORIZED_TMP_SIZE__
    - name: bootstrap
      secret:
        # mr-boot-<runner uuid>: replaced by the manager when the generation advances.
        secretName: __BOOTSTRAP_SECRET__
        # Only this bootstrap Secret is readable by the runner. Do not use fsGroup:
        # recursive group-mode expansion can invalidate private ORBIT_HOME permissions.
        defaultMode: 0444
        items:
          - key: token
            path: token
          - key: generation
            path: generation
