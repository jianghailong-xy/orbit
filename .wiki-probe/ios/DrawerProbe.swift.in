/// The drawer as it stands open: the header, the rail's work rows, and the rows under the rule.
struct DrawerRail: View {
    let model: ProbeDrawerModel
    var close: () -> Void = {}
    var live = true

    var body: some View {
        VStack(alignment: .leading, spacing: 0) {
            HStack {
                Text("Orbit").font(.title2.weight(.bold))
                Spacer()
                DrawerCircleGlyph(systemName: "magnifyingglass")
            }
            .padding(.leading, DrawerMetrics.textLeading)
            .padding(.trailing, DrawerMetrics.hInset)
            .padding(.top, 14)
            .padding(.bottom, 8)
            List {
                // ---- cut from CompactShell.swift: the rail's work rows ----
                {RAIL}
                // ---- end of cut ----
                workspacesHeader
                ForEach(ProbeDrawerModel.workspaces, id: \.name) { workspace in
                    standInRow(workspace.name, detail: workspace.runner, badge: workspace.badge)
                }
                drawerGroupLabel(AppSection.projects.title, count: 26)
                ForEach(ProbeDrawerModel.projects, id: \.self) { title in
                    standInRow(title, detail: nil, badge: title.hasPrefix("把") || title.hasPrefix("Postgres") ? 1 : 0)
                }
            }
            .listStyle(.plain)
            .scrollContentBackground(.hidden)
            .environment(\.defaultMinListRowHeight, 0)
            .overlay(alignment: .bottom) {
                HStack(spacing: 12) {
                    HStack(spacing: 8) {
                        Image(systemName: "square.and.pencil")
                        Text("New session")
                    }
                    .font(.orbitControl.weight(.semibold))
                    .foregroundStyle(.white)
                    .padding(.horizontal, 18)
                    .padding(.vertical, 11)
                    .background(Color.accentColor, in: Capsule())
                    Spacer(minLength: 8)
                    DrawerCircleGlyph(systemName: AppSection.settings.systemImage, raised: true)
                }
                .padding(.horizontal, DrawerMetrics.hInset)
                .padding(.bottom, 8)
            }
        }
        .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .topLeading)
        .background(drawerSurface)
    }

    /// A workspace or project row under the rule — stand-ins in the rows' own grammar.
    private func standInRow(_ title: String, detail: String?, badge: Int) -> some View {
        pill(selected: false) {
            HStack(spacing: 12) {
                if detail != nil {
                    Image(systemName: "folder").frame(width: 24)
                }
                Text(title).lineLimit(1)
                if let detail { Text("· \(detail)").foregroundStyle(.secondary).lineLimit(1) }
                Spacer(minLength: 6)
                if badge > 0 {
                    Text("\(badge)")
                        .font(.orbitMeta.weight(.semibold))
                        .foregroundStyle(.orange)
                        .padding(.horizontal, 6).padding(.vertical, 1)
                        .background(Color.orange.opacity(0.15), in: Capsule())
                }
            }
        }
        .drawerRow()
    }

    // ---- cut from CompactShell.swift: the rows ----
{ROWS}
