{
  "name": "orbit.project-task-refusals",
  "recoveryContractVersion": 1,
  "doc": "docs/recovery-contract.md#9-project-and-task-refusals",
  "note": "The recovery block the API states for each Project and Task refusal listed here, beside the legacy flat fields it keeps. Transcribed from src/apiserver/src/common/refusal-recovery.ts, which serves it; refusal-recovery.spec.ts holds the two equal. requiredAction narrows an entry to one legacy token. resources are [type, body field path], read in order; only ids the body already carries are named.",
  "refusals": [
    {
      "code": "STALE_CONFIG_REVISION",
      "status": 409,
      "endpoints": [
        "PATCH /projects/:id",
        "PATCH /runner/projects/:id"
      ],
      "when": "The write stated expectedConfigRevision and the project has moved past it.",
      "recovery": {
        "effect": "NONE",
        "userConfirmation": "NOT_REQUIRED",
        "retryPolicy": "NEVER",
        "actionCode": "REREAD_AND_DECIDE",
        "actor": "CALLER",
        "disposition": "AUTOMATIC"
      },
      "resources": [
        [
          "PROJECT",
          "projectId"
        ]
      ]
    },
    {
      "code": "PROJECT_SCOPE_MISMATCH",
      "requiredAction": "RE_DERIVE_SCOPE",
      "status": 403,
      "endpoints": [
        "POST /runner/tasks",
        "PATCH /runner/tasks/:id",
        "POST /runner/tasks/batch-create"
      ],
      "when": "The scope token the write carried does not agree with the server (R2).",
      "recovery": {
        "effect": "NONE",
        "userConfirmation": "NOT_REQUIRED",
        "retryPolicy": "NEVER",
        "actionCode": "REREAD_AND_DECIDE",
        "actor": "CALLER",
        "disposition": "AUTOMATIC"
      },
      "resources": [
        [
          "PROJECT",
          "scope.projectId"
        ],
        [
          "PROJECT",
          "target.projectId"
        ],
        [
          "TASK",
          "taskId"
        ]
      ]
    },
    {
      "code": "PROJECT_SCOPE_MISMATCH",
      "requiredAction": "YIELD_TO_CURRENT_SCOPE",
      "status": 403,
      "endpoints": [
        "POST /runner/tasks",
        "PATCH /runner/tasks/:id",
        "POST /runner/tasks/batch-create"
      ],
      "when": "This session holds no scope for the project the write is about (R5, or a declaring session that is not this account's).",
      "recovery": {
        "effect": "NONE",
        "userConfirmation": "NOT_REQUIRED",
        "retryPolicy": "NEVER",
        "actionCode": "STAND_DOWN",
        "actor": "CALLER",
        "disposition": "STOP"
      },
      "resources": [
        [
          "PROJECT",
          "scope.projectId"
        ],
        [
          "PROJECT",
          "target.projectId"
        ],
        [
          "TASK",
          "taskId"
        ]
      ]
    },
    {
      "code": "PROJECT_SCOPE_MISMATCH",
      "requiredAction": "FILE_IN_OWN_PROJECT_OR_REQUEST_HANDOFF",
      "status": 403,
      "endpoints": [
        "POST /runner/tasks",
        "PATCH /runner/tasks/:id",
        "POST /runner/tasks/batch-create"
      ],
      "when": "The write aims at a project this session does not coordinate and declares no crossing (R6, R7).",
      "recovery": {
        "effect": "NONE",
        "userConfirmation": "NOT_REQUIRED",
        "retryPolicy": "NEVER",
        "actionCode": "FILE_IN_OWN_PROJECT_OR_REQUEST_HANDOFF",
        "actor": "CALLER",
        "disposition": "AUTOMATIC"
      },
      "resources": [
        [
          "PROJECT",
          "scope.projectId"
        ],
        [
          "PROJECT",
          "target.projectId"
        ],
        [
          "TASK",
          "taskId"
        ]
      ]
    },
    {
      "code": "COORDINATOR_GENERATION_MOVED",
      "status": 409,
      "endpoints": [
        "POST /runner/tasks",
        "PATCH /runner/tasks/:id",
        "POST /runner/tasks/batch-create"
      ],
      "when": "The coordination scope was handed to a newer coordinator after this write was composed (R3).",
      "recovery": {
        "effect": "NONE",
        "userConfirmation": "NOT_REQUIRED",
        "retryPolicy": "NEVER",
        "actionCode": "STAND_DOWN",
        "actor": "SYSTEM",
        "disposition": "STOP"
      },
      "resources": [
        [
          "PROJECT",
          "scope.projectId"
        ],
        [
          "PROJECT",
          "target.projectId"
        ],
        [
          "TASK",
          "taskId"
        ]
      ]
    },
    {
      "code": "UNMAPPED_PROJECT_WORK",
      "status": 403,
      "endpoints": [
        "POST /runner/tasks",
        "PATCH /runner/tasks/:id",
        "POST /runner/tasks/batch-create"
      ],
      "when": "The write files work under no project, and a coordinator may not pick one (R4).",
      "recovery": {
        "effect": "NONE",
        "userConfirmation": "NOT_REQUIRED",
        "retryPolicy": "AFTER_STATE_CHANGE",
        "actionCode": null,
        "actor": "USER",
        "disposition": "HUMAN"
      },
      "resources": [
        [
          "PROJECT",
          "scope.projectId"
        ],
        [
          "PROJECT",
          "target.projectId"
        ],
        [
          "TASK",
          "taskId"
        ]
      ]
    },
    {
      "code": "PROJECT_REOPEN_REQUIRED",
      "status": 403,
      "endpoints": [
        "POST /runner/tasks",
        "PATCH /runner/tasks/:id",
        "POST /runner/tasks/batch-create",
        "POST /projects/:id/handoffs/:handoffId/decision"
      ],
      "when": "A settled (DONE or CANCELLED) project stands at an end of the write (R8).",
      "recovery": {
        "effect": "NONE",
        "userConfirmation": "NOT_REQUIRED",
        "retryPolicy": "AFTER_STATE_CHANGE",
        "actionCode": "AWAIT_OWNER_DECISION",
        "actor": "USER",
        "disposition": "HUMAN"
      },
      "resources": [
        [
          "PROJECT",
          "target.projectId"
        ],
        [
          "PROJECT",
          "projectId"
        ],
        [
          "PROJECT",
          "scope.projectId"
        ],
        [
          "TASK",
          "taskId"
        ]
      ],
      "nextTool": "project_request_reopen"
    },
    {
      "code": "MOVE_TASK_SERVES_SETTLED_CRITERION",
      "status": 403,
      "endpoints": [
        "POST /runner/tasks",
        "PATCH /runner/tasks/:id",
        "POST /runner/tasks/batch-create",
        "POST /projects/:id/handoffs/:handoffId/decision"
