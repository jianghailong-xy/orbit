      "resources": [
        [
          "CROSSING",
          "handoffId"
        ],
        [
          "TASK",
          "taskId"
        ],
        [
          "PROJECT",
          "target.projectId"
        ]
      ]
    },
    {
      "code": "APPROVAL_PENDING",
