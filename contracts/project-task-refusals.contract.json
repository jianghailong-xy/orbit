        "actionCode": "FIX_REQUEST",
        "actor": "CALLER",
        "disposition": "AUTOMATIC"
      },
      "resources": [
        [
          "CROSSING",
          "handoffId"
        ],
        [
          "TASK",
          "taskId"
        ],
        [
          "PROJECT",
          "target.projectId"
        ]
      ]
    },
    {
      "code": "PROJECT_NOT_EMPTY",
      "status": 409,
      "endpoints": [
        "DELETE /projects/:id",
