{
  "name": "orbit.recovery.fixtures",
  "contractVersion": 1,
  "cases": [
    {
      "name": "refusal: legacy coded body names its action as a token",
      "input": {
        "source": "HTTP",
        "status": 409,
        "body": "{\"statusCode\":409,\"error\":\"Conflict\",\"code\":\"PROJECT_SCOPE_MISMATCH\",\"message\":\"this write names project P2, and this session belongs to P1\",\"owner\":\"COORDINATOR\",\"requiredAction\":\"FILE_IN_OWN_PROJECT_OR_REQUEST_HANDOFF\",\"projectId\":\"P2\"}"
      },
      "expect": {
        "contractVersion": 1,
        "code": "PROJECT_SCOPE_MISMATCH",
        "message": "this write names project P2, and this session belongs to P1",
        "kind": "REFUSAL",
        "status": 409,
        "effect": "NONE",
        "retry": {
          "policy": "AFTER_STATE_CHANGE",
          "afterSeconds": null
        },
        "actor": "COORDINATOR",
        "owner": "COORDINATOR",
        "actionCode": "FILE_IN_OWN_PROJECT_OR_REQUEST_HANDOFF",
        "requiredAction": "FILE_IN_OWN_PROJECT_OR_REQUEST_HANDOFF",
        "userConfirmation": "NOT_REQUIRED",
        "resources": [
          {
            "type": "PROJECT",
            "id": "P2"
          }
        ]
      },
      "legacyText": "  refused: PROJECT_SCOPE_MISMATCH\n  what:    this write names project P2, and this session belongs to P1\n  owner:   COORDINATOR\n  do:      FILE_IN_OWN_PROJECT_OR_REQUEST_HANDOFF\n"
    },
    {
      "name": "refusal: request in progress is retried under the same request id",
      "input": {
        "source": "HTTP",
        "status": 409,
        "body": "{\"statusCode\":409,\"error\":\"Conflict\",\"code\":\"TASK_RUN_REQUEST_IN_PROGRESS\",\"message\":\"this run request is being answered right now\",\"owner\":\"USER\",\"requiredAction\":\"retry the same request in a moment\",\"triggerId\":\"trg_1\"}"
      },
      "expect": {
        "contractVersion": 1,
        "code": "TASK_RUN_REQUEST_IN_PROGRESS",
        "message": "this run request is being answered right now",
        "kind": "REFUSAL",
        "status": 409,
        "effect": "NONE",
        "retry": {
          "policy": "SAME_REQUEST_ID",
          "afterSeconds": null
        },
        "actor": "USER",
        "owner": "USER",
        "actionCode": "RETRY_SAME_REQUEST",
        "requiredAction": "retry the same request in a moment",
        "userConfirmation": "NOT_REQUIRED",
        "resources": [
          {
            "type": "REQUEST",
            "id": "trg_1"
          }
        ]
      },
      "legacyText": "  refused: TASK_RUN_REQUEST_IN_PROGRESS\n  what:    this run request is being answered right now\n  owner:   USER\n  do:      retry the same request in a moment\n"
    },
    {
      "name": "refusal: prose that says retry does not make a mismatch retryable",
      "input": {
        "source": "HTTP",
        "status": 409,
        "body": "{\"code\":\"TASK_RUN_REQUEST_MISMATCH\",\"message\":\"retry the same request, it will work\",\"requiredAction\":\"just retry the same request\",\"triggerId\":\"trg_2\"}"
      },
      "expect": {
        "contractVersion": 1,
        "code": "TASK_RUN_REQUEST_MISMATCH",
        "message": "retry the same request, it will work",
        "kind": "REFUSAL",
        "status": 409,
        "effect": "NONE",
        "retry": {
          "policy": "NEVER",
          "afterSeconds": null
        },
        "actor": "CALLER",
        "owner": null,
        "actionCode": "USE_NEW_REQUEST_ID",
        "requiredAction": "just retry the same request",
        "userConfirmation": "NOT_REQUIRED",
        "resources": [
          {
            "type": "REQUEST",
            "id": "trg_2"
          }
        ]
      },
      "legacyText": "  refused: TASK_RUN_REQUEST_MISMATCH\n  what:    retry the same request, it will work\n  do:      just retry the same request\n"
    },
    {
      "name": "refusal: a stated recovery block wins over inference, inside the invariants (COMMITTED is never resent)",
      "input": {
        "source": "HTTP",
        "status": 409,
        "body": "{\"code\":\"PROJECT_CREATED_COORDINATOR_FAILED\",\"message\":\"the project exists; its coordinator session did not start\",\"owner\":\"USER\",\"projectId\":\"P9\",\"recovery\":{\"effect\":\"COMMITTED\",\"retryPolicy\":\"VERIFY_THEN_RETRY\",\"actionCode\":\"VERIFY_STATE\",\"actor\":\"CALLER\",\"userConfirmation\":\"NOT_REQUIRED\",\"retryAfterSeconds\":5,\"resources\":[{\"type\":\"PROJECT\",\"id\":\"P9\"},{\"type\":\"SESSION\",\"id\":\"S3\"}]}}"
      },
      "expect": {
        "contractVersion": 1,
        "code": "PROJECT_CREATED_COORDINATOR_FAILED",
        "message": "the project exists; its coordinator session did not start",
        "kind": "REFUSAL",
        "status": 409,
        "effect": "COMMITTED",
        "retry": {
          "policy": "NEVER",
          "afterSeconds": null
        },
        "actor": "CALLER",
        "owner": "USER",
        "actionCode": "VERIFY_STATE",
        "requiredAction": null,
        "userConfirmation": "NOT_REQUIRED",
        "resources": [
          {
            "type": "PROJECT",
            "id": "P9"
          },
          {
            "type": "SESSION",
            "id": "S3"
          }
        ]
      },
      "legacyText": "  refused: PROJECT_CREATED_COORDINATOR_FAILED\n  what:    the project exists; its coordinator session did not start\n  owner:   USER\n"
    },
