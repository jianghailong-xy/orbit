      "REQUEST_NEW_AUTHORIZATION",
      "REQUEST_EXTERNAL_IDENTITY"
    ],
    "resolverProfiles": [
      {
        "id": "STANDARD_MANDATORY",
        "startState": "ACTIVE",
        "resolvers": [
          {
            "id": "FACT_RESOLVES",
            "from": "ACTIVE",
            "exit": "RESOLVE",
            "to": "RESOLVED",
            "actor": "SYSTEM",
            "capability": "obligation.exit.resolve",
            "adapter": "OUTCOME_RECONCILER"
          },
          {
            "id": "DECISION_CANCELS",
            "from": "ACTIVE",
            "exit": "CANCEL",
            "to": "CANCELLED",
            "actor": "SYSTEM",
            "capability": "obligation.exit.cancel",
            "adapter": "OUTCOME_RECONCILER"
          },
          {
            "id": "REVISION_SUPERSEDES",
            "from": "ACTIVE",
            "exit": "SUPERSEDE",
            "to": "SUPERSEDED",
            "actor": "SYSTEM",
            "capability": "obligation.exit.supersede",
            "adapter": "OUTCOME_RECONCILER"
          },
          {
            "id": "POLICY_ESCALATES",
            "from": "ACTIVE",
            "exit": "ESCALATE",
            "to": "ESCALATED",
            "actor": "SYSTEM",
            "capability": "obligation.exit.escalate",
            "adapter": "OUTCOME_RECONCILER"
          },
          {
            "id": "DURABLE_TIMER_EXPIRES",
            "from": "ACTIVE",
            "exit": "TIMEOUT",
            "to": "TIMED_OUT",
            "actor": "SYSTEM",
            "capability": "obligation.exit.timeout",
            "adapter": "DURABLE_TIMER_SERVICE"
          }
        ]
      }
    ],
    "runtimeAdapters": [
      {
        "id": "OUTCOME_RECONCILER",
        "status": "REGISTERED",
        "actors": [
          "SYSTEM"
        ]
      },
      {
        "id": "DURABLE_TIMER_SERVICE",
        "status": "REGISTERED",
        "actors": [
          "SYSTEM"
        ]
      },
      {
        "id": "COORDINATOR_AGENT",
