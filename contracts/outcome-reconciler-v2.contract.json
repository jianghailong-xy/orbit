{
  "$schema": "./outcome-reconciler-v2.schema.json",
  "contractName": "orbit.outcome-reconciler",
  "contractVersion": "2.0.0",
  "evaluatorVersion": "outcome-reducer-v2",
  "canonicalization": {
    "algorithm": "RFC8785_JSON_SHA256",
    "digestEncoding": "LOWERCASE_HEX",
    "unorderedArrays": "SORT_BY_DECLARED_STABLE_KEY",
    "nullAndAbsentAreDistinct": true
  },
  "nonGoals": [
    "HARDENED_HUMAN_PRESENCE",
    "FULL_HISTORY_MIGRATION",
    "GENERAL_SAAS_SAGA"
  ],
  "stateAlgebra": {
    "states": [
      "SATISFIED",
      "UNSATISFIED",
      "UNKNOWN",
      "CONFLICT",
      "NOT_APPLICABLE"
    ],
    "closureEligibleStates": [
      "SATISFIED",
      "NOT_APPLICABLE"
    ],
    "precedence": [
      "NOT_APPLICABLE",
      "SATISFIED",
      "UNSATISFIED",
      "UNKNOWN",
      "CONFLICT"
    ],
    "definitions": {
      "SATISFIED": "Current, trusted proof establishes the dimension for the exact binding.",
      "UNSATISFIED": "Current, trusted proof establishes that the dimension is not met.",
      "UNKNOWN": "The model requires the dimension but lacks current, trusted evidence to decide it.",
      "CONFLICT": "Two current authoritative facts for the same binding cannot both be true.",
      "NOT_APPLICABLE": "A current applicability proof establishes that this declared dimension does not apply."
    },
    "combineTable": {
      "SATISFIED": {
        "SATISFIED": "SATISFIED",
        "UNSATISFIED": "UNSATISFIED",
        "UNKNOWN": "UNKNOWN",
        "CONFLICT": "CONFLICT",
        "NOT_APPLICABLE": "SATISFIED"
      },
      "UNSATISFIED": {
        "SATISFIED": "UNSATISFIED",
        "UNSATISFIED": "UNSATISFIED",
        "UNKNOWN": "UNKNOWN",
        "CONFLICT": "CONFLICT",
        "NOT_APPLICABLE": "UNSATISFIED"
      },
      "UNKNOWN": {
        "SATISFIED": "UNKNOWN",
        "UNSATISFIED": "UNKNOWN",
        "UNKNOWN": "UNKNOWN",
        "CONFLICT": "CONFLICT",
        "NOT_APPLICABLE": "UNKNOWN"
      },
      "CONFLICT": {
        "SATISFIED": "CONFLICT",
        "UNSATISFIED": "CONFLICT",
        "UNKNOWN": "CONFLICT",
        "CONFLICT": "CONFLICT",
        "NOT_APPLICABLE": "CONFLICT"
      },
      "NOT_APPLICABLE": {
        "SATISFIED": "SATISFIED",
        "UNSATISFIED": "UNSATISFIED",
        "UNKNOWN": "UNKNOWN",
        "CONFLICT": "CONFLICT",
        "NOT_APPLICABLE": "NOT_APPLICABLE"
      }
    },
    "notApplicableRequiresApplicabilityProof": true,
    "emptyDimensionSetResult": "MODEL_GAP"
  },
  "completionDimensions": [
    {
      "id": "GOAL_DISPOSITION",
      "mandatory": true,
      "notApplicableAllowed": false,
      "unsatisfiedObligationKind": "ESTABLISH_GOAL_DISPOSITION"
    },
    {
      "id": "CONTRACT_RATIFICATION",
      "mandatory": true,
      "notApplicableAllowed": false,
      "unsatisfiedObligationKind": "REQUEST_GOAL_DECISION"
    },
    {
      "id": "CRITERIA_EVALUATION",
      "mandatory": true,
      "notApplicableAllowed": false,
      "unsatisfiedObligationKind": "SATISFY_COMPLETION_DIMENSION"
    },
    {
      "id": "FACT_CUT_INTEGRITY",
      "mandatory": true,
      "notApplicableAllowed": false,
      "unsatisfiedObligationKind": "REPAIR_FACT_CUT"
    },
    {
      "id": "EVIDENCE_TRUST",
      "mandatory": true,
      "notApplicableAllowed": false,
      "unsatisfiedObligationKind": "REPAIR_FACT_CUT"
    },
    {
      "id": "BINDING_FRESHNESS",
      "mandatory": true,
      "notApplicableAllowed": false,
      "unsatisfiedObligationKind": "REFRESH_STALE_BINDING"
    },
    {
      "id": "AUTHORITY_VALIDITY",
      "mandatory": true,
      "notApplicableAllowed": false,
      "unsatisfiedObligationKind": "REQUEST_NEW_AUTHORIZATION"
    },
    {
      "id": "POLICY_COMPLIANCE",
      "mandatory": true,
      "notApplicableAllowed": false,
      "unsatisfiedObligationKind": "REQUEST_RISK_ACCEPTANCE"
    },
    {
      "id": "BUDGET_COMPLIANCE",
      "mandatory": true,
      "notApplicableAllowed": false,
      "unsatisfiedObligationKind": "REQUEST_RISK_ACCEPTANCE"
    },
    {
      "id": "ARTIFACT_INTEGRATION",
      "mandatory": true,
      "notApplicableAllowed": true,
      "unsatisfiedObligationKind": "PROVE_ARTIFACT_INTEGRATION"
    },
    {
      "id": "TARGET_PRESENCE",
      "mandatory": true,
      "notApplicableAllowed": true,
      "unsatisfiedObligationKind": "PROVE_TARGET_PRESENCE"
    },
    {
      "id": "POST_MERGE_VERIFICATION",
      "mandatory": true,
      "notApplicableAllowed": true,
      "unsatisfiedObligationKind": "RUN_BOUND_VERIFICATION"
    },
    {
      "id": "EXTERNAL_CLOSURE_DEPENDENCIES",
      "mandatory": true,
      "notApplicableAllowed": true,
      "unsatisfiedObligationKind": "MONITOR_EXTERNAL_WAIT"
    },
    {
      "id": "ACTION_REMEDIATION",
      "mandatory": true,
      "notApplicableAllowed": true,
      "unsatisfiedObligationKind": "REMEDIATE_SIDE_EFFECT"
    },
    {
      "id": "MODEL_COVERAGE",
      "mandatory": true,
      "notApplicableAllowed": false,
      "unsatisfiedObligationKind": "DIAGNOSE_MODEL_GAP"
    }
  ],
