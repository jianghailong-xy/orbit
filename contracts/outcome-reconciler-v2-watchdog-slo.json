{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "contract": "orbit.outcome-reconciler.watchdog-slo.v2",
  "collector": {
    "name": "outcome-watchdog",
    "deploymentBoundary": "INDEPENDENT_PROCESS",
    "pollIntervalSeconds": 15,
    "maximumDetectionDeltaSeconds": 30,
    "maximumDetectionDeltaLogicalTicks": 1,
    "maximumRowsPerProbe": 257,
    "checksumSubjectsPerProbe": 64,
    "progressUnitsPerProbe": 262144,
    "progressHistorySamples": 8,
    "collectorSha": {
      "source": "RUNTIME_REQUIRED",
      "format": "FULL_GIT_SHA"
    },
    "targetSha": {
      "source": "RUNTIME_REQUIRED",
      "format": "FULL_GIT_SHA"
    }
  },
  "operationalSlo": {
    "name": "bounded-obligation-progress",
    "objective": 0.999,
    "window": {
      "kind": "ROLLING",
      "seconds": 3600,
      "logicalTicks": 60
    },
    "numerator": "eligible active obligations with VALID_ATTEMPT, EXTERNAL_DELIVERY, EXTERNAL_WAIT, SUPERSEDE, ESCALATE, TERMINAL_DISPOSITION, or OWNER_DECISION_REQUEST before progress_deadline_logical_time",
    "denominator": "all non-terminal canonical coordinator obligation revisions whose progress deadline intersects the window, excluding only explicit OWNER_DECISION and EXTERNAL_WAIT intervals",
    "minSampleSize": 1000,
    "abortThreshold": {
      "ratioBelow": 0.995,
      "consecutiveWindows": 2
    },
    "collectorSha": "RUNTIME_REQUIRED",
    "targetSha": "RUNTIME_REQUIRED"
  },
  "metrics": {
    "evaluatedThroughWatermarkLag": {
      "window": { "kind": "ROLLING", "seconds": 300, "logicalTicks": 5 },
      "denominator": "canonical fact streams examined by the bounded recent-stream probe",
      "minSampleSize": 1,
      "threshold": { "maximumLogicalTicks": 0 },
      "abortThreshold": { "violations": 1 },
      "collectorSha": "RUNTIME_REQUIRED",
      "targetSha": "RUNTIME_REQUIRED"
    },
    "oldestActiveObligation": {
      "window": { "kind": "ROLLING", "seconds": 300, "logicalTicks": 5 },
      "denominator": "active coordinator obligations examined by the liveness-index probe",
      "minSampleSize": 1,
      "threshold": { "maximumLogicalTicksWithoutProgress": 5 },
      "abortThreshold": { "violations": 1 },
      "collectorSha": "RUNTIME_REQUIRED",
      "targetSha": "RUNTIME_REQUIRED"
    },
    "expiredLease": {
      "window": { "kind": "ROLLING", "seconds": 60, "logicalTicks": 1 },
      "denominator": "currently claimed coordinator obligations examined by the lease-expiry probe",
      "minSampleSize": 1,
      "threshold": { "expiredLeases": 0 },
      "abortThreshold": { "violations": 1 },
      "collectorSha": "RUNTIME_REQUIRED",
      "targetSha": "RUNTIME_REQUIRED"
    },
    "deadLetter": {
      "window": { "kind": "ROLLING", "seconds": 60, "logicalTicks": 1 },
      "denominator": "coordinator wake deliveries in terminal DEAD state examined by the due-wake probe",
      "minSampleSize": 1,
      "threshold": { "deadLetters": 0 },
      "abortThreshold": { "violations": 1 },
      "collectorSha": "RUNTIME_REQUIRED",
      "targetSha": "RUNTIME_REQUIRED"
    },
    "outboxBacklog": {
      "window": { "kind": "ROLLING", "seconds": 300, "logicalTicks": 5 },
      "denominator": "projection outbox events examined in outbox_id order",
      "minSampleSize": 1,
      "threshold": { "maximumOldestAgeSeconds": 60 },
      "abortThreshold": { "oldestAgeSeconds": 120 },
      "collectorSha": "RUNTIME_REQUIRED",
      "targetSha": "RUNTIME_REQUIRED"
    },
    "schedulerStarvation": {
      "window": { "kind": "ROLLING", "seconds": 300, "logicalTicks": 5 },
      "denominator": "READY or due SCHEDULED coordinator obligations examined by the liveness-index probe",
      "minSampleSize": 1,
      "threshold": { "maximumLogicalTicksReady": 5 },
      "abortThreshold": { "violations": 1 },
      "collectorSha": "RUNTIME_REQUIRED",
      "targetSha": "RUNTIME_REQUIRED"
    },
    "retryCost": {
      "window": { "kind": "ROLLING", "seconds": 300, "logicalTicks": 5 },
      "denominator": "most recent coordinator attempt results in the window examined by the bounded retry probe",
      "minSampleSize": 3,
      "threshold": { "maximumRetryRatio": 0.5, "maximumRetryCostUnits": 20 },
      "abortThreshold": { "retryRatio": 0.75, "retryCostUnits": 40 },
      "collectorSha": "RUNTIME_REQUIRED",
      "targetSha": "RUNTIME_REQUIRED"
    },
    "inboxAge": {
      "window": { "kind": "ROLLING", "seconds": 300, "logicalTicks": 5 },
      "denominator": "received but unprocessed watchdog inbox records examined by the inbox-age probe",
      "minSampleSize": 1,
      "threshold": { "maximumOldestAgeSeconds": 60 },
      "abortThreshold": { "oldestAgeSeconds": 120 },
      "collectorSha": "RUNTIME_REQUIRED",
      "targetSha": "RUNTIME_REQUIRED"
    },
    "checksumDrift": {
      "window": { "kind": "ROLLING", "seconds": 900, "logicalTicks": 15 },
      "denominator": "deterministically selected projection subjects whose rowset, proof, gate, and six surface checksums were recomputed",
      "minSampleSize": 1,
      "threshold": { "mismatches": 0 },
      "abortThreshold": { "violations": 1 },
      "collectorSha": "RUNTIME_REQUIRED",
      "targetSha": "RUNTIME_REQUIRED"
    },
    "goalProgress": {
      "window": { "kind": "ROLLING", "seconds": 3600, "logicalTicks": 60 },
      "denominator": "consecutive samples of this tenant's own settled-work vector, counted from the coordinator obligation, task and typed-acceptance settlement lanes; samples in which nothing was engaged are still counted and classified, never dropped",
      "minSampleSize": 2,
      "threshold": { "maximumConsecutiveFlatSamples": 2, "minimumFlatWindowSeconds": 900 },
      "abortThreshold": { "consecutiveFlatSamples": 2, "flatWindowSeconds": 900 },
      "collectorSha": "RUNTIME_REQUIRED",
      "targetSha": "RUNTIME_REQUIRED"
    },
    "alertConstancy": {
      "window": { "kind": "ROLLING", "seconds": 3600, "logicalTicks": 60 },
      "denominator": "consecutive samples of this tenant carrying an alert count, including the samples whose alert set never changed; a permanently lit alert is a fault of the alert lane, not background noise",
      "minSampleSize": 2,
      "threshold": { "minimumAlertCount": 1, "maximumConsecutiveIdenticalSamples": 2, "minimumConstantWindowSeconds": 900 },
      "abortThreshold": { "consecutiveIdenticalSamples": 2, "constantWindowSeconds": 900 },
      "collectorSha": "RUNTIME_REQUIRED",
      "targetSha": "RUNTIME_REQUIRED"
    },
    "completionAckStaleness": {
      "window": { "kind": "ROLLING", "seconds": 300, "logicalTicks": 5 },
      "denominator": "legacy v1 terminal shell events durably ingested while their exact conversation turn remains IN_FLIGHT",
      "minSampleSize": 1,
      "threshold": { "maximumDetectionSeconds": 30, "maximumActiveObligationsPerIdentity": 1 },
      "abortThreshold": { "missedDetections": 1, "duplicateActiveObligations": 1 },
      "collectorSha": "RUNTIME_REQUIRED",
      "targetSha": "RUNTIME_REQUIRED"
    }
  },
  "canary": {
    "cohort": {
      "population": "tasks with a canonical outcome binding created during the canary admission interval",
      "selection": "unsigned first 32 bits of sha256(task_id || ':' || target_sha) modulo 10000 is below rolloutBasisPoints",
      "rolloutBasisPoints": 1000,
      "exclusions": [
        "tasks without a current semantic binding",
        "tasks explicitly opted out before admission",
        "tasks whose target SHA changed before first observation"
      ]
    },
    "denominator": "all eligible tasks selected into the immutable target-SHA cohort, including tasks with missing observations as failures after the observation window",
    "minSampleSize": 1000,
    "observationWindow": { "kind": "FIXED", "seconds": 3600, "logicalTicks": 60 },
    "abortThreshold": {
      "reconcilerStaleMisreportedEmpty": 0,
      "securityBoundaryViolations": 0,
      "watchdogDetectionMissRatio": 0.001,
      "boundedProgressRatioBelow": 0.995,
      "queryP99Milliseconds": 250
    },
    "collectorSha": "RUNTIME_REQUIRED",
    "targetSha": "RUNTIME_REQUIRED",
    "metrics": {
      "watchdogDetection": {
        "window": { "kind": "FIXED", "seconds": 3600, "logicalTicks": 60 },
        "denominator": "injected or naturally witnessed canary faults with an independently observable ledger fact",
        "minSampleSize": 20,
        "abortThreshold": { "missRatio": 0.001 },
        "collectorSha": "RUNTIME_REQUIRED",
        "targetSha": "RUNTIME_REQUIRED"
      },
      "boundedProgress": {
        "window": { "kind": "FIXED", "seconds": 3600, "logicalTicks": 60 },
        "denominator": "selected canary obligations whose progress deadline intersects the observation window",
        "minSampleSize": 1000,
        "abortThreshold": { "ratioBelow": 0.995 },
        "collectorSha": "RUNTIME_REQUIRED",
        "targetSha": "RUNTIME_REQUIRED"
      },
      "securityBoundary": {
        "window": { "kind": "FIXED", "seconds": 3600, "logicalTicks": 60 },
        "denominator": "canary evidence and inbox writes attempted during the observation window",
        "minSampleSize": 1000,
        "abortThreshold": { "violations": 0 },
        "collectorSha": "RUNTIME_REQUIRED",
        "targetSha": "RUNTIME_REQUIRED"
      },
      "queryLatency": {
        "window": { "kind": "FIXED", "seconds": 3600, "logicalTicks": 60 },
        "denominator": "bounded watchdog queries issued for the selected cohort",
        "minSampleSize": 1000,
        "abortThreshold": { "p99Milliseconds": 250 },
        "collectorSha": "RUNTIME_REQUIRED",
        "targetSha": "RUNTIME_REQUIRED"
      }
    }
  },
  "progressIndependence": {
    "rationale": "The progress channel and the self-correction channel must be able to fail independently. They were previously the same detector, so one bug disabled both: the agent stopped changing strategy and nobody was told, for three days, while every liveness indicator stayed green.",
    "forbiddenSignalSources": [
      "task.convergence_counters",
      "task.progress_state",
      "task.last_progress_at",
      "task_convergence_decision",
      "project_convergence_decision",
      "outcome_action_failure_fingerprint",
      "outcome_coordinator_failure_fingerprint",
      "task_executable_attempt.failure_fingerprint"
    ],
    "permittedSignalSources": [
      "outcome_coordinator_obligation.status",
      "task.status",
      "task_executable_attempt.termination_kind",
      "task_executable_attempt.actual_exit_code",
      "session.status",
      "outcome_watchdog.sample"
    ]
  },
  "security": {
    "maximumPayloadBytes": 65536,
    "maximumRawCommandOutputBytes": 16384,
    "redactionReplacement": "[REDACTED]",
    "secretKeyPattern": "authorization|cookie|token|secret|password|private[_-]?key|api[_-]?key|credential",
    "tenantAuthorization": "authenticated tenant must equal the stored tenant and project must belong to that tenant",
    "rawCommandOutput": "redact before truncation; store only sanitized output, original byte count, truncation bit, and SHA-256 digest"
  },
  "capacity": {
    "taskScale": 111000,
    "queryRowLimit": 257,
    "checksumSampleLimit": 64,
    "maximumQueryP99Milliseconds": 250,
    "maximumStorageBytesPerTask": 8192,
    "maximumCompletionAckEvidenceBytes": 16384,
    "maximumCompletionAckActiveActions": 16,
    "requiredIndexes": [
      "outcome_fact_stream_watchdog_recent_idx",
      "outcome_coordinator_watchdog_lease_idx",
      "outcome_coordinator_watchdog_active_idx",
      "outcome_coordinator_liveness_idx",
      "outcome_coordinator_wake_due_idx",
      "outcome_coordinator_attempt_result_watchdog_idx",
      "outcome_projection_outbox_delivery_idx",
      "outcome_watchdog_inbox_pending_idx",
      "outcome_watchdog_sample_replay_idx"
    ],
    "runtimeSchemaIndexes": [
      "completion_ack_fact_turn_idx",
      "completion_ack_event_latest_idx",
      "completion_ack_delivery_plan_latest_idx",
      "completion_ack_delivery_receipt_coordination_idx",
      "completion_ack_delivery_one_revocation_idx",
      "completion_ack_delivery_progress_trace_idx",
      "completion_ack_delivery_progress_deadline_idx",
      "completion_ack_remediation_action_coordination_idx",
      "executable_runtime_expectation_slot_idx",
      "executable_runtime_expectation_event_latest_idx",
      "executable_runtime_heartbeat_expectation_idx",
      "executable_dead_man_expectation_latest_idx"
    ]
  }
}
