{
  "description": "Release-version syntax and ordering, shared by both implementations: src/runner-go (selfupdate.go, isNewer) and src/apiserver (runner-api/runner-release.ts, isRunnerReleaseVersion/compareRunnerReleaseVersions). Each test suite reads this file, so the runner and the control plane cannot drift apart on which release is newer.",
  "syntax": "one or more dot-separated numeric parts; optional '-prerelease' and '+build' metadata of dot-separated identifiers matching [0-9A-Za-z-]+",
  "valid": [
    "0.1.216",
    "0.1",
    "0.2",
    "0.1.257-beta.1",
    "0.1.257-beta",
    "0.1.257-beta.10",
    "0.1.257-alpha.1",
    "0.1.257+build.5",
    "0.1.257-beta.1+build.5"
  ],
  "invalid": [
    "",
    "v0.1.216",
    "previous",
    " 0.1.257",
    "0.1.257-",
    "0.1.257+",
    "0.1.257-beta..1",
    "0.1.257-beta_1",
    "0.1.257-beta.1.2.3-x?"
  ],
  "compare": [
    { "a": "0.1.10", "b": "0.1.9", "want": 1 },
    { "a": "0.1.9", "b": "0.1.10", "want": -1 },
    { "a": "0.2", "b": "0.1.99", "want": 1 },
    { "a": "0.1", "b": "0.1.0", "want": 0 },
    { "a": "0.1.257-beta.1", "b": "0.1.256", "want": 1 },
    { "a": "0.1.256", "b": "0.1.257-beta.1", "want": -1 },
    { "a": "0.1.257-beta.2", "b": "0.1.257-beta.1", "want": 1 },
    { "a": "0.1.257-beta.10", "b": "0.1.257-beta.9", "want": 1 },
    { "a": "0.1.257", "b": "0.1.257-beta.2", "want": 1 },
    { "a": "0.1.257-beta.2", "b": "0.1.257", "want": -1 },
    { "a": "0.1.257-beta.1", "b": "0.1.257-beta.1", "want": 0 },
    { "a": "0.1.257-alpha.1", "b": "0.1.257-beta.1", "want": -1 },
    { "a": "0.1.257-beta", "b": "0.1.257-beta.1", "want": -1 },
    { "a": "0.1.257-beta.1", "b": "0.1.257-beta", "want": 1 },
    { "a": "0.1.257-1", "b": "0.1.257-beta", "want": -1 },
    { "a": "0.1.257+build.5", "b": "0.1.257", "want": 0 },
    { "a": "1.0.0", "b": "0.99.99", "want": 1 }
  ]
}
