  adoptionId            String   @id @map("adoption_id") @db.Uuid
  deliveryReceiptId     String   @map("delivery_receipt_id") @db.Uuid
  planId                String   @map("plan_id") @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  projectId             String   @map("project_id") @db.Uuid
  coordinationId        String   @map("coordination_id") @db.Uuid
  obligationRevision    String   @map("obligation_revision") @db.Char(64)
  leaseId               String   @unique @map("lease_id") @db.Uuid
  leaseGeneration       BigInt   @map("lease_generation")
  workerId              String   @map("worker_id")
  adopted               Boolean
  recordedLogicalTime   BigInt   @map("recorded_logical_time")
  adoptionDigest        String   @unique @map("adoption_digest") @db.Char(64)
  recordedAt            DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@unique([deliveryReceiptId, leaseId])
  @@map("completion_ack_coordinator_delivery_adoption")
}

/// Bounded, append-only remediation evidence. Session and task ids are deletion-stable snapshots.
model CompletionAckRemediationAction {
  actionId                String   @id @map("action_id") @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  projectId               String   @map("project_id") @db.Uuid
  coordinationId          String   @map("coordination_id") @db.Uuid
  obligationId            String   @map("obligation_id") @db.Char(64)
  obligationRevision      String   @map("obligation_revision") @db.Char(64)
  planId                  String   @map("plan_id") @db.Uuid
  deliveryReceiptId       String   @map("delivery_receipt_id") @db.Uuid
  sourceSessionIdSnapshot String   @map("source_session_id_snapshot") @db.Uuid
  actionKind              String   @map("action_kind")
  actionKey               String   @map("action_key")
  taskIdSnapshot          String   @map("task_id_snapshot") @db.Uuid
  taskProjectIdSnapshot   String?  @map("task_project_id_snapshot") @db.Uuid
  evidence                Json
  evidenceDigest          String   @map("evidence_digest") @db.Char(64)
  actionDigest            String   @unique @map("action_digest") @db.Char(64)
  recordedAt              DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@unique([obligationRevision, sourceSessionIdSnapshot, taskIdSnapshot, actionKind, actionKey])
  @@index([tenantId, coordinationId, recordedAt(sort: Desc), actionId(sort: Desc)], map: "completion_ack_remediation_action_coordination_idx")
  @@map("completion_ack_remediation_action")
}

/// Append-only progress or revocation fact for one exact coordinator delivery receipt. Repeated
/// watchdog polls of the same durable fingerprint do not create a row or move its fixed deadline.
model CompletionAckDeliveryProgressEvent {
  eventId                String   @id @map("event_id") @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  projectId              String   @map("project_id") @db.Uuid
  coordinationId         String   @map("coordination_id") @db.Uuid
  obligationId           String   @map("obligation_id") @db.Char(64)
  obligationRevision     String   @map("obligation_revision") @db.Char(64)
  deliveryReceiptId      String   @map("delivery_receipt_id") @db.Uuid
  planId                 String   @map("plan_id") @db.Uuid
  coordinatorSessionId   String   @map("coordinator_session_id") @db.Uuid
  eventKind              String   @map("event_kind")
  progressFingerprint    String   @map("progress_fingerprint") @db.Char(64)
  reasonCode             String?  @map("reason_code")
  sourceProgressAt       DateTime @map("source_progress_at") @db.Timestamptz(6)
  deadlineAt             DateTime @map("deadline_at") @db.Timestamptz(6)
  detectionDeltaSeconds  Int      @map("detection_delta_seconds")
  sourceObservedAt       DateTime @map("source_observed_at") @db.Timestamptz(6)
  evidence               Json
  evidenceDigest         String   @map("evidence_digest") @db.Char(64)
  eventDigest            String   @unique @map("event_digest") @db.Char(64)
  recordedAt             DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@unique([deliveryReceiptId, eventKind, progressFingerprint])
  @@index([tenantId, coordinationId, recordedAt(sort: Desc), eventId(sort: Desc)], map: "completion_ack_delivery_progress_trace_idx")
  @@index([eventKind, deadlineAt, deliveryReceiptId], map: "completion_ack_delivery_progress_deadline_idx")
  @@map("completion_ack_delivery_progress_event")
}

/// Non-semantic bounded-scan cursor. Deadlines and authority never read this mutable checkpoint.
model CompletionAckDeliveryReconcileCursor {
  singletonId             Boolean  @id @default(true) @map("singleton_id")
  lastDeliveryReceiptId   String?  @map("last_delivery_receipt_id") @db.Uuid
  scanCount               BigInt   @default(0) @map("scan_count")
  updatedAt               DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("completion_ack_delivery_reconcile_cursor")
}

/// Append-only proof that an exact current, non-revoked coordinator delivery asked one of the
/// four owner-only questions. It is a child of the AGENT-owned completion obligation, not a second
/// obligation and not lifecycle authority.
model CompletionAckOwnerDecisionBinding {
  bindingId             String   @id @map("binding_id") @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  projectId             String   @map("project_id") @db.Uuid
  coordinationId        String   @map("coordination_id") @db.Uuid
  obligationId          String   @map("obligation_id") @db.Char(64)
  obligationRevision    String   @map("obligation_revision") @db.Char(64)
  requestId             String   @unique @map("request_id") @db.Uuid
  deliveryReceiptId     String   @map("delivery_receipt_id") @db.Uuid
  coordinatorSessionId  String   @map("coordinator_session_id") @db.Uuid
  runnerIdSnapshot      String   @map("runner_id_snapshot") @db.Uuid
  reason                String
  requestDigest         String   @map("request_digest") @db.Char(64)
  bindingDigest         String   @unique @map("binding_digest") @db.Char(64)
  recordedLogicalTime   BigInt   @map("recorded_logical_time")
  recordedAt            DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@index([tenantId, projectId, obligationId, obligationRevision, recordedAt(sort: Desc)], map: "completion_ack_owner_decision_scope_idx")
  @@map("completion_ack_owner_decision_binding")
}

/// Stable delivery contract plus one current-target revision. Historical revisions remain so an
/// EVER_DELIVERED policy can be audited without weakening CURRENT_TARGET_CONTAINS.
model OutcomeDeliveryBinding {
  deliveryBindingId             String   @id @map("delivery_binding_id") @db.Uuid
  bindingSequence               BigInt   @default(autoincrement()) @unique @map("binding_sequence")
  tenantId                      String   @map("tenant_id") @db.Uuid
  projectId                     String   @map("project_id") @db.Uuid
  goalId                        String   @map("goal_id")
  goalRevision                  BigInt   @map("goal_revision")
  canonicalBindingDigest        String   @map("canonical_binding_digest") @db.Char(64)
  deliveryBindingDigest         String   @map("delivery_binding_digest") @db.Char(64)
  bindingRevisionDigest         String   @map("binding_revision_digest") @db.Char(64)
  policyMode                    String   @map("policy_mode")
  repositoryProvider            String   @map("repository_provider")
  repositoryId                  String   @map("repository_id")
  repositoryDigest              String   @map("repository_digest") @db.Char(64)
  targetRef                     String   @map("target_ref")
  currentTargetSha              String   @map("current_target_sha")
  currentTargetContentDigest    String   @map("current_target_content_digest") @db.Char(64)
  artifactDigest                String   @map("artifact_digest") @db.Char(64)
  evaluationPlanDigest          String   @map("evaluation_plan_digest") @db.Char(64)
  acceptanceCommandDigest       String   @map("acceptance_command_digest") @db.Char(64)
  integrationProviderIdentity   String   @map("integration_provider_identity")
  verificationProviderIdentity  String   @map("verification_provider_identity")
  asOfLogicalTime               BigInt   @map("as_of_logical_time")
  idempotencyKey                String   @map("idempotency_key")
  requestDigest                 String   @map("request_digest") @db.Char(64)
  createdAt                     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, projectId, bindingRevisionDigest])
  @@unique([tenantId, projectId, idempotencyKey])
  @@index([tenantId, projectId, deliveryBindingDigest, bindingSequence(sort: Desc)], map: "outcome_delivery_binding_current_idx")
  @@map("outcome_delivery_binding")
}

/// Provider-authenticated repository delivery receipt. Its provider receipt identity is replay-fenced.
model OutcomeDeliveryAttestation {
  attestationId          String   @id @map("attestation_id") @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  projectId              String   @map("project_id") @db.Uuid
  deliveryBindingDigest  String   @map("delivery_binding_digest") @db.Char(64)
  bindingRevisionDigest  String   @map("binding_revision_digest") @db.Char(64)
  providerReceiptId      String   @map("provider_receipt_id")
  providerIdentity       String   @map("provider_identity")
  repositoryProvider     String   @map("repository_provider")
  repositoryId           String   @map("repository_id")
  repositoryDigest       String   @map("repository_digest") @db.Char(64)
  targetRef              String   @map("target_ref")
  targetSha              String   @map("target_sha")
  targetContentDigest    String   @map("target_content_digest") @db.Char(64)
  artifactDigest         String   @map("artifact_digest") @db.Char(64)
  result                 String
  externalEffectState    String   @map("external_effect_state")
  verifiedAt             DateTime @map("verified_at") @db.Timestamptz(6)
  verifiedLogicalTime    BigInt   @map("verified_logical_time")
  idempotencyKey         String   @map("idempotency_key")
  receipt                Json
  receiptDigest          String   @map("receipt_digest") @db.Char(64)
  recordedAt             DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@unique([tenantId, projectId, providerIdentity, providerReceiptId])
  @@unique([tenantId, projectId, idempotencyKey])
  @@index([tenantId, projectId, deliveryBindingDigest, verifiedLogicalTime(sort: Desc), attestationId], map: "outcome_delivery_attestation_binding_idx")
  @@map("outcome_delivery_attestation")
}

/// Mechanical acceptance rerun from a clean checkout of the exact attested target SHA.
model OutcomeDeliveryVerification {
  verificationId          String   @id @map("verification_id") @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  projectId               String   @map("project_id") @db.Uuid
  deliveryBindingDigest   String   @map("delivery_binding_digest") @db.Char(64)
  bindingRevisionDigest   String   @map("binding_revision_digest") @db.Char(64)
  providerReceiptId       String   @map("provider_receipt_id")
  providerIdentity        String   @map("provider_identity")
  repositoryDigest        String   @map("repository_digest") @db.Char(64)
  targetRef               String   @map("target_ref")
  targetSha               String   @map("target_sha")
  targetContentDigest     String   @map("target_content_digest") @db.Char(64)
  artifactDigest          String   @map("artifact_digest") @db.Char(64)
  evaluationPlanDigest    String   @map("evaluation_plan_digest") @db.Char(64)
  acceptanceCommandDigest String   @map("acceptance_command_digest") @db.Char(64)
  environment             String
  result                  String
  exitCode                Int      @map("exit_code")
  skipCount               Int      @map("skip_count")
  verifiedAt              DateTime @map("verified_at") @db.Timestamptz(6)
  verifiedLogicalTime     BigInt   @map("verified_logical_time")
  idempotencyKey          String   @map("idempotency_key")
  receipt                 Json
  receiptDigest           String   @map("receipt_digest") @db.Char(64)
  recordedAt              DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@unique([tenantId, projectId, providerIdentity, providerReceiptId])
  @@unique([tenantId, projectId, idempotencyKey])
  @@index([tenantId, projectId, deliveryBindingDigest, verifiedLogicalTime(sort: Desc), verificationId], map: "outcome_delivery_verification_binding_idx")
  @@map("outcome_delivery_verification")
}

/// Linearized work request for the exact current binding and stream watermark. A newer request
/// supersedes an older pending one; COMMITTED always names the immutable evaluator result.
model OutcomeReconcileRequest {
  requestId          String    @id @map("request_id") @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  requestGeneration  BigInt    @map("request_generation")
  bindingDigest      String    @map("binding_digest") @db.Char(64)
  triggerLogicalTime BigInt    @map("trigger_logical_time")
  reasonCode         String    @map("reason_code")
  changedFields      String[]  @map("changed_fields")
  invalidators       String[]
  status             String
  evaluationId       String?   @map("evaluation_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  concludedAt        DateTime? @map("concluded_at") @db.Timestamptz(6)

  @@unique([tenantId, projectId, requestGeneration])
  @@index([tenantId, projectId, bindingDigest, requestGeneration(sort: Desc)], map: "outcome_reconcile_request_binding_idx")
  @@map("outcome_reconcile_request")
}

/// Append-only binding epoch edge, including every changed field and canonical invalidator.
model OutcomeBindingTransition {
  transitionId     String   @id @map("transition_id") @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  fromBindingDigest String? @map("from_binding_digest") @db.Char(64)
  toBindingDigest  String   @map("to_binding_digest") @db.Char(64)
  fromBindingEpoch BigInt?  @map("from_binding_epoch")
  toBindingEpoch   BigInt   @map("to_binding_epoch")
  changedFields    String[] @map("changed_fields")
  invalidators     String[]
  requestId        String   @unique @map("request_id") @db.Uuid
  recordedAt       DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@unique([tenantId, projectId, toBindingDigest])
  @@map("outcome_binding_transition")
}

/// Immutable reason an evaluator result stopped being eligible for the current binding/watermark.
model OutcomeProofObsolescence {
  evaluationId         String   @id @map("evaluation_id") @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  projectId            String   @map("project_id") @db.Uuid
  bindingDigest        String   @map("binding_digest") @db.Char(64)
  requestId            String   @map("request_id") @db.Uuid
  transitionId         String?  @map("transition_id") @db.Uuid
  reasonCode           String   @map("reason_code")
  obsoleteAtLogicalTime BigInt  @map("obsolete_at_logical_time")
  recordedAt           DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@map("outcome_proof_obsolescence")
}

model OutcomeProofSuccessor {
  tenantId                 String   @map("tenant_id") @db.Uuid
  projectId                String   @map("project_id") @db.Uuid
  predecessorEvaluationId  String   @map("predecessor_evaluation_id") @db.Uuid
  successorEvaluationId    String   @map("successor_evaluation_id") @db.Uuid
  requestId                String   @map("request_id") @db.Uuid
  recordedAt               DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@id([tenantId, projectId, predecessorEvaluationId, successorEvaluationId])
  @@map("outcome_proof_successor")
}

model OutcomeObsoleteObligation {
  tenantId                       String   @map("tenant_id") @db.Uuid
  projectId                      String   @map("project_id") @db.Uuid
  predecessorObligationId        String   @map("predecessor_obligation_id") @db.Char(64)
  predecessorObligationRevision  String   @map("predecessor_obligation_revision") @db.Char(64)
  bindingDigest                  String   @map("binding_digest") @db.Char(64)
  requestId                      String   @map("request_id") @db.Uuid
  transitionId                   String?  @map("transition_id") @db.Uuid
  obligation                     Json
  obsoleteAtLogicalTime          BigInt   @map("obsolete_at_logical_time")
  recordedAt                     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@id([tenantId, projectId, predecessorObligationRevision])
  @@map("outcome_obsolete_obligation")
}

/// Exists even when successorCount is zero, proving that the empty successor set was decided.
model OutcomeObligationReduction {
  tenantId                      String   @map("tenant_id") @db.Uuid
  projectId                     String   @map("project_id") @db.Uuid
  predecessorObligationRevision String   @map("predecessor_obligation_revision") @db.Char(64)
  successorEvaluationId         String   @map("successor_evaluation_id") @db.Uuid
  requestId                     String   @map("request_id") @db.Uuid
  reducedAt                     DateTime @default(now()) @map("reduced_at") @db.Timestamptz(6)

  @@id([tenantId, projectId, predecessorObligationRevision])
  @@map("outcome_obligation_reduction")
}

/// Many-to-many by design: neither predecessor nor successor is unique on its own.
model OutcomeObligationSuccessor {
  tenantId                       String   @map("tenant_id") @db.Uuid
  projectId                      String   @map("project_id") @db.Uuid
  predecessorObligationRevision  String   @map("predecessor_obligation_revision") @db.Char(64)
  successorObligationRevision    String   @map("successor_obligation_revision") @db.Char(64)
  successorEvaluationId          String   @map("successor_evaluation_id") @db.Uuid
  requestId                      String   @map("request_id") @db.Uuid
  recordedAt                     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@id([tenantId, projectId, predecessorObligationRevision, successorObligationRevision])
  @@map("outcome_obligation_successor")
}

model OutcomeBindingRatification {
  tenantId          String   @map("tenant_id") @db.Uuid
  projectId         String   @map("project_id") @db.Uuid
  bindingDigest     String   @map("binding_digest") @db.Char(64)
  contractDigest    String   @map("contract_digest") @db.Char(64)
  contractRevision  BigInt?  @map("contract_revision")
  ratificationId    String?  @map("ratification_id") @db.Uuid
  carriedForward    Boolean  @default(false) @map("carried_forward")
  boundAt           DateTime @default(now()) @map("bound_at") @db.Timestamptz(6)

  @@id([tenantId, projectId, bindingDigest])
  @@map("outcome_binding_ratification")
}
