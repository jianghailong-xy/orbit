/// One agent's membership of one project's team, and the only place a project's COORDINATOR is
/// recorded.
///
/// Deliberately a row here rather than a `coordinator_agent_id` column on `project`: a coordinator
/// is one role of a team, and the same fact stored in two shapes is the one that drifts. "At most
/// one coordinator per project" is a partial unique index in the migration
/// (`project_member_coordinator_idx`, `WHERE role = 'COORDINATOR'`) rather than a service check,
/// so a second one is refused by the database whichever process, version or raw statement tries it.
///
/// `agentId` names a `workspace` row, which is what an Agent IS on the wire today — MCP
/// `agent_list` / `agent_create`, `orbit agent`, and `task.assigneeId` all mean this table. The
/// domain contract's target state splits identity out of `workspace` into its own `agent` table;
/// when that lands, this column re-points at the mirror row of the same workspace, which is
/// exactly the mapping that migration already has to build. Recording the coordinator against a
/// workspace-shaped agent now is what makes the identity stable across coordinator SESSIONS, which
/// is the thing this table exists for.
///
/// Restrict on the agent, Cascade on the project: deleting a project takes its team with it (a
/// team of a project that no longer exists means nothing), while an agent some project coordinates
/// with cannot be deleted out from under it — that would silently disband the team rather than ask.
model ProjectMember {
  id        String      @id @default(uuid(7)) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentId   String      @map("agent_id") @db.Uuid
  agent     Workspace   @relation("ProjectMemberAgent", fields: [agentId], references: [id], onDelete: Restrict)
  role      ProjectRole
  addedAt   DateTime    @default(now()) @map("added_at")

  // One membership per agent per project; a role change edits the row rather than adding a second.
  @@unique([projectId, agentId])
  // "Which projects is this agent on the team of" — and the lookup the Restrict above performs on
  // every attempt to delete an agent. Referencing columns are never indexed automatically.
  @@index([agentId])
  @@map("project_member")
}

/// The control loop's own row for a project: state that belongs to running the project rather than
/// to the project itself.
///
/// Separate from `project` for two reasons that both matter. Layering: `project.status`
/// (OPEN/DONE/CANCELLED) is what happened to the WORK, and a column named like a run state sitting
/// next to it invites code that confuses the two. Write amplification: this row is where the loop's
/// hot fields will live, and `project` is read by every list, task page and stream.
///
model ProjectRuntime {
  /// The primary key IS the project id: exactly one runtime row per project, stated by the schema
  /// instead of by a unique index over a surrogate key nothing would ever reference.
  projectId             String   @id @map("project_id") @db.Uuid
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// How many times this project's coordinator SESSION has been replaced. It counts rotations, not
  /// identity: the coordinator AGENT is unchanged by any of them (that is `ProjectMember`), and a
  /// rotation replaces the conversation while leaving the previous one intact and readable.
  ///
  /// Monotonic and never reused, because keys derived from it have to stay unique for the life of
  /// the project — a counter that can go back is a counter that can make two different runs look
  /// like the same one.
  coordinatorGeneration BigInt   @default(0) @map("coordinator_generation")
  /// The coordinator session `coordinatorGeneration` was last counted against — the baseline a
  /// rotation is measured FROM, so that "how many times has this pointer been replaced" is a
  /// function of two committed facts (this column and the project row) rather than of how many
  /// statements a writer split its change across. Maintained entirely by the database
  /// (`project_coordinator_reconcile`, migration 0113); no service writes it.
  ///
  /// No relation, deliberately, for the reason `project_decision.coordinator_session_id` has none
  /// (contract §7.7 D19-b): a historical id, not a reference. SetNull would reset the baseline
  /// when a rotated-away session is purged — and a baseline that resets is a rotation that goes
  /// uncounted — while Restrict would make deleting a session fail against a counter.
  coordinatorSessionId  String?  @map("coordinator_session_id") @db.Uuid

  /// Where the coordinator identity on `ProjectMember` came from. DERIVED is the default and the
  /// value every pre-0114 row keeps, because it is the answer that leaves the database able to
  /// correct a stale derivation; EXPLICIT is written by the service in the SAME transaction as the
  /// membership whenever an owner sets, replaces or clears `coordinatorAgentId`, and by
  /// `project_coordinator_reconcile` when it finds a seat only a chooser could have written.
  coordinatorIdentitySource ProjectIdentitySource @default(DERIVED) @map("coordinator_identity_source")
  /// The coordination workspace a DERIVED identity was derived FROM — the baseline for WHO, exactly
  /// as `coordinatorSessionId` is the baseline the generation is counted from. It is how the
  /// database recognises a choice made by a writer that cannot write the column above (a 0113-era
  /// binary rolled back onto this schema writes `project_member` directly): the seat it derived
  /// names this workspace, so a seat naming anything else was moved, and a seat that is gone was
  /// removed. Meaningless while the source is EXPLICIT, and cleared when it becomes so.
  ///
  /// No relation, for the reason `coordinatorSessionId` has none: a historical marker, not a
  /// reference. Maintained entirely by the database and by the two service paths above.
  coordinatorIdentityLandingId String? @map("coordinator_identity_landing_id") @db.Uuid

  /// Derived control-loop state and the durable recovery clock. A PLANNING runtime with no live
  /// work always carries a next wake; SETTLED clears it.
  runState       ProjectRunState @default(PLANNING) @map("run_state")
  nextWakeAt     DateTime?       @map("next_wake_at")
  nextWakeReason String?         @map("next_wake_reason")

  /// One renewable lease per Project. Every successful acquisition increments fencingToken;
  /// token-guarded commits make an expired process physically unable to publish an action.
  leaseHolder      String?   @map("lease_holder") @db.Uuid
  leaseExpiresAt   DateTime? @map("lease_expires_at")
  leaseHeartbeatAt DateTime? @map("lease_heartbeat_at")
  fencingToken     BigInt    @default(0) @map("fencing_token")

  /// Persistent epoch used by RUN_PROJECT_ACCEPTANCE once that action is introduced.
  acceptanceAttempt BigInt @default(0) @map("acceptance_attempt")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("project_runtime")
}

/// Permanent idempotency ledger for orchestration side effects. The unique key is claimed before
/// the effect and both are committed in one transaction, so a retry observes the existing row and
/// skips the effect. Rows are never deleted independently; the Project cascade is the only exit.
model ProjectAction {
  id             String              @id @default(uuid(7)) @db.Uuid
  projectId      String              @map("project_id") @db.Uuid
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  idempotencyKey String              @unique @map("idempotency_key")
  type           ProjectActionType
  status         ProjectActionStatus @default(CLAIMED)
  subjectType    String              @map("subject_type")
  subjectId      String?             @map("subject_id") @db.Uuid
  fencingToken   BigInt              @map("fencing_token")

  /// Result-session lineage is bidirectional and commit-time checked by the Project dispatch
  /// boundary (migration 0122).
  resultSessionId String? @unique @map("result_session_id") @db.Uuid
  resultSession   Session? @relation("ProjectActionResultSession", fields: [resultSessionId], references: [id], onDelete: NoAction)
  dispatchedSession Session? @relation("ProjectActionSession")
  verdictFailures   TaskVerificationFailure[] @relation("VerificationFailureAction")
  refusalCode     String? @map("refusal_code")
  detail          Json    @default("{}")
  executionContext       Json?   @map("execution_context")
  executionContextDigest String? @map("execution_context_digest") @db.Char(64)
  executionResultDigest  String? @map("execution_result_digest") @db.Char(64)
  reasonCode             String? @map("reason_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId, createdAt])
  @@index([projectId, type, status])
  @@map("project_action")
}

/// One committed fact that woke — or was refused the right to wake — this project's coordinator
/// (unit T2, migration 0174).
///
/// The identity is `idempotency_key` = `cw:v1:<event>:<subjectType>:<subjectId>:<subjectVersion>`,
/// derived by `coordinator-wake.ts` from the fact alone and BEFORE anything asks whether the wake
/// is authorized. Its uniqueness is a PARTIAL index declared in the migration, because Prisma
/// cannot express one:
///
///   UNIQUE ("idempotency_key") WHERE "status" <> 'REFUSED'
///
/// That predicate is the difference between this table and `project_action`, whose plain unique
/// key means a refusal spends the key permanently — which is how the coordinator rotation path was
/// once welded shut. Here a refused row leaves the index and stays in the table: the fact can be
/// delivered again, and why it was refused is still on the record.
///
/// Nothing fires on its own. Rows are written only by `CoordinatorWakeService`, from facts a
/// producer derived out of rows that were already committed — never from a timer.
model ProjectCoordinatorWake {
  /// Supplied by the writer, like `ProjectHandoffApproval.id`: the claim is a raw INSERT with an
  /// `ON CONFLICT` clause Prisma cannot express, so there is no `create()` for a default to serve.
  id        String  @id @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// `COORDINATOR_WAKE_EVENTS`, frozen by a CHECK in the migration rather than a Prisma enum — the
  /// choice `ProjectBlocker.kind` makes, so the closed set has one home and not two.
  event          String
  subjectType    String @map("subject_type")
  /// TEXT, not uuid: a CRITERION names `<projectId>:<criterionKey>` because a criterion is a line
  /// of the project's acceptance text and has no row until a run judges it.
  subjectId      String @map("subject_id")
  /// Which occurrence of the fact this is — the attempt's session id, or a digest of the
  /// `(taskId, status)` pairs the fact is defined over. Argued per event in `coordinator-wake.ts`.
  subjectVersion String @map("subject_version")
  idempotencyKey String @map("idempotency_key")

  /// CLAIMED, SESSION_OPENED, CONSUMED or REFUSED. Both successful terminal states remain inside
  /// 0174's partial unique index: one fact opens/feeds one consumer at most once.
  status      String  @default("CLAIMED")
  /// Non-null exactly when `status` is REFUSED, enforced by a CHECK: a stop with no reason is the
  /// one shape this table exists to make impossible.
  refusalCode String? @map("refusal_code")
  /// Display and diagnosis. Never an input to a decision and never part of the key (cf.
  /// `ProjectBlocker.occurrences`, BL7).
  detail      Json    @default("{}")

  /// Non-session completion inputs name their durable consumer exactly when status is CONSUMED.
  /// Human requests use HUMAN_INBOX; they never acquire a Session pointer.
  consumerType String?   @map("consumer_type")
  consumedAt   DateTime? @map("consumed_at")

  /// The one judgment session this wake opened (unit T3, migration 0175). Unique, so two wakes
  /// cannot name one session; nullable and `SetNull`, so deleting a session is never refused by
  /// this ledger — what the row still says afterwards is that it opened one.
  sessionId String?  @unique(map: "project_coordinator_wake_session_id_key") @map("session_id") @db.Uuid
  session   Session? @relation("CoordinatorJudgmentSession", fields: [sessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  /// Both, and the pair is deliberate: the claim is a raw INSERT that names no timestamp, so the
  /// column needs the database default 0174 gives it, while `@updatedAt` is what makes a refusal
  /// stamp the moment the key was given back.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  /// The judgment T4 made on this fact, if it got that far. At most one.
  convergenceDecisions ProjectConvergenceDecision[]

  /// Named to match the migration, so the schema and the DDL that built the table agree literally
  /// rather than approximately.
  @@index([projectId, createdAt], map: "project_coordinator_wake_project_idx")
  @@map("project_coordinator_wake")
}

/// One coordinator wake, judged: what the progress vector was before it and at it, what that cost
/// the budget, and whether the coordinator may go on waking (unit T4, migration 0176).
///
/// This table is where the counters LIVE. `convergence-ledger.ts` names the reason in as many
/// words — 「重启把计数清零，于是预算永远用不完」 — so a stop-loss whose numbers sit in process
/// memory is not a stop-loss: every deploy, crash and takeover gives it a fresh budget. Everything
/// `planWakeConvergence` reads is a committed row here.
///
/// `idempotencyKey` is `pcv:v1:<projectId>:<scopeHash>:<wakeKey>`, where the wake key is T2's
/// identity of the committed FACT. A fact redelivered ten times is charged once and reads its own
/// judgment back the other nine — the difference between counting facts and counting deliveries.
/// Unlike `ProjectCoordinatorWake`, whose key is released by a refusal, this one is a PLAIN unique
/// index: a judgment that could be re-made would be a budget that could be re-spent.
///
/// Nothing here fires on its own, and `outcome = STOP` schedules nothing. It stops the coordinator
/// by refusing the NEXT wake, and it raises its `project_blocker` on the TRANSITION into a stop and
/// never while one holds — which is precisely what `COORDINATOR_NO_PROGRESS` did not do when it was
/// a condition detector, and how a project with every acceptance criterion passing sat at OPEN.
model ProjectConvergenceDecision {
  /// Supplied by the writer: the row is a raw INSERT alongside a `MAX + 1` seq allocation, so there
  /// is no `create()` for a default to serve.
  id        String  @id @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The fact this judgment was made on. Always present: a judgment with no fact behind it is the
  /// timer this unit exists to remove.
  wakeId String                 @map("wake_id") @db.Uuid
  wake   ProjectCoordinatorWake @relation(fields: [wakeId], references: [id], onDelete: Cascade)

  /// Monotone within a project, allocated `MAX + 1` under the project row lock — a replay ORDER
  /// that does not depend on `createdAt`, which two writers can tie on.
  seq BigInt

  idempotencyKey String @map("idempotency_key")
  inputHash      String @map("input_hash") @db.Char(64)
  /// Everything the decision was a function of. A replay that recomputes a different `inputHash`
  /// from this is a ledger something other than the planner has written to.
  input          Json

  event     String
  scopeHash String @map("scope_hash") @db.Char(64)

  /// The pair, which is the point: the vector as the previous wake measured it, and the vector at
  /// this one. Null on a project's first decision and after a scope change — a measurement against
  /// a different target says nothing about this one (§4 PV3).
  previousProgressVector Json?    @map("previous_progress_vector")
  progressVector         Json     @map("progress_vector")
  progressVectorDigest   String   @map("progress_vector_digest") @db.Char(64)
  /// §4 PV2, as decided by `strictlyImproves` and by nothing else in this system.
  progressed             Boolean
  /// PV6. UNMEASURED is an empty snapshot, whose all-zero vector reads as "every defect closed" to
  /// a comparison that only sees numbers.
  evidenceFreshness      String   @map("evidence_freshness")
  evidenceAsOf           DateTime? @map("evidence_as_of")

  /// §8 TH4's counters, after this judgment charged them.
  counters   Json
  /// The RESOLVED thresholds that applied — which may be the documented defaults, because
  /// `project.convergenceThresholds` is null on almost every project.
  thresholds Json

  /// Which §8 line was crossed and the two numbers that crossed it, or all three null. A CHECK in
  /// 0176 keeps them one fact rather than three columns that can disagree.
  nonConvergenceReason String? @map("non_convergence_reason")
  observed             Int?
  crossedLimit         Int?    @map("crossed_limit")

  /// PROCEED or STOP, and a CHECK ties STOP to a reason being present.
  outcome String

  /// The blocker this decision raised, when it is the one that raised it. `SetNull` rather than
  /// Cascade: deleting the blocker must leave the decision saying it raised one that is now gone.
  ///
  /// Named `raisedBlockerId` and not `blockerId` deliberately. `PublicIdInterceptor` keys on the
  /// FIELD NAME, not on the model, so a second column called `blockerId` would silently change how
  /// `GET /tasks/:id/attribution` renders its own `blockerId` — a field that has always gone out as
  /// a raw uuid. Whether that surface should be base62 is a real question and not this unit's; a
  /// distinct name keeps it a question rather than a side effect.
  raisedBlockerId String?         @map("blocker_id") @db.Uuid
  raisedBlocker   ProjectBlocker? @relation(fields: [raisedBlockerId], references: [id], onDelete: SetNull)

  observedAt DateTime @map("observed_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([idempotencyKey], map: "project_convergence_decision_key_idx")
  @@unique([projectId, seq], map: "project_convergence_decision_seq_idx")
  @@index([wakeId], map: "project_convergence_decision_wake_idx")
  @@map("project_convergence_decision")
}

/// Append-only Coordinator judgment audit. The JSON protocol uses Base62 public ids, while the
/// relational attribution columns retain UUIDs so ownership and action lineage remain enforceable.
/// WHO can resolve a blocker (contract §11.1). This column decides `run_state` — §4.2's guard 2
/// selects AWAITING_HUMAN when any open blocker is USER, guard 3 BLOCKED otherwise — and nothing
/// else. §11.5 ES3 moves it exactly once, always to USER.
enum ProjectBlockerOwner {
  USER
  COORDINATOR
  SYSTEM

  @@map("project_blocker_owner")
}

/// WHAT can clear a blocker (§11.1, v1.1). This column decides the CLOCK (§10.4) and nothing else,
/// and escalation never rewrites it (ES1).
///
/// It exists because `owner` alone was answering three questions at once. BUDGET_EXHAUSTED is the
/// row that proved it: the person who can raise a budget is the user, so v1 wrote owner = USER,
/// which made the state AWAITING_HUMAN, which made `next_wake_at` NULL — and a wait that ends by
/// itself in six hours became a wait for somebody nobody told (`PC-CX-05`).
enum ProjectBlockerRecovery {
  TIME
  EVENT
  HUMAN

  @@map("project_blocker_recovery")
}

/// How loudly this reads on the control plane. The contract names the column and leaves the values
/// free; `PROJECT_BLOCKER_POLICY` freezes one per kind.
enum ProjectBlockerSeverity {
  INFO
  WARNING
  CRITICAL

  @@map("project_blocker_severity")
}

/// Who ended the episode. AUTO is §11.4's recomputation finding the condition gone, which is the
/// normal exit; the other two record a person or the coordinator resolving it deliberately.
enum ProjectBlockerResolvedBy {
  AUTO
  USER
  COORDINATOR

  @@map("project_blocker_resolved_by")
}

/// One structured reason this project did not move (contract §11).
///
/// §11.1 BL1 is why the table exists at all: a pass that did not advance lands HERE or on a `NOOP`
/// audit row that says why, and there is no third option. "It silently did nothing" is the failure
/// mode this project was built to make impossible, so it has to be unrepresentable.
///
/// Rows are NEVER deleted on resolution — `resolvedAt` is set and the row stays. Two things depend
/// on that: `lifecycleGeneration` is allocated as `MAX + 1` over this key's whole history (§11.3
/// BE1), so the history has to still be there; and "what was blocking this last Tuesday" is a
/// question the audit is supposed to answer.
model ProjectBlocker {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// §11.2's closed set, frozen by a CHECK in migration 0125 rather than by a Prisma enum: the
  /// first six values ARE PAC §12's refusal codes, and a second enum spelling them would be a
  /// second place for them to drift from.
  kind           String
  owner          ProjectBlockerOwner
  recovery       ProjectBlockerRecovery
  severity       ProjectBlockerSeverity
  /// BL0's fourth question: one executable sentence, not a restated error message.
  requiredAction String   @map("required_action")
  /// BL5. Meaning depends on `recovery`: the recovery instant (TIME), a recompute poll (EVENT), or
  /// the escalation alarm (HUMAN). NOT NULL because §11.1 requires one even when owner = USER.
  nextCheckAt    DateTime @map("next_check_at")

  /// What it is about. `subjectId` is TEXT, not uuid: most subjects are a row id (rendered Base62
  /// on the way out) but a builtin provider has no row of its own and is named by its slug, and
  /// `dedupeKey` has to be a total function of these two.
  subjectType String @map("subject_type")
  subjectId   String @map("subject_id")

  /// Display and diagnosis. Never an input to any decision.
  detail Json @default("{}")

  /// §11.3: `<kind>:<subjectType>:<subjectId>` by default. Two indexes are declared on it in the
  /// migration — a partial unique over open rows (one open episode per key) and a full unique over
  /// `(project, key, generation)` (no two episodes share a generation, even across a takeover).
  dedupeKey String @map("dedupe_key")
  /// §11.3 BE1: which failure episode this is on that key. Allocated inside the INSERT as
  /// `COALESCE(MAX(...), 0) + 1`, so it advances only when a resolved condition genuinely comes
  /// back — which is what makes it an identity §8.2 GE1 accepts, and what lets §7.6 TR3 tell "the
  /// coordinator made no progress" apart from "it broke again".
  lifecycleGeneration BigInt @map("lifecycle_generation")
  /// §7.2 TF2: a digest of the snapshot FACTS that produced this row. Recomputed and overwritten
  /// every time the same key is observed again, which is what makes "the conflicting file set
  /// changed" distinguishable from "the same conflict was seen once more".
  conditionVersion String @map("condition_version") @db.Char(64)

  firstSeenAt DateTime @map("first_seen_at")
  lastSeenAt  DateTime @map("last_seen_at")
  /// BL7: `occurrences` and `lastSeenAt` are for display and diagnosis ONLY. They must never enter
  /// an idempotency key, `turnFacts`, an escalation condition, a `run_state` decision, a
  /// notification decision or a `nextWakeAt` computation. v1.2's `occurrences > 10` escalation made
  /// the owner, the state and one notification depend on how often a queue redelivered the same
  /// fact (`PC-CX-15`); ES5 is the regression test for its absence.
  occurrences Int @default(1)

  /// §11.5: set once, by the escalation that moved `owner` to USER. Non-null also means §7.2's
  /// BLOCKER_DECISION stops firing for this row (BL6) and §10.4 clause 2 stops selecting it — the
  /// precise mechanical meaning of "escalated" is a wait that has been handed over and stopped
  /// ticking.
  escalatedAt DateTime? @map("escalated_at")

  resolvedAt DateTime?                 @map("resolved_at")
  resolvedBy ProjectBlockerResolvedBy? @map("resolved_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The T4 decision that raised this row, if a stop-loss did (0176).
  raisedByConvergenceDecisions ProjectConvergenceDecision[]

  @@unique([projectId, dedupeKey, lifecycleGeneration], map: "project_blocker_episode_idx")
  @@index([projectId, resolvedAt])
  @@index([projectId, nextCheckAt])
  @@map("project_blocker")
}

/// A durable signal that some committed fact belonging to a Project changed.
///
/// This is a transactional outbox, not a second source of business truth: consumers use the
/// envelope to decide which Project to reconcile, then re-read the current world. Repeated signals
/// with the same `dedupeKey` coalesce while pending; the partial unique index that enforces that is
/// declared in migration 0116 because Prisma cannot express a partial unique constraint.
/// A LEGACY run request's RECEIPT: what the caller asked for, and what the door authoritatively
/// answered (migration 0137).
///
/// Deriving each artifact from the caller's token makes every artifact stable and still leaves the
/// REQUEST non-idempotent, because the door re-runs its mutable gates first — prerequisites, the
/// hold, the assignee, the aggregate/retirement rules, the Project the task is filed under. A
/// delivery arriving after any of those moved answers something else. So the answer is recorded at
/// the door and a repeat is served from here, before a single mutable check runs.
/// The automatic doors' request identity (migration 0137): a monotone per-Task counter, advanced
/// once per moment at which an automatic door may legitimately start this task's work.
///
/// A manual door is named by its caller (`triggerId`). An automatic one has no press, and naming it
/// with the CURRENT VALUE of the fact it acted on is wrong because those values come back: `run_at`
/// 09:00 -> 10:00 -> 09:00 is a legitimate second appointment that re-derives the first one's name,
/// and a prerequisite going DONE -> reopened -> DONE is a legitimate second READY transition under
/// an unchanged edge set. Both would be answered with the first request's receipt — silently never
/// running. See §7.7 D5-b4 for the transition table.
///
/// A side table rather than a column on `task`, for the three costs 0132 measured: writing the Task
/// row re-checks all its foreign keys, re-runs every row trigger on it, and moves a clock users
/// can see.
model TaskDispatchEpoch {
  taskId String @id @map("task_id") @db.Uuid
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  epoch  BigInt @default(0)

  @@map("task_dispatch_epoch")
}

model TaskRunRequest {
  ownerId      String   @map("owner_id") @db.Uuid
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// `TASK_EXECUTE` or `TASK_BATCH_EXECUTE`: one token used at both doors is two requests.
  actionKind   String   @map("action_kind")
  /// The caller's `triggerId`, or the durable fact an automatic door acted on.
  requestToken String   @map("request_token")
  /// The canonical payload. The same token with a different one is refused, not answered.
  fingerprint  String
  /// OPEN | BOUND | COMPLETED — the request's own state machine, not a two-state cache.
  status       String   @default("OPEN")
  /// The immutable plan, written by a compare-and-set BEFORE any effect: which Session is created
  /// or adopted, which turn is delivered under which key, which batch item goes where. A takeover
  /// performs exactly this and never re-reads the mutable world that produced it.
  target       Json?
  boundAt      DateTime? @map("bound_at")
  /// The answer, verbatim, so a repeat returns the same bytes.
  result       Json?
  /// One evaluator at a time. The holder is the only delivery that reads mutable state or applies
  /// an effect; the lease expires so a dead holder does not wedge the request, and `attempt` fences
  /// its writes so a resumed one cannot complete a request that has since been taken over.
  leaseHolder    String?   @map("lease_holder")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  attempt        Int       @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([ownerId, actionKind, requestToken])
  @@index([ownerId, createdAt(sort: Desc)], map: "task_run_request_owner_created_idx")
  @@map("task_run_request")
}

/// First durable observation of one automatic dependency-dispatch watermark. The companion write
/// increments Task.dispatchAttempt exactly once; trigger/sweep re-deliveries share this row.
model TaskAutoDispatchAttempt {
  tenantId       String   @map("tenant_id") @db.Uuid
  projectId      String?  @map("project_id") @db.Uuid
  taskId         String   @map("task_id") @db.Uuid
  taskRevision   BigInt   @map("task_revision")
  watermark      BigInt
  attemptOrdinal BigInt   @map("attempt_ordinal")
  firstTrigger   String   @map("first_trigger")
  firstOutcome   String   @map("first_outcome")
  firstObservedAt DateTime @default(now()) @map("first_observed_at")

  @@id([taskId, watermark])
  @@index([tenantId, projectId, firstObservedAt(sort: Desc)], map: "task_auto_dispatch_attempt_tenant_project_idx")
  @@map("task_auto_dispatch_attempt")
}

/// Immutable reason/binding revision for a blocked automatic dispatch.
model TaskAutoDispatchObligationRevision {
  tenantId          String   @map("tenant_id") @db.Uuid
  projectId         String?  @map("project_id") @db.Uuid
  taskId            String   @map("task_id") @db.Uuid
  taskRevision      BigInt   @map("task_revision")
  watermark         BigInt
  obligationId      String   @map("obligation_id") @db.Char(64)
  obligationRevision String  @map("obligation_revision") @db.Char(64)
  bindingDigest     String   @map("binding_digest") @db.Char(64)
  reasonCode        String   @map("reason_code")
  reason            Json
  owner             String
  nextAction        String   @map("next_action")
  binding           Json
  createdAt         DateTime @default(now()) @map("created_at")

  @@id([tenantId, taskId, obligationRevision])
  @@unique([tenantId, taskId, obligationId, obligationRevision], map: "task_auto_dispatch_obligation_identity_idx")
  @@map("task_auto_dispatch_obligation_revision")
}

/// Rebuildable current state. ACTIVE rows are the task/project control-plane obligation overlay;
/// DISPATCHED is terminal for one watermark and cannot be reopened by a late racing refusal.
model TaskAutoDispatchState {
  tenantId          String   @map("tenant_id") @db.Uuid
  projectId         String?  @map("project_id") @db.Uuid
  taskId            String   @map("task_id") @db.Uuid
  taskRevision      BigInt   @map("task_revision")
  watermark         BigInt
  attemptOrdinal    BigInt   @map("attempt_ordinal")
  obligationId      String   @map("obligation_id") @db.Char(64)
  obligationRevision String  @map("obligation_revision") @db.Char(64)
  state             String
  outcome           String
  reasonCode        String   @map("reason_code")
  sessionId         String?  @map("session_id") @db.Uuid
  attemptedActions  Json     @default("[]") @map("attempted_actions")
  firstObservedAt   DateTime @default(now()) @map("first_observed_at")
  latestObservedAt  DateTime @default(now()) @map("latest_observed_at")
  observationCount  BigInt   @default(1) @map("observation_count")

  @@id([taskId, watermark])
  @@index([tenantId, taskId, watermark], map: "task_auto_dispatch_state_active_task_idx")
  @@index([tenantId, projectId, firstObservedAt], map: "task_auto_dispatch_state_active_project_idx")
  @@map("task_auto_dispatch_state")
}

/// Append-only transition trace for the automatic dispatch obligation projection.
model TaskAutoDispatchEvent {
  eventId           BigInt   @id @default(autoincrement()) @map("event_id")
  tenantId          String   @map("tenant_id") @db.Uuid
  projectId         String?  @map("project_id") @db.Uuid
  taskId            String   @map("task_id") @db.Uuid
  taskRevision      BigInt   @map("task_revision")
  watermark         BigInt
  obligationId      String   @map("obligation_id") @db.Char(64)
  obligationRevision String  @map("obligation_revision") @db.Char(64)
  fromState         String?  @map("from_state")
  toState           String   @map("to_state")
  outcome           String
  reasonCode        String   @map("reason_code")
  sessionId         String?  @map("session_id") @db.Uuid
  idempotencyKey    String   @unique @map("idempotency_key") @db.Char(64)
  recordedAt        DateTime @default(now()) @map("recorded_at")

  @@index([tenantId, taskId, watermark, eventId], map: "task_auto_dispatch_event_trace_idx")
  @@map("task_auto_dispatch_event")
}

/// Persistent retry clock. A timer may deliver this fact repeatedly; it may not invent a reason.
model TaskAutoDispatchWakeup {
  wakeupId          String   @id @default(uuid(7)) @map("wakeup_id") @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  projectId         String?  @map("project_id") @db.Uuid
  taskId            String   @map("task_id") @db.Uuid
  taskRevision      BigInt   @map("task_revision")
  watermark         BigInt
  obligationRevision String  @map("obligation_revision") @db.Char(64)
  generation        BigInt   @default(1)
  dueAt             DateTime @map("due_at")
  reasonCode        String   @map("reason_code")
  state             String   @default("PENDING")
  deliveryAttempts  Int      @default(0) @map("delivery_attempts")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([taskId, watermark, obligationRevision, generation], map: "task_auto_dispatch_wakeup_identity_key")
  @@index([state, dueAt, tenantId, taskId], map: "task_auto_dispatch_wakeup_due_idx")
  @@map("task_auto_dispatch_wakeup")
}

/// The conclusion an acceptance run — or one of its criteria — reached. Deliberately its own enum
/// rather than a second use of `TaskVerdict`: a project-level acceptance is not a verification
/// task, and one enum shared by two subjects is the one that grows a value only one of them means.
enum ProjectAcceptanceVerdict {
  PASS
  FAIL
  INCONCLUSIVE

  @@map("project_acceptance_verdict")
}

/// One immutable version of the project-level acceptance evidence set.
///
/// The historical API/table name is retained for compatibility. Since migration 0179 this is not a
/// human-driven attempt and does not own a verdict: merge/criteria facts advance it automatically,
/// idempotent evaluators share one current row, and ProjectAcceptanceConclusion events supply the
/// derived standing. Legacy terminal columns remain readable and immutable.
model ProjectAcceptanceRun {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation("ProjectAcceptanceRuns", fields: [projectId], references: [id], onDelete: Cascade)

  /// The epoch this run was claimed at — `project_runtime.acceptance_attempt` as read when the run
  /// opened, with the `+1` committed in the same transaction (§13.4 AE11). Monotonic and never
  /// reused, which makes `(projectId, attempt)` a permanent evidence-version name.
  attempt BigInt

  /// The project's `acceptanceEpoch` when this run was opened (migration 0150), stamped by the
  /// database rather than by whoever opened it — so a run opened by a binary that does not know the
  /// column exists still lands in the epoch that is actually current, instead of fail-closing at 0.
  /// Frozen for the life of the row, concluded or not: it is not a conclusion, it is the identity
  /// of the world the conclusion is about.
  acceptanceEpoch BigInt @default(0) @map("acceptance_epoch")

  /// The criteria this run actually judged, frozen at open: the raw text plus its sha256. A run is
  /// evidence about a stated condition, and a condition that can be edited afterwards is not one.
  criteriaSnapshot String  @map("criteria_snapshot")
  /// The structured snapshot for runs opened by schema 0172 or later. Historical runs keep null
  /// and remain readable through `criteriaSnapshot` plus their per-criterion rows.
  criteriaSnapshotV2 Json? @map("criteria_snapshot_v2")
  criteriaRevision String  @map("criteria_revision") @db.Char(64)

  /// The acceptance-only input digest (current criterion revision plus cited merge evidence),
  /// computed under the project row lock when the run opened. Task status is deliberately absent:
  /// the DONE gate recomputes this digest from the outcome being accepted, not the work backlog.
  /// Which reading of the world this evidence was taken under (`ACCEPTANCE_DIGEST_VERSION`).
  /// Defaults to 1, so a row produced by a binary that predates digest versioning fails closed.
  /// Version 4 removed task rows and task-verification verdicts from this input shape.
  digestVersion   Int      @default(1) @map("digest_version")
  inputDigest String @map("input_digest") @db.Char(64)
  /// Legacy pre-0179 terminal projection. New conclusions live only in the event table.
  resultDigest String? @map("result_digest") @db.Char(64)

  /// Legacy pre-0179 terminal projection; new evidence versions leave it null.
  verdict ProjectAcceptanceVerdict?

  /// Who caused this evidence version to be materialized. Conclusion authorship is recorded on
  /// every ProjectAcceptanceConclusion event instead.
  decidedBy String @map("decided_by")

  /// Historical attribution, deliberately without foreign keys (the reason `project_decision`'s
  /// pair has none): rotating or deleting a coordinator must not rewrite who ran an acceptance.
  coordinatorAgentId   String? @map("coordinator_agent_id") @db.Uuid
  coordinatorSessionId String? @map("coordinator_session_id") @db.Uuid

  /// Ledger lineage, when this run was produced by a pass rather than by a direct owner-channel
  /// request. Optional: that channel may run acceptance directly.
  projectActionId  String?          @map("project_action_id") @db.Uuid

  /// Why this is no longer the current evidence version. Set — never cleared — when facts advance.
  supersededAt     DateTime? @map("superseded_at")
  supersededReason String?   @map("superseded_reason")

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  criteria ProjectAcceptanceCriterion[]
  conclusions ProjectAcceptanceConclusion[]

  @@unique([projectId, attempt])
  @@index([projectId, createdAt])
  /// "Which epoch's evidence does this project have" — the read the DONE gate and the acceptance
  /// face both make once a project has been reopened at least once.
  @@index([projectId, acceptanceEpoch], map: "project_acceptance_run_epoch_idx")
  @@map("project_acceptance_run")
}

/// One append-only conclusion about one criterion, made against one durable evidence version.
///
/// A run is the immutable version of the evidence set. Conclusions are events over those versions:
/// adding merge evidence advances the version but does not rewrite or invalidate an earlier
/// conclusion. The current standing is derived by taking the highest-version conclusion for the
/// current definition revision. This is why actor, time and evidence version are all mandatory.
model ProjectAcceptanceConclusion {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  evidenceRunId  String               @map("evidence_run_id") @db.Uuid
  evidenceRun    ProjectAcceptanceRun @relation(fields: [evidenceRunId], references: [id], onDelete: Cascade)
  evidenceVersion BigInt              @map("evidence_version")

  ordinal       Int
  criterionKey  String @map("criterion_key")
  criterionText String @map("criterion_text")
  /// Historical definition identity. Null only on backfilled pre-0172 conclusions, whose original
  /// rows deliberately did not claim an identity that did not yet exist.
  definitionId       String? @map("definition_id") @db.Uuid
  definitionRevision Int?    @map("definition_revision")

  verdict ProjectAcceptanceVerdict
  summary String?
  evidence Json @default("{}")
  evidenceTaskId    String? @map("evidence_task_id") @db.Uuid
  evidenceSessionId String? @map("evidence_session_id") @db.Uuid

  /// USER or COORDINATOR_AGENT. PASS is additionally constrained to USER by migration 0179.
  decidedBy String @map("decided_by")
  /// The durable credentialed principal: owner id for a USER-attributed channel, acting Session id
  /// for a judgment agent. The former does not prove that a human held the owner credential.
  decidedById String @map("decided_by_id") @db.Uuid
  actingSessionId String? @map("acting_session_id") @db.Uuid
  decidedAt DateTime @default(now()) @map("decided_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId, definitionId, definitionRevision, evidenceVersion(sort: Desc), decidedAt(sort: Desc), id(sort: Desc)], map: "project_acceptance_conclusion_standing_idx")
  @@index([evidenceRunId], map: "project_acceptance_conclusion_run_idx")
  @@map("project_acceptance_conclusion")
}

/// One stated criterion, and what this run concluded about it (contract §13.4 clause 3).
///
/// The per-criterion row is the whole point: "the project passed" is not a fact anybody can check,
/// while "criterion 7 passed, here is the command, the output and the SHA" is. A run cannot reach
/// PASS unless every criterion parsed out of the snapshot has a row here with a PASS verdict.
model ProjectAcceptanceCriterion {
  id        String               @id @default(uuid(7)) @db.Uuid
  runId     String               @map("run_id") @db.Uuid
  run       ProjectAcceptanceRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Denormalized so tenancy and the audit reads filter without joining the run. Kept in step by
  /// the service, which only ever writes it from the run it just locked.
  projectId String               @map("project_id") @db.Uuid

  /// Position in the snapshot, 1-based, and the stable content key of the criterion line. The key
  /// is what lets a later run be lined up against this one when the criteria text was reordered.
  ordinal       Int
  criterionKey  String @map("criterion_key")
  criterionText String @map("criterion_text")
  /// Historical identity of the authored definition. No FK: deleting or replacing a current
  /// definition must never rewrite or prevent deletion of the run snapshot that judged it.
  definitionId       String? @map("definition_id") @db.Uuid
  definitionRevision Int?    @map("definition_revision")

  /// Frozen declaration shape. Historical rows are migrated honestly to HUMAN_SIGNOFF; current
  /// rows copy the definition so the review page never guesses a criterion from mutable state.
  completionCriterion TaskCompletionCriterion @map("completion_criterion")
  acceptanceCommand          String? @map("acceptance_command")
  acceptanceExpectedExitCode Int?    @map("acceptance_expected_exit_code")

  verdict ProjectAcceptanceVerdict?
  summary String?
  /// Commands, key output, SHAs, environment — §13.4 clause 3's evidence, as JSON so a checker can
  /// read it without parsing prose.
  evidence Json @default("{}")

  /// What in Orbit this conclusion leans on. Historical ids without foreign keys, for the reason
  /// the run's attribution columns have none.
  evidenceTaskId    String? @map("evidence_task_id") @db.Uuid
  evidenceSessionId String? @map("evidence_session_id") @db.Uuid

  decidedAt DateTime? @map("decided_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([runId, ordinal])
  // Null for every pre-0172 row; PostgreSQL permits multiple nulls, while a structured run may
  // snapshot one current definition only once.
  @@unique([runId, definitionId], map: "project_acceptance_criterion_run_definition_idx")
  @@index([projectId])
  @@map("project_acceptance_criterion")
}

/// The database's own record of what a target branch contained when it was last observed
/// (contract §13.4 AE9).
///
/// `mergeEvidence` is the one acceptance projection that describes the world OUTSIDE the database,
/// and AE9-a is explicit about what that means: a DONE asserts "on the content observed at
/// `refGeneration = g`, acceptance passed" — not "the branch is like this now". `contentHash` is
/// taken BY CONTENT (AE9-b / §13.4 clause 6), never from `git branch --contains`, which is a
/// guaranteed false negative after a squash.
///
/// A row is never updated in place when the content differs: the writer inserts a new row with
/// `refGeneration + 1`, which is what makes "the branch moved and moved back" visible in a database
/// that cannot lock a git ref.
model ProjectMergeEvidence {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// What was required, and where it had to land. Free-form on purpose: a requirement is stated by
  /// whoever states the acceptance criteria, and forcing it into an id would invent an entity §2.3
  /// forbids.
  requirementId String @map("requirement_id")
  targetBranch  String @map("target_branch")

  /// The normalized content observation, and the monotonic generation it belongs to.
  contentHash   String @map("content_hash") @db.Char(64)
  refGeneration BigInt @map("ref_generation")

  /// How it was observed, and the raw observation behind the hash (command, output, blob ids).
  source String @default("MERGE_EVIDENCE_WRITER")
  detail Json   @default("{}")

  observedAt DateTime @default(now()) @map("observed_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@unique([projectId, requirementId, targetBranch, refGeneration])
  @@index([projectId, requirementId, targetBranch])
  @@map("project_merge_evidence")
}

/// Unit L4 (migration 0155): one recorded ANSWER about one cross-project crossing, and the single
/// task it was spent on.
///
/// `docs/project-coordinator-scope-contract.md` §6 makes `APPROVE` and `APPLY` two events — "or
/// there is no state in which the approved move can wait for its own transaction" — so a yes that
/// has been given and not yet spent has to survive between transactions. Nothing already in this
/// schema can hold it: `approval` dies with its session while a question outlives a takeover,
/// `project_blocker.detail` is display-only by BL7, and `project_action` has one project column
/// where a crossing has two.
///
/// It stores the answer and nothing else. No work is filed here and no goal is stated here, so §8
/// CM3 still holds where it can: `DISCOVERED`, `FILED`, `UNMAPPED` and `ABANDONED` remain derived
/// from `task` columns. Same category of row as `project_blocker` — a control-plane record of a
/// decision, not a fourth thing a user has to learn.
model ProjectHandoffApproval {
  id      String @id @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// The two ends. Cascade on both: an answer about a project that no longer exists is not an
  /// answer, and no crossing can name a deleted project, so nothing is loosened by removing it.
  fromProjectId String  @map("from_project_id") @db.Uuid
  fromProject   Project @relation("ProjectHandoffFrom", fields: [fromProjectId], references: [id], onDelete: Cascade)
  toProjectId   String  @map("to_project_id") @db.Uuid
  toProject     Project @relation("ProjectHandoffTo", fields: [toProjectId], references: [id], onDelete: Cascade)

  /// FILE_TASK | MOVE_TASK | DEPEND_ON_TASK, frozen by a CHECK in 0155 rather than by a Prisma enum
  /// (cf. `ProjectBlocker.kind`): the values are `project-handoff.ts`'s closed set, and a second
  /// spelling is a second place for them to drift from.
  kind String

  /// MOVE_TASK: the task being moved. DEPEND_ON_TASK: the prerequisite. FILE_TASK: null — what it
  /// authorises does not exist yet, and the source it was noticed on is bound through the digest.
  /// No foreign key, deliberately: deleting the task must not delete the record of what was decided.
  subjectTaskId String? @map("subject_task_id") @db.Uuid

  /// The full request identity this answer is about — plan fields, structure, execution and source
  /// evidence — and the identity of the crossing itself, which is what a retry looks itself up by.
  payloadDigest String @map("payload_digest") @db.Char(64)
  crossingKey   String @map("crossing_key") @db.Char(64)

  /// PENDING | APPROVED | DENIED | APPLIED. `EXPIRED` is derived from `expiresAt`, never stored, so
  /// nothing has to run for a stale yes to stop working.
  state String

  /// Display, never a gate.
  title  String
  reason String?

  /// Historical attribution without a foreign key : rotating or deleting the
  /// session that asked must not rewrite who asked or delete the answer.
  requestedBySessionId String   @map("requested_by_session_id") @db.Uuid
  requestedAt          DateTime @map("requested_at")

  decidedBy       String?   @map("decided_by")
  decidedByUserId String?   @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at")

  /// When a live yes stops being spendable. Set only in APPROVED (R13).
  expiresAt DateTime? @map("expires_at")

  /// The one task this yes was spent on. No foreign key for the same reason as above; uniqueness is
  /// a partial index in 0155 over FILE_TASK rows only, because a task may legitimately be moved
  /// twice or made to wait on two projects.
  appliedTaskId String?   @map("applied_task_id") @db.Uuid
  appliedAt     DateTime? @map("applied_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  @@unique([ownerId, crossingKey])
  @@index([toProjectId, state, requestedAt])
  @@index([fromProjectId, state, requestedAt])
  @@map("project_handoff_approval")
}

/// Append-only audit of everything that happened to a project's acceptance standing: a run opened
/// or finalized, a DONE bound to a run, a DONE refused and why, a terminal project reopened because
/// an acceptance fact changed underneath it (§13.4 AE8's `reopened_by_fact_change`).
///
/// Separate from `project_decision` because most of these rows are not decisions of the control
/// loop at all — a user pressing DONE and being refused produces one, and it is exactly the row
/// somebody needs when they ask why the button did nothing.
model ProjectAcceptanceAudit {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Closed set, frozen by a CHECK in migration 0127 rather than by an enum: these values are read
  /// by the audit face and by the reopen trigger, and a CHECK is the spelling a trigger can write.
  kind String

  runId  String? @map("run_id") @db.Uuid
  reason String?
  detail Json    @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("project_acceptance_audit")
}

model TaskList {
  id        String   @id @default(uuid(7)) @db.Uuid
  title     String
  // Tenant scope: list/authorization always filter by this column (like tasks).
  ownerId   String   @map("owner_id") @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Standing instructions for every task in this list — how this class of work is done, as
  // opposed to which item this task is. Spliced into the run prompt at dispatch, so editing it
  // takes effect on every task not yet started, without touching a single task row.
  //
  // This layer was missing entirely: above it sits Workspace.systemPrompt (one machine, every
  // kind of work) and below it Task.description (one item), and with nowhere in between the
  // invariant half of a campaign's instructions ends up copied into every description. Measured
  // on this deployment: 27,706 task descriptions collapse to 140 distinct shapes, ~86% of each
  // one duplicated text. Applying one lesson learned meant rewriting all of them.
  instructions  String?
  // Emergency stop for the whole list. The auto-run sweep skips a paused list's tasks and
  // execute() refuses them, so one write halts a campaign that is dispatching wrongly —
  // previously the only way to stop one was to edit and redeploy the reconciler. Runs already
  // in flight are deliberately left alone: this gates dispatch, not execution.
  paused        Boolean @default(false)
  // Cap on this list's concurrently RUNNING task sessions, enforced by the claim transaction's
  // existing batch gate (see QueueService) with the list id as the batch. Null means uncapped,
  // which is the pre-existing behaviour: only the runner-wide cap applies, so a 500-task list
  // auto-running takes every free slot and starves every other list behind it.
  maxConcurrent Int?    @map("max_concurrent")

  /// The workspace that runs this list's coordination work, when it has one. A foreman is not a
  /// resident process watching the list — it is dispatched as an ordinary task when something
  /// needs deciding, does one bounded piece of work, and ends. That is what lets it inherit the
  /// retry, reaping, slot accounting and audit every other run already has, instead of needing a
  /// parallel set of guarantees; a long-lived supervisor session would be subject to exactly the
  /// failures it exists to notice.
  foremanWorkspaceId String?    @map("foreman_workspace_id") @db.Uuid
  foremanWorkspace   Workspace? @relation("TaskListForeman", fields: [foremanWorkspaceId], references: [id], onDelete: SetNull)
  /// Dispatch the foreman when the list has been stalled this many minutes: work remains, but
  /// nothing is running and nothing has started in that long. Null disables it. The condition is
  /// deliberately "nothing happened", not "something failed" — every incident this is built for
  /// (a wedged session holding a task, a livelocked merge, a quota outage nobody was told about)
  /// looks identical from outside and none of them raises an error anywhere.
  foremanStallMinutes Int?      @map("foreman_stall_minutes")
  /// File a verification run whenever a task in this list reports DONE.
  ///
  /// Off by default because it doubles a list's runs, and because the check is only worth its
  /// cost where a false "done" is expensive. It is opt-in per list rather than global for the
  /// same reason the concurrency cap is: the right answer differs per campaign.
  verifyOnDone        Boolean   @default(false) @map("verify_on_done")

  /// The conversation this list is steered from — where a human says "pause it", "drop the
  /// concurrency to 2", "here is what changed about how these should be run", and an agent turns
  /// that into policy writes.
  ///
  /// A pointer, never a dependency. Nothing on the dispatch path reads it: the sweep, the claim
  /// gate and the foreman all work exactly the same whether it is set, stale or null. That
  /// separation is the whole design — a console session that could stall a campaign by dying
  /// would be the resident supervisor this architecture spent P3 avoiding, and this deployment
  /// already has the cautionary case (one session created 43 lists and ~21,500 tasks, then sat
  /// FAILED). SetNull on delete for the same reason: losing the conversation loses the entry
  /// point and nothing else.
  ownerSessionId      String?   @map("owner_session_id") @db.Uuid
  ownerSession        Session?  @relation("TaskListConsole", fields: [ownerSessionId], references: [id], onDelete: SetNull)

  tasks     Task[]
  revisions TaskListRevision[]
  events    TaskListEvent[]

  @@index([ownerId])
  @@map("task_list")
}

/// A condition the control plane noticed about a list, kept so somebody can eventually read it.
///
/// These are all things the sweep already detects, acts on, and then forgets into a log line —
/// "12 ready tasks held, provider quota exhausted" is written once per sweep to stdout and is
/// invisible to the person whose campaign stopped moving. The auto-run comment says as much:
/// "why is nothing running" needs an answer somewhere.
///
/// One row per (list, kind), not one per occurrence. A quota outage lasting four hours is one
/// condition seen 240 times, not 240 events, and the board a reader wants is "what is true about
/// this list now" — so a repeat bumps `lastSeenAt`/`occurrences` in place. That also bounds the
/// table by lists × kinds instead of by sweep count.
///
/// Nothing here is on the dispatch path, and nothing waits on it. It is read at delivery into the
/// list's console session and by tasklist_get; a row nobody ever reads costs one upsert.
model TaskListEvent {
  id     String   @id @default(uuid(7)) @db.Uuid
  listId String   @map("list_id") @db.Uuid
  list   TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// quota_hold | disk_hold | foreman_filed | verification_rejected
  kind        String
  /// One line, already phrased for a reader — the counts and the reset time are the answer, and
  /// re-deriving them at read time would mean re-running the sweep's query against a moved world.
  detail      String
  occurrences Int       @default(1)
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  /// When this condition was last reported into the console. A condition seen again since then is
  /// due for re-reporting; comparing against `lastSeenAt` rather than clearing this flag is what
  /// keeps a four-hour outage from re-announcing itself on every 60s sweep.
  deliveredAt DateTime? @map("delivered_at")

  @@unique([listId, kind])
  @@map("task_list_event")
}

/// One recorded state of a list's dispatch policy — instructions, paused, maxConcurrent.
///
/// A snapshot of the result, not a delta. Restoring v3 means writing v3's values back as a new
/// revision, which works from any distance; a chain of deltas only ever undoes the last step and
/// has to be replayed to answer "what did it look like then".
///
/// This exists so a policy write can be undone rather than pre-approved. The failure it is
/// designed against is not a wrong edit but an unnoticed one: an auto-run loop ran for 21 hours
/// because nothing recorded that anything had changed. `note` carries the reason in words —
/// worth more than the diff, because "keep the disk safe, so gate the downloads" is what someone
/// reading this in three months needs, and a column list cannot say it.
///
/// Title is deliberately not versioned: renaming a list is not a policy change, and a rename
/// that produced a restorable revision would bury the changes that matter.
model TaskListRevision {
  id     String   @id @default(uuid(7)) @db.Uuid
  listId String   @map("list_id") @db.Uuid
  list   TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Monotonic per list from 1. Assigned under the list's row lock, so concurrent writers
  /// cannot mint the same number.
  version Int

  instructions        String?
  paused              Boolean
  maxConcurrent       Int?    @map("max_concurrent")
  foremanWorkspaceId  String? @map("foreman_workspace_id") @db.Uuid
  foremanStallMinutes Int?    @map("foreman_stall_minutes")
  verifyOnDone        Boolean @default(false) @map("verify_on_done")

  /// Why this change was made, in words. Optional, but it is the field that makes the history
  /// readable rather than merely complete.
  note String?

  /// Polymorphic author, same convention as Task.creator*: a user or a workspace agent, plus the
  /// session it was written from when an agent did it.
  authorType      CreatorType @map("author_type")
  authorId        String      @map("author_id") @db.Uuid
  authorSessionId String?     @map("author_session_id") @db.Uuid
  authorSession   Session?    @relation("TaskListRevisionAuthorSession", fields: [authorSessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([listId, version])
  @@index([listId, createdAt(sort: Desc)])
  @@map("task_list_revision")
}

// A human-facing work item (unrelated to the old execution-Task dropped in 0006).
// Created by a user or an agent, optionally assigned to an agent to execute; the
// agent's runs hang off it as Sessions.
model Task {
  id               String      @id @default(uuid(7)) @db.Uuid
  title            String
  description      String?
  status           TaskStatus  @default(OPEN)
  // Tenant scope: list/authorization always filter by this column (like agents/sessions).
  ownerId          String      @map("owner_id") @db.Uuid
  owner            User        @relation(fields: [ownerId], references: [id])
  // Polymorphic creator (no FK, cf. Activity.actorId): who/what authored the task.
  creatorType      CreatorType @map("creator_type")
  creatorId        String      @map("creator_id") @db.Uuid
  // The session an in-session agent created this task from (real FK, optional; null for
  // user-created tasks). Deleting the session detaches but keeps the task. Lets the task
  // detail page link back to its origin run.
  creatorSessionId String?     @map("creator_session_id") @db.Uuid
  creatorSession   Session?    @relation("TaskCreatorSession", fields: [creatorSessionId], references: [id], onDelete: SetNull)
  // The workspace this task runs in when executed (real FK, optional).
  assigneeId       String?     @map("assignee_id") @db.Uuid
  assignee         Workspace?  @relation(fields: [assigneeId], references: [id])
  // Optional parent list grouping; deleting the list detaches but keeps the task.
  listId           String?     @map("list_id") @db.Uuid
  list             TaskList?   @relation(fields: [listId], references: [id], onDelete: SetNull)
  /// The project this task is work towards. Legacy Projects keep the original grouping-only
  /// behaviour; enabling the Project Coordinator atomically transfers automatic dispatch authority
  /// to that control loop. User-initiated runs remain available in either mode.
  ///
  /// Restrict on delete, NOT SetNull, and this is the one place it differs from `listId`. A list is
  /// a dispatch policy its tasks can outlive; a project is what its tasks are *for*, so silently
  /// nulling this column would not detach the tasks, it would destroy the only record of why they
  /// exist — and it would do so invisibly, since nothing about a project-less task says it ever had
  /// one. Deleting a non-empty project is therefore refused outright (see ProjectsService.remove),
  /// and this constraint is the backstop that makes that refusal true even for a caller that races
  /// past the check.
  projectId        String?     @map("project_id") @db.Uuid
  project          Project?    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// Where this work was NOTICED, as opposed to which goal it counts towards (unit L2, migration
  /// 0150; contract §2 and §3 SC7). Four columns, and none of them authority.
  ///
  /// The distinction is the whole unit. `projectId` above is the ONLY column that says whose goal
  /// this task is work towards — scheduling, acceptance, liveness and concurrency read it and
  /// nothing else. These four say where the write came from, so that a coordinator filing work into
  /// a project it does not coordinate leaves a row that can be COMPARED rather than reconstructed
  /// from session transcripts. The day a gate reads `discoveredFromProjectId` to decide anything,
  /// "I found this" has quietly become "I may write here" — which is the incident, with paperwork.
  ///
  /// The referential actions are where that is stated in a language every writer meets: `projectId`
  /// is Restrict (a project that OWNS work cannot be deleted), these are SetNull (a project, task
  /// or session work was merely noticed in can be, and what survives is the absence). Written once,
  /// at creation, and frozen afterwards by `task_provenance_immutable_guard` against every change,
  /// emptying included. The three references have one lawful way to become null and it is the
  /// SetNull itself, arriving as an UPDATE because the row they name was deleted; the guard admits
  /// it by checking that the referenced row is GONE, which is true exactly when the referential
  /// action is what is running and false when a person clears the column by hand. `triggerEvent`
  /// has no foreign key, so nothing can be deleted that would empty it and it has no lawful null
  /// at all.
  ///
  /// A handoff that moves `projectId` (unit L4) leaves all four untouched: where the work was
  /// noticed did not change when it changed hands.
  discoveredFromProjectId String?  @map("discovered_from_project_id") @db.Uuid
  discoveredFromProject   Project? @relation("TaskDiscoveredFrom", fields: [discoveredFromProjectId], references: [id], onDelete: SetNull)
  /// WHICH fact prompted the write, in the free-text vocabulary `project_acceptance_reopen(p_fact)`
  /// already speaks — 'task.verdict_failed', 'merge_evidence', 'user.project_edited'. Deliberately
  /// not an enum: L1 froze the column names and left the vocabulary open, and a closed set here
  /// would need a migration for every new trigger, which is how a column stops being written.
  triggerEvent            String?  @map("trigger_event")
  /// The task being executed when this work was noticed, and the session it was noticed in.
  /// Distinct from `creatorSessionId`, which is a fact about who authored the row; these are facts
  /// about where the WORK came from, and the two differ the moment anything files on behalf of
  /// something else.
  sourceTaskId            String?  @map("source_task_id") @db.Uuid
  sourceTask              Task?    @relation("TaskDiscoverySource", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  discovered              Task[]   @relation("TaskDiscoverySource")
  sourceSessionId         String?  @map("source_session_id") @db.Uuid
  sourceSession           Session? @relation("TaskDiscoverySession", fields: [sourceSessionId], references: [id], onDelete: SetNull)
  /// The task this one is a part of. Decomposition, not ordering: `TaskDependency` already says
  /// "B waits for A", and that is a different claim from "B is part of A" — a subtask can be
  /// unblocked and still belong to its parent, and a prerequisite can be finished work nobody
  /// considers part of anything.
  ///
  /// A single optional parent (a forest) rather than an edge table, because the question it answers
  /// admits exactly one answer: two parents would give one task two different wholes to be part of,
  /// and the completion of neither would mean anything definite.
  ///
  /// SetNull on delete, NOT Cascade. Cascade would make `DELETE /tasks/:id` delete other tasks —
  /// a change to what an existing, already-shipped endpoint does, and the destructive direction.
  /// An orphaned child is recoverable by re-pointing it; a cascade-deleted subtree is not.
  parentTaskId     String?     @map("parent_task_id") @db.Uuid
  parent           Task?       @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children         Task[]      @relation("TaskHierarchy")
  /// What would settle that this task is actually done, as opposed to reported done. The task-level
  /// counterpart of `Project.acceptanceCriteria`; nothing assembles it into a prompt in this phase.
  acceptanceCriteria String?   @map("acceptance_criteria")
  /// EXECUTABLE acceptance: one shell command and its expected exit code.
  /// The database constraint added with these columns requires both or neither; there is no
  /// command list, expression language, or separate acceptance entity behind them.
  acceptanceCommand          String? @map("acceptance_command")
  acceptanceExpectedExitCode Int?    @map("acceptance_expected_exit_code")
  /// The declared completion fact for this task. HUMAN_SIGNOFF is a first-class criterion and the
  /// compatibility value for every row that predates this column, never an exceptional fallback.
  completionCriterion TaskCompletionCriterion @default(HUMAN_SIGNOFF) @map("completion_criterion")
  /// Present only for the negotiated protocol. NULL preserves the N-1 fixed-120-second plan.
  acceptanceTimeoutSeconds              Int?    @map("acceptance_timeout_seconds")
  acceptanceOwnerTimeoutCeilingSeconds  Int?    @map("acceptance_owner_timeout_ceiling_seconds")
  acceptancePolicyTimeoutCeilingSeconds Int?    @map("acceptance_policy_timeout_ceiling_seconds")
  acceptanceSchemaRevision               Int?    @map("acceptance_schema_revision")
  acceptanceCapabilityRevision           Int?    @map("acceptance_capability_revision")
  acceptanceCommandDigest                String? @map("acceptance_command_digest") @db.Char(64)
  acceptanceEvaluationPlanDigest         String? @map("acceptance_evaluation_plan_digest") @db.Char(64)
  /// Incremented only by the admitted start handshake, never by admission itself.
  executionAttemptCount                  Int     @default(0) @map("execution_attempt_count")
  /// Revision of the database-owned canonical DONE fence. Current task creation writes 1
  /// explicitly and the database default protects rows inserted by an N-1 server too.
  completionFenceRevision Int @default(1) @map("completion_fence_revision")
  /// Why the creator deliberately kept a completion criterion after Orbit questioned the shape of
  /// the acceptance prose. NULL means no override was needed or recorded; the text is audit
  /// evidence only and is never interpreted as completion evidence.
  completionCriterionOverrideReason String? @map("completion_criterion_override_reason")
  /// Free-text labels, written by whoever files the task (in practice the agent creating it).
  /// The second grouping axis, orthogonal to `listId` and carrying no authority: a list decides
  /// how its tasks run (instructions, concurrency, pause, foreman), a label decides nothing and
  /// only says which tasks belong together. That split is why one is a single FK and these are a
  /// set — "which stage" admits exactly one answer because two stages would give one task two
  /// conflicting run policies, while "which batch" is just a fact about the work and can be
  /// stated as many times as it is true.
  ///
  /// The need predates the column. Agents were already labelling, by writing the label into the
  /// title where nothing could query it: at this migration 109,873 of 110,421 titles carried a
  /// `[CC-MAIN-yyyy-ww]` snapshot marker, 110 distinct values, and every one of them spanned all
  /// four pipeline lists. Migration 0106 lifts those into this column.
  ///
  /// An array rather than a tag table because none of what a tag table buys is wanted here:
  /// there is no rename, no colour, no library to curate. Its cost is real though — the writer
  /// is one INSERT instead of a find-or-create per label plus a join row, and there is no
  /// second table to keep consistent. Matching is exact, including case: these record facts
  /// (a snapshot id, a shard) rather than judgements, and facts arrive already spelled.
  labels           String[]    @default([])
  dueDate          DateTime?   @map("due_date")
  /// The earliest time this task may start automatically. A trigger, and the only column here that
  /// is one: `dueDate` states when the work is wanted BY and nothing reads it, while a sweep reads
  /// this one and dispatches on it. The two are independent — a task can be scheduled without a
  /// deadline and given a deadline without a schedule — and conflating them would make setting a
  /// due date start the work.
  ///
  /// NULL means unscheduled, which is every task that exists today and every task created without
  /// the field. Non-NULL is one-shot: the first run that is actually accepted consumes it back to
  /// NULL (compare-and-set on the observed instant, so a reschedule racing the dispatch survives),
  /// so this can never become a recurrence by accident. A schedule that cannot run yet — no
  /// assignee, its list paused, a prerequisite outstanding — is left alone rather than consumed,
  /// and the next sweep reconsiders it.
  ///
  /// Stored UTC, like every other instant here. Not to be confused with the `scheduledAt` column
  /// migration 0001 put on the long-deleted execution `Task`: that table is gone, and this is a
  /// property of the human-facing task, not of a run.
  runAt            DateTime?   @map("run_at")
  // Per-task override for the runs this task dispatches: a built-in engine slug
  // ("claude"/"codex"/"kimi"/"opencode") or one of the owner's configured ModelProvider slugs,
  // and a model id inside that provider's space. NULL keeps the historical behaviour — the run
  // inherits whatever its assignee agent is set to. Pinning the provider makes the next run
  // start a fresh session rather than continue the last one, since a session's provider is
  // fixed for its lifetime (see TasksService.runAgentOnTask).
  provider         String?
  model            String?
  // When all prerequisites are DONE, auto-run this task (the dependency "pipeline"
  // default). Turn off to keep the gate but trigger the run manually.
  autoRunWhenReady Boolean     @default(true) @map("auto_run_when_ready")
  /// This task is held: no sweep dispatch, no manual run. The projection of `TaskList.paused`,
  /// written onto every task in a list when the list is paused or resumed.
  ///
  /// It is a column here rather than a join to `task_list.paused` because a join makes the
  /// authority to spend money conditional on a row that can be deleted, and an unexpressible veto
  /// reads as permission. Deleting a paused list used to resume its 55k tasks — the stop existed
  /// only as `NOT EXISTS (... paused = true)`, so removing the list removed the brake. Authority
  /// to run has to be carried by the task and revocable only by writing to the task.
  ///
  /// The cost is real and accepted: pausing is now one UPDATE over the list's tasks instead of a
  /// single flag write. It is a separate column from `autoRunWhenReady` so resuming restores each
  /// task's own setting instead of overwriting it with a guess.
  dispatchHold     Boolean     @default(false) @map("dispatch_hold")
  // Derived by database triggers from (project_id, project.coordinator_enabled). No service may
  // use this as a second policy knob; it is the mixed-version dispatch brake.
  dispatchAuthority TaskDispatchAuthority @default(LEGACY) @map("dispatch_authority")
  // Monotonic action-key epoch. Every first observation of a Coordinator dispatch outcome advances
  // it in the same transaction; duplicate delivery of the same action key does not.
  dispatchAttempt   BigInt @default(0) @map("dispatch_attempt")
  // Requirements consumed by the Runner scheduler after WHO/WITH resolution. Empty preserves the
  // behaviour of every pre-0122 task and remains runnable on an old runner.
  requiredCapabilities String[] @default([]) @map("required_capabilities")
  // This task is a coordination run over its list, not one of the list's units of work. Two
  // consequences: it does not receive the list's standing instructions (those describe how the
  // *work* is done, and the foreman is not doing it), and an unfinished one suppresses further
  // foreman dispatch for that list, so a stall cannot mint a new coordinator every minute.
  isForeman        Boolean     @default(false) @map("is_foreman")
  /// When set, this task exists to check another task's claim of completion, and names the task
  /// it checks. Non-null carries the same two consequences as isForeman — no list instructions,
  /// and never itself verified — plus the thing a boolean could not: it identifies the subject,
  /// so "is this already being checked" and "how many times has this been checked" are exact
  /// rather than inferred.
  /// How this task's own completion is decided. See TaskCompletionPolicy: MANUAL (the default,
  /// and what every task created before migration 0123 keeps) leaves the status entirely to
  /// whoever writes it, while the other values make it a recomputation over the direct children.
  completionPolicy TaskCompletionPolicy @default(MANUAL) @map("completion_policy")
  /// This verification task's conclusion about its subject. NULL until it concludes, and NULL
  /// again if it is revoked; only meaningful together with `verifiesTaskId`, which migration 0123
  /// enforces with a CHECK rather than a comment.
  verdict          TaskVerdict? @map("verdict")
  /// Which conclusion this is (§13.2 V7). Monotonic, never reused, never reset — it advances in
  /// the transaction that reaches a verdict and is what the mechanical consequences are keyed on.
  /// Without it the key would be built from `verdict`, a value with three states that a re-run can
  /// return to: the second FAIL would collide with the first, be skipped as already applied, and
  /// leave the subject at DONE with no defect and nothing downstream stopped.
  verdictRevision  BigInt      @default(0) @map("verdict_revision")
  verifiesTaskId   String?     @map("verifies_task_id") @db.Uuid
  verifies         Task?       @relation("TaskVerification", fields: [verifiesTaskId], references: [id], onDelete: Cascade)
  verifiedBy       Task[]      @relation("TaskVerification")
  /// The later attempt that took this one's place (§13.6 SU1).
  ///
  /// It exists because the alternative was in production and did not work: a review that was
  /// re-run from scratch left its earlier attempts CANCELLED with the reason in a free-text
  /// comment, so "was this dropped, or is it being done again over there" was a question only a
  /// person reading prose could answer — and the answer was invisible to every query, every list
  /// and every acceptance read.
  ///
  /// Only a task that has already stopped may be linked (`CANCELLED` or `FAILED`, enforced by
  /// migration 0128's trigger), and linking writes nothing to `status`: the original failure is
  /// the fact being preserved, not the one being cleaned up. The successor must belong to the same
  /// owner and the same project, and the chain it forms is acyclic — all three checked by the same
  /// trigger, because a supersession that crosses a tenant or closes a loop is not a weaker version
  /// of the same claim, it is a different one. A task naming ITSELF is the acyclicity rule's
  /// zero-hop case rather than a rule of its own.
  ///
  /// SetNull on delete, like `parentTaskId` and for the same reason: deleting the successor must
  /// not refuse the delete or destroy the row that points at it. What survives is
  /// `terminalReason = 'SUPERSEDED'` with nothing to name, which reads back as
  /// `supersededByTaskIdAbsentReason = 'SUCCESSOR_DELETED'` rather than as "never superseded".
  supersededByTaskId String?  @map("superseded_by_task_id") @db.Uuid
  supersededBy       Task?    @relation("TaskSupersession", fields: [supersededByTaskId], references: [id], onDelete: SetNull)
  supersedes         Task[]   @relation("TaskSupersession")
  supersededAt       DateTime? @map("superseded_at")
  /// WHY this task stopped, when its status alone does not say. Closed set, frozen by a CHECK in
  /// migration 0128: `SUPERSEDED` (a successor is doing it instead) and `ABANDONED` (nobody is).
  ///
  /// Two values rather than four: `FAILED` and `CANCELLED` are already `status`, and a column that
  /// restates its neighbour is a column that can disagree with it. This one answers only the
  /// question `status` cannot — a CANCELLED task that was replaced and a CANCELLED task that was
  /// dropped are the same status and opposite facts.
  terminalReason     String?  @map("terminal_reason")
  // Best-effort dedup of a redelivered turn's re-created tasks: a hash of (session, turn, title,
  // description), set only when the create happens inside a live turn (see TasksService). @unique
  // gives a Postgres unique index, which by default treats NULLs as distinct — so the many tasks
  // created outside any turn (user API, headless) coexist freely while an in-turn re-run collides.
  idempotencyKey   String?     @unique @map("idempotency_key")

  /// `[K2]`: the task's pointer into the bounded-convergence ledger (migration 0138).
  ///
  /// Columns rather than a derived read, because §8 TH4 needs the counters to be COMMITTED facts:
  /// a restart that recomputed them in memory is how the incident's budget never ran out. The
  /// ledger can rebuild every one of them (`recoverConvergenceState`), and the pg spec checks that
  /// it does — the columns are the fast path, not a second source of truth.
  ///
  /// A task is under convergence management exactly when it has a `TaskScopeRevision` row, and
  /// none of these have any effect until it does. That is the whole compatibility story: every
  /// task filed before `[K2]` keeps its defaults and behaves exactly as it did.
  scopeRevision      Int      @default(1) @map("scope_revision")
  /// Which attempt on the CURRENT revision. One generation is one Session (§1); steering an
  /// existing one is not a new attempt and resets nothing (TH3).
  attemptGeneration  BigInt   @default(0) @map("attempt_generation")
  /// §2's state. A CHECK rather than a Prisma enum: the seven values are frozen in
  /// `convergence-contract.ts` and a second enum spelling them is a second place to drift from.
  progressState      String   @default("CONVERGING") @map("progress_state")
  /// §8's seven counters. Migration 0138's trigger refuses any UPDATE that walks one DOWN without
  /// strict progress or a new scope revision — which is every shape a budget has ever escaped by.
  convergenceCounters Json    @default("{\"attemptsOnRevision\":0,\"attemptsWithoutProgress\":0,\"sameFingerprintRepeats\":0,\"sameActionRepeats\":0,\"repairsWithoutSeverityDrop\":0,\"decisionsWithoutProgress\":0,\"verificationRounds\":0,\"transientRetries\":0,\"scopeExpansionRequests\":0}") @map("convergence_counters")
  /// §4 PV4: moved ONLY by strict improvement toward acceptance. Producing an action, opening a
  /// session, writing a commit or burning a token does not touch it (RL0).
  lastProgressAt     DateTime? @map("last_progress_at")
  /// §7: the commit this task is known good at. The checkpoint TABLE and the merge gate that reads
  /// it are a later unit; this is the pointer the progress vector's one identity dimension carries.
  knownGoodSha       String?  @map("known_good_sha")

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  comments     TaskComment[]
  completionEvidence TaskCompletionEvidence[]
  judgmentRequests TaskJudgmentRequest[]
  legacyEvidenceImports TaskLegacyEvidenceImport[]
  judgmentInboxItems TaskJudgmentInboxItem[]
  /// The durable HUMAN_SIGNOFF criterion event. Unique by task today: one signature satisfies the
  /// criterion, and retries return that same event rather than minting a second judgment.
  humanSignoffs TaskHumanSignoff[]
  sessions     Session[]        @relation("SessionTask") // agent sessions run under this task (one Task -> many Session)
  /// Conversations ABOUT this task that do not execute it — an @-mention's reply thread. Separate
  /// from `sessions` on purpose: those hold the task's execution claim and follow its lifecycle,
  /// these do neither (migration 0131).
  contextSessions Session[]     @relation("SessionContextTask")
  mentionDeliveries TaskCommentMentionDelivery[]
  // Dependency edges where THIS task is the dependent: the prerequisites it waits on.
  dependsOn    TaskDependency[] @relation("DependencyFromTask")
  // Dependency edges where THIS task is the prerequisite: tasks blocked until it's DONE.
  dependedOnBy TaskDependency[] @relation("DependencyToTask")
  /// The dispatch version of this task's prerequisite set (0132). Always present.
  dependencyRevision TaskDependencyRevision?
  /// The automatic doors' request identity (0137). Always present.
  dispatchEpoch      TaskDispatchEpoch?
  /// Verification conditions this task takes part in (§13.2): the ones it CONCLUDED as a verifier,
  /// the ones recorded ABOUT it as a subject, and the one it was filed to fix as a defect.
  verdictFailuresRaised   TaskVerificationFailure[] @relation("VerificationFailureVerifier")
  verdictFailuresAbout    TaskVerificationFailure[] @relation("VerificationFailureSubject")
  verdictFailuresRepaired TaskVerificationFailure[] @relation("VerificationFailureDefect")
  /// Merges recorded against this task's branches (§13.7 MR1).
  mergeReceipts           SessionMergeReceipt[]    @relation("TaskMergeReceipt")
  /// `[K2]`: every version of what this task asked for, and every judgment made about it.
  scopeRevisions          TaskScopeRevision[]
  convergenceDecisions    TaskConvergenceDecision[]
  /// `[K3]`: every attempt spent on this task — one row per Session that ran it (migration 0139).
  attempts                TaskAttempt[]
  executableAcceptanceAdmissions TaskExecutableAdmission[]
  executableAcceptanceAttempts   TaskExecutableAttempt[]
  executableAcceptanceContinuations TaskExecutableContinuation[]
  executableAcceptanceDiagnoses  TaskExecutableDiagnosis[]
  /// `[K5]`: §6's findings ABOUT this task, and the ones whose one effect IS this task.
  verificationFindings    TaskVerificationFinding[] @relation("FindingSubject")
  filedByFinding          TaskVerificationFinding[] @relation("FindingEffectTask")
  /// Presses of Run Now recorded against this task (0137).
  /// `[K6]`: §7's known-good and known-red points, append-only (migration 0152).
  checkpoints             TaskCheckpoint[]

  @@index([ownerId])
  @@index([ownerId, createdAt(sort: Desc), id(sort: Desc)], map: "task_owner_created_id_idx")
  @@index([ownerId, status, createdAt(sort: Desc), id(sort: Desc)], map: "task_owner_status_created_id_idx")
  @@index([ownerId, listId, createdAt(sort: Desc), id(sort: Desc)], map: "task_owner_list_created_id_idx")
  @@index([assigneeId])
  @@index([listId])
  /// "What is in this project" and "what are this task's subtasks" are the only two questions the
  /// new columns are read by, and each is one indexed lookup. Both are also the FKs' own lookup
  /// indexes, which is what keeps a project or parent delete from scanning the task table.
  @@index([projectId])
  @@index([parentTaskId])
  /// Cover GET /projects' page-wide rollup without visiting the wide Task heap (154 MB for 111k
  /// rows on the production workload). Created PARTIAL for project tasks in migration 0178; the
  /// schema cannot express that predicate, just like the two task-tree indexes below.
  @@index([ownerId, projectId, status, id, updatedAt], map: "task_project_rollup_covering_idx")
  /// The two reads `GET /projects/:id/tasks/page` makes: one project's top-level tasks, and one
  /// task's direct children, both in cursor order. They need SEPARATE indexes because the top
  /// level is `parent_task_id IS NULL` — an index scan key PostgreSQL can seek on but cannot
  /// carry an ordering past, so a shared index leaves that page sorting its whole level.
  ///
  /// Both are created PARTIAL (see migration 0108), which this schema cannot spell — as with
  /// `Session.retryAt`, whose index has been `WHERE retry_at IS NOT NULL` since 0081. The
  /// predicates are what make the root index able to order at all, and what keep both indexes off
  /// the six figures of tasks that are in no project.
  @@index([ownerId, projectId, createdAt(sort: Desc), id(sort: Desc)], map: "task_owner_project_root_created_id_idx")
  @@index([ownerId, projectId, parentTaskId, createdAt(sort: Desc), id(sort: Desc)], map: "task_owner_project_child_created_id_idx")
  @@index([status])
  /// The scheduled sweep's way in: the due tasks, in the order they came due. Created PARTIAL
  /// (`WHERE run_at IS NOT NULL`, see migration 0110) — a predicate this schema cannot spell, the
  /// same trade `session_quota_retry_at_idx` and 0108's pair already carry. It is what keeps the
  /// index sized to the scheduled tasks rather than to the six figures of tasks that are not.
  @@index([runAt], map: "task_run_at_idx")
  @@index([creatorType, creatorId])
  /// Both dispatcher questions about a verification — "is one already in flight for this
  /// subject" and "how many has it had" — key on this column.
  @@index([verifiesTaskId])
  /// "what replaced this" is the column; "what did this replace" is the index. The successor chain
  /// is walked in both directions — forward by a reader following one task to the attempt that is
  /// actually running, backward by the acyclicity trigger and by every list that wants to show a
  /// live task's abandoned predecessors.
  @@index([supersededByTaskId])
  /// The provenance columns' lookup indexes, and the referencing side of their three foreign keys —
  /// without them every project, task or session delete scans `task` to find the rows its SET NULL
  /// applies to. All three are created PARTIAL (`WHERE ... IS NOT NULL`, migration 0150), which
  /// this schema cannot spell, exactly as 0108's and 0110's are: the tasks with no provenance are
  /// most of the table and belong in none of them.
  @@index([discoveredFromProjectId], map: "task_discovered_from_project_idx")
  @@index([sourceTaskId], map: "task_source_task_idx")
  @@index([sourceSessionId], map: "task_source_session_idx")
  /// The tenancy fence `[K2]`'s two ledger tables hang off: a child row names BOTH the task and
  /// the owner, so it cannot disagree with its parent about whose it is. The same device migration
  /// 0120 used for (decision, project).
  @@unique([id, ownerId], map: "task_id_owner_id_key")
  @@map("task")
}

/// An explicit, immutable claim that structured completion evidence was submitted for a Task.
/// This is deliberately neither a Task status transition nor a TaskComment inference. Source ids
/// are snapshots rather than relations so execution retention cannot erase accepted provenance.
model TaskCompletionEvidence {
  id      String @id @default(uuid(7)) @db.Uuid
  taskId  String @map("task_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  task    Task   @relation(fields: [taskId, ownerId], references: [id, ownerId], onDelete: Cascade, map: "task_completion_evidence_task_fkey")

  actorType  CreatorType @map("actor_type")
  actorId    String      @map("actor_id") @db.Uuid
  submittedAt DateTime   @default(now()) @map("submitted_at")

  sourceSessionId String  @map("source_session_id") @db.Uuid
  sourceAttemptId String? @map("source_attempt_id") @db.Uuid

  criterionRevision String @map("criterion_revision") @db.Char(64)
  criterion         Json
  evidence          Json
  evidenceDigest    String @map("evidence_digest") @db.Char(64)
  revision          BigInt

  idempotencyKeys TaskCompletionEvidenceIdempotency[]
  judgmentRequests TaskJudgmentRequest[]
  legacyImport TaskLegacyEvidenceImport?

  @@unique([id, taskId], map: "task_completion_evidence_id_task_key")
  @@unique([id, taskId, criterionRevision, evidenceDigest], map: "task_completion_evidence_bound_fact_key")
  @@unique([taskId, revision], map: "task_completion_evidence_task_revision_key")
  @@unique([taskId, actorType, actorId, sourceSessionId, criterionRevision, evidenceDigest], map: "task_completion_evidence_stable_fact_key")
  @@index([taskId, submittedAt, id], map: "task_completion_evidence_task_submitted_idx")
  @@map("task_completion_evidence")
}

/// Caller retry keys are separate rows so distinct keys for the same stable fact both replay it.
model TaskCompletionEvidenceIdempotency {
  id             String @id @default(uuid(7)) @db.Uuid
  taskId         String @map("task_id") @db.Uuid
  idempotencyKey String @map("idempotency_key")
  evidenceId     String @map("evidence_id") @db.Uuid
  evidence       TaskCompletionEvidence @relation(fields: [evidenceId, taskId], references: [id, taskId], onDelete: Cascade, map: "task_completion_evidence_idempotency_evidence_fkey")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([taskId, idempotencyKey], map: "task_completion_evidence_idempotency_task_key")
  @@index([evidenceId], map: "task_completion_evidence_idempotency_evidence_idx")
  @@map("task_completion_evidence_idempotency")
}

/// The audit receipt for an explicit conversion of one historical TaskComment into one structured
/// evidence revision. No comment producer writes this table; only the user-authenticated import
/// path does, after the caller supplies the structured fact and a non-blank review note.
model TaskLegacyEvidenceImport {
  id      String @id @default(uuid(7)) @db.Uuid
  taskId  String @map("task_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  task    Task   @relation(fields: [taskId, ownerId], references: [id, ownerId], onDelete: Cascade, map: "task_legacy_evidence_import_task_fkey")

  evidenceId String @map("evidence_id") @db.Uuid
  evidence TaskCompletionEvidence @relation(fields: [evidenceId, taskId], references: [id, taskId], onDelete: Cascade, map: "task_legacy_evidence_import_evidence_fkey")

  sourceCommentId String @map("source_comment_id") @db.Uuid
  sourceComment TaskComment @relation(fields: [sourceCommentId, taskId], references: [id, taskId], onDelete: NoAction, map: "task_legacy_evidence_import_comment_fkey")
  /// An immutable provenance snapshot, deliberately not an FK: Session retention must not erase
  /// which execution the reviewer explicitly named as the source.
  sourceSessionId String @map("source_session_id") @db.Uuid
  sourceAuthorType CreatorType @map("source_author_type")
  sourceAuthorId String @map("source_author_id") @db.Uuid
  sourceCreatedAt DateTime @map("source_created_at")
  sourceDigest String @map("source_digest") @db.Char(64)
  structuredEvidenceDigest String @map("structured_evidence_digest") @db.Char(64)

  importedById String @map("imported_by_id") @db.Uuid
  importedBy User @relation(fields: [importedById], references: [id], onDelete: Restrict)
  importedAt DateTime @default(now()) @map("imported_at")
  idempotencyKey String @map("idempotency_key")
  reviewNote String @map("review_note")
  devicePolicy TaskJudgmentDevicePolicy @map("device_policy")

  @@unique([evidenceId, taskId], map: "task_legacy_evidence_import_evidence_key")
  @@unique([taskId, sourceCommentId], map: "task_legacy_evidence_import_source_key")
  @@unique([taskId, idempotencyKey], map: "task_legacy_evidence_import_idempotency_key")
  @@index([importedById, importedAt(sort: Desc)], map: "task_legacy_evidence_import_reviewer_idx")
  @@index([sourceSessionId], map: "task_legacy_evidence_import_source_session_idx")
  @@map("task_legacy_evidence_import")
}

/// One bounded operator invocation of the request backfill. The selection and push allowlist are
/// immutable input facts; all counters are filled in the same transaction as its request rows.
model TaskJudgmentBackfillBatch {
  id      String @id @default(uuid(7)) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  actorType CreatorType @map("actor_type")
  actorId String @map("actor_id") @db.Uuid
  idempotencyKey String @map("idempotency_key")
  inputDigest String @map("input_digest") @db.Char(64)
  batchSize Int @map("batch_size")
  pushTaskIds String[] @default([]) @map("push_task_ids") @db.Uuid
  selection Json
  startedAt DateTime @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  scannedCount Int? @map("scanned_count")
  requestCount Int? @map("request_count")
  inboxCount Int? @map("inbox_count")
  pushSelectedCount Int? @map("push_selected_count")
  pushSuppressedCount Int? @map("push_suppressed_count")
  durationMs BigInt? @map("duration_ms")

  requests TaskJudgmentRequest[]

  @@unique([ownerId, idempotencyKey], map: "task_judgment_backfill_batch_owner_key")
  @@index([ownerId, startedAt(sort: Desc)], map: "task_judgment_backfill_batch_owner_started_idx")
  @@map("task_judgment_backfill_batch")
}

/// A person's explicit judgment that the task's HUMAN_SIGNOFF criterion is satisfied.
///
/// This is an event, not a disguised status edit: signer, server timestamp and evidence are all
/// non-null, and the service derives Task.status from its existence in the same transaction.
model TaskHumanSignoff {
  id         String   @id @default(uuid(7)) @db.Uuid
  taskId     String   @unique @map("task_id") @db.Uuid
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestId  String   @unique @map("request_id") @db.Uuid
  request    TaskJudgmentRequest @relation(fields: [requestId, taskId, evidenceDigest], references: [id, taskId, evidenceDigest], onDelete: Restrict, map: "task_human_signoff_request_fact_fkey")
  signedById String   @map("signed_by_id") @db.Uuid
  signedBy   User     @relation(fields: [signedById], references: [id])
  evidenceDigest String @map("evidence_digest") @db.Char(64)
  evidence   String
  signedAt   DateTime @default(now()) @map("signed_at")

  @@unique([requestId, taskId, evidenceDigest], map: "task_human_signoff_request_fact_key")
  @@index([signedById, signedAt(sort: Desc)])
  @@map("task_human_signoff")
}

/// The durable question created for exactly one criterion snapshot and evidence digest.
///
/// `recipientId` is deliberately text: an account owner, Session and verifier Task are UUIDs
/// today, but the discriminator is the authority boundary and callers must never infer one kind
/// from another merely because their identifiers share a representation.
model TaskJudgmentRequest {
  id       String @id @default(uuid(7)) @db.Uuid
  taskId   String @map("task_id") @db.Uuid
  ownerId  String @map("owner_id") @db.Uuid
  task     Task   @relation(fields: [taskId, ownerId], references: [id, ownerId], onDelete: Cascade, map: "task_judgment_request_task_fkey")

  evidenceId       String @map("evidence_id") @db.Uuid
  criterionRevision String @map("criterion_revision") @db.Char(64)
  evidenceDigest    String @map("evidence_digest") @db.Char(64)
  evidence           TaskCompletionEvidence @relation(fields: [evidenceId, taskId, criterionRevision, evidenceDigest], references: [id, taskId, criterionRevision, evidenceDigest], onDelete: Restrict, map: "task_judgment_request_evidence_fact_fkey")

  kind          TaskCompletionCriterion
  recipientType TaskJudgmentRecipientType @map("recipient_type")
  recipientId   String @map("recipient_id")
  status        TaskJudgmentRequestStatus @default(OPEN)
  origin        TaskJudgmentRequestOrigin @default(LIVE_EVIDENCE)
  devicePolicy  TaskJudgmentDevicePolicy @default(IMMEDIATE) @map("device_policy")
  backfillBatchId String? @map("backfill_batch_id") @db.Uuid
  backfillBatch TaskJudgmentBackfillBatch? @relation(fields: [backfillBatchId], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now()) @map("created_at")
  decidedAt   DateTime? @map("decided_at")
  decidedByType String? @map("decided_by_type")
  decidedById String? @map("decided_by_id")
  decision    TaskJudgmentDecision?
  /// Human-readable audit for a human request conclusion. PASS keeps its richer review text on
  /// TaskHumanSignoff; INCONCLUSIVE requires this field and means "wait for a new evidence
  /// revision", never "change Task.status".
  decisionNote String? @map("decision_note")
  supersededAt DateTime? @map("superseded_at")
  supersededById String? @map("superseded_by_id") @db.Uuid
  supersededBy TaskJudgmentRequest? @relation("JudgmentRequestSupersession", fields: [supersededById], references: [id], onDelete: NoAction)
  supersedes TaskJudgmentRequest[] @relation("JudgmentRequestSupersession")
  /// Audit snapshots for the transition itself. `supersededById` names a successor request;
  /// these fields name the principal and Session that caused the transition and the rule applied.
  supersessionRule TaskJudgmentSupersessionRule? @map("supersession_rule")
  supersededActorType CreatorType? @map("superseded_actor_type")
  supersededActorId String? @map("superseded_actor_id") @db.Uuid
  supersededSourceSessionId String? @map("superseded_source_session_id") @db.Uuid

  executableResult TaskExecutableJudgmentResult?
  humanSignoff TaskHumanSignoff?
  inboxItems TaskJudgmentInboxItem[]

  @@unique([id, taskId, evidenceDigest], map: "task_judgment_request_id_task_digest_key")
  @@unique([taskId, criterionRevision, evidenceDigest, kind], map: "task_judgment_request_fact_key")
  @@index([taskId, status, createdAt(sort: Desc)], map: "task_judgment_request_task_status_idx")
  @@index([ownerId, recipientType, recipientId, status], map: "task_judgment_request_recipient_idx")
  @@index([supersededById], map: "task_judgment_request_superseded_by_idx")
  @@index([backfillBatchId], map: "task_judgment_request_backfill_batch_idx")
  @@map("task_judgment_request")
}

/// The reliable, in-app delivery of one HUMAN_SIGNOFF request to one concrete person.
///
/// Migration 0182 files this row from an AFTER INSERT trigger on `TaskJudgmentRequest`, in the
/// request's own transaction. `deliveredAt` is therefore the receipt for the reliable primary
/// channel: if the request commits, this row has already committed; if either insert fails, both
/// roll back. Titles, action and deep link are snapshots so the inbox remains an audit of what was
/// put in front of the recipient even if the task/project is renamed later.
model TaskJudgmentInboxItem {
  id             String @id @default(uuid(7)) @db.Uuid
  requestId      String @map("request_id") @db.Uuid
  requestVersion Int    @default(1) @map("request_version")
  request        TaskJudgmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  taskId         String @map("task_id") @db.Uuid
  ownerId        String @map("owner_id") @db.Uuid
  task           Task   @relation(fields: [taskId, ownerId], references: [id, ownerId], onDelete: Cascade)
  recipientId    String @map("recipient_id") @db.Uuid

  projectId     String? @map("project_id") @db.Uuid
  projectTitle  String? @map("project_title")
  taskTitle     String  @map("task_title")
  requiredAction String @map("required_action")
  deepLink       String @map("deep_link")
  createdAt      DateTime @default(now()) @map("created_at")
  deliveredAt    DateTime @default(now()) @map("delivered_at")

  pushDelivery TaskJudgmentPushDelivery?

  @@unique([requestId, requestVersion], map: "task_judgment_inbox_request_version_key")
  @@unique([id, requestId, requestVersion], map: "task_judgment_inbox_delivery_fkey")
  @@index([recipientId, deliveredAt(sort: Desc)], map: "task_judgment_inbox_recipient_idx")
  @@index([taskId, deliveredAt(sort: Desc)], map: "task_judgment_inbox_task_idx")
  @@map("task_judgment_inbox_item")
}

/// The retryable APNs projection of one in-app item.
///
/// There is one logical notification key per request/version. A worker lease prevents concurrent
/// sends; a stable APNs collapse id makes the unavoidable "APNs accepted, process died before the
/// receipt" replay replace the earlier banner rather than build a notification storm. `attempts`
/// counts every transport pass, while `failures` alone spends the DEAD budget: no device or an
/// unconfigured sender remains BLOCKED and can recover years later without losing the request.
model TaskJudgmentPushDelivery {
  id             String @id @default(uuid(7)) @db.Uuid
  inboxItemId    String @unique @map("inbox_item_id") @db.Uuid
  requestId      String @map("request_id") @db.Uuid
  requestVersion Int    @map("request_version")
  inboxItem      TaskJudgmentInboxItem @relation(fields: [inboxItemId, requestId, requestVersion], references: [id, requestId, requestVersion], onDelete: Cascade, map: "task_judgment_push_inbox_fkey")

  logicalNotificationKey String @unique @map("logical_notification_key")
  collapseId             String @map("collapse_id")
  status                  TaskJudgmentPushDeliveryStatus @default(PENDING)
  attempts                Int @default(0)
  failures                Int @default(0)
  /// Consecutive expired DELIVERING leases. Reset whenever a worker records an outcome.
  claims                  Int @default(0)
  nextAttemptAt           DateTime? @default(now()) @map("next_attempt_at")
  leaseHolder             String? @map("lease_holder")
  leaseExpiresAt          DateTime? @map("lease_expires_at")
  lastAttemptAt           DateTime? @map("last_attempt_at")
  errorCode               String? @map("error_code")
  requiredAction          String? @map("required_action")
  lastError               String? @map("last_error")
  lastPayload             Json? @map("last_payload")
  deliveredDevices        Int? @map("delivered_devices")
  deliveredAt             DateTime? @map("delivered_at")
  stoppedAt               DateTime? @map("stopped_at")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([nextAttemptAt, createdAt], map: "task_judgment_push_due_idx")
  @@index([status, updatedAt], map: "task_judgment_push_status_idx")
  @@unique([inboxItemId, requestId, requestVersion], map: "task_judgment_push_inbox_request_version_key")
  @@unique([requestId, requestVersion], map: "task_judgment_push_request_version_key")
  @@map("task_judgment_push_delivery")
}

