/// One digest-bound owner question. CTA identity/generation make stale, expired and duplicate
/// answers safe instead of relying on whichever row happens to render first.
model ProjectOwnerDecisionRequest {
  id                     String    @id @db.Uuid
  projectId              String    @map("project_id") @db.Uuid
  ownerId                String    @map("owner_id") @db.Uuid
  contractDigest         String    @map("contract_digest") @db.Char(64)
  contractRevision       BigInt    @map("contract_revision")
  requestGeneration      BigInt    @map("request_generation")
  kind                   String    @default("OWNER_RATIFICATION")
  status                 String    @default("PENDING")
  reasonCode             String    @map("reason_code")
  previousContractDigest String?   @map("previous_contract_digest") @db.Char(64)
  semanticDiff           Json      @default("{}") @map("semantic_diff")
  decisionPayload        Json      @map("decision_payload")
  ctaToken               String    @unique @map("cta_token") @db.Uuid
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Terminal owner answer plus its replay identity. Kept on the exact request so DENY has the
  /// same recoverable network-retry semantics as an append-only APPROVE ratification.
  decision               String?
  decisionIdempotencyKey String?   @map("decision_idempotency_key")
  decidedAt              DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedByType          String?   @map("decided_by_type")
  decidedById            String?   @map("decided_by_id")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([projectId, requestGeneration])
  @@unique([ownerId, decisionIdempotencyKey], map: "project_owner_decision_idempotency_key")
  @@index([ownerId, status, createdAt(sort: Desc)], map: "project_owner_decision_inbox_idx")
  @@map("project_owner_decision_request")
}

