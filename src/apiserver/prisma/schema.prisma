// Orbit control-plane data model. See src/shared/src/enums.ts for the
// TypeScript mirrors of these enums (kept in sync by string value).
//
// DB-level table/column/enum names are mapped to snake_case via @@map/@map to
// follow PostgreSQL conventions. Prisma Client field names stay camelCase, so
// application code is unaffected; only raw SQL references the mapped names.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  // Interactive sessions (Route B). Appended last to match ALTER TYPE ADD VALUE.
  AWAITING_INPUT
  INTERRUPTED
  // NOTE: the `run_status` DB type still carries a now-unused 'PARKED' label — Postgres has
  // no ALTER TYPE ... DROP VALUE, and rebuilding the type would rewrite/lock `session`. It is
  // absent here on purpose: migration 0071 backfilled every PARKED row to CANCELLED and no
  // code path writes it any more, so no row can carry a value this enum can't decode.

  @@map("run_status")
}

enum RunnerStatus {
  ONLINE
  OFFLINE
  DRAINING

  @@map("runner_status")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
  FAILED

  @@map("task_status")
}

/// Where a project stands as a piece of work: still being pursued, achieved, or abandoned.
///
/// A business lifecycle, deliberately mirroring `TaskStatus`'s vocabulary rather than inventing a
/// second one — a project and its tasks are the same kind of claim at different scales, and
/// "DONE" has to mean the same thing at both or a coordinator cannot roll one up into the other.
///
/// Filing (archive / hide / pin) is NOT expressed here and must not be added here. That is a
/// statement about a reader's list, not about the work: a cancelled project someone still wants
/// on screen and a finished one they have put away are independent facts, and collapsing them
/// into one column makes each unable to be recorded without overwriting the other. `Session`
/// already keeps the two apart (`RunStatus` beside `completedAt`/`deletedAt`) and this follows it.
enum ProjectStatus {
  OPEN
  DONE
  CANCELLED

  @@map("project_status")
}

/// How far a project's coordinator may act on its own — the user's authorization level, not a
/// switch for the control loop (that is `Project.coordinatorEnabled`).
///
/// MANUAL still reconciles, still records what the next step would be and still raises blockers;
/// it just turns every step that would change something into a request for approval. So "I turned
/// automation off" and "it is broken" stay distinguishable on the control plane, which is the
/// whole reason this is a level rather than a second off switch.
///
/// The COLUMN default is MANUAL and the default for a NEWLY CREATED project is GUARDED_AUTO;
/// those are two different values on purpose (see `Project.automationPolicy`).
enum ProjectAutomationPolicy {
  MANUAL
  GUARDED_AUTO
  AUTO

  @@map("project_automation_policy")
}

/// The orchestration loop's derived state. This is deliberately separate from ProjectStatus:
/// ProjectStatus describes the work, while this enum describes why the control loop is (or is
/// not) able to advance it right now.
enum ProjectRunState {
  PLANNING
  EXECUTING
  AWAITING_VERIFICATION
  BLOCKED
  AWAITING_HUMAN
  ACCEPTANCE
  SETTLED

  @@map("project_run_state")
}

/// A durable action is first claimed and then published into exactly one terminal state.
enum ProjectActionStatus {
  CLAIMED
  APPLIED
  REFUSED
  SUPERSEDED

  @@map("project_action_status")
}

/// Closed set of side-effecting orchestration actions. SCHEDULE_WAKE, NOOP and parent aggregation
/// are current-state writes/audit outcomes rather than permanent-ledger entries.
enum ProjectActionType {
  DISPATCH_TASK
  OPEN_COORDINATOR_TURN
  ROTATE_COORDINATOR_SESSION
  RAISE_BLOCKER
  CLEAR_BLOCKER
  APPLY_VERIFICATION_VERDICT
  REQUEST_APPROVAL
  RUN_PROJECT_ACCEPTANCE
  FILE_VERIFICATION_TASK

  @@map("project_action_type")
}

/// Which scheduler is currently authorized to create a task-bound Session. This is a database-
/// maintained projection of Project.coordinatorEnabled, not a second policy setting.
enum TaskDispatchAuthority {
  LEGACY
  COORDINATOR

  @@map("task_dispatch_authority")
}

/// The authority under which a task-bound Session was inserted. Kept separate from runSource:
/// runSource is product provenance, while this column is consumed by the database authorization
/// trigger during mixed-version deployment.
enum SessionDispatchOrigin {
  USER
  PROJECT_COORDINATOR
  LEGACY_SWEEP

  @@map("session_dispatch_origin")
}

/// User-visible/auditable provenance for a Session start. Existing create paths keep MANUAL;
/// Task List dependency/schedule sweeps opt into TASK_LIST_AUTO, and only the Project dispatcher
/// may write PROJECT_COORDINATOR.
enum SessionRunSource {
  MANUAL
  TASK_LIST_AUTO
  PROJECT_COORDINATOR

  @@map("session_run_source")
}

/// What an agent is to a project it is on the team of. COORDINATOR is the identity that decides
/// what this project does next; MEMBER is an agent the coordinator may hand work to.
enum ProjectRole {
  COORDINATOR
  MEMBER

  @@map("project_role")
}

/// Where a project's coordinator identity came from, and therefore who may change it.
///
/// DERIVED means the database worked it out from the project's coordination workspace and may work
/// it out again — that is what lets a landing that moves take its identity with it (migration 0113,
/// validation 04R). EXPLICIT means a person chose it, including choosing to have none, and no
/// mechanical re-derivation may replace it (migration 0114, validation 04R2 P1-04R2-01): WHO and
/// WHERE are two independent chains (PAC R3), so one must not be re-inferred from the other.
enum ProjectIdentitySource {
  DERIVED
  EXPLICIT

  @@map("project_identity_source")
}

/// How a parent task decides it is finished (contract AC7 / §13.1).
///
/// MANUAL is the column default and the historical behaviour: nothing but a person or an agent
/// writing the status ever completes the task. The other two make the parent's status a
/// RECOMPUTATION over its direct children, which is what removes the hand-maintained roll-up node
/// — and, because it is a recomputation rather than an accumulation, what makes a reopened child
/// pull its parent back open instead of leaving it stuck DONE.
///
/// The policy is inert on a task with no children. "Every one of zero children is done" is true
/// and useless, and honouring it would let setting a policy complete a leaf that nobody did.
enum TaskCompletionPolicy {
  MANUAL
  ALL_CHILDREN_DONE
  VERIFICATION_PASSED

  @@map("task_completion_policy")
}

/// The structured conclusion a verification task reached about the task it verifies (§13.2 V1).
///
/// It lives on the VERIFIER's row, beside `verifiesTaskId`, because that row is the thing that has
/// a conclusion; the verified task has a status, which is a different claim. NULL means the check
/// has not concluded, and — deliberately — is not PASS: `VERIFICATION_PASSED` reads this column
/// fail-closed, so a verification task that merely finished never completes its subject.
///
/// The value alone is not the whole of a conclusion: `verdictRevision` beside it says WHICH
/// conclusion it is, and that is what §13.2's mechanical consequences — the native revert, the
/// defect subtask, the downstream block — are keyed on. A verdict can return to a value it already
/// held, so it could never have been the key itself.
enum TaskVerdict {
  PASS
  FAIL
  INCONCLUSIVE

  @@map("task_verdict")
}

/// The one fact that is allowed to settle a task's own work.
///
/// These are peers, not a fallback chain. HUMAN_SIGNOFF is the ordinary compatibility default for
/// tasks created before this distinction existed; it does not mean that executable or verification
/// acceptance failed and escalated to a person.
enum TaskCompletionCriterion {
  EXECUTABLE
  VERIFICATION
  HUMAN_SIGNOFF

  @@map("task_completion_criterion")
}

/// Admission and process termination are independent axes. A rejected plan never has an attempt;
/// a process termination exists only after an admitted runner crossed the spawn boundary.
enum ExecutableAcceptanceAdmissionDecision {
  ADMITTED
  REJECTED

  @@map("executable_acceptance_admission_decision")
}

enum ExecutableAcceptanceTerminationKind {
  EXITED
  TIMED_OUT
  CANCELLED
  SIGNALED
  START_FAILED
  INFRASTRUCTURE_LOST

  @@map("executable_acceptance_termination_kind")
}

enum ExecutableAcceptanceLegacyTermination {
  UNTYPED

  @@map("executable_acceptance_legacy_termination")
}

enum ExecutableAcceptanceContinuationKind {
  RETRY
  DIAGNOSIS
  SUCCESSOR

  @@map("executable_acceptance_continuation_kind")
}

/// Lifecycle of one evidence-bound request for a criterion decision. It is monotonic: OPEN may
/// become DECIDED or SUPERSEDED, and neither terminal fact is rewritten or reopened.
enum TaskJudgmentRequestStatus {
  OPEN
  DECIDED
  SUPERSEDED

  @@map("task_judgment_request_status")
}

/// Why an OPEN judgment request stopped being actionable without being decided. Evidence
/// revisions point at their successor; TASK_ALREADY_DONE and VERIFIER_ROLE are terminal rules
/// with no successor. VERIFIER_ROLE closes a legacy check-of-check request after the task's own
/// verdict is established as the verifier carrier's completion fact.
enum TaskJudgmentSupersessionRule {
  EVIDENCE_REVISED
  TASK_ALREADY_DONE
  VERIFIER_ROLE

  @@map("task_judgment_supersession_rule")
}

/// How a request entered the durable judgment ledger. BACKFILL is never a migration side effect:
/// it always names the separately invoked, bounded batch row that selected it.
enum TaskJudgmentRequestOrigin {
  LIVE_EVIDENCE
  LEGACY_IMPORT
  BACKFILL

  @@map("task_judgment_request_origin")
}

/// Whether the reliable in-app delivery also becomes due APNs work. IN_APP_ONLY still receives a
/// terminal device-ledger receipt so suppression is an auditable fact rather than a missing row.
enum TaskJudgmentDevicePolicy {
  IMMEDIATE
  IN_APP_ONLY

  @@map("task_judgment_device_policy")
}

/// The concrete principal that owns the next decision. These are peers selected from the task's
/// declared criterion; no row moves from one recipient type to another as a fallback.
enum TaskJudgmentRecipientType {
  SYSTEM_EXECUTABLE_EVALUATOR
  VERIFIER_TASK
  ACCOUNT_OWNER

  @@map("task_judgment_recipient_type")
}

/// A request conclusion. PASS is the only optimistic conclusion; the other two remain durable
/// evidence without manufacturing Task.status DONE.
enum TaskJudgmentDecision {
  PASS
  FAIL
  INCONCLUSIVE

  @@map("task_judgment_decision")
}

/// What happened to the retryable device projection of one durable in-app judgment item.
/// PENDING/BLOCKED may be retried, DELIVERING is leased, and the remaining three values are
/// terminal receipts. CANCELLED means the request was decided or superseded before delivery; it
/// is deliberately different from DEAD, which means the delivery budget itself was exhausted.
enum TaskJudgmentPushDeliveryStatus {
  PENDING
  DELIVERING
  DELIVERED
  BLOCKED
  DEAD
  CANCELLED

  @@map("task_judgment_push_delivery_status")
}

// Who/what authored a Task. The creator is a polymorphic reference (no FK),
// so a Task can be created by a user or by an agent (agent-spawned subtasks).
enum CreatorType {
  USER
  AGENT

  @@map("creator_type")
}

model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  email                 String    @unique
  name                  String
  passwordHash          String    @map("password_hash")
  createdAt             DateTime  @default(now()) @map("created_at")
  // Per-account UI preferences (theme, new-agent defaults). Shape: UserPreferences
  // (@orbit/shared). JSON so new keys need no migration; missing keys fall back.
  preferences           Json      @default("{}")
  // Access role. MEMBER (default) for everyone; ADMIN unlocks the user-management area.
  role                  String    @default("MEMBER")
  // DEPRECATED, unread: a Claude subscription token (`claude setup-token`) the control plane used
  // to hold and inject on every runner. Claude now authenticates per runner — a session that finds
  // no local login surfaces the sign-in card (RunnerSignIn) — so nothing writes or reads these.
  // The columns stay until a migration drops them, so any token already stored isn't destroyed by
  // the code change alone.
  claudeOauthTokenEnc   String?   @map("claude_oauth_token_enc")
  claudeOauthTokenSetAt DateTime? @map("claude_oauth_token_set_at")

  workspaces       Workspace[]
  runners          Runner[]
  enrollmentTokens EnrollmentToken[]
  serviceTokens    ServiceToken[]
  ownedSessions    Session[]         @relation("SessionOwner")
  createdSessions  Session[]         @relation("SessionCreator")
  ownedTasks       Task[] // tasks this user owns (tenant scope)
  taskLists        TaskList[] // task lists this user owns (tenant scope)
  projects         Project[] // projects this user owns (tenant scope)
  attachments      Attachment[] // blobs this user uploaded (tenant scope)
  deviceTokens     DeviceToken[] // registered iOS devices for APNs push
  modelProviders   ModelProvider[] // personal (BYOK) model providers
  sessionTags      SessionTag[] // personal colored session labels (tenant scope)
  refreshTokens    RefreshToken[] // long-lived rotating refresh tokens (hashed at rest)
  clientVersions   ClientVersion[] // which build of each client this user is running
  mergeReceipts    SessionMergeReceipt[] // merges recorded against this user's session branches
  agents           Agent[] // Agent identities this user owns (tenant scope)

  /// Presses of Run Now this user made, and the receipts of their requests (0137).
  runRequests       TaskRunRequest[]

  /// Cross-project crossings recorded under this account (unit L4, 0155).
  handoffApprovals ProjectHandoffApproval[]

  /// Human completion judgments authored by this person. The event carries its own signer rather
  /// than borrowing Task.ownerId so the audit answers who actually signed.
  taskHumanSignoffs TaskHumanSignoff[]
  legacyEvidenceImports TaskLegacyEvidenceImport[]
  judgmentBackfillBatches TaskJudgmentBackfillBatch[]

  @@map("user")
  mentionDeliveries TaskCommentMentionDelivery[]
}

/// A long-lived opaque refresh token a client swaps for a fresh short-lived access JWT via
/// POST /api/auth/refresh, so an active client is never forced to re-login while the access
/// token stays short-lived. Only the SHA-256 hash of the token is stored (never the token
/// itself). Rotating: each refresh sets `revokedAt` on the presented row and issues a new one;
/// replaying an already-revoked row signals theft → the user's whole family is revoked. Logout
/// revokes the presented token. Rows cascade-delete with the user.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  // Non-null once the token is consumed (rotated) or revoked (logout / theft-triggered family
  // kill); a dead token presented again is treated as replay.
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("refresh_token")
}

/// An iOS device's APNs token, owner-scoped, so the server can push "needs your reply" alerts to a
/// user's phones/iPads. One row per device (`token` unique) — re-registering upserts, and a token
/// handed to a different user re-points its `userId`. `environment` selects the APNs host
/// (production for App Store/TestFlight, sandbox for dev builds). Registered via POST /api/push/register.
model DeviceToken {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  platform    String   @default("ios")
  environment String   @default("production")
  bundleId    String   @map("bundle_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("device_token")
}

/// Which build of each client a user is actually running, so "has every client in the field
/// upgraded past X?" is a query instead of a guess.
///
/// It exists because the answer is currently unknowable. `WorkspaceAliasInterceptor` carries a
/// compatibility shim whose own comment says to delete it "once every client in the field speaks
/// `workspace*`" — and nothing in the system can tell you when that became true, so it is still
/// running. Runners are the one client already covered (`Runner.version`, reported in the
/// heartbeat); a browser tab nobody reloaded and a TestFlight build from last month were not
/// covered by anything. Every wire-format migration after this one needs the same gate, so the
/// data has to start accumulating BEFORE the migration that will consume it — measuring the tail
/// only once you want to cut it means waiting a full upgrade cycle to see it.
///
/// One row per (user, client kind): the question is "what is this user's iOS app on", and a user
/// with a current browser and a stale phone must show up as stale. Runners are deliberately NOT
/// written here — `Runner.version` already answers for them, and a second source of truth for the
/// same fact is how the two disagree later.
model ClientVersion {
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'web' | 'ios' | 'macos' — the client kind, from the `X-Orbit-Client` header.
  kind       String
  version    String
  lastSeenAt DateTime @updatedAt @map("last_seen_at")

  @@id([userId, kind])
  @@map("client_version")
}

// A machine the user registered via `orbit register`. Claude Code runs here.
model Runner {
  id                String       @id @default(uuid(7)) @db.Uuid
  name              String
  // User-set friendly name shown in the UI. `name` stays the machine-reported
  // identity used to match re-registrations, so renaming never creates a dup.
  displayName       String?      @map("display_name")
  hostname          String?
  ownerId           String       @map("owner_id") @db.Uuid
  owner             User         @relation(fields: [ownerId], references: [id])
  labels            String[]     @default([])
  status            RunnerStatus @default(OFFLINE)
  maxConcurrent     Int          @default(1) @map("max_concurrent")
  // Free-space floor, in MB, below which this machine takes no new auto-run work. Null (the
  // default) leaves the gate off, which is the behaviour every runner had before it existed.
  // One knob per machine, but evaluated against each workspace's own measured filesystem —
  // "keep this much headroom wherever you are writing" is the same policy on every mount.
  minFreeDiskMb     Int?         @map("min_free_disk_mb")
  version           String?
  tokenHash         String       @map("token_hash") // hash of the long-lived runner credential
  lastHeartbeatAt   DateTime?    @map("last_heartbeat_at")
  enrolledAt        DateTime     @default(now()) @map("enrolled_at")
  // User-defined display order shared by the sidebar and Runners page. NULL keeps
  // newly enrolled runners after explicitly positioned ones until the next reorder.
  position          Int?         @map("position")
  // Slash commands / skills the runner discovered on its disk, reported via
  // heartbeat and surfaced to the web composer's `/` autocomplete. Arrays of
  // { name, description?, type? } (mirrors @orbit/shared SlashCommandInfo).
  availableCommands Json?        @map("available_commands")
  availableSkills   Json?        @map("available_skills")
  // Latest provider quota for the account(s) this runner uses, reported via heartbeat.
  // Shape mirrors @orbit/shared PlanUsage.
  planUsage         Json?        @map("plan_usage")
  // Runtime model catalog reported via heartbeat (for example Codex `debug models`).
  modelCatalog      Json?        @map("model_catalog")
  // Declarative scheduler capabilities. NULL reported-at means an old runner: it remains eligible
  // for an empty requirement set, but can never prove a non-empty requirement.
  capabilities           String[]  @default([])
  capabilitiesReportedAt DateTime? @map("capabilities_reported_at")
  // EXECUTABLE v2 is advertised separately from the open-ended capability tokens because its
  // numeric hard maximum participates in admission. All four fields move in one heartbeat write;
  // NULL is an N-1 runner and can never prove a v2-bound plan.
  acceptanceRuntimeSchemaRevision     Int?      @map("acceptance_runtime_schema_revision")
  acceptanceRuntimeCapabilityRevision Int?      @map("acceptance_runtime_capability_revision")
  acceptanceRuntimeHardMaxSeconds      Int?      @map("acceptance_runtime_hard_max_seconds")
  acceptanceRuntimeReportedAt          DateTime? @map("acceptance_runtime_reported_at")
  // Effective default reported by each built-in runtime on this machine. Heartbeat-owned cache,
  // kept separate from modelCatalog because availability and selected-default are independent.
  // Shape: { "claude": "claude-opus-5", "codex": "gpt-5.6-sol", ... }.
  runtimeDefaultModels Json?     @map("runtime_default_models")
  // Whether this runner's process is root, reported each heartbeat. Capability state, not a
  // setting: Claude Code refuses Bypass under root and exits before its first message, so this is
  // what lets the pickers and dispatch withdraw that one mode (ROOT_REFUSED_PERMISSION_MODES).
  // NULL means a runner too old to report it, which stays unrestricted — "we don't know" must not
  // remove a mode that works today.
  runsAsRoot        Boolean?     @map("runs_as_root")
  // Where this machine puts checkouts Orbit clones for it, reported each heartbeat. A clone of
  // `<owner>/<repo>` lands at `<reposRoot>/<owner>-<repo>`.
  // NULL means this runner has never reported one — a build too old to send it. That withdraws
  // the create-from-a-git-URL path for this machine instead of inventing a root: a guessed path
  // is a checkout written somewhere the user never agreed to put one.
  reposRoot         String?     @map("repos_root")
  // State of the shared checkouts this machine's agents work in, reported each heartbeat.
  // Array of @orbit/shared RunnerRepoHealth. Session worktrees are isolated; the checkout they
  // fork from and merge into is not, so a half-finished merge left there blocks every merge on
  // this runner — this is how the UI gets to say that once instead of per failing session.
  repoHealth        Json?        @map("repo_health")
  // One-slot repair relay for the checkout above, same shape as the sign-in/install relays: a
  // machine repairs one checkout at a time and the request is redelivered until the runner reports.
  //   NULL            — nothing in flight
  //   pending         — user asked; the next heartbeat tells the runner to do it
  //   done | failed   — terminal; repoCleanupMessage explains, and names the rescue branch
  repoCleanupStatus  String?     @map("repo_cleanup_status")
  repoCleanupRoot    String?     @map("repo_cleanup_root")
  // Branch holding the checkout's content as it was before the repair. Kept after the relay ends:
  // it is the only pointer a user has back to whatever was in that tree.
  repoCleanupBranch  String?     @map("repo_cleanup_branch")
  repoCleanupMessage String?     @map("repo_cleanup_message")
  repoCleanupAt      DateTime?   @map("repo_cleanup_at")

  executableAcceptanceAdmissions TaskExecutableAdmission[]
  executableRuntimeHeartbeats     ExecutableRuntimeHeartbeat[]

  // Browser-less sign-in relay for this machine's built-in runtime CLI. The runner drives the CLI
  // on its own machine while the user approves in their own browser, so a machine with no
  // terminal access can still be signed in. State, not history: one sign-in at a time per
  // runner, since each CLI writes that machine's single credentials file.
  //   NULL       — nothing in flight
  //   pending    — user asked to sign in; the next heartbeat tells the runner to start
  //   awaiting_code — loginUrl holds the link to approve; loginCode carries the user's paste
  //   awaiting_approval — device flow (codex/kimi): loginUrl + loginUserCode are what the user
  //                       enters in the browser; nothing comes back through us
  //   done | failed — terminal, loginMessage explains a failure
  loginStatus   String?   @map("login_status")
  // Which CLI the relay is driving: 'claude' | 'codex'. NULL on a row written before the relay
  // handled more than claude.
  loginEngine   String?   @map("login_engine")
  loginUrl      String?   @map("login_url")
  // The device flow's one-time code, which the user types on loginUrl's page. Runner → user,
  // the opposite direction from loginCode.
  loginUserCode String?   @map("login_user_code")
  // The pasted authorization code, cleared as soon as the heartbeat hands it to the runner. It
  // is single-use and worthless without the PKCE verifier, which never leaves the runner.
  loginCode     String?   @map("login_code")
  loginMessage  String?   @map("login_message")
  // When the current relay started, so an abandoned one can be timed out.
  loginAt       DateTime? @map("login_at")

  // Per-engine health on this machine — installed / version / signed in — reported by heartbeat
  // from the same probe `orbit doctor` prints. Shape: @orbit/shared RunnerEngineHealth[].
  engines        Json?     @map("engines")

  // Browser-driven install of one engine CLI, the same one-slot relay shape as the sign-in above
  // (a machine installs one CLI at a time; the request is redelivered until the runner reports).
  //   NULL       — nothing in flight
  //   pending    — user asked; the next heartbeat tells the runner to start
  //   installing — the runner started the installer; installCommand is what it is running
  //   done | failed — terminal, installMessage explains a failure
  installStatus  String?   @map("install_status")
  installEngine  String?   @map("install_engine")
  installCommand String?   @map("install_command")
  installMessage String?   @map("install_message")
  installAt      DateTime? @map("install_at")
  // Which job the slot is running: 'install' (installEngine's CLI) or 'update' (every CLI already
  // on the machine — installEngine is then NULL). Both run a package manager against this
  // machine's one global prefix, so they share a slot instead of racing. NULL = 'install'.
  installMode    String?   @map("install_mode")

  sessions Session[]
  // Workspaces `orbit register` minted for this machine (one per project dir + tool).
  workspaces Workspace[]
  // Narrow, revocable credentials minted for headless processes on this machine.
  serviceTokens ServiceToken[]

  @@index([ownerId])
  @@map("runner")
}

// A long-lived credential for a HEADLESS process on one machine — a launchd/cron bridge that
// belongs to no session, so it can hold none of the session-bound proofs orchestration uses.
//
// Deliberately not the runner credential: that one sits in plaintext in ~/.orbit/config.json and
// is what the machine authenticates every claim with, so promoting it to "may spawn any agent
// with any prompt" would make a config leak equal arbitrary execution. A service token instead
// enumerates exactly what it may do, may be pinned to a single agent, expires on its own, and is
// revoked individually without re-registering the machine.
//
// The token itself is a signed JWT whose `jti` is this row's id — nothing secret is stored here,
// so a database leak cannot yield a usable credential. This row is the revocation list and the
// audit record: `lastUsedAt` says whether the thing is still in use before anyone revokes it.
model ServiceToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // The machine this token acts on. Its reach never crosses to another runner's sessions.
  runnerId   String    @map("runner_id") @db.Uuid
  runner     Runner    @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  // Optional single-workspace pin. Required when the token may create sessions, so a leaked
  // bridge token can only ever start sessions in the one workspace it was minted for.
  workspaceId String?  @map("workspace_id") @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Human label shown by `orbit token list`, so an unused token can be identified before revoking.
  label      String?
  // Enumerated capabilities: session:get | session:list | session:send | session:create. The
  // destructive verbs (end/interrupt/merge/complete) are deliberately not representable.
  scopes     String[]  @default([])
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([runnerId])
  @@index([ownerId])
  @@map("service_token")
}

// One-time token a user generates in the UI and passes to `orbit register`.
model EnrollmentToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  ownerId   String    @map("owner_id") @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id])
  label     String?
  expiresAt DateTime? @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("enrollment_token")
}

// A pending `orbit register` device-login session (RFC 8628-style browser flow).
// The CLI polls with the secret deviceCode; a logged-in user approves the machine
// in the browser by the short, human-typable userCode.
model DeviceEnrollment {
  id             String    @id @default(uuid(7)) @db.Uuid
  deviceCodeHash String    @unique @map("device_code_hash") // hash of the secret the CLI polls with
  userCode       String    @unique @map("user_code") // short code shown in the browser + terminal
  name           String
  hostname       String?
  labels         String[]  @default([])
  maxConcurrent  Int       @default(1) @map("max_concurrent")
  version        String?
  status         String    @default("PENDING") // PENDING | APPROVED
  // Agent (coding-tool) keys requested at device/start; approval mints one Runner
  // for the machine (named by hostname) and one Agent per key (named `<name>/<key>`).
  agents         String[]  @default([])
  // The project directory the minted agents run in (claude's cwd), from the CLI.
  workDir        String?   @map("work_dir")
  runnerId       String?   @map("runner_id") @db.Uuid // the machine runner minted on approval
  runnerToken    String?   @map("runner_token") // raw runner credential, delivered to the CLI once then cleared
  // The minted agents [{agentKey,agentId,name,workDir}], delivered to the CLI once
  // on poll then wiped (mirrors runnerToken above). Column kept named `runners`.
  mintedAgents   Json?     @map("runners")
  approvedById   String?   @map("approved_by_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("device_enrollment")
}

/// Where a Workspace's `workDir` is in its lifecycle. Only the create-from-a-git-remote path can
/// leave READY: it inserts the row CLONING, and the runner's result moves it to READY or FAILED.
///
///   READY   — the directory is on the machine and usable. Every workspace that predates this
///             column, and every one made from a path the user already had, is born here.
///   CLONING — a clone job is in flight; the directory is not usable yet.
///   FAILED  — the clone did not finish. `Workspace.provisionError` holds git's stderr verbatim.
///
/// NOT NULL with a READY default, and no UNKNOWN member, on purpose. `Workspace.repoUrl`'s NULL is
/// already this model's one "nobody told us"; a second spelling of it here would make every reader
/// ask which of the two a given row means.
enum WorkspaceProvisionState {
  READY
  CLONING
  FAILED

  @@map("workspace_provision_state")
}

// A workspace: one checkout on one machine, plus how to branch and merge inside it.
//
// It is a PLACE, not an actor — the actor is the Session (one live coding-runtime process) and
// the body of work is the Task graph. Everything that is a policy decision rather than a
// property of the checkout lives elsewhere on purpose: the permission posture is per-run
// (Session.permissionMode) with an account-level default (UserPreferences.defaultPermissionMode),
// and tool allowlists / MCP servers are machine or account concerns, not directory ones.
model Workspace {
  id                  String    @id @default(uuid(7)) @db.Uuid
  name                String
  description         String?
  // A workspace holds no provider: it names a machine and a project directory, while the provider
  // is a per-session binding (Session.provider, fixed for that session's lifetime). The default a
  // new session inherits is derived from what this workspace last ran — see
  // workspaces/workspace-provider.ts.
  // Legacy per-workspace model pin. New sessions resolve from their Runtime/ModelProvider; migration
  // 0079 copied old pins into existing sessions. Temporarily retained as a rolling-deploy bridge
  // for model-less sessions written by old replicas; first claim snapshots it onto Session.model.
  model               String?
  appendSystemPrompt  String?   @map("append_system_prompt")
  systemPrompt        String?   @map("system_prompt")
  disallowedTools     Json      @default("[]") @map("disallowed_tools")
  // Explicit, ordered Project-dispatch fallback. Empty is the safety default: Provider
  // unavailability is reported, never silently resolved from whatever else the fleet can run.
  providerFallbacks   Json      @default("[]") @map("provider_fallbacks")
  // Project-scoped Coordinator permissions. These are human-authored Agent properties; runner
  // registration/update endpoints deliberately cannot set them.
  canCreateTasks      Boolean   @default(false) @map("can_create_tasks")
  canDelegate         Boolean   @default(false) @map("can_delegate")
  // Optional admission cap for this Agent's Project tasks. NULL preserves legacy behaviour.
  maxConcurrentTasks  Int?      @map("max_concurrent_tasks")
  // Default reasoning effort a new session inherits when its create request omits one
  // ('' / null = the model's default). Claude: low|medium|high|xhigh|max; codex adds minimal.
  effort              String?   @map("effort")
  // routing: bind to a specific runner and/or match runner labels
  targetRunnerId      String?   @map("target_runner_id") @db.Uuid
  targetLabels        String[]  @default([]) @map("target_labels")
  // The machine (Runner) this workspace lives on, set when `orbit register` mints it;
  // null for hand-made config workspaces. Cascade so unregistering a machine drops them.
  runnerId            String?   @map("runner_id") @db.Uuid
  runner              Runner?   @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  // The project directory the runtime runs in for this workspace, and its coding-tool key.
  workDir             String?   @map("work_dir")
  // The git remote this workspace's `workDir` was cloned from, when Orbit created it from a repo
  // URL. NULL means nobody ever told us — a workspace `orbit register` minted from a directory
  // that was already there, or one hand-made in the config form. Those are deliberately NOT
  // backfilled from the checkout's own `origin`: at every later read a guessed remote is
  // indistinguishable from a recorded one, and this column exists to be trusted.
  repoUrl             String?   @map("repo_url")
  // Where the directory is in its lifecycle — see WorkspaceProvisionState for why it cannot be
  // NULL and has no UNKNOWN.
  provisionState      WorkspaceProvisionState @default(READY) @map("provision_state")
  // Git's own stderr from the clone that failed, stored verbatim: no summarising, no rewriting,
  // no mapping onto an Orbit vocabulary. What git said about a bad URL or a missing credential is
  // the only text that tells the user what to change. NULL unless provisionState is FAILED.
  provisionError      String?   @map("provision_error")
  // Custom environment variables injected into this workspace's runtime process (string map).
  env                 Json?     @map("env")
  agentKey            String?   @map("agent_key")
  enabled             Boolean   @default(true)
  // When workDir is NOT a git repo, the runner auto-`git init`s it (default .gitignore +
  // baseline commit) on the next claim so its sessions can be worktree-isolated. Opt-in
  // per workspace — the web "Enable isolation" action on a non-git run flips this on.
  autoInitGit         Boolean   @default(false) @map("auto_init_git")
  // Whether this workspace's sessions each run in their own per-session git worktree. Default off,
  // so a new workspace's sessions run directly in workDir with no isolation unless the user opts
  // in. Off → a session gets no `branch` and the runner runs it directly in workDir with no
  // worktree (the workspace's concurrent sessions then share one working tree); the
  // merge/commit/diff machinery is skipped since there's no isolated branch.
  enableWorktree      Boolean   @default(false) @map("enable_worktree")
  // Opt-in per workspace (default off): may this workspace's in-session coding agent spawn and
  // manage OTHER sessions via the `orbit mcp` session_* tools (L3 orchestration)? Off → those
  // tools aren't exposed and the runner-token spawn endpoint refuses.
  enableOrchestration Boolean   @default(false) @map("enable_orchestration")
  // The branch this workspace's sessions merge into by default, remembered from the last time the
  // user switched targets in the status bar's merge dropdown. Null → the runner's auto-detect
  // (main, else master). Workspace-scoped so a chosen target sticks across all its sessions.
  defaultMergeTarget  String?   @map("default_merge_target")
  // What the runner last saw at `workDir` on its own disk, refreshed each heartbeat. The config
  // form reads these to say whether the path is actually there and whether it can be worktree-
  // isolated, instead of letting a typo surface only when a session finally fails to start.
  // All three NULL = never probed (no runner report yet, or one too old to send it), which must
  // stay distinct from "probed, and it isn't there".
  workDirExists       Boolean?  @map("work_dir_exists")
  workDirIsGit        Boolean?  @map("work_dir_is_git")
  workDirProbedAt     DateTime? @map("work_dir_probed_at")
  // Headroom on the filesystem this workspace's work dir lives on, from the same heartbeat probe
  // as the flags above. Per workspace rather than per runner because one machine's workspaces can
  // sit on different mounts, and a run can only be gated on the disk it will write to. BigInt:
  // a multi-terabyte volume overflows Int. Null means unknown (old runner, missing path,
  // platform without an answer) and must never be read as "full".
  workDirFreeBytes    BigInt?   @map("work_dir_free_bytes")
  workDirTotalBytes   BigInt?   @map("work_dir_total_bytes")
  ownerId             String    @map("owner_id") @db.Uuid
  owner               User      @relation(fields: [ownerId], references: [id])
  createdAt           DateTime  @default(now()) @map("created_at")
  // Soft delete: deleting a workspace stamps this instead of removing the row, so its
  // sessions/tasks stay linked (no orphaning) and it can be restored. NULL = live;
  // every user-facing listing filters on `deletedAt: null`. Runtime lookups by a live
  // session's workspaceId intentionally don't filter, so in-flight sessions keep running.
  deletedAt           DateTime? @map("deleted_at")
  // Sidebar display order set by drag-to-reorder; NULL sorts last (after positioned
  // workspaces, by createdAt) so existing/new ones stay oldest-first until reordered.
  position            Int?      @map("position")

  sessions      Session[]
  assignedTasks Task[] // tasks assigned to run in this workspace
  foremanFor    TaskList[] @relation("TaskListForeman") // lists whose coordination runs here
  coordinatorForProjects Project[] @relation("ProjectCoordinatorWorkspace") // projects coordinated here
  // Teams this workspace is on as an agent — the coordinator of a project is one of these rows
  // (see ProjectMember, which explains why an agent is a workspace today).
  projectMemberships     ProjectMember[] @relation("ProjectMemberAgent")
  // Service tokens pinned to this workspace (see ServiceToken).
  serviceTokens ServiceToken[]
  // What this workspace always allows without asking again (see WorkspacePermissionRule).
  permissionRules WorkspacePermissionRule[]

  @@index([ownerId])
  @@index([runnerId])
  @@map("workspace")
}

/// WHO does the work — an identity, and nothing about where it runs.
///
/// Today an "Agent" on the wire is a `workspace` row (MCP `agent_list`, `orbit agent`,
/// `task.assignee_id`, `project_member.agent_id` all mean that table), which is exactly the defect
/// this project exists to remove: a workspace names a machine and a directory, so choosing WHO
/// does a task silently chose WHICH MACHINE ran it. Splitting the identity out is what lets a
/// task be handed to "the iOS build agent" without that also being a decision about a Mac.
///
/// The core constraint is therefore a NEGATIVE one (contract §3.1 A1): this table must never grow
/// `runnerId`, `targetRunnerId`, `targetLabels`, `workDir`, `enableWorktree` or `env`. Where the
/// work runs is resolved separately, from the Project's workspaces and the runner capabilities the
/// task requires. `agent-schema.spec.ts` asserts the absence, because a column added "just for
/// convenience" is how the coupling would come back.
model Agent {
  id                   String    @id @default(uuid(7)) @db.Uuid
  ownerId              String    @map("owner_id") @db.Uuid
  owner                User      @relation(fields: [ownerId], references: [id])
  /// Display name. Unique per owner among LIVE rows only — the partial unique index
  /// (`agent_owner_id_name_active_key`, `WHERE deleted_at IS NULL`) lives in the migration because
  /// schema.prisma cannot express a partial index, exactly as 0108/0110/0111 do for theirs.
  /// A plain `@@unique([ownerId, name])` would let a soft-deleted row hold a name for ever.
  name                 String
  description          String?
  /// A human-facing label ("coordinator", "product", "ux", "dev", "qa", …) and nothing more.
  /// Contract §3.1 A3: this column takes NO part in any authorization decision. The authoritative
  /// role inside a project is `project_member.role`, which is scoped to that project and enforced
  /// by an index; a global string on the identity would be a permission anybody can rename.
  role                 String?
  systemPrompt         String?   @map("system_prompt")
  appendSystemPrompt   String?   @map("append_system_prompt")
  /// What this identity runs on by default. NULL = inherit the owner-level default, which is the
  /// value every mirrored legacy agent keeps: a workspace never named a provider (the provider is
  /// derived from what it last ran), so writing one here during the migration would be inventing a
  /// decision the user never made.
  defaultProvider      String?   @map("default_provider")
  defaultModel         String?   @map("default_model")
  defaultEffort        String?   @map("default_effort")
  /// Explicit, ordered fallback: `[{provider, model?}]`. Empty — the default — means DO NOT
  /// downgrade: an unavailable provider fails the run and says so (contract §7.4). Silently
  /// running somebody's task on a different engine is the failure this default exists to prevent.
  providerFallbacks    Json      @default("[]") @map("provider_fallbacks")
  disallowedTools      Json      @default("[]") @map("disallowed_tools")
  /// This identity's baseline Runtime Requirement (an iOS build agent is permanently `["macos"]`).
  /// Matched against what a runner REPORTS it can do, so the requirement is a fact about the work
  /// rather than a pointer at one machine.
  requiredCapabilities String[]  @default([]) @map("required_capabilities")
  /// Project permissions, both closed by default (contract §8). A project may narrow them further
  /// on the membership row; it may never widen them from here.
  canCreateTasks       Boolean   @default(false) @map("can_create_tasks")
  canDelegate          Boolean   @default(false) @map("can_delegate")
  /// Off = cannot be assigned and cannot be dispatched. Kept distinct from `deletedAt`: disabled
  /// is a reversible operational state, deleted is a removal that in-flight sessions survive.
  enabled              Boolean   @default(true)
  /// Creation order, and the deterministic tie-break the mirror backfill numbers duplicate names
  /// by, so re-running it produces the same assignment.
  createdAt            DateTime  @default(now()) @map("created_at")
  /// Soft delete, same semantics as `workspace.deletedAt`: the row stays so history keeps
  /// resolving, every user-facing listing filters on NULL, and in-flight sessions are unaffected.
  deletedAt            DateTime? @map("deleted_at")
  /// MIGRATION ONLY: the `workspace` row this identity was mirrored out of. Written once by
  /// `0129_project_agent_identity` and read in exactly two places (contract §3.1 A4) — the
  /// `workspace <-> agent` compatibility lookup, and that migration's own idempotency key. No
  /// resolution chain and no authorization check may read it, and a hand-created Agent is always
  /// NULL. Deliberately NOT a foreign key: the contract states no referential action for it, and
  /// the mirror set includes soft-deleted sources whose rows this column must keep naming.
  legacyWorkspaceId    String?   @unique @map("legacy_workspace_id") @db.Uuid

  @@index([ownerId])
  @@map("agent")
}

/// A tool call this workspace's sessions may make without asking a human again — written
/// when someone answers an approval with "always allow", read back into every later session
/// of the same workspace.
///
/// Workspace-scoped on purpose. The unit of trust is not a session: "I trust `npm test` in
/// this repo" does not stop being true when a conversation ends, and re-teaching it once per
/// session makes the cost scale with the number of sessions — which is the thing the product
/// is for. It is not account-scoped either, because a command waved through in a toy checkout
/// must not silently arm itself in the repo that matters; the workspace is what owns the
/// workDir, the runner and the env, so it is the boundary users already reason about.
///
/// Orbit stores and scopes these; it does NOT match them. They are handed to the runtime
/// (claude's `--allowedTools`) so the vendor's own matcher decides what counts as "the same
/// kind of call" — writing a second matcher for shell strings here would be a bypassable
/// parser guarding a shell.
model WorkspacePermissionRule {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // The gated tool ("Bash", "Edit", …).
  toolName    String    @map("tool_name")
  // Narrows the tool, in the runtime's own rule grammar (Bash uses a command prefix like
  // "git commit:*"). Empty string — not NULL — means "every call to this tool", so the
  // unique index actually collapses duplicates (postgres treats NULLs as distinct).
  ruleContent String    @default("") @map("rule_content")
  // Who allowed it, and from which approval (no FK: the approval's session may be deleted
  // long before the rule is revoked).
  createdById String?   @map("created_by_id") @db.Uuid
  approvalId  String?   @map("approval_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([workspaceId, toolName, ruleContent])
  @@index([workspaceId])
  @@map("workspace_permission_rule")
}

// A first-class interactive chat session (Route B): a long-lived conversation
// driven by one claude process on a runner. Chat events, user-input turns, tool
// calls, and llm usage hang directly off the Session.
model Session {
  id                   String    @id @default(uuid(7)) @db.Uuid
  title                String
  /// True while the project this Session coordinates owns its display title. A manual session
  /// rename clears this in the same UPDATE as the new title, so later project renames cannot take
  /// that choice back (including the ABA case where both titles happen to be equal).
  titleManagedByProject Boolean  @default(false) @map("title_managed_by_project")
  /// The title that was present when an existing Session first became a coordinator. This is kept
  /// as recovery provenance; dedicated coordinator Sessions have no earlier title and leave it
  /// null. It is intentionally internal rather than a second title rendered by clients.
  titleBeforeProjectManagement String? @map("title_before_project_management")
  prompt               String // first-turn seed
  ownerId              String    @map("owner_id") @db.Uuid
  owner                User      @relation("SessionOwner", fields: [ownerId], references: [id])
  creatorId            String    @map("creator_id") @db.Uuid
  creator              User      @relation("SessionCreator", fields: [creatorId], references: [id])
  assignedRunnerId     String?   @map("assigned_runner_id") @db.Uuid
  assignedRunner       Runner?   @relation(fields: [assignedRunnerId], references: [id])
  workspaceId          String?   @map("workspace_id") @db.Uuid
  workspace            Workspace? @relation(fields: [workspaceId], references: [id])
  // Optional parent work item; deleting the Task detaches but keeps the session.
  taskId               String?   @map("task_id") @db.Uuid
  task                 Task?     @relation("SessionTask", fields: [taskId], references: [id], onDelete: SetNull)
  // Project Coordinator dispatch lineage. USER and legacy sweep sessions carry NULL; a
  // PROJECT_COORDINATOR row is inserted in the same transaction as the referenced action.
  projectActionId      String?   @unique @map("project_action_id") @db.Uuid
  projectAction        ProjectAction? @relation("ProjectActionSession", fields: [projectActionId], references: [id], onDelete: NoAction)
  dispatchOrigin       SessionDispatchOrigin @default(LEGACY_SWEEP) @map("dispatch_origin")
  runSource            SessionRunSource @default(MANUAL) @map("run_source")
  /// Whether this Session was opened to DO the task's work (Run Now, a sweep, the Project
  /// dispatcher) as opposed to look at it. §13.6 SU6's guard is the only reader: a replaced attempt
  /// may not have its work repeated, while a session opened against it to read or salvage the old
  /// run is a decision somebody is deliberately making.
  ///
  /// The database default is TRUE — see migration 0130. A default decides what a write that does
  /// not mention the column means, and every such write comes from a binary that predates it; the
  /// safe reading of those is "this starts work", so the guard refuses rather than exempts. The
  /// service is explicit on every path, so this default is only ever reached by an older writer.
  startsTaskWork       Boolean          @default(true) @map("starts_task_work")
  /// The task this session is ABOUT, as distinct from `taskId`, which means it EXECUTES that task.
  /// A conversation opened by an @-mention carries this and leaves `taskId` null, so it takes no
  /// execution claim, occupies no project slot, does not follow the task's lifecycle — and is
  /// invisible as a task session to a binary that predates the column, which is what makes it safe
  /// to create during a rolling deploy. Mutually exclusive with `taskId` (migration 0131's CHECK).
  mentionDeliveries    TaskCommentMentionDelivery[] @relation("MentionDeliveryTarget")
  contextTaskId        String?          @map("context_task_id") @db.Uuid
  contextTask          Task?            @relation("SessionContextTask", fields: [contextTaskId], references: [id], onDelete: SetNull)
  // Frozen dispatcher result. The coordinator path writes all four atomically with the Session;
  // legacy rows keep NULL/empty defaults and continue to use their existing columns.
  resolution           Json?
  snapshotFrozenAt     DateTime? @map("snapshot_frozen_at")
  requiredCapabilities String[]  @default([]) @map("required_capabilities")
  executionPinGeneration BigInt  @default(0) @map("execution_pin_generation")
  // Set when another session's agent spawned this one via the orbit mcp session_create tool
  // (L3 orchestration). Detaches (SetNull) if the parent is purged; drives the orchestration
  // tree, the spawn-depth / child-count guards, and attribution.
  parentSessionId      String?   @map("parent_session_id") @db.Uuid
  parent               Session?  @relation("SessionSpawn", fields: [parentSessionId], references: [id], onDelete: SetNull)
  children             Session[] @relation("SessionSpawn")
  // The spawn tree this session belongs to, named by the session it grew from — a root points
  // at itself once it has spawned anything. null = not part of any tree. This is what the claim
  // queue's tree cap groups on, and what makes "the tree" one indexed read instead of a walk up
  // parentSessionId. Deliberately NOT batchId: a batch run is a closed set with a user-chosen
  // cap, a tree is open-ended with a server-owned one.
  rootSessionId        String?   @map("root_session_id") @db.Uuid
  // Parent links above this session: a root is 0, its child 1. Written at creation so the depth
  // guard is a read rather than one query per level.
  spawnDepth           Int       @default(0) @map("spawn_depth")
  // Batch-run grouping: when a session is dispatched as part of a "批量运行" batch,
  // these tag it with that batch's id and the batch's own concurrency cap. The claim
  // queue gates live sessions per batch on batchMaxConcurrent — independent of, and on
  // top of, the runner's own max_concurrent. null = not part of any batch (ungated).
  batchId              String?   @map("batch_id") @db.Uuid
  batchMaxConcurrent   Int?      @map("batch_max_concurrent")
  // Runtime thread/session id, always owned by the runtime named in `provider`. Claude's is
  // pre-generated at creation (--session-id on first spawn, --resume on reclaim/respawn);
  // Codex/Kimi/OpenCode mint their own after process initialization, so it stays null then.
  runtimeSessionId     String?   @map("runtime_session_id")
  provider             String    @default("claude")
  // Materialized from the owning agent. Only needed to distinguish first-class Kimi from a
  // stale old-replica write that still uses the former custom-provider slug `kimi`.
  providerBuiltin      Boolean   @default(false) @map("provider_builtin")
  // The only runner-engine generation allowed to dequeue this session's inbox. Retired values
  // remain here as tombstones until the next activation, so legacy NULL polls stay fenced.
  inboxLeaseGeneration String?   @map("inbox_lease_generation") @db.Uuid
  /// Highest durable runtime compaction boundary observed for this conversation. This is an
  /// event seq rather than a counter so replaying the same event batch cannot advance it twice.
  coordinatorContextEpoch Int @default(0) @map("coordinator_context_epoch")
  /// SHA-256 of the coordinator context last confirmed by a successful top-level turn. The
  /// digest also binds the project, exact instruction body, engine lease generation and epoch.
  coordinatorContextAckKey String? @map("coordinator_context_ack_key") @db.Char(64)
  // Stable UUID of the runner process authorized to activate new generations. Process takeover
  // is an expected-owner CAS, so a delayed request from a superseded process cannot regain control.
  inboxLeaseOwner      String?   @map("inbox_lease_owner") @db.Uuid
  // Explicit/snapshotted model. Null uses the rolling legacy Agent bridge when present, otherwise
  // the runner Runtime/catalog default; first claim materializes whichever value was inherited.
  model                String?
  // New code sets this explicitly on create. The false database default identifies a model-less
  // Session written by an old replica after migration 0079, whose pre-0079 static/Agent fallback
  // must be preserved until first claim snapshots it.
  usesRuntimeDefaultModel Boolean @default(false) @map("uses_runtime_default_model")
  permissionMode       String?   @map("permission_mode")
  // Claude effort level (low|medium|high|xhigh|max); null omits --effort so claude
  // uses the model's default.
  effort               String?
  // Legacy internal provenance. Current clients use one Active list rather than splitting
  // out System; task-linked runs are always "user" for compatibility with older clients.
  source               String    @default("user")
  // PENDING = created, claimable by its assigned runner.
  status               RunStatus @default(PENDING)
  // billing, accrued per turn
  sumInputTokens       Int       @default(0) @map("sum_input_tokens")
  sumOutputTokens      Int       @default(0) @map("sum_output_tokens")
  sumCacheRead         Int       @default(0) @map("sum_cache_read")
  sumCacheWrite        Int       @default(0) @map("sum_cache_write")
  numTurns             Int       @default(0) @map("num_turns")
  costUsd              Float     @default(0) @map("cost_usd")
  // How full the context window is RIGHT NOW: the tokens the latest top-level assistant message
  // actually cost (fresh input + cache reads + cache writes + output), denormalized from the
  // turn_end event that already carries it for the clients' context gauge. Deliberately not
  // derivable from the four sums above — those accrue over the session's whole life, so the only
  // thing they say about the current window is that it is smaller. A long-lived session has to
  // rotate before it reaches the window (compaction is lossy), and this is the measurement that
  // decision needs. null until a runtime reports one: never-run sessions, and runtimes that
  // don't report it yet (kimi).
  contextTokens        Int?      @map("context_tokens")
  // What contextTokens is a fraction of: the window the engine that produced that number will
  // actually use, reported by the runner from its own probe of that engine rather than looked up
  // by model id. The id doesn't determine the window (`opus` and `opus[1m]` are one model with
  // two), so the pair only means anything when both halves come from the same reading — which is
  // why it is written from the same event and never from a table. null when the runtime doesn't
  // report one; a reader with no window shows the token count, not a percentage of a guess.
  contextWindow        Int?      @map("context_window")
  lastTurnAt           DateTime? @map("last_turn_at")
  cancelRequestedAt    DateTime? @map("cancel_requested_at")
  startedAt            DateTime? @map("started_at")
  finishedAt           DateTime? @map("finished_at")
  error                String?
  result               String?
  // Why the session ended, orthogonal to `status` (which collapses every graceful end
  // to CANCELLED). Set by the path that requests the end — endLive (user end/complete/
  // delete) or the reaper (idle/task-done recycle, orphan) — and left untouched by the
  // runner's async /finalize. null = a natural agent finish (read `status`) or a
  // pre-migration row. Values: see SessionEndReason in @orbit/shared.
  endReason            String?   @map("end_reason")
  // Denormalized preview: the text of the most recent `assistant` RunEvent, written on
  // event ingestion. Lets the session list show a last-reply line without querying the
  // (high-volume, append-only) run_event table per row. null until the first reply.
  lastAssistantText    String?   @map("last_assistant_text")
  // Denormalized "frontier" activity for the sidebar's live status line: the tool
  // name when a tool_use is the latest durable event (in flight, no tool_result yet),
  // cleared back to null on any other frontier (assistant text, tool_result, turn end).
  // Only meaningful while RUNNING; the list gates display on status so a stale value
  // on a finished session is never shown.
  lastToolUse          String?   @map("last_tool_use")
  // Denormalized "pending question": the latest user turn's text while it's the frontier — a
  // turn just started and the agent hasn't replied yet. Set alongside lastToolUse on event
  // ingestion and cleared (null) the moment any other frontier lands (assistant text, a tool,
  // turn end). Lets the list show the message you just sent while awaiting the reply, instead of
  // the now-stale previous reply. Only meaningful while RUNNING; display is status-gated.
  lastUserText         String?   @map("last_user_text")
  // Denormalized set of the agent's still-running background shells (Bash run_in_background):
  // the tool_use ids of launches that haven't yet reported a terminal `<task-notification>`.
  // Added on launch, removed on completion, cleared on (re)spawn/complete. Lets the list +
  // header show "Background running" without scanning events. Only meaningful while live.
  runningBgShells      String[]  @map("running_bg_shells")
  // Denormalized set of the agent's still-running sub-agents (Task/Agent tool): the tool_use
  // ids of sub-agent launches that haven't yet reported a terminal `<task-notification>`
  // (background_task). Added on launch, removed on completion, cleared on (re)spawn. The Agent
  // tool is async — its launch tool_result lands immediately and the parent then streams its
  // own top-scope system progress events, so lastToolUse can't carry this. Lets the list show
  // "Running Agent…" while a sub-agent is in flight. Only meaningful while live.
  runningSubagents     String[]  @map("running_subagents")
  // Denormalized "the engine is generating right now", tracked independently of `status`.
  // A runtime restarts the model on its own for a background-task notification or a scheduled
  // wake-up; those turns never pass through the inbox, so /turn-complete never acks them and
  // `status` stays AWAITING_INPUT while tools and replies stream for minutes. Set by any
  // generation event, cleared by a turn ending or a runtime (re)spawn handshake. Display only:
  // `status` remains the sole source of truth for runner-slot accounting, so a self-driven
  // turn never consumes a permit it did not acquire.
  engineTurnActive     Boolean   @default(false) @map("engine_turn_active")
  // When the engine first spoke for the CURRENT run: cleared by every claim, stamped by the
  // first event the engine itself produced (a spawn handshake, or any generation event when a
  // warm process is reused and there is no handshake). RUNNING with this still null is the
  // gap between acquiring a slot and the runtime being ready — a git worktree checkout, a CLI
  // cold start, an MCP handshake — which is several seconds and which `status` alone cannot
  // see, so the clients drew it as "Running" while the agent had not yet read the prompt.
  // Display only, like engineTurnActive: slot accounting stays on `status`. Doubles as the
  // server-side startup measurement (engineStartedAt - lastTurnAt).
  engineStartedAt      DateTime? @map("engine_started_at")
  // ── Per-session git worktree isolation ──────────────────────────────────────
  // When the agent's workDir is a git repo, the runner runs this session in its own
  // git worktree on `branch`, forked from `baseSha` (the workDir HEAD at claim time).
  // On terminal completion the runner commits the work to `branch`, removes the
  // worktree (the branch stays, for a manual merge), and reports `changedFiles` — a
  // compact per-file {path,additions,deletions,status} summary, deliberately NOT
  // selected by the session list query so the (potentially large) diff never bloats
  // the list payload. `isolationStatus` records what the runner actually did:
  // 'worktree' (isolated) or 'shared-nogit' (workDir wasn't a git repo, so it ran in
  // the shared dir with no isolation). All null for pre-feature / never-run sessions.
  branch               String?
  baseSha              String?   @map("base_sha")
  changedFiles         Json?     @map("changed_files")
  isolationStatus      String?   @map("isolation_status")
  // ── "Merge to main" (UI button on the worktree status bar) ──────────────────
  // The user can ask the runner to merge this session's `branch` into a target branch.
  // mergeStatus drives the button: 'pending' (queued for the next heartbeat of the
  // session's assigned runner) → 'merged' (mergedAt set) | 'conflict' | 'error'
  // (mergeError carries git's message / the failed precondition). All null until asked.
  mergeStatus          String?   @map("merge_status")
  mergeError           String?   @map("merge_error")
  mergeRequestedAt     DateTime? @map("merge_requested_at")
  // Fresh for every queued attempt. Runner results must echo this UUID, so a
  // delayed result from an attempt cleared by Resume cannot complete a later one.
  mergeOperationId     String?   @map("merge_operation_id") @db.Uuid
  // Claimed once by a capable heartbeat process. Same-owner redelivery is
  // idempotent; another process cannot steal a possibly executing git mutation.
  mergeOperationOwner  String?   @map("merge_operation_owner") @db.Uuid
  mergedAt             DateTime? @map("merged_at")
  // The exact source-branch tip that a successful Orbit merge replayed. Unlike patch-id,
  // this remains authoritative when rebasing onto the target adapts overlapping changes and
  // produces a non-equivalent patch. A later worktree report clears merged state only after
  // its current branch tip differs from this SHA. Null for legacy merge results.
  mergedSourceSha      String?   @map("merged_source_sha")
  /// `[K6]` §7: the checkpoint the QUEUED merge was authorised for (migration 0152).
  ///
  /// Written when the merge is queued and read when its result comes back, so the server decides
  /// whether a reported landing is the verified one from a fact it persisted itself rather than
  /// from a field the runner chose to send. `requiredSourceSha` travels on the command for the
  /// runner's benefit — it is the only party that can compare a commit against a working tree —
  /// but a runner that ignores it must not be able to make the control plane record an unverified
  /// tip as landed. A gate that only holds when the client cooperates is not a gate.
  mergeCheckpointId    String?         @map("merge_checkpoint_id") @db.Uuid
  mergeCheckpoint      TaskCheckpoint? @relation("SessionMergeCheckpoint", fields: [mergeCheckpointId], references: [id], onDelete: SetNull)
  // The branch the user chose to merge into (from the status bar's branch dropdown). Null
  // means the default — the runner auto-detects main, else master. Relayed to the runner in
  // the MergeCommand and shown on the merged ✓ chip.
  mergeTarget          String?   @map("merge_target")
  // Candidate merge targets the runner reported for this session's repo (local branches
  // minus Orbit's own orbit/* session branches), populating the dropdown. Refreshed each
  // heartbeat while live and at completion; empty for older runners (dropdown hidden).
  mergeTargets         String[]  @default([]) @map("merge_targets")
  // branchMerged is the runner's verdict that this branch's work is already in the default target
  // (main, else master): the branch tip is an ancestor of it (fast-forward / command-line push), or
  // every post-fork commit has a patch-equivalent there (a squash/rebase merge under new SHAs, e.g.
  // Orbit's own rebase-based "Merge to main"). Refreshed alongside worktreeDirty on each worktree
  // report: true → the bar shows a "✓ In main" chip instead of a redundant Merge button. Null = the
  // runner hasn't reported it (older runner / not yet recomputed) → the bar keeps its
  // mergeStatus-driven behavior.
  branchMerged         Boolean?  @map("branch_merged")
  // The worktree's ACTUAL current HEAD branch, as last reported by the runner (git symbolic-ref).
  // Normally equals `branch`; it differs when the agent ran `git checkout -b` inside the worktree,
  // moving the work onto a branch Orbit isn't tracking. When it differs, the status bar flags the
  // divergence ("On <branch> — not tracked") instead of a stale "✓ In main", and offers Adopt
  // (which re-points `branch` here). Null = not isolated / not reported (older runner).
  worktreeBranch       String?   @map("worktree_branch")
  // ── "Commit" (UI button on the worktree status bar, for a live session) ─────
  // worktreeDirty is the runner's last-reported `git status` for the live worktree: true
  // → the bar shows Commit (commit the uncommitted work onto `branch`), false → Merge.
  // commitStatus drives the Commit button while it runs: 'pending' (queued for the next
  // heartbeat) → 'committed' | 'nochange' | 'error' (commitError carries git's message).
  // All null until the runner reports / the user clicks commit.
  worktreeDirty        Boolean?  @map("worktree_dirty")
  commitStatus         String?   @map("commit_status")
  commitError          String?   @map("commit_error")
  commitRequestedAt    DateTime? @map("commit_requested_at")
  // Same ABA fence as mergeOperationId, for heartbeat-delivered commits.
  commitOperationId    String?   @map("commit_operation_id") @db.Uuid
  commitOperationOwner String?   @map("commit_operation_owner") @db.Uuid
  // Product lifecycle: completedAt moves an Open session to Completed; deletedAt moves
  // it to Trash. Both retain all data and restore clears them. archivedAt is a temporary
  // rolling-deploy compatibility mirror maintained by migration 0076's database trigger.
  completedAt          DateTime? @map("completed_at")
  /// @deprecated Compatibility mirror of completedAt; do not use in new server code.
  archivedAt           DateTime? @map("archived_at")
  deletedAt            DateTime? @map("deleted_at")
  // Pin to the top of the session list: when set, the session sorts above unpinned ones
  // (a per-owner personal ordering). null = not pinned. Toggled via POST/DELETE /sessions/:id/pin.
  // Ordering only — never affects visibility or the runner.
  pinnedAt             DateTime? @map("pinned_at")
  // ── Public read-only share link ─────────────────────────────────────────────
  // shareToken is an unguessable token embedded in a public URL (/s/<token>); anyone
  // with the link can view this session's transcript read-only, no login. null = not
  // shared. Revoking sets it back to null (old links 404); re-sharing mints a fresh
  // token. sharedAt records when the current link was minted. Only the transcript is
  // exposed via the token (see SharedController) — never ownership/billing/runner internals.
  shareToken           String?   @unique @map("share_token")
  sharedAt             DateTime? @map("shared_at")
  // ── A failure that fixes itself → re-send when it will work ─────────────────
  // Two failures say nothing about the work and succeed on a plain re-send: the account's
  // provider quota running out ("You've hit your session limit · resets 6:20pm
  // (Europe/Berlin)"), and the provider being briefly unable to answer ("API Error: 529 …
  // overloaded_error"). retryAt is when to re-send — set on event ingestion the moment such a
  // reply lands, and cleared by anything that means nobody is waiting on it any more (the
  // retry fired, the user sent their own message, the session ended, or the user switched
  // auto-retry off). null = no armed retry, which is also how "the user declined" and "no
  // reset time could be determined" are both spelled.
  retryAt              DateTime? @map("retry_at")
  // Auto-retries already spent on the current run of failures: what the API-error backoff
  // steps through, and what makes a quota that keeps reporting itself spent past its own reset
  // time hand back to the user instead of re-sending forever. Reset to 0 when a turn finally
  // answers with something that is not one of those failures — not merely when a retry is
  // dispatched, which would let a provider that fails identically every time loop unbounded.
  retryAttempts        Int       @default(0) @map("retry_attempts")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  events                RunEvent[]
  turns                 ConversationTurn[]
  startupTurnFragments  ConversationTurnStartupFragment[]
  toolCalls             ToolCall[]
  llmUsage              LlmUsage[]
  approvals             Approval[]
  inboxLeaseGenerations InboxLeaseGeneration[]
  // Tasks an agent created from within this session (cf. Task.creatorSession).
  createdTasks          Task[]                 @relation("TaskCreatorSession")
  // Tasks that record this session as where the work was NOTICED (migration 0150). Overlaps
  // `createdTasks` today and is not the same claim: that one says who authored the row, this one
  // says where the work came from, and the two part company the moment anything files on behalf
  // of something else.
  discoveredTasks       Task[]                 @relation("TaskDiscoverySession")
  taskListRevisions     TaskListRevision[]     @relation("TaskListRevisionAuthorSession")
  consoleForLists       TaskList[]             @relation("TaskListConsole")
  // At most one, enforced by the unique index behind Project.coordinatorSessionId.
  coordinatorForProject Project?               @relation("ProjectCoordinator")
  /// The wake this session was opened to judge, if it is a judgment session (unit T3, 0174). At
  /// most one — distinct from `coordinatorForProject`, which is the conversation a PERSON opens.
  judgmentForWake       ProjectCoordinatorWake? @relation("CoordinatorJudgmentSession")
  attachments           Attachment[]
  diff                  SessionDiff?
  // Personal colored labels applied to this session (many-to-many via the join table).
  tagLinks              SessionTagLink[]
  resultOfProjectAction ProjectAction? @relation("ProjectActionResultSession")
  // Append-only record of every merge attempted for this session's branch, however it was made.
  mergeReceipts         SessionMergeReceipt[]
  /// `[K3]`: the attempt this session IS, if it is one (migration 0139). At most one — a session is
  /// one attempt or none, never a second try at the same thing.
  attempt               TaskAttempt?
  executableAcceptanceAdmissions TaskExecutableAdmission[]
  executableAcceptanceAttempts   TaskExecutableAttempt[]
  executableAcceptanceDiagnoses  TaskExecutableDiagnosis[]

  @@index([assignedRunnerId, status])
  // "what did this workspace last run on", the derived seed a new session inherits when the
  // caller names no provider (workspaces/workspace-provider.ts).
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([batchId, status])
  @@index([parentSessionId])
  // The claim queue's tree cap: a tree's active turns.
  @@index([rootSessionId, status])
  @@index([ownerId])
  @@index([ownerId, status, taskId], map: "session_owner_status_task_idx")
  @@index([status])
  // The auto-retry sweeper's only query: armed retries that have come due.
  @@index([retryAt])
  @@map("session")
}

// Durable activation/retirement records for runner inbox consumers. A retired row is kept as a
// tombstone so a delayed activate request cannot resurrect an engine after release or reclaim.
model InboxLeaseGeneration {
  generation  String    @id @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  leaseOwner  String?   @map("lease_owner") @db.Uuid
  activatedAt DateTime  @default(now()) @map("activated_at")
  retiredAt   DateTime? @map("retired_at")

  @@index([sessionId])
  @@map("inbox_lease_generation")
}

// On-demand per-file unified diffs of a session's worktree changes, kept in a side table
// (1:1 with Session) so the potentially large patch text NEVER rides the session detail or
// list payload — it's fetched only when the user opens a file's diff (GET /sessions/:id/diff).
// The runner upserts it each turn (live, uncommitted) and at completion (committed). `patches`
// is a FilePatch[] ({ path, patch?, truncated? }) — see @orbit/shared.
/// One merge of one session's branch, as it actually happened (§13.7 MR1).
///
/// The row exists because `Session.merge_status` could not be the answer and was being asked to be
/// one. That column is LIVE UI state for the "Merge to main" button: it is written when a merge is
/// queued, and deliberately cleared again when the session is resumed or takes another turn. It is
/// also only ever written by the one path that goes through Orbit — so a branch merged the way
/// these branches are actually merged, by an agent running `git merge --ff-only` in its own
/// worktree, left `merge_status` NULL and `branch_merged` false FOREVER, and the control plane's
/// honest answer to "did this task's work land" was "no idea".
///
/// So this table records the merge and that column keeps showing it. A receipt is APPEND-ONLY
/// (migration 0128 refuses UPDATE) because it is a statement about a moment: the target moves
/// afterwards, and a receipt that were kept current would stop being evidence of anything.
///
/// It names every address the audit needs to join on — the session, its task, its project — and
/// every SHA the claim can be checked against: what was merged, what it was merged into before and
/// after, and which base the source had been rebased onto when the merge was computed. `rebaseBase`
/// is the one people leave out and the one that decides whether "the tests passed" was about this
/// world: a branch merged clean onto a target it was never rebased against tested a different tree.
model SessionMergeReceipt {
  id        String  @id @default(uuid(7)) @db.Uuid
  /// Tenant scope. Denormalized from the session on purpose: every read of this table filters by
  /// it, and a receipt whose reachability depends on joining a row that may be soft-deleted is a
  /// receipt that can go quiet exactly when somebody is auditing it.
  ownerId   String  @map("owner_id") @db.Uuid
  owner     User    @relation(fields: [ownerId], references: [id])
  sessionId String  @map("session_id") @db.Uuid
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// The work this merge was FOR. Optional because a session need not be task-bound; SetNull
  /// because deleting a task must not delete the evidence that its branch landed.
  taskId    String? @map("task_id") @db.Uuid
  task      Task?   @relation("TaskMergeReceipt", fields: [taskId], references: [id], onDelete: SetNull)
  /// Denormalized from the task at write time, so "which merges does this project's acceptance get
  /// to stand on" is one indexed read and stays answerable after the task is re-filed.
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// What happened. Closed set, frozen by a CHECK in migration 0128:
  /// `MERGED` (the target moved and now contains this source), `ALREADY_MERGED` (it was already
  /// there — the external-ff-only and re-run cases, which are a RESULT and not a no-op), `CONFLICT`
  /// (git refused, `conflicts` names the paths) and `ERROR` (everything else, `detail` says what).
  result String

  sourceBranch String  @map("source_branch")
  /// The exact source tip this receipt is about. Full 40-hex, lowercase, checked: an abbreviated
  /// SHA is ambiguous by construction and this row's whole purpose is to be checkable later.
  sourceSha    String  @map("source_sha") @db.Char(40)
  targetBranch String  @map("target_branch")
  /// The target before and after. `targetShaAfter` is NOT NULL for `MERGED` (0128's CHECK): a
  /// merge that cannot say where the target ended up is a claim, not a receipt.
  targetShaBefore String? @map("target_sha_before") @db.Char(40)
  targetShaAfter  String? @map("target_sha_after") @db.Char(40)
  /// The base `sourceSha` was rebased onto before the merge was computed, when it was rebased at
  /// all. NULL means "not rebased", which is a different statement from "unknown" only because
  /// `detail` is where an unknown goes.
  rebaseBaseSha   String? @map("rebase_base_sha") @db.Char(40)

  /// Paths git reported as conflicting. Empty for every non-CONFLICT result.
  conflicts String[] @default([])

  /// WHO recorded it: `RUNNER` (Orbit's own merge path reporting its outcome), `AGENT` (a worker
  /// recording a merge it made itself, which is the external-ff-only case) or `USER`. Closed set,
  /// frozen by a CHECK. It is provenance, never an input to a decision.
  recordedBy String @map("recorded_by")

  /// The raw observation: the command, its output, the refs read. Display and diagnosis only.
  detail Json @default("{}")

  /// What makes re-recording the same merge a no-op rather than a second row. Supplied by the
  /// caller when it has a natural one, otherwise derived from
  /// `(sessionId, sourceSha, targetBranch, result)` — the four facts that make two reports the
  /// same report. Unique WITHIN a session, not globally: two sessions merging the same commit into
  /// the same branch is two merges and deserves two receipts.
  idempotencyKey String @map("idempotency_key")

  /// `[K6]` CP4: the §7 checkpoint this merge landed, when the work was under convergence
  /// management. Nullable because most merges are not, and project AC11 says those keep behaving
  /// exactly as they did. Where it IS set it is the receipt's real identity: MR4's key is scoped to
  /// one session, so the same landing reported by a takeover or by a cross-runner recovery mints a
  /// second row — and a checkpoint outlives the session that produced it. A trigger refuses a
  /// LANDED receipt that names a `WIP_RED` checkpoint (§7's "可否进入依赖分支/main = 否").
  checkpointId String?         @map("checkpoint_id") @db.Uuid
  checkpoint   TaskCheckpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sessionId, idempotencyKey])
  @@index([sessionId, createdAt])
  @@index([taskId, createdAt])
  @@index([projectId, createdAt])
  @@index([ownerId, createdAt])
  @@index([checkpointId, createdAt(sort: Desc)], map: "session_merge_receipt_checkpoint_idx")
  /// CP4 is enforced by a PARTIAL unique index this schema cannot spell
  /// (`session_merge_receipt_checkpoint_key` on `(checkpoint_id, idempotency_key)`,
  /// `WHERE checkpoint_id IS NOT NULL`), the same trade `task_attempt_one_open_key` carries. It has
  /// to be partial: the many receipts with no checkpoint must keep colliding only within their own
  /// session, or every unmanaged merge in the system would share one identity.
  @@map("session_merge_receipt")
}

model SessionDiff {
  sessionId String   @id @map("session_id") @db.Uuid
  patches   Json
  updatedAt DateTime @updatedAt @map("updated_at")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_diff")
}

// A personal, colored label the owner can apply to their sessions (Files.app-style Tags).
// Per-owner: every query filters by ownerId. `isSystem` marks the 7 seeded preset-color tags
// (Red…Gray) — always present, selectable, but not renamable/deletable; user-created tags are
// isSystem=false. `position` orders them in the picker (system first, then creation order).
// `color` is a #RRGGBB hex from the shared palette. Deleting a tag cascades its links away
// (the sessions themselves are untouched). Seeded lazily on first list — see SessionTagsService.
model SessionTag {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  color     String
  isSystem  Boolean  @default(false) @map("is_system")
  position  Int      @default(0)
  ownerId   String   @map("owner_id") @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  links SessionTagLink[]

  // One tag name per owner: makes the system-tag seed idempotent (createMany skipDuplicates)
  // and blocks duplicate custom names.
  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("session_tag")
}

// Join table wiring a SessionTag onto a Session (many-to-many). Both endpoints cascade-delete
// with their parent; unique on (session, tag) so an assignment is idempotent.
model SessionTagLink {
  id        String     @id @default(uuid(7)) @db.Uuid
  sessionId String     @map("session_id") @db.Uuid
  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tagId     String     @map("tag_id") @db.Uuid
  tag       SessionTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([sessionId, tagId])
  @@index([tagId])
  @@map("session_tag_link")
}

// A tool-permission request from claude's --permission-prompt-tool (served by the
// runner's orbit MCP server), awaiting a human allow/deny. The MCP tool blocks on a
// long-poll until status flips. Not a RunEvent: the orbit MCP server is a separate
// process from the runner's seq-owning session loop, so persisting it as an event
// would race the runner's monotonic seq. Idempotent on (sessionId, toolUseId).
model Approval {
  id           String    @id @default(uuid(7)) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  toolName     String    @map("tool_name")
  input        Json
  toolUseId    String?   @map("tool_use_id")
  // PENDING -> ALLOWED | DENIED
  status       String    @default("PENDING")
  message      String? // optional deny reason / note from the human
  // AskUserQuestion only: the human's picks, keyed by question text -> selected
  // option labels. The runner feeds this back to claude as updatedInput.answers.
  answers      Json?
  // Set when the human chose "allow + remember same kind": a claude permission rule
  // ({ toolName, ruleContent? }) the runner adds to the session so future matching
  // calls are auto-allowed by claude without re-prompting.
  rememberRule Json?     @map("remember_rule")
  // User who decided it (no FK; cf. Activity.actorId).
  decidedById  String?   @map("decided_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  decidedAt    DateTime? @map("decided_at")

  @@unique([sessionId, toolUseId])
  @@index([sessionId, status])
  @@map("approval")
}

// Normalized streamed events for a session (replay + live SSE).
model RunEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq       Int
  type      String
  payload   Json
  // conversation_turn.id that produced this event; null for session-level events.
  // No FK: high-volume append-only log (cf. Activity); both cascade-delete via session.
  turnId    String?  @map("turn_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  /// PostgreSQL receive time. Unlike createdAt, this is never supplied by the runner and is the
  /// only event clock an operational SLO may use. Historical rows remain null during the online
  /// rollout and use the migration's DB-owned rollout epoch. They are not rewritten or backfilled.
  ingestedAt DateTime? @default(now()) @map("ingested_at")
  /// Exact HTTP-authenticated provenance for post-0201 rows; null means a historical row whose
  /// current Session assignment must never be presented as exact historical identity.
  ingestedByRunnerId String? @map("ingested_by_runner_id") @db.Uuid
  ingestedUnderLeaseGeneration String? @map("ingested_under_lease_generation") @db.Uuid

  @@unique([sessionId, seq])
  @@index([sessionId, seq])
  @@index([turnId])
  @@map("run_event")
}

// Audit of every tool the agent invoked during a session.
model ToolCall {
  id         String    @id @default(uuid(7)) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name       String
  // The tool_use id the runtime assigned this call. A tool_result event arrives in a
  // later event batch than its tool_use, so it can only be joined back to this row by
  // (sessionId, toolUseId) — without the column, output/isError/finishedAt below were
  // unreachable and stayed NULL forever. Nullable because very old runners never sent an
  // id, and because it is the pairing key, the result update skips rows where it is unset.
  toolUseId  String?   @map("tool_use_id")
  input      Json?
  output     Json?
  isError    Boolean   @default(false) @map("is_error")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([sessionId])
  @@index([sessionId, toolUseId])
  @@map("tool_call")
}

// Per-model token/cost detail for billing rollups.
model LlmUsage {
  id                       String   @id @default(uuid(7)) @db.Uuid
  sessionId                String   @map("session_id") @db.Uuid
  session                  Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  model                    String
  inputTokens              Int      @default(0) @map("input_tokens")
  outputTokens             Int      @default(0) @map("output_tokens")
  cacheCreationInputTokens Int      @default(0) @map("cache_creation_input_tokens")
  cacheReadInputTokens     Int      @default(0) @map("cache_read_input_tokens")
  costUsd                  Float    @default(0) @map("cost_usd")
  createdAt                DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("usage")
}

// Durable, server-owned queue of user inputs for an interactive session (Route B).
// The runner long-polls these via GET /runner/sessions/:id/inbox; delivery is
// at-least-once with a lease + idempotency on (sessionId, clientTurnId).
model ConversationTurn {
  id              String    @id @default(uuid(7)) @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq             Int // server-assigned, per-session delivery ordering
  clientTurnId    String    @map("client_turn_id") // client-supplied idempotency key
  /// Hash of the complete logical resume request (authored content plus runtime configuration).
  /// Null on legacy/non-resume turns; lets an uncertain retry reject configuration drift.
  requestFingerprint String? @map("request_fingerprint") @db.Char(64)
  // message | steer | shell | interrupt | end | reload | setconfig | diff (see
  // ConversationTurnKind). A plain string, so a new kind needs no migration. `steer` is a
  // message written into the turn already running instead of queued behind its result;
  // `setconfig` is the half of a config change a resident engine can just be told about,
  // split off from `reload` so it need not wait for the running turn to end.
  kind            String    @default("message")
  /// Explicit sender routing. Null is the legacy server-side auto-steer/queue protocol.
  sendIntent      String?   @map("send_intent")
  /// The exact executable turn a CURRENT_WORK steer joins. Startup context uses its own
  /// append-only row rather than overloading this executable queue.
  targetTurnId    String?   @map("target_turn_id") @db.Uuid
  targetTurn      ConversationTurn?  @relation("ConversationTurnTarget", fields: [sessionId, targetTurnId], references: [sessionId, id], onDelete: NoAction, map: "conversation_turn_target_turn_id_fkey")
  targetedTurns   ConversationTurn[] @relation("ConversationTurnTarget")
  /// Durable terminal receipt for explicit CURRENT_WORK that never entered its exact target.
  /// Successful delivery remains represented by the runner-authored transcript events.
  deliveryStatus        String?   @map("delivery_status")
  deliveryFailureCode   String?   @map("delivery_failure_code")
  deliveryFailureReason String?   @map("delivery_failure_reason")
  deliveryTerminalAt    DateTime? @map("delivery_terminal_at")
  /// Runtime-authored USER acknowledgement, persisted by event ingest before turn-complete.
  deliveryAcknowledgedAt DateTime? @map("delivery_acknowledged_at")
  content         String? // user message text (null for interrupt/end)
  status          String    @default("PENDING") // PENDING | IN_FLIGHT | ANSWERED
  deliveredAt     DateTime? @map("delivered_at")
  leaseDeadlineAt DateTime? @map("lease_deadline_at")
  // Random runner-engine generation that owns the current delivery lease. A
  // delayed release from a dead process may expire only its own generation.
  leaseGeneration String?   @map("lease_generation") @db.Uuid
  /// Coordinator-context digest attached to this delivery. It is acknowledged onto Session only
  /// when this exact top-level turn succeeds under the same engine generation and compaction epoch.
  coordinatorContextKey String? @map("coordinator_context_key") @db.Char(64)
  answeredAt      DateTime? @map("answered_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  // Image blobs sent with this turn (web composer). Linked when the turn is enqueued;
  // the inbox hands their refs to the runner. Cascade so withdrawing/ending drops them.
  attachments Attachment[]
  startupFragments ConversationTurnStartupFragment[]

  @@unique([sessionId, clientTurnId])
  @@unique([sessionId, seq])
  @@unique([sessionId, id], map: "conversation_turn_session_id_id_key")
  @@index([sessionId, status])
  @@index([targetTurnId], map: "conversation_turn_target_turn_id_idx")
  @@map("conversation_turn")
}

// Append-only authored input accepted while the seeded first executable is still waiting for
// dequeue. It is delivered in that executable's prompt envelope and retained as a distinct
// receipt for idempotency, audit, attachments, retries, and terminal delivery state.
model ConversationTurnStartupFragment {
  id            String           @id @default(uuid(7)) @db.Uuid
  sessionId     String           @map("session_id") @db.Uuid
  session       Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  targetTurnId  String           @map("target_turn_id") @db.Uuid
  targetTurn    ConversationTurn @relation(fields: [sessionId, targetTurnId], references: [sessionId, id], onDelete: NoAction, map: "conversation_turn_startup_fragment_target_turn_id_fkey")
  clientTurnId  String           @map("client_turn_id")
  content       String
  createdAt     DateTime         @default(now()) @map("created_at")
  deliveredAt   DateTime?        @map("delivered_at")
  /// Null while unresolved; ACKNOWLEDGED, FAILED, or UNCONFIRMED once the runtime boundary
  /// supplies a durable outcome. UNCONFIRMED is deliberately not rollback-safe proof.
  deliveryStatus String?          @map("delivery_status")
  /// Runtime-authored USER acknowledgement for the combined opening envelope.
  acknowledgedAt DateTime?       @map("acknowledged_at")
  failedAt      DateTime?        @map("failed_at")
  failureCode   String?          @map("failure_code")
  failureReason String?          @map("failure_reason")
  attachments   Attachment[]

  @@unique([sessionId, clientTurnId], map: "conversation_turn_startup_session_client_key")
  @@index([targetTurnId, createdAt, id], map: "conversation_turn_startup_target_created_idx")
  @@map("conversation_turn_startup_fragment")
}

// Binary blob storage (currently web-composer image uploads) kept in-DB as bytea.
// Postgres is the only persistent store in the single-host Compose deployment (the
// apiserver mounts no volume), and the runner is a remote process that must fetch bytes
// over HTTP regardless of backend — so DB storage is the simplest option that also
// survives `upgrade`. Bytes are stored raw (not base64); callers base64-encode only at
// the claude/runner boundary. Bounded by a size cap + MIME allowlist (attachments.media.ts).
model Attachment {
  id        String            @id @default(uuid(7)) @db.Uuid
  ownerId   String            @map("owner_id") @db.Uuid // tenant scope; reads always filter by it
  owner     User              @relation(fields: [ownerId], references: [id])
  // Optional session scope: set when uploaded inside a session composer so the blob
  // cascade-deletes with the session. Null for uploads made before the session exists.
  sessionId String?           @map("session_id") @db.Uuid
  session   Session?          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Optional turn scope: set when the attachment is sent with a user turn, so the inbox
  // can hand the runner exactly that turn's images. Null until linked at enqueue time;
  // cascades with the turn (withdrawing a queued turn or ending the session drops it).
  turnId    String?           @map("turn_id") @db.Uuid
  turn      ConversationTurn? @relation(fields: [turnId], references: [id], onDelete: Cascade)
  // Startup context owns attachments without manufacturing an executable turn. Exactly one of
  // turnId/startupFragmentId may be populated (enforced by migration 0210).
  startupFragmentId String?                          @map("startup_fragment_id") @db.Uuid
  startupFragment   ConversationTurnStartupFragment? @relation(fields: [startupFragmentId], references: [id], onDelete: Cascade)
  mimeType  String            @map("mime_type")
  sizeBytes Int               @map("size_bytes")
  // Original upload filename. The runner writes a non-image/-PDF upload to the worktree
  // under this name and references it to claude. Null for legacy rows and pasted images.
  fileName  String?           @map("file_name")
  data      Bytes // raw bytes (bytea); Postgres TOAST compresses/offloads transparently
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([ownerId])
  @@index([sessionId])
  @@index([turnId])
  @@index([startupFragmentId])
  @@map("attachment")
}

// Lightweight activity feed (no FKs, append-only).
model Activity {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("activity")
}

// A user-created grouping of Tasks. Minimal: just a title + tenant scope.
// Deleting a list detaches its tasks (Task.listId -> null), never deletes them.
/// A body of work stated as an outcome: what is wanted, how anyone would know it was reached, and
/// how it is to be pursued.
///
/// Deliberately not a second TaskList. A list is a dispatch policy — it decides how its tasks run
/// (instructions spliced into the prompt, concurrency, pause, foreman) and every column on it
/// exists because some part of the dispatch path reads it. A project decides nothing about
/// dispatch: nothing in the sweep, the claim gate, the reconciler or the runner reads this table,
/// and this phase adds no code that does. That separation is the point of introducing it as its
/// own model rather than as more columns on the list — the two answer different questions ("how
/// should this class of work be run" vs "what are we trying to achieve"), and a campaign can be
/// re-organised along one axis without disturbing the other.
///
/// `goal` and `acceptanceCriteria` are separate columns rather than one prose blob because they
/// are read by different readers for different purposes: the goal is the standing statement of
/// intent, the criteria are what a check is run against. Merging them would make "is this done"
/// a matter of interpreting a paragraph, which is the failure verification exists to avoid.
model Project {
  id      String @id @default(uuid(7)) @db.Uuid
  title   String
  // Tenant scope: list/authorization always filter by this column (like tasks and task lists).
  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  /// What this project is trying to achieve, in words. Optional: a project is often filed before
  /// anyone can state the outcome precisely, and refusing to record it until then loses the only
  /// place the intent could live.
  goal               String?
  /// What would settle that the goal was reached. The same field exists on Task for the same
  /// reason it exists here — a claim of completion is only checkable against a stated condition.
  ///
  /// Compatibility projection only since migration 0172. The authored source of truth is
  /// `acceptanceCriterionDefinitions`; this text remains while older API/CLI clients still send
  /// and read it. A database trigger keeps the two representations in step, including writes from
  /// an older binary during a rolling upgrade.
  acceptanceCriteria String? @map("acceptance_criteria")
  /// Database-maintained sha256 of the current criteria's stable ids, monotone revisions, and
  /// semantic content hashes. This, rather than the compatibility text, is the acceptance fact:
  /// reordering a conjunction changes presentation without invalidating evidence, while an edit
  /// followed by restoring the same words still advances the revision and requires confirmation.
  acceptanceCriteriaDigest String @default("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") @map("acceptance_criteria_digest") @db.Char(64)
  /// LEGACY_TEXT while current definitions came through/backfilled from the compatibility field;
  /// STRUCTURED after a caller explicitly submitted item boundaries and stable ids.
  acceptanceCriteriaFormat String @default("LEGACY_TEXT") @map("acceptance_criteria_format")
  /// How this project's work is to be done, as opposed to which item is being done. The project
  /// counterpart of `TaskList.instructions`, and — importantly for this phase — NOT wired into
  /// any run prompt: nothing assembles it into a dispatch today. It is recorded so a coordinator
  /// can be given it later, not so a task silently starts inheriting it now.
  instructions       String?

  status ProjectStatus @default(OPEN)

  /// The session this project is coordinated from — one durable conversation per project.
  ///
  /// Written in either of two places, meaning the same thing in both. A project recorded from
  /// inside an agent session is bound HERE, in the same insert that creates the project, to the
  /// session that recorded it: the conversation a body of work was planned in is the conversation
  /// about that body of work. Everything else is resolved or created by
  /// `POST /projects/:id/coordinator`, which also replaces a binding whose session was trashed.
  /// The value is server-derived from the authenticated session context in both cases and is never
  /// accepted from a request body.
  ///
  /// A pointer, never a dependency, exactly as `TaskList.ownerSessionId` is: nothing on the
  /// dispatch path reads it, so a coordinator that dies, fails or is deleted cannot stall a single
  /// one of this project's tasks. `@unique` states the other half of the binding — a session
  /// coordinates at most one project — and gives the reverse lookup its index. NULLs are exempt
  /// from a Postgres unique index, so any number of projects may have no coordinator.
  ///
  /// SetNull on delete, which is what makes "deleted, so replaceable" true at the database rather
  /// than only in the service: losing the conversation empties the pointer, and the next request
  /// opens a new one. Cascade would delete the PROJECT — every task's `project_id` is RESTRICT, so
  /// it would not even succeed; it would make deleting a session fail against work it never touched.
  coordinatorSessionId   String?    @unique @map("coordinator_session_id") @db.Uuid
  coordinatorSession     Session?   @relation("ProjectCoordinator", fields: [coordinatorSessionId], references: [id], onDelete: SetNull)
  /// Where this project's coordinator runs — recorded rather than read back off the session
  /// (`Session.workspaceId` is nullable and belongs to the session's own lifecycle).
  ///
  /// Written wherever `coordinator_session_id` is, in the same statement and off the same session
  /// row, so the two can never disagree about where this project's coordinator runs. A project
  /// recorded from inside an agent session takes the workspace that session was running in;
  /// binding a coordinator afterwards writes the workspace it was opened in. So: the bound
  /// workspace while something is bound, and the last one after a coordinator is trashed — which
  /// is where its replacement reopens. A project created outside a session (the user-facing
  /// POST /projects, or a headless runner call) starts with both columns NULL and gets them at
  /// bind time.
  ///
  /// It is what a second request naming a DIFFERENT workspace is compared against — that is a 409,
  /// not a silent migration, because moving a coordinator is a decision with a conversation
  /// attached to it. SetNull for the reason above: a deleted workspace loses the record of where,
  /// not the coordinator.
  coordinatorWorkspaceId String?    @map("coordinator_workspace_id") @db.Uuid
  coordinatorWorkspace   Workspace? @relation("ProjectCoordinatorWorkspace", fields: [coordinatorWorkspaceId], references: [id], onDelete: SetNull)

  /// Whether this project's coordinator may act at all. The off switch, kept separate from
  /// `automationPolicy` because "stop for now" and "how far may it go when it runs" are two
  /// decisions a user changes independently — one column would let a pause overwrite the level
  /// they chose, and they would have to remember it to get back.
  ///
  /// FALSE at the database, which is what makes the migration safe: every project that existed
  /// before this column stays exactly as silent as it was. A project created AFTER it is written
  /// `true` explicitly by the service, so the two populations differ by a decision rather than by
  /// when they happened to be created.
  coordinatorEnabled  Boolean                 @default(false) @map("coordinator_enabled")
  /// How far it may go when it does run (see ProjectAutomationPolicy).
  ///
  /// The column default is MANUAL and `ProjectsService.create` writes GUARDED_AUTO explicitly.
  /// Doing it the other way around — defaulting the column to GUARDED_AUTO and updating the old
  /// rows in the migration — leaves a window between the migration and the new code in which every
  /// project created lands automatic, and the rows it would have to rewrite are the ones whose
  /// owners never asked for any of this.
  automationPolicy    ProjectAutomationPolicy @default(MANUAL) @map("automation_policy")
  /// How many of this project's tasks may be in flight at once — the user's own number, and an
  /// ADMISSION limit rather than a statement about the present: lowering it is always allowed,
  /// never cancels anything already running, and applies to the next start. (Killing sessions to
  /// satisfy a lowered cap would be the destructive thing a cap is not for.)
  maxConcurrentTasks  Int                     @default(3) @map("max_concurrent_tasks")
  /// How many sessions the coordinator itself may start in a rolling 24h. NULL = no limit.
  /// Sessions a person starts are not counted by it and are never refused because of it.
  sessionBudgetPerDay Int?                    @map("session_budget_per_day")
  /// Bumped by exactly one on every write to the four fields above — the authorization set.
  ///
  /// Not a lock and not a compare-and-set: mutual exclusion between a person changing these and a
  /// coordinator acting on what it read comes from the row lock both take. This column is what
  /// makes such a race READABLE afterwards — a decision records the revision it read and the
  /// revision it committed under, so "was this authorized when it happened" is a comparison rather
  /// than an archaeology. BigInt for the same reason every monotonic counter here is: it is only
  /// ever allowed to go up.
  configRevision      BigInt                  @default(0) @map("config_revision")

  /// `[K2]` / convergence §8: this project's OVERRIDES of the bounded-convergence thresholds and
  /// of one attempt's resource budget. Null means the frozen `GUARDED_AUTO` defaults, which is why
  /// migration 0138 changes no project's behaviour on the day it lands — an existing project keeps
  /// finite limits without anybody having chosen them.
  ///
  /// Read through `resolveThresholds` / `resolveAttemptBudget` and never directly: those are where
  /// an override that is not an integer, or a `null` nobody signed for, falls back to the default.
  convergenceThresholds Json? @map("convergence_thresholds")
  attemptBudget         Json? @map("attempt_budget")

  /// OW4's signature: `{ actor: 'USER', principal }`, and the only thing that makes an unbounded
  /// threshold mean unbounded. An agent's own authorization is not a weaker authorization; it is
  /// not one, and migration 0138's CHECK refuses to store it — so a stray PATCH or a migration
  /// cannot switch the breaker off for every project at once.
  unboundedAuthorizedBy Json? @map("unbounded_authorized_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// The acceptance run this project's DONE is standing on (§13.4 AE2), and the only thing that
  /// makes a DONE legal for a project that has ever been accepted natively. Written in the same
  /// locked transaction as `status = DONE`, and cleared by the reopen path — so "DONE" and "there
  /// is evidence for it" are one row and cannot drift apart.
  ///
  /// A plain column rather than a Prisma relation: `project → run → project` is a cycle Prisma
  /// refuses to give referential actions to. The foreign key is real all the same — migration 0127
  /// declares it `ON DELETE SET NULL`.
  acceptedRunId String? @map("accepted_run_id") @db.Uuid

  /// Which acceptance this project is on (unit L2, migration 0150). Monotonic, never reused, and
  /// advanced by exactly one every time the project is REOPENED — a settled status (DONE or
  /// CANCELLED) moving back to OPEN.
  ///
  /// It answers the one question `project_runtime.acceptance_attempt` cannot: that counter moves
  /// when acceptance is re-RUN and stands still when the project is reopened, which is the opposite
  /// way round. A run records the epoch it was opened in, so "is this PASS the current one" is an
  /// integer comparison the DONE gate makes — and a historical PASS stops being current by being
  /// READ, not by being rewritten. That matters: `superseded_at` says the same thing along the one
  /// service path that remembers to write it, and says nothing at all when a project is reopened by
  /// a raw UPDATE, by a DONE → CANCELLED → OPEN route, or by a binary that predates this column.
  ///
  /// Maintained ENTIRELY by the database (`project_acceptance_advance_epoch`), which is what makes
  /// the previous sentence true for writers that have never heard of it. No service writes it; a
  /// value sent for this column is overwritten with the one the transition implies.
  acceptanceEpoch BigInt @default(0) @map("acceptance_epoch")

  /// When this project was marked as carrying a DONE that predates native acceptance (§13.5 LG1).
  /// Migration 0127 stamps every project that was already DONE, which is what keeps AC11's promise
  /// here: an old DONE is not reopened, not invalidated and not silently re-labelled as evidence —
  /// it is labelled as exactly what it is, and the label is what the next DONE has to replace.
  legacyAcceptedAt DateTime? @map("legacy_accepted_at")

  tasks   Task[]
  /// Tasks this project's coordination scope NOTICED but does not necessarily own. Evidence, not
  /// membership: `tasks` is the project's work, this is a list of writes that named it as where
  /// they came from. Nothing that decides anything reads it (contract §3 SC7).
  discoveredTasks Task[] @relation("TaskDiscoveredFrom")
  members ProjectMember[]
  runtime ProjectRuntime?
  actions ProjectAction[]
  blockers  ProjectBlocker[]
  verdictFailures TaskVerificationFailure[]
  acceptanceRuns  ProjectAcceptanceRun[]     @relation("ProjectAcceptanceRuns")
  acceptanceConclusions ProjectAcceptanceConclusion[]
  acceptanceCriterionDefinitions ProjectAcceptanceCriterionDefinition[]
  acceptanceCriteriaConfirmations ProjectAcceptanceCriteriaConfirmation[]
  acceptanceAudit ProjectAcceptanceAudit[]
  mergeEvidence   ProjectMergeEvidence[]
  mergeReceipts   SessionMergeReceipt[]

  /// Presses of Run Now recorded against this project's tasks (0137).

  /// Cross-project crossings decided about this project, in both directions (unit L4, 0155).
  handoffsOut ProjectHandoffApproval[] @relation("ProjectHandoffFrom")
  handoffsIn  ProjectHandoffApproval[] @relation("ProjectHandoffTo")

  /// The committed facts that woke this project's coordinator (unit T2, 0173).
  coordinatorWakes ProjectCoordinatorWake[]

  /// The progress ledger those wakes are charged against (unit T4, 0176).
  convergenceDecisions ProjectConvergenceDecision[]

  @@index([ownerId])
  // The referencing side of the workspace FK. Postgres indexes the REFERENCED column automatically
  // and the referencing one never, so without this every workspace delete has to scan project to
  // find the rows its SET NULL applies to. (`coordinatorSessionId` needs no entry here — its
  // `@unique` already is one.)
  @@index([coordinatorWorkspaceId])
  @@map("project")
}

/// One CURRENT, authored project acceptance criterion.
///
/// This is deliberately not `ProjectAcceptanceCriterion`: that row is an immutable snapshot inside
/// one acceptance run. Definitions are editable and carry a stable identity across reordering and
/// wording revisions; a run copies them rather than pointing at mutable text.
model ProjectAcceptanceCriterionDefinition {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Presentation order only. Project acceptance is a conjunction, so this is intentionally not
  /// part of the semantic criteria digest: reordering cannot make evidence stale.
  ordinal Int
  /// One atomic condition. Inline Markdown is allowed; item boundaries are structural rather than
  /// inferred from punctuation or list markers.
  text String
  /// The required procedure/evidence by which a reader decides whether `text` holds. Legacy prose
  /// rows receive an explicit manual-review method during migration rather than an invented test.
  verificationMethod String @map("verification_method")
  /// The same peer criterion family used by Task. There is intentionally no project-specific
  /// enum and no fallback order between these values.
  completionCriterion TaskCompletionCriterion @map("completion_criterion")
  /// EXECUTABLE declarations name the exact command/result pair to consume. They are null for the
  /// two peer criteria rather than acting as an implicit executable declaration.
  acceptanceCommand          String? @map("acceptance_command")
  acceptanceExpectedExitCode Int?    @map("acceptance_expected_exit_code")
  /// EXECUTABLE: the Task whose recorded command result is evidence. VERIFICATION: the independent
  /// verifier Task whose current verdict is evidence. Historical pointer; deliberately no FK.
  evidenceTaskId String? @map("evidence_task_id") @db.Uuid
  /// N23's advisory override audit, using the same field and keyword table as Task declarations.
  completionCriterionOverrideReason String? @map("completion_criterion_override_reason")
  /// Monotonic for this stable id. Editing the assertion, method, criterion kind, or mechanical
  /// input increments it; reordering and advisory-override prose leave it alone.
  revision Int @default(1)
  /// sha256 of the normalized assertion, reader-facing method, criterion kind, and mechanical
  /// inputs. Legacy reconciliation separately hashes text when matching old lines to stable ids.
  contentHash String @map("content_hash") @db.Char(64)

  /// Owner Ratification separates the meaning being approved from the machinery that evaluates
  /// it. Text and criterion trust advance the semantic lane; commands, verifier prose and evidence
  /// wiring advance the evaluation-plan lane. `revision`/`contentHash` above remain the combined
  /// acceptance-evidence identity for rolling compatibility.
  semanticRevision      Int    @default(1) @map("semantic_revision")
  semanticHash          String @default(dbgenerated()) @map("semantic_hash") @db.Char(64)
  evaluationPlanRevision Int   @default(1) @map("evaluation_plan_revision")
  evaluationPlanHash    String @default(dbgenerated()) @map("evaluation_plan_hash") @db.Char(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([projectId, ordinal], map: "project_acceptance_definition_ordinal_idx")
  @@index([projectId, contentHash], map: "project_acceptance_definition_content_idx")
  @@map("project_acceptance_criterion_definition")
}

/// One confirmation that the complete standard set represented by `criteriaDigest` is a valid
/// expression of the project's goal. It is append-only and set-scoped: there is no criterion id.
/// A later definition edit advances the digest and therefore makes this row historical without
/// rewriting it. Actor provenance is audit visibility, not proof a human held the credential.
model ProjectAcceptanceCriteriaConfirmation {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  criteriaDigest  String @map("criteria_digest") @db.Char(64)
  confirmedByType String @map("confirmed_by_type")
  confirmedById   String @map("confirmed_by_id") @db.Uuid
  actingSessionId String? @map("acting_session_id") @db.Uuid
  confirmedAt     DateTime @default(now()) @map("confirmed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([projectId, criteriaDigest], map: "project_acceptance_confirmation_digest_key")
  @@index([projectId, confirmedAt(sort: Desc)], map: "project_acceptance_confirmation_project_idx")
  @@map("project_acceptance_criteria_confirmation")
}

/// Rebuildable current projection of the Project completion contract. The owner decision is the
