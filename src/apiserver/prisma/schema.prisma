/// One verification conclusion that was not a PASS, and what it is still holding up (§13.2).
///
/// A row rather than a status written onto the tasks it blocks (V3): "why can this task not run"
/// has to remain a question the data answers. Rewriting the downstream tasks' status would answer
/// it once, in a place nobody can read afterwards.
///
/// Identity is `(verifierTaskId, verdictRevision)`, the same pair the action key is built from, so
/// the same conclusion delivered any number of times leaves exactly one row — while a genuinely
/// new conclusion, which by V7 carries a new revision, leaves a new one.
/// `[K2]` / convergence §1: one version of what a task is asking for, frozen.
///
/// The table exists because the incident's scope grew from "fix one bug" into "AutoRetry + deploy +
/// lock ordering" without a single one of those expansions ever being a decision somebody made.
/// A revision row is that decision, with a name on it — and the OLD rows are the audit: after an
/// expansion you can still read what the task used to ask for, and therefore whether the attempts
/// charged to that revision were spent on the thing that was asked.
///
/// Immutable and never deleted except with the task (migration 0138's trigger). Editing a version
/// in place would destroy the only evidence that earlier attempts answered a different question.
///
/// Having a row here is what puts a task under convergence management. Revision 1 is unsigned —
/// `authorizedByActor` null, meaning "as found" — because the task's original statement of scope is
/// not something anybody revised into being. Revisions 2 and up must name a signatory, and §1's
/// authority table decides who may be one.
model TaskScopeRevision {
  id       String @id @default(uuid(7)) @db.Uuid
  taskId   String @map("task_id") @db.Uuid
  ownerId  String @map("owner_id") @db.Uuid
  task     Task   @relation(fields: [taskId, ownerId], references: [id, ownerId], onDelete: Cascade)
  revision Int

  /// §1's digest of the three columns below. It is the identity a progress vector (§4 PV3) and a
  /// failure fingerprint (§5 FP3) are measured against; the text is kept verbatim beside it so the
  /// audit can answer "what did it say", not only "did it change".
  scopeHash          String  @map("scope_hash") @db.Char(64)
  title              String
  description        String?
  acceptanceCriteria String? @map("acceptance_criteria")

  /// WHO signed for this version, and under WHICH policy. The policy is recorded rather than looked
  /// up later, because `automationPolicy` is mutable and an audit that re-reads today's value
  /// cannot answer whether a coordinator was allowed to do this at the time it did it.
  authorizedByActor     String? @map("authorized_by_actor")
  authorizedByPrincipal String? @map("authorized_by_principal")
  automationPolicy      String? @map("automation_policy")
  reason                String
  supersedesRevision    Int?    @map("supersedes_revision")
  createdAt             DateTime @default(now()) @map("created_at")

  decisions TaskConvergenceDecision[]
  attempts  TaskAttempt[]
  findings  TaskVerificationFinding[]
  checkpoints TaskCheckpoint[]

  @@unique([taskId, revision])
  /// The composite key `TaskConvergenceDecision` points at. Naming the HASH as well as the revision
  /// is what stops a judgment from claiming to have been measured against a scope that never had
  /// that content (§6 FD4).
  @@unique([taskId, revision, scopeHash], map: "task_scope_revision_identity_key")
  @@index([ownerId])
  @@map("task_scope_revision")
}

/// `[K2]` / convergence: one coordination judgment about one task, append-only.
///
/// Everything §8 reads is here rather than in a process: the snapshot the judgment was a function
/// of and its hash, the attempt generation, the failure fingerprint, the progress vector, the
/// decision, the action and the key it was applied under, the known-good checkpoint, and what has
/// to happen next / who can do it / when to look again. `[K1]`'s functions decide; this is what
/// they decide FROM after a restart, a takeover or a redelivered event (RL3).
///
/// `idempotencyKey` is keyed on the FACT's own identity, not on the reader's snapshot — a snapshot
/// changes the moment the first delivery commits, so hashing it would give a redelivery a different
/// key and write the same fact twice. That is AC1: however many times and in whatever order an
/// event arrives, at most one logical decision and one logical action land.
model TaskConvergenceDecision {
  id      String @id @default(uuid(7)) @db.Uuid
  taskId  String @map("task_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  task    Task   @relation(fields: [taskId, ownerId], references: [id, ownerId], onDelete: Cascade)
  /// Monotonic within a task, allocated `MAX + 1` under the task row lock. It gives the ledger a
  /// replay ORDER that does not depend on `createdAt`, which two writers can tie on.
  seq     BigInt

  scopeRevision     Int               @map("scope_revision")
  scopeHash         String            @map("scope_hash") @db.Char(64)
  scope             TaskScopeRevision @relation(fields: [taskId, scopeRevision, scopeHash], references: [taskId, revision, scopeHash], onDelete: Cascade)
  attemptGeneration BigInt            @map("attempt_generation")

  idempotencyKey String @unique @map("idempotency_key")
  inputHash      String @map("input_hash") @db.Char(64)
  input          Json

  event          String
  fromState      String  @map("from_state")
  toState        String  @map("to_state")
  classification String?
  decision       String

  /// What the judgment DID, and under which key. Both or neither: an action without a key is one a
  /// takeover cannot recognise as already done, which is how one decision becomes two dispatches.
  action               String?
  actionIdempotencyKey String? @map("action_idempotency_key")

  failureFingerprint   String?  @map("failure_fingerprint") @db.Char(64)
  /// `[K4]` §5.1: the normalized identity of the action this judgment PROPOSED, and of the
  /// hypothesis behind it. Not `actionIdempotencyKey`, which carries the attempt generation so a
  /// redelivery can be recognised — an identity that carried it could never see a repeat.
  actionIdentity       String?  @map("action_identity") @db.Char(64)
  hypothesisIdentity   String?  @map("hypothesis_identity") @db.Char(64)
  /// `[K4]` PV6: how old the oldest piece of evidence behind `progressVector` was, and whether the
  /// reading may be believed. Null means the writer took no reading; `UNMEASURED` means the
  /// reading came back empty, which is a broken evidence pipeline rather than a clean world.
  evidenceFreshness    String?   @map("evidence_freshness")
  evidenceAsOf         DateTime? @map("evidence_as_of")
  progressVector       Json     @map("progress_vector")
  progressVectorDigest String   @map("progress_vector_digest") @db.Char(64)
  progressed           Boolean
  counters             Json
  nonConvergenceReason String?  @map("non_convergence_reason")
  knownGoodSha         String?  @map("known_good_sha")

  /// §11.1's three questions, asked per task rather than per project: what has to happen, who can
  /// make it happen, and when this is worth looking at again. `nextCheckAt` is null wherever the
  /// owner is USER — a wait that ends when a person decides has no clock.
  requiredAction String?   @map("required_action")
  owner          String?
  nextCheckAt    DateTime? @map("next_check_at")

  /// Historical attribution, deliberately without foreign keys (migration 0120's rule): deleting or
  /// rotating a session must not rewrite which run made an earlier judgment.
  decidedBy         String  @map("decided_by")
  sessionId         String? @map("session_id") @db.Uuid
  projectDecisionId String? @map("project_decision_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([taskId, seq], map: "task_convergence_decision_seq_key")
  @@index([taskId, seq(sort: Desc)])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([taskId, scopeRevision, failureFingerprint])
  /// The window query `[K4]` asks on every judgment: this task, this revision, this action, since
  /// the last row that progressed. Both are partial indexes, declared in migration 0140 (as with
  /// `actionIdempotencyKey`), because this schema cannot spell a WHERE clause.
  @@index([taskId, scopeRevision, actionIdentity])
  /// `[K5]`: the findings this judgment was made about. At most one today — a finding commits with
  /// its own decision — and a list rather than a single row because the ledger is append-only and
  /// the shape of "which findings does this judgment answer for" must not need a migration to grow.
  findings TaskVerificationFinding[]
  @@map("task_convergence_decision")
}

/// `[K3]`: one attempt — one Session, under one Task, under one scope revision (migration 0139).
///
/// The identity is the point, and it comes before any limit. `[K1]` made the breaker decidable and
/// `[K2]` made its counters durable, and neither would have stopped the incident: those hundreds of
/// rounds never crossed an attempt line because they were never hundreds of attempts. They were ONE
/// session steered hundreds of times — which adds no attempt, mints no new fingerprint, and leaves
/// every liveness check green because the loop really is busy.
///
/// Still no new business entity (RL4): this is a subordinate table between Task and Session, and
/// the business layer continues to be Project and Task.
model TaskAttempt {
  id      String @id @default(uuid(7)) @db.Uuid
  taskId  String @map("task_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  task    Task   @relation(fields: [taskId, ownerId], references: [id, ownerId], onDelete: Cascade)
  /// AT1. NOT NULL because an attempt with nothing running is not a weaker attempt, it is not one.
  /// Cascade on delete: purging a session destroys the run this row is a fact ABOUT, while the
  /// spend it was charged survives in `[K2]`'s ledger, which keeps its own copy of the generation.
  sessionId String  @map("session_id") @db.Uuid
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  scopeRevision     Int               @map("scope_revision")
  scopeHash         String            @map("scope_hash") @db.Char(64)
  /// §5 FP3 as a foreign key: an attempt names the revision it was spent on, hash included, so it
  /// cannot be re-pointed at a different question after the fact.
  revision          TaskScopeRevision @relation(fields: [taskId, scopeRevision, scopeHash], references: [taskId, revision, scopeHash], onDelete: Cascade, map: "task_attempt_scope_revision_fkey")
  attemptGeneration BigInt            @map("attempt_generation")

  /// GN1: the durable identity of THIS dispatch, supplied by the caller — never a fresh UUID. A
  /// replay after a crash re-derives it and reads its own row back instead of opening a second
  /// generation. The same rule, for the same reason, as `[K2]`'s observation key.
  attemptKey String @map("attempt_key")
  /// AT3: what this attempt will do DIFFERENTLY. The digest is a gate, not decoration — migration
  /// 0139 refuses a second attempt carrying the previous one's, unless that one ended `TRANSIENT`.
  hypothesis       String
  hypothesisDigest String @map("hypothesis_digest") @db.Char(64)

  /// BD5: the six limits in force when this attempt opened, frozen. Judged against this copy and
  /// not the project's current policy, so a policy edit mid-flight can neither end a running
  /// attempt nor revive one already asked to stop — both are one result overwriting another.
  budget Json
  /// The last measured spend, for the read face; the budget decision is taken against a fresh
  /// measurement. Null until something has been measured.
  spend  Json?
  /// The one dimension the control plane itself writes rather than reads (AU3). Monotonic.
  coordinatorSteers Int @default(0) @map("coordinator_steers")

  /// §2's lifecycle: OPEN → WINDING_DOWN → CLOSED. `WINDING_DOWN` exists so that "was asked to
  /// stop" is a committed fact rather than an intention held in whoever asked.
  status             String  @default("OPEN")
  /// NC2's four real endings. `CANCELLED` is not among them and a CHECK refuses it, so "cancel the
  /// run and call that its result" is a statement this table cannot store.
  outcome            String?
  classification     String?
  exhaustedDimension String? @map("exhausted_dimension")

  /// NC5: the pointer half of §7's checkpoint. The `ACCEPTED`/`WIP_RED` table and the merge gate
  /// that reads it are `[K6]`; an `ACCEPTED` sha here is also written back to `task.knownGoodSha`.
  checkpointSha            String? @map("checkpoint_sha")
  checkpointKind           String? @map("checkpoint_kind")
  checkpointEvidenceDigest String? @map("checkpoint_evidence_digest")
  /// NC3's "if there is none, say there is none". A crash HAS none; inventing a checkpoint would
  /// make the next generation resume from a point that does not exist.
  noCheckpointReason       String? @map("no_checkpoint_reason")

  /// SD1: evidence crosses a generation, context does not.
  inheritedKnownGoodSha String?   @map("inherited_known_good_sha")
  windDownRequestedAt   DateTime? @map("wind_down_requested_at")
  closedAt              DateTime? @map("closed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  /// `[K6]`: the checkpoints this attempt wrote on its way out (§2 NC5, §7).
  checkpoints TaskCheckpoint[]

  @@unique([attemptKey], map: "task_attempt_attempt_key_key")
  /// AC4 in one line: the same (task, revision, generation) is never started twice. Two
  /// coordinators, a redelivered event and a takeover all compute the same triple; one lands.
  @@unique([taskId, scopeRevision, attemptGeneration], map: "task_attempt_generation_key")
  /// AT1, and AC3's mechanical half: a "fresh generation" that actually resumes the previous
  /// session — inheriting its unbounded context with it — is a row this refuses.
  @@unique([sessionId], map: "task_attempt_session_key")
  /// One live attempt per task is enforced by a PARTIAL unique index this schema cannot spell
  /// (`task_attempt_one_open_key`, `WHERE status <> 'CLOSED'`), the same trade `Session.retryAt`
  /// and migration 0108's pair already carry.
  @@index([taskId, scopeRevision, attemptGeneration(sort: Desc)], map: "task_attempt_task_generation_idx")
  @@index([ownerId, createdAt(sort: Desc)], map: "task_attempt_owner_created_idx")
  @@map("task_attempt")
}

/// `[K5]` §6 (migration 0141): the only shape a verification Session may write.
///
/// §1 OW1 forbids a verifier from touching the subject's scope and OW2 forbids a worker from
/// approving its own new acceptance criteria; this is the row both of them write INSTEAD. A finding
/// changes nothing about the subject — it is a claim about it — and §3's frozen table turns exactly
/// one claim into exactly one piece of work.
///
/// Append-only, and keyed twice. `dedupKey` is FD1's identity of the FINDING, so the same defect
/// reported by a second check, after a restart, or out of order lands on the row that already
/// exists. `effectIdempotencyKey` is the identity of its one EFFECT, so a crash between the row and
/// the Task it files cannot produce two Tasks on replay. Both are needed: the first stops a second
/// finding, the second stops a second consequence of one finding.
model TaskVerificationFinding {
  id      String @id @default(uuid(7)) @db.Uuid
  taskId  String @map("task_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  task    Task   @relation("FindingSubject", fields: [taskId, ownerId], references: [id, ownerId], onDelete: Cascade)
  /// Denormalised from the task: FD1's key is scoped by project, and the finding must keep
  /// answering for the project it was filed in even after the task is re-filed elsewhere.
  projectId String? @map("project_id") @db.Uuid
  /// Monotonic within a task, allocated `MAX + 1` under the task row lock — a replay ORDER that
  /// does not depend on `createdAt`, which two writers can tie on.
  seq     BigInt

  scopeRevision Int               @map("scope_revision")
  scopeHash     String            @map("scope_hash") @db.Char(64)
  /// FD4 as a foreign key, hash included: a finding cannot be re-pointed at a scope that never had
  /// the content it was measured against.
  scope         TaskScopeRevision @relation(fields: [taskId, scopeRevision, scopeHash], references: [taskId, revision, scopeHash], onDelete: Cascade, map: "task_verification_finding_scope_fkey")

  dedupKey String @unique @map("dedup_key")

  /// §6's table, verbatim. Every column required, because every row of that table says 是.
  severity            String
  violatedInvariant   String @map("violated_invariant")
  minimalRepro        String @map("minimal_repro")
  failureFingerprint  String @map("failure_fingerprint") @db.Char(64)
  scopeClassification String @map("scope_classification")
  /// Base62 throughout: a finding is audit material a person reads and hands back, and an id
  /// spelled as an internal UUID is neither.
  evidence            Json
  verdict             String

  /// Who claimed it, and from where. No foreign keys on the two ids (migration 0120's rule):
  /// deleting a session or rotating a task must not rewrite who reported an earlier finding.
  reporter          String
  reporterTaskId    String? @map("reporter_task_id") @db.Uuid
  reporterSessionId String? @map("reporter_session_id") @db.Uuid

  /// FD2's answer and how it was reached. `effectiveClassification` differs from what was submitted
  /// only under CL2, and then `overrideReason` says so — a rewrite that left no trace would make
  /// "it was called transient six times" unaskable.
  effectiveClassification String  @map("effective_classification")
  outcome                 String
  overrideReason          String? @map("override_reason")
  effectKind              String  @map("effect_kind")

  effectIdempotencyKey String  @unique @map("effect_idempotency_key")
  /// The Task this finding filed, for the three outcomes that file one. `SetNull` rather than
  /// Cascade: deleting the defect must leave the finding saying it filed one that is now gone.
  effectTaskId         String? @map("effect_task_id") @db.Uuid
  effectTask           Task?   @relation("FindingEffectTask", fields: [effectTaskId], references: [id], onDelete: SetNull)
  effectBlockerKind    String? @map("effect_blocker_kind")

  /// finding → decision, and the reason this is not a second ledger: the judgment that turned this
  /// finding into that effect lives in `[K2]`'s ledger with its counters and its input hash.
  decisionId String?                  @map("decision_id") @db.Uuid
  decision   TaskConvergenceDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  /// §11.1's three questions, per finding. `nextCheckAt` is null wherever the owner is USER — a
  /// wait that ends when a person decides has no clock.
  requiredAction String    @map("required_action")
  owner          String
  nextCheckAt    DateTime? @map("next_check_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([taskId, seq], map: "task_verification_finding_seq_key")
  @@index([taskId, seq(sort: Desc)], map: "task_verification_finding_task_idx")
  @@index([ownerId, createdAt(sort: Desc)], map: "task_verification_finding_owner_idx")
  /// FD3': "has this revision already been repaired, and how bad was it then" — one index scan on
  /// the exact three columns the triage reads.
  @@index([taskId, scopeRevision, seq(sort: Desc)], map: "task_verification_finding_repair_idx")
  @@index([effectTaskId], map: "task_verification_finding_effect_task_idx")
  @@map("task_verification_finding")
}

/// `[K6]` §7 (migration 0152): the known-good point, and the known-red one.
///
/// `[K3]` gave `task_attempt` the POINTER half of a checkpoint — a sha, a kind, an evidence digest
/// — and said the table was a later unit. This is it, and what it adds is the three things a
/// pointer cannot answer: what the state IS (commit, tree, base, so a second machine can rebuild
/// it), what makes it known-good (the test evidence, digested), and where known-RED work lives when
/// the machine that produced it is gone (CP2's artifact). §0's incident lost work exactly there: a
/// `git stash` on one runner, neither lost nor reachable.
///
/// Append-only and immutable by trigger. CP1 says changing a field is a NEW checkpoint, so identity
/// is spelled over the whole content (`contentDigest`) and the unique `dedupKey` makes recording
/// the same thing twice a no-op rather than a second row.
model TaskCheckpoint {
  id      String @id @default(uuid(7)) @db.Uuid
  taskId  String @map("task_id") @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  task    Task   @relation(fields: [taskId, ownerId], references: [id, ownerId], onDelete: Cascade)
  /// Denormalised from the task: the dedup key is project-scoped, and a checkpoint must keep
  /// answering for the project it was recorded in after the task is re-filed elsewhere.
  projectId String? @map("project_id") @db.Uuid
  /// Monotonic within a task, allocated `MAX + 1` under the task row lock. "The LATEST accepted
  /// checkpoint" is the whole baseline rule, so it may not rest on `createdAt`, which two writers
  /// can tie on.
  seq     BigInt

  scopeRevision Int               @map("scope_revision")
  scopeHash     String            @map("scope_hash") @db.Char(64)
  /// FD4 as a foreign key: a checkpoint names the revision it was verified against, hash included,
  /// so it cannot be re-pointed at a scope that never had that content.
  revision      TaskScopeRevision @relation(fields: [taskId, scopeRevision, scopeHash], references: [taskId, revision, scopeHash], onDelete: Cascade, map: "task_checkpoint_scope_revision_fkey")

  /// §7's first column. Derived from the evidence, never supplied — a caller that could name its
  /// own kind could call a red tree `ACCEPTED`, and every property below it rests on that word.
  kind String

  branch    String
  commitSha String @map("commit_sha") @db.Char(40)
  /// Not redundant with `commitSha`: two runners replaying the same work produce two commits and
  /// one tree, and it is the TREE that answers "is this the same state".
  treeSha   String @map("tree_sha") @db.Char(40)
  baseSha   String @map("base_sha") @db.Char(40)

  /// §7's "有测试证据", as a row rather than an adjective. Both null for a red point; a CHECK
  /// requires both for an accepted one.
  evidenceDigest String? @map("evidence_digest") @db.Char(64)
  testEvidence   Json?   @map("test_evidence")

  /// CP2: how this is recovered on a machine that has never seen it. A CHECK refuses every kind
  /// that does not travel — which is "不得只依赖某台机器上的 stash", said mechanically.
  artifactKind   String? @map("artifact_kind")
  artifactRef    String? @map("artifact_ref")
  artifactDigest String? @map("artifact_digest") @db.Char(64)

  /// CP1's identity: every field above, hashed.
  contentDigest String @map("content_digest") @db.Char(64)
  dedupKey      String @map("dedup_key")

  /// Provenance, never an input to a decision. No foreign key on `sessionId`, on migration 0120's
  /// rule: deleting a session must not rewrite who recorded an earlier checkpoint.
  recordedBy String  @map("recorded_by")
  sessionId  String? @map("session_id") @db.Uuid
  /// `[K3]`'s attempt this came out of. SetNull rather than Cascade: purging the RUN must not
  /// destroy the known-good point the next generation is standing on.
  attemptId  String?      @map("attempt_id") @db.Uuid
  attempt    TaskAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  /// The merges recorded against this checkpoint (CP4), and the queued merges authorised for it.
  mergeReceipts   SessionMergeReceipt[]
  authorisedMerges Session[]            @relation("SessionMergeCheckpoint")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([dedupKey], map: "task_checkpoint_dedup_key")
  @@unique([taskId, seq], map: "task_checkpoint_seq_key")
  /// "The latest ACCEPTED checkpoint of this task" — the baseline rule, in one indexed read.
  @@index([taskId, kind, seq(sort: Desc)], map: "task_checkpoint_task_kind_seq_idx")
  @@index([ownerId, createdAt(sort: Desc)], map: "task_checkpoint_owner_created_idx")
  @@index([commitSha], map: "task_checkpoint_commit_idx")
  @@map("task_checkpoint")
}

model TaskVerificationFailure {
  id              String  @id @default(uuid(7)) @db.Uuid
  projectId       String  @map("project_id") @db.Uuid
  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  verifierTaskId  String  @map("verifier_task_id") @db.Uuid
  verifier        Task    @relation("VerificationFailureVerifier", fields: [verifierTaskId], references: [id], onDelete: Cascade)
  subjectTaskId   String  @map("subject_task_id") @db.Uuid
  subject         Task    @relation("VerificationFailureSubject", fields: [subjectTaskId], references: [id], onDelete: Cascade)

  /// FAIL or INCONCLUSIVE; a PASS has no condition to record, it resolves the ones already here.
  /// The migration says so with a CHECK, since this table is written from more than one place.
  verdict         TaskVerdict
  verdictRevision BigInt      @map("verdict_revision")
  /// Whether the tasks depending on the subject are stopped. True exactly for FAIL — §13.2 gives
  /// downstream blocking to the revert, and INCONCLUSIVE deliberately reverts nothing.
  blocksDownstream Boolean    @map("blocks_downstream")

  /// The subtask filed under the subject to fix what the check found. Null for INCONCLUSIVE, and
  /// null again if somebody deletes it — which leaves the condition unresolved and visibly without
  /// the work item that was going to resolve it.
  defectTaskId     String? @map("defect_task_id") @db.Uuid
  defect           Task?   @relation("VerificationFailureDefect", fields: [defectTaskId], references: [id], onDelete: SetNull)
  raisedByActionId String? @map("raised_by_action_id") @db.Uuid
  raisedByAction   ProjectAction? @relation("VerificationFailureAction", fields: [raisedByActionId], references: [id], onDelete: SetNull)

  /// Base62 throughout, in Base62: this is read back over the audit API
  /// and an id spelled as a UUID here is one no caller could hand to any other endpoint.
  evidence Json @default("{}")

  /// Set only by a later PASS on the same subject. Revoking the verdict deliberately does NOT
  /// resolve it — otherwise deleting an inconvenient conclusion would be the way to unblock the
  /// work, which is the hole V4 names.
  resolvedAt       DateTime? @map("resolved_at")
  /// Historical attribution without a foreign key: deleting the
  /// verification that passed must not rewrite what resolved this.
  resolvedByTaskId String?   @map("resolved_by_task_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([verifierTaskId, verdictRevision])
  /// The dispatch guard's read is `subject_task_id WHERE resolved_at IS NULL` — a partial index
  /// this schema cannot spell, declared in migration 0124 (as with Session.retryAt).
  @@index([projectId, createdAt])
  @@map("task_verification_failure")
}

// Comments on a Task (dedicated table; append-only MVP: create/list/delete).
model TaskComment {
  id         String      @id @default(uuid(7)) @db.Uuid
  taskId     String      @map("task_id") @db.Uuid
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Polymorphic author (no FK, cf. Task.creatorId): a comment can be written by a
  // user (web) or by an agent (via the runner MCP path). Names are resolved in code.
  authorType CreatorType @map("author_type")
  authorId   String      @map("author_id") @db.Uuid
  body       String
  // Agent ids @-mentioned in this comment (web composer). Each mention notifies and
  // triggers that agent on this task; resolved to names in the UI. No FK (cf. authorId).
  mentions   String[]    @default([]) @db.Uuid
  /// Which mention-delivery contract this comment was written under (migration 0131). 0 is the
  /// inline best-effort loop a binary predating the ledger used, and is what an absent value means;
  /// 1 files a `TaskCommentMentionDelivery` row per mentioned agent in the same transaction. The
  /// column exists so a rolling deploy cannot deliver one comment twice or lose one entirely.
  mentionDeliveryVersion Int    @default(0) @map("mention_delivery_version") @db.SmallInt
  createdAt  DateTime    @default(now()) @map("created_at")

  deliveries TaskCommentMentionDelivery[]
  legacyEvidenceImports TaskLegacyEvidenceImport[]

  @@unique([id, taskId], map: "task_comment_id_task_id_key")
  @@index([taskId, createdAt])
  @@map("task_comment")
}

/// One @-mention's delivery, from the comment that made it to the turn that carried it.
///
/// Written in the same transaction as the comment (0131's trigger), worked off by a sweep that
/// retries with backoff. `(commentId, workspaceId)` is unique, so a mention is delivered at most
/// once however many workers or retries touch it, and `status` is the answer to "did that agent
/// ever hear about this" that a log line could never give.
model TaskCommentMentionDelivery {
  id              String   @id @default(uuid(7)) @db.Uuid
  commentId       String   @map("comment_id") @db.Uuid
  comment         TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  taskId          String   @map("task_id") @db.Uuid
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// The agent that was mentioned, as an immutable snapshot. No relation and no cascade on
  /// purpose: deleting a runner cascades to its workspaces, and a ledger row that vanished with
  /// them would take the record of an undelivered mention with it (migration 0131).
  workspaceId     String   @map("workspace_id") @db.Uuid
  ownerId         String   @map("owner_id") @db.Uuid
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  status          TaskCommentMentionDeliveryStatus @default(PENDING)
  /// The delivery budget: tries that failed for a reason belonging to this delivery. Availability
  /// failures (no runner, provider down) refund it — see migration 0131.
  attempts        Int      @default(0)
  /// Leases that expired while still DELIVERING — a worker died mid-flight. Bounds that loop, and
  /// deliberately not advanced by an ordinary poll (see migration 0131).
  claims          Int      @default(0)
  /// Availability and polling generations: no runner yet, no turn seeded yet. Drives the backoff
  /// and nothing else — no cap, because a machine being down is not a reason to throw away a
  /// message somebody sent.
  waits           Int      @default(0)
  nextAttemptAt   DateTime @default(now()) @map("next_attempt_at")
  leaseHolder     String?  @map("lease_holder")
  leaseExpiresAt  DateTime? @map("lease_expires_at")
  /// The closed name of the condition holding this delivery — what a client switches on.
  errorCode       String?  @map("error_code")
  /// What would clear it, addressed to whoever can do it.
  requiredAction  String?  @map("required_action")
  /// The underlying message, for the case nobody anticipated. Shown, not just logged.
  lastError       String?  @map("last_error")
  /// The session id this delivery INTENDS to use, written before that session exists so a crash in
  /// between retries with the same id rather than opening a second conversation. No FK, and that
  /// is the point (migration 0131).
  desiredSessionId String? @map("desired_session_id") @db.Uuid
  /// Where the message actually landed, once that session exists.
  targetSessionId String?  @map("target_session_id") @db.Uuid
  targetSession   Session? @relation("MentionDeliveryTarget", fields: [targetSessionId], references: [id], onDelete: SetNull)
  turnId          String?  @map("turn_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([commentId, workspaceId])
  @@index([taskId, createdAt])
  @@map("task_comment_mention_delivery")
}

/// §13.8: what has happened to one @-mention. PENDING and BLOCKED are both "not yet"; only
/// DELIVERED and DEAD are terminal, and DEAD is deliberately loud.
enum TaskCommentMentionDeliveryStatus {
  PENDING
  DELIVERING
  /// The conversation exists and carries the prompt, but the runner has not claimed it yet, so no
  /// `ConversationTurn` does. Revisited until one appears.
  SESSION_CREATED
  /// The turn exists and is still PENDING — durably queued, not yet handed to the engine. A queued
  /// turn can still be lost (its session can fail before reaching it), so this is deliberately not
  /// DELIVERED.
  QUEUED
  DELIVERED
  BLOCKED
  DEAD

  @@map("task_comment_mention_delivery_status")
}

// A "B depends on A" edge: the dependent task (`taskId`) may only run once its
// prerequisite (`dependsOnTaskId`) reaches DONE. An explicit join table because the
// relation is many-to-many (a task can wait on several prerequisites and block several
// dependents). Both endpoints cascade-delete with their task; the graph is kept acyclic
// in code (wouldCreateCycle) on insert, so the completion-triggered runner can't loop.
// Tenant scope is the endpoints' owner — both tasks are validated same-owner on insert
// (cf. TaskComment, which likewise carries no own ownerId).
model TaskDependency {
  id              String   @id @default(uuid(7)) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  task            Task     @relation("DependencyFromTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String   @map("depends_on_task_id") @db.Uuid
  dependsOnTask   Task     @relation("DependencyToTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependency")
}

/// The dispatch version boundary for one task's prerequisite set (migration 0132).
///
/// An edge carries no version and an empty edge set has no row to lock, so a dispatch decision
/// had nothing to hold while it read the prerequisites — 0122 borrowed the dependent Task's row
/// for that, at the cost of an unrelated `updated_at` write, its creator-session FK re-check and
/// every Task trigger. This row is the thing to hold instead: one per task, created with the task
/// and advanced once per statement that changes any of its edges, entirely in the database
/// (`task_dependency_revision_advance`). No application code writes it.
model TaskDependencyRevision {
  taskId   String @id @map("task_id") @db.Uuid
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  revision BigInt @default(0)

  @@map("task_dependency_revision")
}

// A control-plane-configured model provider (e.g. DeepSeek) that borrows a built-in
// runtime CLI instead of shipping its own. Sessions/agents keep its `slug` in their
// `provider` column as a first-class identity (shown in pickers). At dispatch the queue
// resolves the slug here and coerces the runner-facing provider to `runtime` (claude|codex),
// and injects baseUrl + the decrypted key into the borrowed CLI's process env so it talks
// to this endpoint. The API key is stored AES-256-GCM encrypted (providers/provider-crypto.ts);
// it is dispatched only over the runner-auth claim channel and NEVER returned to the browser.
model ModelProvider {
  id            String   @id @default(uuid(7)) @db.Uuid
  // Stable identity stored in Agent/Session.provider and shown in pickers, e.g. "deepseek".
  slug          String   @unique
  label         String
  // Which configurable runtime CLI drives it: "claude" (Anthropic-compatible endpoint),
  // "codex" (OpenAI-compatible) or "kimi" (Moonshot's own API, which the Kimi CLI speaks
  // natively). Borrowing the Kimi runtime is not the same as claiming the built-in `kimi`
  // slug, which stays reserved.
  runtime       String   @default("claude")
  baseUrl       String   @map("base_url")
  // AES-256-GCM ciphertext of the provider API key ("iv:tag:ct", each base64). Kept out of
  // every browser-facing payload but one: the owner of a personal row can read their own key
  // back (GET /providers/mine/:id/key).
  apiKeyEnc     String   @map("api_key_enc")
  // Picker model list: [{ value, label, contextWindow? }]. `value` is the runtime model id
  // passed as --model (e.g. "deepseek-chat"). For a preset-backed row this is a snapshot taken
  // at write time; reads serve the preset's current list instead (see presetSlug).
  models        Json     @default("[]")
  defaultModel  String?  @map("default_model")
  // The vendor preset (@orbit/shared PROVIDER_PRESETS) this row was created from — its identity,
  // fixed for life: the logo it shows and the vendor it "is", even when its own slug had to be
  // suffixed. NULL for a custom endpoint.
  presetSlug    String?  @map("preset_slug")
  // Whether the preset also OWNS the model list: true → models and default model resolve from the
  // catalogue on every read, so one added there reaches providers configured long before it
  // existed. Editing the list by hand clears this (the row keeps its identity, and can opt back
  // in); `models` above is then the row's own.
  followsPreset Boolean  @default(false) @map("follows_preset")
  enabled       Boolean  @default(true)
  // Picker display order; NULL sorts last.
  position      Int?
  // NULL = a shared provider (admin-managed, visible to everyone). Set = a personal (BYOK)
  // provider: visible in, and dispatchable for, only its owner's sessions. Slugs stay globally
  // unique either way, so dispatch-by-slug is never ambiguous.
  ownerId       String?  @map("owner_id") @db.Uuid
  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("model_provider")
}

