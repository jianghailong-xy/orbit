// Orbit control-plane data model. See src/shared/src/enums.ts for the
// TypeScript mirrors of these enums (kept in sync by string value).
//
// DB-level table/column/enum names are mapped to snake_case via @@map/@map to
// follow PostgreSQL conventions. Prisma Client field names stay camelCase, so
// application code is unaffected; only raw SQL references the mapped names.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  // Interactive sessions (Route B). Appended last to match ALTER TYPE ADD VALUE.
  AWAITING_INPUT
  INTERRUPTED
  // NOTE: the `run_status` DB type still carries a now-unused 'PARKED' label — Postgres has
  // no ALTER TYPE ... DROP VALUE, and rebuilding the type would rewrite/lock `session`. It is
  // absent here on purpose: migration 0071 backfilled every PARKED row to CANCELLED and no
  // code path writes it any more, so no row can carry a value this enum can't decode.

  @@map("run_status")
}

enum RunnerStatus {
  ONLINE
  OFFLINE
  DRAINING

  @@map("runner_status")
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
  FAILED

  @@map("task_status")
}

// Who/what authored a Task. The creator is a polymorphic reference (no FK),
// so a Task can be created by a user or by an agent (agent-spawned subtasks).
enum CreatorType {
  USER
  AGENT

  @@map("creator_type")
}

model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  email                 String    @unique
  name                  String
  passwordHash          String    @map("password_hash")
  createdAt             DateTime  @default(now()) @map("created_at")
  // Per-account UI preferences (theme, new-agent defaults). Shape: UserPreferences
  // (@orbit/shared). JSON so new keys need no migration; missing keys fall back.
  preferences           Json      @default("{}")
  // Access role. MEMBER (default) for everyone; ADMIN unlocks the user-management area.
  role                  String    @default("MEMBER")
  // DEPRECATED, unread: a Claude subscription token (`claude setup-token`) the control plane used
  // to hold and inject on every runner. Claude now authenticates per runner — a session that finds
  // no local login surfaces the sign-in card (RunnerSignIn) — so nothing writes or reads these.
  // The columns stay until a migration drops them, so any token already stored isn't destroyed by
  // the code change alone.
  claudeOauthTokenEnc   String?   @map("claude_oauth_token_enc")
  claudeOauthTokenSetAt DateTime? @map("claude_oauth_token_set_at")

  workspaces       Workspace[]
  runners          Runner[]
  enrollmentTokens EnrollmentToken[]
  serviceTokens    ServiceToken[]
  ownedSessions    Session[]         @relation("SessionOwner")
  createdSessions  Session[]         @relation("SessionCreator")
  ownedTasks       Task[] // tasks this user owns (tenant scope)
  taskLists        TaskList[] // task lists this user owns (tenant scope)
  attachments      Attachment[] // blobs this user uploaded (tenant scope)
  deviceTokens     DeviceToken[] // registered iOS devices for APNs push
  modelProviders   ModelProvider[] // personal (BYOK) model providers
  sessionTags      SessionTag[] // personal colored session labels (tenant scope)
  refreshTokens    RefreshToken[] // long-lived rotating refresh tokens (hashed at rest)
  clientVersions   ClientVersion[] // which build of each client this user is running

  @@map("user")
}

/// A long-lived opaque refresh token a client swaps for a fresh short-lived access JWT via
/// POST /api/auth/refresh, so an active client is never forced to re-login while the access
/// token stays short-lived. Only the SHA-256 hash of the token is stored (never the token
/// itself). Rotating: each refresh sets `revokedAt` on the presented row and issues a new one;
/// replaying an already-revoked row signals theft → the user's whole family is revoked. Logout
/// revokes the presented token. Rows cascade-delete with the user.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  // Non-null once the token is consumed (rotated) or revoked (logout / theft-triggered family
  // kill); a dead token presented again is treated as replay.
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("refresh_token")
}

/// An iOS device's APNs token, owner-scoped, so the server can push "needs your reply" alerts to a
/// user's phones/iPads. One row per device (`token` unique) — re-registering upserts, and a token
/// handed to a different user re-points its `userId`. `environment` selects the APNs host
/// (production for App Store/TestFlight, sandbox for dev builds). Registered via POST /api/push/register.
model DeviceToken {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  platform    String   @default("ios")
  environment String   @default("production")
  bundleId    String   @map("bundle_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("device_token")
}

/// Which build of each client a user is actually running, so "has every client in the field
/// upgraded past X?" is a query instead of a guess.
///
/// It exists because the answer is currently unknowable. `WorkspaceAliasInterceptor` carries a
/// compatibility shim whose own comment says to delete it "once every client in the field speaks
/// `workspace*`" — and nothing in the system can tell you when that became true, so it is still
/// running. Runners are the one client already covered (`Runner.version`, reported in the
/// heartbeat); a browser tab nobody reloaded and a TestFlight build from last month were not
/// covered by anything. Every wire-format migration after this one needs the same gate, so the
/// data has to start accumulating BEFORE the migration that will consume it — measuring the tail
/// only once you want to cut it means waiting a full upgrade cycle to see it.
///
/// One row per (user, client kind): the question is "what is this user's iOS app on", and a user
/// with a current browser and a stale phone must show up as stale. Runners are deliberately NOT
/// written here — `Runner.version` already answers for them, and a second source of truth for the
/// same fact is how the two disagree later.
model ClientVersion {
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'web' | 'ios' | 'macos' — the client kind, from the `X-Orbit-Client` header.
  kind       String
  version    String
  lastSeenAt DateTime @updatedAt @map("last_seen_at")

  @@id([userId, kind])
  @@map("client_version")
}

// A machine the user registered via `orbit register`. Claude Code runs here.
model Runner {
  id                String       @id @default(uuid(7)) @db.Uuid
  name              String
  // User-set friendly name shown in the UI. `name` stays the machine-reported
  // identity used to match re-registrations, so renaming never creates a dup.
  displayName       String?      @map("display_name")
  hostname          String?
  ownerId           String       @map("owner_id") @db.Uuid
  owner             User         @relation(fields: [ownerId], references: [id])
  labels            String[]     @default([])
  status            RunnerStatus @default(OFFLINE)
  maxConcurrent     Int          @default(1) @map("max_concurrent")
  // Free-space floor, in MB, below which this machine takes no new auto-run work. Null (the
  // default) leaves the gate off, which is the behaviour every runner had before it existed.
  // One knob per machine, but evaluated against each workspace's own measured filesystem —
  // "keep this much headroom wherever you are writing" is the same policy on every mount.
  minFreeDiskMb     Int?         @map("min_free_disk_mb")
  version           String?
  tokenHash         String       @map("token_hash") // hash of the long-lived runner credential
  lastHeartbeatAt   DateTime?    @map("last_heartbeat_at")
  enrolledAt        DateTime     @default(now()) @map("enrolled_at")
  // User-defined display order shared by the sidebar and Runners page. NULL keeps
  // newly enrolled runners after explicitly positioned ones until the next reorder.
  position          Int?         @map("position")
  // Slash commands / skills the runner discovered on its disk, reported via
  // heartbeat and surfaced to the web composer's `/` autocomplete. Arrays of
  // { name, description?, type? } (mirrors @orbit/shared SlashCommandInfo).
  availableCommands Json?        @map("available_commands")
  availableSkills   Json?        @map("available_skills")
  // Latest provider quota for the account(s) this runner uses, reported via heartbeat.
  // Shape mirrors @orbit/shared PlanUsage.
  planUsage         Json?        @map("plan_usage")
  // Runtime model catalog reported via heartbeat (for example Codex `debug models`).
  modelCatalog      Json?        @map("model_catalog")
  // Effective default reported by each built-in runtime on this machine. Heartbeat-owned cache,
  // kept separate from modelCatalog because availability and selected-default are independent.
  // Shape: { "claude": "claude-opus-5", "codex": "gpt-5.6-sol", ... }.
  runtimeDefaultModels Json?     @map("runtime_default_models")
  // Whether this runner's process is root, reported each heartbeat. Capability state, not a
  // setting: Claude Code refuses Bypass under root and exits before its first message, so this is
  // what lets the pickers and dispatch withdraw that one mode (ROOT_REFUSED_PERMISSION_MODES).
  // NULL means a runner too old to report it, which stays unrestricted — "we don't know" must not
  // remove a mode that works today.
  runsAsRoot        Boolean?     @map("runs_as_root")
  // State of the shared checkouts this machine's agents work in, reported each heartbeat.
  // Array of @orbit/shared RunnerRepoHealth. Session worktrees are isolated; the checkout they
  // fork from and merge into is not, so a half-finished merge left there blocks every merge on
  // this runner — this is how the UI gets to say that once instead of per failing session.
  repoHealth        Json?        @map("repo_health")
  // One-slot repair relay for the checkout above, same shape as the sign-in/install relays: a
  // machine repairs one checkout at a time and the request is redelivered until the runner reports.
  //   NULL            — nothing in flight
  //   pending         — user asked; the next heartbeat tells the runner to do it
  //   done | failed   — terminal; repoCleanupMessage explains, and names the rescue branch
  repoCleanupStatus  String?     @map("repo_cleanup_status")
  repoCleanupRoot    String?     @map("repo_cleanup_root")
  // Branch holding the checkout's content as it was before the repair. Kept after the relay ends:
  // it is the only pointer a user has back to whatever was in that tree.
  repoCleanupBranch  String?     @map("repo_cleanup_branch")
  repoCleanupMessage String?     @map("repo_cleanup_message")
  repoCleanupAt      DateTime?   @map("repo_cleanup_at")

  // Browser-less sign-in relay for this machine's built-in runtime CLI. The runner drives the CLI
  // on its own machine while the user approves in their own browser, so a machine with no
  // terminal access can still be signed in. State, not history: one sign-in at a time per
  // runner, since each CLI writes that machine's single credentials file.
  //   NULL       — nothing in flight
  //   pending    — user asked to sign in; the next heartbeat tells the runner to start
  //   awaiting_code — loginUrl holds the link to approve; loginCode carries the user's paste
  //   awaiting_approval — device flow (codex/kimi): loginUrl + loginUserCode are what the user
  //                       enters in the browser; nothing comes back through us
  //   done | failed — terminal, loginMessage explains a failure
  loginStatus   String?   @map("login_status")
  // Which CLI the relay is driving: 'claude' | 'codex'. NULL on a row written before the relay
  // handled more than claude.
  loginEngine   String?   @map("login_engine")
  loginUrl      String?   @map("login_url")
  // The device flow's one-time code, which the user types on loginUrl's page. Runner → user,
  // the opposite direction from loginCode.
  loginUserCode String?   @map("login_user_code")
  // The pasted authorization code, cleared as soon as the heartbeat hands it to the runner. It
  // is single-use and worthless without the PKCE verifier, which never leaves the runner.
  loginCode     String?   @map("login_code")
  loginMessage  String?   @map("login_message")
  // When the current relay started, so an abandoned one can be timed out.
  loginAt       DateTime? @map("login_at")

  // Per-engine health on this machine — installed / version / signed in — reported by heartbeat
  // from the same probe `orbit doctor` prints. Shape: @orbit/shared RunnerEngineHealth[].
  engines        Json?     @map("engines")

  // Browser-driven install of one engine CLI, the same one-slot relay shape as the sign-in above
  // (a machine installs one CLI at a time; the request is redelivered until the runner reports).
  //   NULL       — nothing in flight
  //   pending    — user asked; the next heartbeat tells the runner to start
  //   installing — the runner started the installer; installCommand is what it is running
  //   done | failed — terminal, installMessage explains a failure
  installStatus  String?   @map("install_status")
  installEngine  String?   @map("install_engine")
  installCommand String?   @map("install_command")
  installMessage String?   @map("install_message")
  installAt      DateTime? @map("install_at")
  // Which job the slot is running: 'install' (installEngine's CLI) or 'update' (every CLI already
  // on the machine — installEngine is then NULL). Both run a package manager against this
  // machine's one global prefix, so they share a slot instead of racing. NULL = 'install'.
  installMode    String?   @map("install_mode")

  sessions Session[]
  // Workspaces `orbit register` minted for this machine (one per project dir + tool).
  workspaces Workspace[]
  // Narrow, revocable credentials minted for headless processes on this machine.
  serviceTokens ServiceToken[]

  @@index([ownerId])
  @@map("runner")
}

// A long-lived credential for a HEADLESS process on one machine — a launchd/cron bridge that
// belongs to no session, so it can hold none of the session-bound proofs orchestration uses.
//
// Deliberately not the runner credential: that one sits in plaintext in ~/.orbit/config.json and
// is what the machine authenticates every claim with, so promoting it to "may spawn any agent
// with any prompt" would make a config leak equal arbitrary execution. A service token instead
// enumerates exactly what it may do, may be pinned to a single agent, expires on its own, and is
// revoked individually without re-registering the machine.
//
// The token itself is a signed JWT whose `jti` is this row's id — nothing secret is stored here,
// so a database leak cannot yield a usable credential. This row is the revocation list and the
// audit record: `lastUsedAt` says whether the thing is still in use before anyone revokes it.
model ServiceToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // The machine this token acts on. Its reach never crosses to another runner's sessions.
  runnerId   String    @map("runner_id") @db.Uuid
  runner     Runner    @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  // Optional single-workspace pin. Required when the token may create sessions, so a leaked
  // bridge token can only ever start sessions in the one workspace it was minted for.
  workspaceId String?  @map("workspace_id") @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Human label shown by `orbit token list`, so an unused token can be identified before revoking.
  label      String?
  // Enumerated capabilities: session:get | session:list | session:send | session:create. The
  // destructive verbs (end/interrupt/merge/complete) are deliberately not representable.
  scopes     String[]  @default([])
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([runnerId])
  @@index([ownerId])
  @@map("service_token")
}

// One-time token a user generates in the UI and passes to `orbit register`.
model EnrollmentToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  ownerId   String    @map("owner_id") @db.Uuid
  owner     User      @relation(fields: [ownerId], references: [id])
  label     String?
  expiresAt DateTime? @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("enrollment_token")
}

// A pending `orbit register` device-login session (RFC 8628-style browser flow).
// The CLI polls with the secret deviceCode; a logged-in user approves the machine
// in the browser by the short, human-typable userCode.
model DeviceEnrollment {
  id             String    @id @default(uuid(7)) @db.Uuid
  deviceCodeHash String    @unique @map("device_code_hash") // hash of the secret the CLI polls with
  userCode       String    @unique @map("user_code") // short code shown in the browser + terminal
  name           String
  hostname       String?
  labels         String[]  @default([])
  maxConcurrent  Int       @default(1) @map("max_concurrent")
  version        String?
  status         String    @default("PENDING") // PENDING | APPROVED
  // Agent (coding-tool) keys requested at device/start; approval mints one Runner
  // for the machine (named by hostname) and one Agent per key (named `<name>/<key>`).
  agents         String[]  @default([])
  // The project directory the minted agents run in (claude's cwd), from the CLI.
  workDir        String?   @map("work_dir")
  runnerId       String?   @map("runner_id") @db.Uuid // the machine runner minted on approval
  runnerToken    String?   @map("runner_token") // raw runner credential, delivered to the CLI once then cleared
  // The minted agents [{agentKey,agentId,name,workDir}], delivered to the CLI once
  // on poll then wiped (mirrors runnerToken above). Column kept named `runners`.
  mintedAgents   Json?     @map("runners")
  approvedById   String?   @map("approved_by_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("device_enrollment")
}

// A workspace: one checkout on one machine, plus how to branch and merge inside it.
//
// It is a PLACE, not an actor — the actor is the Session (one live coding-runtime process) and
// the body of work is the Task graph. Everything that is a policy decision rather than a
// property of the checkout lives elsewhere on purpose: the permission posture is per-run
// (Session.permissionMode) with an account-level default (UserPreferences.defaultPermissionMode),
// and tool allowlists / MCP servers are machine or account concerns, not directory ones.
model Workspace {
  id                  String    @id @default(uuid(7)) @db.Uuid
  name                String
  description         String?
  // A workspace holds no provider: it names a machine and a project directory, while the provider
  // is a per-session binding (Session.provider, fixed for that session's lifetime). The default a
  // new session inherits is derived from what this workspace last ran — see
  // workspaces/workspace-provider.ts.
  // Legacy per-workspace model pin. New sessions resolve from their Runtime/ModelProvider; migration
  // 0079 copied old pins into existing sessions. Temporarily retained as a rolling-deploy bridge
  // for model-less sessions written by old replicas; first claim snapshots it onto Session.model.
  model               String?
  appendSystemPrompt  String?   @map("append_system_prompt")
  systemPrompt        String?   @map("system_prompt")
  disallowedTools     Json      @default("[]") @map("disallowed_tools")
  // Default reasoning effort a new session inherits when its create request omits one
  // ('' / null = the model's default). Claude: low|medium|high|xhigh|max; codex adds minimal.
  effort              String?   @map("effort")
  // routing: bind to a specific runner and/or match runner labels
  targetRunnerId      String?   @map("target_runner_id") @db.Uuid
  targetLabels        String[]  @default([]) @map("target_labels")
  // The machine (Runner) this workspace lives on, set when `orbit register` mints it;
  // null for hand-made config workspaces. Cascade so unregistering a machine drops them.
  runnerId            String?   @map("runner_id") @db.Uuid
  runner              Runner?   @relation(fields: [runnerId], references: [id], onDelete: Cascade)
  // The project directory the runtime runs in for this workspace, and its coding-tool key.
  workDir             String?   @map("work_dir")
  // Custom environment variables injected into this workspace's runtime process (string map).
  env                 Json?     @map("env")
  agentKey            String?   @map("agent_key")
  enabled             Boolean   @default(true)
  // When workDir is NOT a git repo, the runner auto-`git init`s it (default .gitignore +
  // baseline commit) on the next claim so its sessions can be worktree-isolated. Opt-in
  // per workspace — the web "Enable isolation" action on a non-git run flips this on.
  autoInitGit         Boolean   @default(false) @map("auto_init_git")
  // Whether this workspace's sessions each run in their own per-session git worktree. Default off,
  // so a new workspace's sessions run directly in workDir with no isolation unless the user opts
  // in. Off → a session gets no `branch` and the runner runs it directly in workDir with no
  // worktree (the workspace's concurrent sessions then share one working tree); the
  // merge/commit/diff machinery is skipped since there's no isolated branch.
  enableWorktree      Boolean   @default(false) @map("enable_worktree")
  // Opt-in per workspace (default off): may this workspace's in-session coding agent spawn and
  // manage OTHER sessions via the `orbit mcp` session_* tools (L3 orchestration)? Off → those
  // tools aren't exposed and the runner-token spawn endpoint refuses.
  enableOrchestration Boolean   @default(false) @map("enable_orchestration")
  // The branch this workspace's sessions merge into by default, remembered from the last time the
  // user switched targets in the status bar's merge dropdown. Null → the runner's auto-detect
  // (main, else master). Workspace-scoped so a chosen target sticks across all its sessions.
  defaultMergeTarget  String?   @map("default_merge_target")
  // What the runner last saw at `workDir` on its own disk, refreshed each heartbeat. The config
  // form reads these to say whether the path is actually there and whether it can be worktree-
  // isolated, instead of letting a typo surface only when a session finally fails to start.
  // All three NULL = never probed (no runner report yet, or one too old to send it), which must
  // stay distinct from "probed, and it isn't there".
  workDirExists       Boolean?  @map("work_dir_exists")
  workDirIsGit        Boolean?  @map("work_dir_is_git")
  workDirProbedAt     DateTime? @map("work_dir_probed_at")
  // Headroom on the filesystem this workspace's work dir lives on, from the same heartbeat probe
  // as the flags above. Per workspace rather than per runner because one machine's workspaces can
  // sit on different mounts, and a run can only be gated on the disk it will write to. BigInt:
  // a multi-terabyte volume overflows Int. Null means unknown (old runner, missing path,
  // platform without an answer) and must never be read as "full".
  workDirFreeBytes    BigInt?   @map("work_dir_free_bytes")
  workDirTotalBytes   BigInt?   @map("work_dir_total_bytes")
  ownerId             String    @map("owner_id") @db.Uuid
  owner               User      @relation(fields: [ownerId], references: [id])
  createdAt           DateTime  @default(now()) @map("created_at")
  // Soft delete: deleting a workspace stamps this instead of removing the row, so its
  // sessions/tasks stay linked (no orphaning) and it can be restored. NULL = live;
  // every user-facing listing filters on `deletedAt: null`. Runtime lookups by a live
  // session's workspaceId intentionally don't filter, so in-flight sessions keep running.
  deletedAt           DateTime? @map("deleted_at")
  // Sidebar display order set by drag-to-reorder; NULL sorts last (after positioned
  // workspaces, by createdAt) so existing/new ones stay oldest-first until reordered.
  position            Int?      @map("position")

  sessions      Session[]
  assignedTasks Task[] // tasks assigned to run in this workspace
  foremanFor    TaskList[] @relation("TaskListForeman") // lists whose coordination runs here
  // Service tokens pinned to this workspace (see ServiceToken).
  serviceTokens ServiceToken[]
  // What this workspace always allows without asking again (see WorkspacePermissionRule).
  permissionRules WorkspacePermissionRule[]

  @@index([ownerId])
  @@index([runnerId])
  @@map("workspace")
}

/// A tool call this workspace's sessions may make without asking a human again — written
/// when someone answers an approval with "always allow", read back into every later session
/// of the same workspace.
///
/// Workspace-scoped on purpose. The unit of trust is not a session: "I trust `npm test` in
/// this repo" does not stop being true when a conversation ends, and re-teaching it once per
/// session makes the cost scale with the number of sessions — which is the thing the product
/// is for. It is not account-scoped either, because a command waved through in a toy checkout
/// must not silently arm itself in the repo that matters; the workspace is what owns the
/// workDir, the runner and the env, so it is the boundary users already reason about.
///
/// Orbit stores and scopes these; it does NOT match them. They are handed to the runtime
/// (claude's `--allowedTools`) so the vendor's own matcher decides what counts as "the same
/// kind of call" — writing a second matcher for shell strings here would be a bypassable
/// parser guarding a shell.
model WorkspacePermissionRule {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // The gated tool ("Bash", "Edit", …).
  toolName    String    @map("tool_name")
  // Narrows the tool, in the runtime's own rule grammar (Bash uses a command prefix like
  // "git commit:*"). Empty string — not NULL — means "every call to this tool", so the
  // unique index actually collapses duplicates (postgres treats NULLs as distinct).
  ruleContent String    @default("") @map("rule_content")
  // Who allowed it, and from which approval (no FK: the approval's session may be deleted
  // long before the rule is revoked).
  createdById String?   @map("created_by_id") @db.Uuid
  approvalId  String?   @map("approval_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([workspaceId, toolName, ruleContent])
  @@index([workspaceId])
  @@map("workspace_permission_rule")
}

// A first-class interactive chat session (Route B): a long-lived conversation
// driven by one claude process on a runner. Chat events, user-input turns, tool
// calls, and llm usage hang directly off the Session.
model Session {
  id                   String    @id @default(uuid(7)) @db.Uuid
  title                String
  prompt               String // first-turn seed
  ownerId              String    @map("owner_id") @db.Uuid
  owner                User      @relation("SessionOwner", fields: [ownerId], references: [id])
  creatorId            String    @map("creator_id") @db.Uuid
  creator              User      @relation("SessionCreator", fields: [creatorId], references: [id])
  assignedRunnerId     String?   @map("assigned_runner_id") @db.Uuid
  assignedRunner       Runner?   @relation(fields: [assignedRunnerId], references: [id])
  workspaceId          String?   @map("workspace_id") @db.Uuid
  workspace            Workspace? @relation(fields: [workspaceId], references: [id])
  // Optional parent work item; deleting the Task detaches but keeps the session.
  taskId               String?   @map("task_id") @db.Uuid
  task                 Task?     @relation("SessionTask", fields: [taskId], references: [id], onDelete: SetNull)
  // Set when another session's agent spawned this one via the orbit mcp session_create tool
  // (L3 orchestration). Detaches (SetNull) if the parent is purged; drives the orchestration
  // tree, the spawn-depth / child-count guards, and attribution.
  parentSessionId      String?   @map("parent_session_id") @db.Uuid
  parent               Session?  @relation("SessionSpawn", fields: [parentSessionId], references: [id], onDelete: SetNull)
  children             Session[] @relation("SessionSpawn")
  // The spawn tree this session belongs to, named by the session it grew from — a root points
  // at itself once it has spawned anything. null = not part of any tree. This is what the claim
  // queue's tree cap groups on, and what makes "the tree" one indexed read instead of a walk up
  // parentSessionId. Deliberately NOT batchId: a batch run is a closed set with a user-chosen
  // cap, a tree is open-ended with a server-owned one.
  rootSessionId        String?   @map("root_session_id") @db.Uuid
  // Parent links above this session: a root is 0, its child 1. Written at creation so the depth
  // guard is a read rather than one query per level.
  spawnDepth           Int       @default(0) @map("spawn_depth")
  // Batch-run grouping: when a session is dispatched as part of a "批量运行" batch,
  // these tag it with that batch's id and the batch's own concurrency cap. The claim
  // queue gates live sessions per batch on batchMaxConcurrent — independent of, and on
  // top of, the runner's own max_concurrent. null = not part of any batch (ungated).
  batchId              String?   @map("batch_id") @db.Uuid
  batchMaxConcurrent   Int?      @map("batch_max_concurrent")
  // Runtime thread/session id, always owned by the runtime named in `provider`. Claude's is
  // pre-generated at creation (--session-id on first spawn, --resume on reclaim/respawn);
  // Codex/Kimi/OpenCode mint their own after process initialization, so it stays null then.
  runtimeSessionId     String?   @map("runtime_session_id")
  provider             String    @default("claude")
  // Materialized from the owning agent. Only needed to distinguish first-class Kimi from a
  // stale old-replica write that still uses the former custom-provider slug `kimi`.
  providerBuiltin      Boolean   @default(false) @map("provider_builtin")
  // The only runner-engine generation allowed to dequeue this session's inbox. Retired values
  // remain here as tombstones until the next activation, so legacy NULL polls stay fenced.
  inboxLeaseGeneration String?   @map("inbox_lease_generation") @db.Uuid
  // Stable UUID of the runner process authorized to activate new generations. Process takeover
  // is an expected-owner CAS, so a delayed request from a superseded process cannot regain control.
  inboxLeaseOwner      String?   @map("inbox_lease_owner") @db.Uuid
  // Explicit/snapshotted model. Null uses the rolling legacy Agent bridge when present, otherwise
  // the runner Runtime/catalog default; first claim materializes whichever value was inherited.
  model                String?
  // New code sets this explicitly on create. The false database default identifies a model-less
  // Session written by an old replica after migration 0079, whose pre-0079 static/Agent fallback
  // must be preserved until first claim snapshots it.
  usesRuntimeDefaultModel Boolean @default(false) @map("uses_runtime_default_model")
  permissionMode       String?   @map("permission_mode")
  // Claude effort level (low|medium|high|xhigh|max); null omits --effort so claude
  // uses the model's default.
  effort               String?
  // Legacy internal provenance. Current clients use one Active list rather than splitting
  // out System; task-linked runs are always "user" for compatibility with older clients.
  source               String    @default("user")
  // PENDING = created, claimable by its assigned runner.
  status               RunStatus @default(PENDING)
  // billing, accrued per turn
  sumInputTokens       Int       @default(0) @map("sum_input_tokens")
  sumOutputTokens      Int       @default(0) @map("sum_output_tokens")
  sumCacheRead         Int       @default(0) @map("sum_cache_read")
  sumCacheWrite        Int       @default(0) @map("sum_cache_write")
  numTurns             Int       @default(0) @map("num_turns")
  costUsd              Float     @default(0) @map("cost_usd")
  // How full the context window is RIGHT NOW: the tokens the latest top-level assistant message
  // actually cost (fresh input + cache reads + cache writes + output), denormalized from the
  // turn_end event that already carries it for the clients' context gauge. Deliberately not
  // derivable from the four sums above — those accrue over the session's whole life, so the only
  // thing they say about the current window is that it is smaller. A long-lived session has to
  // rotate before it reaches the window (compaction is lossy), and this is the measurement that
  // decision needs. null until a runtime reports one: never-run sessions, and runtimes that
  // don't report it yet (kimi).
  contextTokens        Int?      @map("context_tokens")
  // What contextTokens is a fraction of: the window the engine that produced that number will
  // actually use, reported by the runner from its own probe of that engine rather than looked up
  // by model id. The id doesn't determine the window (`opus` and `opus[1m]` are one model with
  // two), so the pair only means anything when both halves come from the same reading — which is
  // why it is written from the same event and never from a table. null when the runtime doesn't
  // report one; a reader with no window shows the token count, not a percentage of a guess.
  contextWindow        Int?      @map("context_window")
  lastTurnAt           DateTime? @map("last_turn_at")
  cancelRequestedAt    DateTime? @map("cancel_requested_at")
  startedAt            DateTime? @map("started_at")
  finishedAt           DateTime? @map("finished_at")
  error                String?
  result               String?
  // Why the session ended, orthogonal to `status` (which collapses every graceful end
  // to CANCELLED). Set by the path that requests the end — endLive (user end/complete/
  // delete) or the reaper (idle/task-done recycle, orphan) — and left untouched by the
  // runner's async /finalize. null = a natural agent finish (read `status`) or a
  // pre-migration row. Values: see SessionEndReason in @orbit/shared.
  endReason            String?   @map("end_reason")
  // Denormalized preview: the text of the most recent `assistant` RunEvent, written on
  // event ingestion. Lets the session list show a last-reply line without querying the
  // (high-volume, append-only) run_event table per row. null until the first reply.
  lastAssistantText    String?   @map("last_assistant_text")
  // Denormalized "frontier" activity for the sidebar's live status line: the tool
  // name when a tool_use is the latest durable event (in flight, no tool_result yet),
  // cleared back to null on any other frontier (assistant text, tool_result, turn end).
  // Only meaningful while RUNNING; the list gates display on status so a stale value
  // on a finished session is never shown.
  lastToolUse          String?   @map("last_tool_use")
  // Denormalized "pending question": the latest user turn's text while it's the frontier — a
  // turn just started and the agent hasn't replied yet. Set alongside lastToolUse on event
  // ingestion and cleared (null) the moment any other frontier lands (assistant text, a tool,
  // turn end). Lets the list show the message you just sent while awaiting the reply, instead of
  // the now-stale previous reply. Only meaningful while RUNNING; display is status-gated.
  lastUserText         String?   @map("last_user_text")
  // Denormalized set of the agent's still-running background shells (Bash run_in_background):
  // the tool_use ids of launches that haven't yet reported a terminal `<task-notification>`.
  // Added on launch, removed on completion, cleared on (re)spawn/complete. Lets the list +
  // header show "Background running" without scanning events. Only meaningful while live.
  runningBgShells      String[]  @map("running_bg_shells")
  // Denormalized set of the agent's still-running sub-agents (Task/Agent tool): the tool_use
  // ids of sub-agent launches that haven't yet reported a terminal `<task-notification>`
  // (background_task). Added on launch, removed on completion, cleared on (re)spawn. The Agent
  // tool is async — its launch tool_result lands immediately and the parent then streams its
  // own top-scope system progress events, so lastToolUse can't carry this. Lets the list show
  // "Running Agent…" while a sub-agent is in flight. Only meaningful while live.
  runningSubagents     String[]  @map("running_subagents")
  // Denormalized "the engine is generating right now", tracked independently of `status`.
  // A runtime restarts the model on its own for a background-task notification or a scheduled
  // wake-up; those turns never pass through the inbox, so /turn-complete never acks them and
  // `status` stays AWAITING_INPUT while tools and replies stream for minutes. Set by any
  // generation event, cleared by a turn ending or a runtime (re)spawn handshake. Display only:
  // `status` remains the sole source of truth for runner-slot accounting, so a self-driven
  // turn never consumes a permit it did not acquire.
  engineTurnActive     Boolean   @default(false) @map("engine_turn_active")
  // ── Per-session git worktree isolation ──────────────────────────────────────
  // When the agent's workDir is a git repo, the runner runs this session in its own
  // git worktree on `branch`, forked from `baseSha` (the workDir HEAD at claim time).
  // On terminal completion the runner commits the work to `branch`, removes the
  // worktree (the branch stays, for a manual merge), and reports `changedFiles` — a
  // compact per-file {path,additions,deletions,status} summary, deliberately NOT
  // selected by the session list query so the (potentially large) diff never bloats
  // the list payload. `isolationStatus` records what the runner actually did:
  // 'worktree' (isolated) or 'shared-nogit' (workDir wasn't a git repo, so it ran in
  // the shared dir with no isolation). All null for pre-feature / never-run sessions.
  branch               String?
  baseSha              String?   @map("base_sha")
  changedFiles         Json?     @map("changed_files")
  isolationStatus      String?   @map("isolation_status")
  // ── "Merge to main" (UI button on the worktree status bar) ──────────────────
  // The user can ask the runner to merge this session's `branch` into a target branch.
  // mergeStatus drives the button: 'pending' (queued for the next heartbeat of the
  // session's assigned runner) → 'merged' (mergedAt set) | 'conflict' | 'error'
  // (mergeError carries git's message / the failed precondition). All null until asked.
  mergeStatus          String?   @map("merge_status")
  mergeError           String?   @map("merge_error")
  mergeRequestedAt     DateTime? @map("merge_requested_at")
  // Fresh for every queued attempt. Runner results must echo this UUID, so a
  // delayed result from an attempt cleared by Resume cannot complete a later one.
  mergeOperationId     String?   @map("merge_operation_id") @db.Uuid
  // Claimed once by a capable heartbeat process. Same-owner redelivery is
  // idempotent; another process cannot steal a possibly executing git mutation.
  mergeOperationOwner  String?   @map("merge_operation_owner") @db.Uuid
  mergedAt             DateTime? @map("merged_at")
  // The exact source-branch tip that a successful Orbit merge replayed. Unlike patch-id,
  // this remains authoritative when rebasing onto the target adapts overlapping changes and
  // produces a non-equivalent patch. A later worktree report clears merged state only after
  // its current branch tip differs from this SHA. Null for legacy merge results.
  mergedSourceSha      String?   @map("merged_source_sha")
  // The branch the user chose to merge into (from the status bar's branch dropdown). Null
  // means the default — the runner auto-detects main, else master. Relayed to the runner in
  // the MergeCommand and shown on the merged ✓ chip.
  mergeTarget          String?   @map("merge_target")
  // Candidate merge targets the runner reported for this session's repo (local branches
  // minus Orbit's own orbit/* session branches), populating the dropdown. Refreshed each
  // heartbeat while live and at completion; empty for older runners (dropdown hidden).
  mergeTargets         String[]  @default([]) @map("merge_targets")
  // branchMerged is the runner's verdict that this branch's work is already in the default target
  // (main, else master): the branch tip is an ancestor of it (fast-forward / command-line push), or
  // every post-fork commit has a patch-equivalent there (a squash/rebase merge under new SHAs, e.g.
  // Orbit's own rebase-based "Merge to main"). Refreshed alongside worktreeDirty on each worktree
  // report: true → the bar shows a "✓ In main" chip instead of a redundant Merge button. Null = the
  // runner hasn't reported it (older runner / not yet recomputed) → the bar keeps its
  // mergeStatus-driven behavior.
  branchMerged         Boolean?  @map("branch_merged")
  // The worktree's ACTUAL current HEAD branch, as last reported by the runner (git symbolic-ref).
  // Normally equals `branch`; it differs when the agent ran `git checkout -b` inside the worktree,
  // moving the work onto a branch Orbit isn't tracking. When it differs, the status bar flags the
  // divergence ("On <branch> — not tracked") instead of a stale "✓ In main", and offers Adopt
  // (which re-points `branch` here). Null = not isolated / not reported (older runner).
  worktreeBranch       String?   @map("worktree_branch")
  // ── "Commit" (UI button on the worktree status bar, for a live session) ─────
  // worktreeDirty is the runner's last-reported `git status` for the live worktree: true
  // → the bar shows Commit (commit the uncommitted work onto `branch`), false → Merge.
  // commitStatus drives the Commit button while it runs: 'pending' (queued for the next
  // heartbeat) → 'committed' | 'nochange' | 'error' (commitError carries git's message).
  // All null until the runner reports / the user clicks commit.
  worktreeDirty        Boolean?  @map("worktree_dirty")
  commitStatus         String?   @map("commit_status")
  commitError          String?   @map("commit_error")
  commitRequestedAt    DateTime? @map("commit_requested_at")
  // Same ABA fence as mergeOperationId, for heartbeat-delivered commits.
  commitOperationId    String?   @map("commit_operation_id") @db.Uuid
  commitOperationOwner String?   @map("commit_operation_owner") @db.Uuid
  // Product lifecycle: completedAt moves an Open session to Completed; deletedAt moves
  // it to Trash. Both retain all data and restore clears them. archivedAt is a temporary
  // rolling-deploy compatibility mirror maintained by migration 0076's database trigger.
  completedAt          DateTime? @map("completed_at")
  /// @deprecated Compatibility mirror of completedAt; do not use in new server code.
  archivedAt           DateTime? @map("archived_at")
  deletedAt            DateTime? @map("deleted_at")
  // Pin to the top of the session list: when set, the session sorts above unpinned ones
  // (a per-owner personal ordering). null = not pinned. Toggled via POST/DELETE /sessions/:id/pin.
  // Ordering only — never affects visibility or the runner.
  pinnedAt             DateTime? @map("pinned_at")
  // ── Public read-only share link ─────────────────────────────────────────────
  // shareToken is an unguessable token embedded in a public URL (/s/<token>); anyone
  // with the link can view this session's transcript read-only, no login. null = not
  // shared. Revoking sets it back to null (old links 404); re-sharing mints a fresh
  // token. sharedAt records when the current link was minted. Only the transcript is
  // exposed via the token (see SharedController) — never ownership/billing/runner internals.
  shareToken           String?   @unique @map("share_token")
  sharedAt             DateTime? @map("shared_at")
  // ── A failure that fixes itself → re-send when it will work ─────────────────
  // Two failures say nothing about the work and succeed on a plain re-send: the account's
  // provider quota running out ("You've hit your session limit · resets 6:20pm
  // (Europe/Berlin)"), and the provider being briefly unable to answer ("API Error: 529 …
  // overloaded_error"). retryAt is when to re-send — set on event ingestion the moment such a
  // reply lands, and cleared by anything that means nobody is waiting on it any more (the
  // retry fired, the user sent their own message, the session ended, or the user switched
  // auto-retry off). null = no armed retry, which is also how "the user declined" and "no
  // reset time could be determined" are both spelled.
  retryAt              DateTime? @map("retry_at")
  // Auto-retries already spent on the current run of failures: what the API-error backoff
  // steps through, and what makes a quota that keeps reporting itself spent past its own reset
  // time hand back to the user instead of re-sending forever. Reset to 0 when a turn finally
  // answers with something that is not one of those failures — not merely when a retry is
  // dispatched, which would let a provider that fails identically every time loop unbounded.
  retryAttempts        Int       @default(0) @map("retry_attempts")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  events                RunEvent[]
  turns                 ConversationTurn[]
  toolCalls             ToolCall[]
  llmUsage              LlmUsage[]
  approvals             Approval[]
  inboxLeaseGenerations InboxLeaseGeneration[]
  // Tasks an agent created from within this session (cf. Task.creatorSession).
  createdTasks          Task[]                 @relation("TaskCreatorSession")
  taskListRevisions     TaskListRevision[]     @relation("TaskListRevisionAuthorSession")
  consoleForLists       TaskList[]             @relation("TaskListConsole")
  attachments           Attachment[]
  diff                  SessionDiff?
  // Personal colored labels applied to this session (many-to-many via the join table).
  tagLinks              SessionTagLink[]

  @@index([assignedRunnerId, status])
  // "what did this workspace last run on", the derived seed a new session inherits when the
  // caller names no provider (workspaces/workspace-provider.ts).
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([batchId, status])
  @@index([parentSessionId])
  // The claim queue's tree cap: a tree's active turns.
  @@index([rootSessionId, status])
  @@index([ownerId])
  @@index([ownerId, status, taskId], map: "session_owner_status_task_idx")
  @@index([status])
  // The auto-retry sweeper's only query: armed retries that have come due.
  @@index([retryAt])
  @@map("session")
}

// Durable activation/retirement records for runner inbox consumers. A retired row is kept as a
// tombstone so a delayed activate request cannot resurrect an engine after release or reclaim.
model InboxLeaseGeneration {
  generation  String    @id @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  leaseOwner  String?   @map("lease_owner") @db.Uuid
  activatedAt DateTime  @default(now()) @map("activated_at")
  retiredAt   DateTime? @map("retired_at")

  @@index([sessionId])
  @@map("inbox_lease_generation")
}

// On-demand per-file unified diffs of a session's worktree changes, kept in a side table
// (1:1 with Session) so the potentially large patch text NEVER rides the session detail or
// list payload — it's fetched only when the user opens a file's diff (GET /sessions/:id/diff).
// The runner upserts it each turn (live, uncommitted) and at completion (committed). `patches`
// is a FilePatch[] ({ path, patch?, truncated? }) — see @orbit/shared.
model SessionDiff {
  sessionId String   @id @map("session_id") @db.Uuid
  patches   Json
  updatedAt DateTime @updatedAt @map("updated_at")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_diff")
}

// A personal, colored label the owner can apply to their sessions (Files.app-style Tags).
// Per-owner: every query filters by ownerId. `isSystem` marks the 7 seeded preset-color tags
// (Red…Gray) — always present, selectable, but not renamable/deletable; user-created tags are
// isSystem=false. `position` orders them in the picker (system first, then creation order).
// `color` is a #RRGGBB hex from the shared palette. Deleting a tag cascades its links away
// (the sessions themselves are untouched). Seeded lazily on first list — see SessionTagsService.
model SessionTag {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  color     String
  isSystem  Boolean  @default(false) @map("is_system")
  position  Int      @default(0)
  ownerId   String   @map("owner_id") @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  links SessionTagLink[]

  // One tag name per owner: makes the system-tag seed idempotent (createMany skipDuplicates)
  // and blocks duplicate custom names.
  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("session_tag")
}

// Join table wiring a SessionTag onto a Session (many-to-many). Both endpoints cascade-delete
// with their parent; unique on (session, tag) so an assignment is idempotent.
model SessionTagLink {
  id        String     @id @default(uuid(7)) @db.Uuid
  sessionId String     @map("session_id") @db.Uuid
  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tagId     String     @map("tag_id") @db.Uuid
  tag       SessionTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([sessionId, tagId])
  @@index([tagId])
  @@map("session_tag_link")
}

// A tool-permission request from claude's --permission-prompt-tool (served by the
// runner's orbit MCP server), awaiting a human allow/deny. The MCP tool blocks on a
// long-poll until status flips. Not a RunEvent: the orbit MCP server is a separate
// process from the runner's seq-owning session loop, so persisting it as an event
// would race the runner's monotonic seq. Idempotent on (sessionId, toolUseId).
model Approval {
  id           String    @id @default(uuid(7)) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  toolName     String    @map("tool_name")
  input        Json
  toolUseId    String?   @map("tool_use_id")
  // PENDING -> ALLOWED | DENIED
  status       String    @default("PENDING")
  message      String? // optional deny reason / note from the human
  // AskUserQuestion only: the human's picks, keyed by question text -> selected
  // option labels. The runner feeds this back to claude as updatedInput.answers.
  answers      Json?
  // Set when the human chose "allow + remember same kind": a claude permission rule
  // ({ toolName, ruleContent? }) the runner adds to the session so future matching
  // calls are auto-allowed by claude without re-prompting.
  rememberRule Json?     @map("remember_rule")
  // User who decided it (no FK; cf. Activity.actorId).
  decidedById  String?   @map("decided_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  decidedAt    DateTime? @map("decided_at")

  @@unique([sessionId, toolUseId])
  @@index([sessionId, status])
  @@map("approval")
}

// Normalized streamed events for a session (replay + live SSE).
model RunEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq       Int
  type      String
  payload   Json
  // conversation_turn.id that produced this event; null for session-level events.
  // No FK: high-volume append-only log (cf. Activity); both cascade-delete via session.
  turnId    String?  @map("turn_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sessionId, seq])
  @@index([sessionId, seq])
  @@index([turnId])
  @@map("run_event")
}

// Audit of every tool the agent invoked during a session.
model ToolCall {
  id         String    @id @default(uuid(7)) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name       String
  // The tool_use id the runtime assigned this call. A tool_result event arrives in a
  // later event batch than its tool_use, so it can only be joined back to this row by
  // (sessionId, toolUseId) — without the column, output/isError/finishedAt below were
  // unreachable and stayed NULL forever. Nullable because very old runners never sent an
  // id, and because it is the pairing key, the result update skips rows where it is unset.
  toolUseId  String?   @map("tool_use_id")
  input      Json?
  output     Json?
  isError    Boolean   @default(false) @map("is_error")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@index([sessionId])
  @@index([sessionId, toolUseId])
  @@map("tool_call")
}

// Per-model token/cost detail for billing rollups.
model LlmUsage {
  id                       String   @id @default(uuid(7)) @db.Uuid
  sessionId                String   @map("session_id") @db.Uuid
  session                  Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  model                    String
  inputTokens              Int      @default(0) @map("input_tokens")
  outputTokens             Int      @default(0) @map("output_tokens")
  cacheCreationInputTokens Int      @default(0) @map("cache_creation_input_tokens")
  cacheReadInputTokens     Int      @default(0) @map("cache_read_input_tokens")
  costUsd                  Float    @default(0) @map("cost_usd")
  createdAt                DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("usage")
}

// Durable, server-owned queue of user inputs for an interactive session (Route B).
// The runner long-polls these via GET /runner/sessions/:id/inbox; delivery is
// at-least-once with a lease + idempotency on (sessionId, clientTurnId).
model ConversationTurn {
  id              String    @id @default(uuid(7)) @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  session         Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seq             Int // server-assigned, per-session delivery ordering
  clientTurnId    String    @map("client_turn_id") // client-supplied idempotency key
  kind            String    @default("message") // message | interrupt | end
  content         String? // user message text (null for interrupt/end)
  status          String    @default("PENDING") // PENDING | IN_FLIGHT | ANSWERED
  deliveredAt     DateTime? @map("delivered_at")
  leaseDeadlineAt DateTime? @map("lease_deadline_at")
  // Random runner-engine generation that owns the current delivery lease. A
  // delayed release from a dead process may expire only its own generation.
  leaseGeneration String?   @map("lease_generation") @db.Uuid
  answeredAt      DateTime? @map("answered_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  // Image blobs sent with this turn (web composer). Linked when the turn is enqueued;
  // the inbox hands their refs to the runner. Cascade so withdrawing/ending drops them.
  attachments Attachment[]

  @@unique([sessionId, clientTurnId])
  @@unique([sessionId, seq])
  @@index([sessionId, status])
  @@map("conversation_turn")
}

// Binary blob storage (currently web-composer image uploads) kept in-DB as bytea.
// Postgres is the only persistent store in the single-host Compose deployment (the
// apiserver mounts no volume), and the runner is a remote process that must fetch bytes
// over HTTP regardless of backend — so DB storage is the simplest option that also
// survives `upgrade`. Bytes are stored raw (not base64); callers base64-encode only at
// the claude/runner boundary. Bounded by a size cap + MIME allowlist (attachments.media.ts).
model Attachment {
  id        String            @id @default(uuid(7)) @db.Uuid
  ownerId   String            @map("owner_id") @db.Uuid // tenant scope; reads always filter by it
  owner     User              @relation(fields: [ownerId], references: [id])
  // Optional session scope: set when uploaded inside a session composer so the blob
  // cascade-deletes with the session. Null for uploads made before the session exists.
  sessionId String?           @map("session_id") @db.Uuid
  session   Session?          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Optional turn scope: set when the attachment is sent with a user turn, so the inbox
  // can hand the runner exactly that turn's images. Null until linked at enqueue time;
  // cascades with the turn (withdrawing a queued turn or ending the session drops it).
  turnId    String?           @map("turn_id") @db.Uuid
  turn      ConversationTurn? @relation(fields: [turnId], references: [id], onDelete: Cascade)
  mimeType  String            @map("mime_type")
  sizeBytes Int               @map("size_bytes")
  // Original upload filename. The runner writes a non-image/-PDF upload to the worktree
  // under this name and references it to claude. Null for legacy rows and pasted images.
  fileName  String?           @map("file_name")
  data      Bytes // raw bytes (bytea); Postgres TOAST compresses/offloads transparently
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([ownerId])
  @@index([sessionId])
  @@index([turnId])
  @@map("attachment")
}

// Lightweight activity feed (no FKs, append-only).
model Activity {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("activity")
}

// A user-created grouping of Tasks. Minimal: just a title + tenant scope.
// Deleting a list detaches its tasks (Task.listId -> null), never deletes them.
model TaskList {
  id        String   @id @default(uuid(7)) @db.Uuid
  title     String
  // Tenant scope: list/authorization always filter by this column (like tasks).
  ownerId   String   @map("owner_id") @db.Uuid
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Standing instructions for every task in this list — how this class of work is done, as
  // opposed to which item this task is. Spliced into the run prompt at dispatch, so editing it
  // takes effect on every task not yet started, without touching a single task row.
  //
  // This layer was missing entirely: above it sits Workspace.systemPrompt (one machine, every
  // kind of work) and below it Task.description (one item), and with nowhere in between the
  // invariant half of a campaign's instructions ends up copied into every description. Measured
  // on this deployment: 27,706 task descriptions collapse to 140 distinct shapes, ~86% of each
  // one duplicated text. Applying one lesson learned meant rewriting all of them.
  instructions  String?
  // Emergency stop for the whole list. The auto-run sweep skips a paused list's tasks and
  // execute() refuses them, so one write halts a campaign that is dispatching wrongly —
  // previously the only way to stop one was to edit and redeploy the reconciler. Runs already
  // in flight are deliberately left alone: this gates dispatch, not execution.
  paused        Boolean @default(false)
  // Cap on this list's concurrently RUNNING task sessions, enforced by the claim transaction's
  // existing batch gate (see QueueService) with the list id as the batch. Null means uncapped,
  // which is the pre-existing behaviour: only the runner-wide cap applies, so a 500-task list
  // auto-running takes every free slot and starves every other list behind it.
  maxConcurrent Int?    @map("max_concurrent")

  /// The workspace that runs this list's coordination work, when it has one. A foreman is not a
  /// resident process watching the list — it is dispatched as an ordinary task when something
  /// needs deciding, does one bounded piece of work, and ends. That is what lets it inherit the
  /// retry, reaping, slot accounting and audit every other run already has, instead of needing a
  /// parallel set of guarantees; a long-lived supervisor session would be subject to exactly the
  /// failures it exists to notice.
  foremanWorkspaceId String?    @map("foreman_workspace_id") @db.Uuid
  foremanWorkspace   Workspace? @relation("TaskListForeman", fields: [foremanWorkspaceId], references: [id], onDelete: SetNull)
  /// Dispatch the foreman when the list has been stalled this many minutes: work remains, but
  /// nothing is running and nothing has started in that long. Null disables it. The condition is
  /// deliberately "nothing happened", not "something failed" — every incident this is built for
  /// (a wedged session holding a task, a livelocked merge, a quota outage nobody was told about)
  /// looks identical from outside and none of them raises an error anywhere.
  foremanStallMinutes Int?      @map("foreman_stall_minutes")
  /// File a verification run whenever a task in this list reports DONE.
  ///
  /// Off by default because it doubles a list's runs, and because the check is only worth its
  /// cost where a false "done" is expensive. It is opt-in per list rather than global for the
  /// same reason the concurrency cap is: the right answer differs per campaign.
  verifyOnDone        Boolean   @default(false) @map("verify_on_done")

  /// The conversation this list is steered from — where a human says "pause it", "drop the
  /// concurrency to 2", "here is what changed about how these should be run", and an agent turns
  /// that into policy writes.
  ///
  /// A pointer, never a dependency. Nothing on the dispatch path reads it: the sweep, the claim
  /// gate and the foreman all work exactly the same whether it is set, stale or null. That
  /// separation is the whole design — a console session that could stall a campaign by dying
  /// would be the resident supervisor this architecture spent P3 avoiding, and this deployment
  /// already has the cautionary case (one session created 43 lists and ~21,500 tasks, then sat
  /// FAILED). SetNull on delete for the same reason: losing the conversation loses the entry
  /// point and nothing else.
  ownerSessionId      String?   @map("owner_session_id") @db.Uuid
  ownerSession        Session?  @relation("TaskListConsole", fields: [ownerSessionId], references: [id], onDelete: SetNull)

  tasks     Task[]
  revisions TaskListRevision[]
  events    TaskListEvent[]

  @@index([ownerId])
  @@map("task_list")
}

/// A condition the control plane noticed about a list, kept so somebody can eventually read it.
///
/// These are all things the sweep already detects, acts on, and then forgets into a log line —
/// "12 ready tasks held, provider quota exhausted" is written once per sweep to stdout and is
/// invisible to the person whose campaign stopped moving. The auto-run comment says as much:
/// "why is nothing running" needs an answer somewhere.
///
/// One row per (list, kind), not one per occurrence. A quota outage lasting four hours is one
/// condition seen 240 times, not 240 events, and the board a reader wants is "what is true about
/// this list now" — so a repeat bumps `lastSeenAt`/`occurrences` in place. That also bounds the
/// table by lists × kinds instead of by sweep count.
///
/// Nothing here is on the dispatch path, and nothing waits on it. It is read at delivery into the
/// list's console session and by tasklist_get; a row nobody ever reads costs one upsert.
model TaskListEvent {
  id     String   @id @default(uuid(7)) @db.Uuid
  listId String   @map("list_id") @db.Uuid
  list   TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// quota_hold | disk_hold | foreman_filed | verification_rejected
  kind        String
  /// One line, already phrased for a reader — the counts and the reset time are the answer, and
  /// re-deriving them at read time would mean re-running the sweep's query against a moved world.
  detail      String
  occurrences Int       @default(1)
  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  /// When this condition was last reported into the console. A condition seen again since then is
  /// due for re-reporting; comparing against `lastSeenAt` rather than clearing this flag is what
  /// keeps a four-hour outage from re-announcing itself on every 60s sweep.
  deliveredAt DateTime? @map("delivered_at")

  @@unique([listId, kind])
  @@map("task_list_event")
}

/// One recorded state of a list's dispatch policy — instructions, paused, maxConcurrent.
///
/// A snapshot of the result, not a delta. Restoring v3 means writing v3's values back as a new
/// revision, which works from any distance; a chain of deltas only ever undoes the last step and
/// has to be replayed to answer "what did it look like then".
///
/// This exists so a policy write can be undone rather than pre-approved. The failure it is
/// designed against is not a wrong edit but an unnoticed one: an auto-run loop ran for 21 hours
/// because nothing recorded that anything had changed. `note` carries the reason in words —
/// worth more than the diff, because "keep the disk safe, so gate the downloads" is what someone
/// reading this in three months needs, and a column list cannot say it.
///
/// Title is deliberately not versioned: renaming a list is not a policy change, and a rename
/// that produced a restorable revision would bury the changes that matter.
model TaskListRevision {
  id     String   @id @default(uuid(7)) @db.Uuid
  listId String   @map("list_id") @db.Uuid
  list   TaskList @relation(fields: [listId], references: [id], onDelete: Cascade)
  /// Monotonic per list from 1. Assigned under the list's row lock, so concurrent writers
  /// cannot mint the same number.
  version Int

  instructions        String?
  paused              Boolean
  maxConcurrent       Int?    @map("max_concurrent")
  foremanWorkspaceId  String? @map("foreman_workspace_id") @db.Uuid
  foremanStallMinutes Int?    @map("foreman_stall_minutes")
  verifyOnDone        Boolean @default(false) @map("verify_on_done")

  /// Why this change was made, in words. Optional, but it is the field that makes the history
  /// readable rather than merely complete.
  note String?

  /// Polymorphic author, same convention as Task.creator*: a user or a workspace agent, plus the
  /// session it was written from when an agent did it.
  authorType      CreatorType @map("author_type")
  authorId        String      @map("author_id") @db.Uuid
  authorSessionId String?     @map("author_session_id") @db.Uuid
  authorSession   Session?    @relation("TaskListRevisionAuthorSession", fields: [authorSessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([listId, version])
  @@index([listId, createdAt(sort: Desc)])
  @@map("task_list_revision")
}

// A human-facing work item (unrelated to the old execution-Task dropped in 0006).
// Created by a user or an agent, optionally assigned to an agent to execute; the
// agent's runs hang off it as Sessions.
model Task {
  id               String      @id @default(uuid(7)) @db.Uuid
  title            String
  description      String?
  status           TaskStatus  @default(OPEN)
  // Tenant scope: list/authorization always filter by this column (like agents/sessions).
  ownerId          String      @map("owner_id") @db.Uuid
  owner            User        @relation(fields: [ownerId], references: [id])
  // Polymorphic creator (no FK, cf. Activity.actorId): who/what authored the task.
  creatorType      CreatorType @map("creator_type")
  creatorId        String      @map("creator_id") @db.Uuid
  // The session an in-session agent created this task from (real FK, optional; null for
  // user-created tasks). Deleting the session detaches but keeps the task. Lets the task
  // detail page link back to its origin run.
  creatorSessionId String?     @map("creator_session_id") @db.Uuid
  creatorSession   Session?    @relation("TaskCreatorSession", fields: [creatorSessionId], references: [id], onDelete: SetNull)
  // The workspace this task runs in when executed (real FK, optional).
  assigneeId       String?     @map("assignee_id") @db.Uuid
  assignee         Workspace?  @relation(fields: [assigneeId], references: [id])
  // Optional parent list grouping; deleting the list detaches but keeps the task.
  listId           String?     @map("list_id") @db.Uuid
  list             TaskList?   @relation(fields: [listId], references: [id], onDelete: SetNull)
  /// Free-text labels, written by whoever files the task (in practice the agent creating it).
  /// The second grouping axis, orthogonal to `listId` and carrying no authority: a list decides
  /// how its tasks run (instructions, concurrency, pause, foreman), a label decides nothing and
  /// only says which tasks belong together. That split is why one is a single FK and these are a
  /// set — "which stage" admits exactly one answer because two stages would give one task two
  /// conflicting run policies, while "which batch" is just a fact about the work and can be
  /// stated as many times as it is true.
  ///
  /// The need predates the column. Agents were already labelling, by writing the label into the
  /// title where nothing could query it: at this migration 109,873 of 110,421 titles carried a
  /// `[CC-MAIN-yyyy-ww]` snapshot marker, 110 distinct values, and every one of them spanned all
  /// four pipeline lists. Migration 0106 lifts those into this column.
  ///
  /// An array rather than a tag table because none of what a tag table buys is wanted here:
  /// there is no rename, no colour, no library to curate. Its cost is real though — the writer
  /// is one INSERT instead of a find-or-create per label plus a join row, and there is no
  /// second table to keep consistent. Matching is exact, including case: these record facts
  /// (a snapshot id, a shard) rather than judgements, and facts arrive already spelled.
  labels           String[]    @default([])
  dueDate          DateTime?   @map("due_date")
  // Per-task override for the runs this task dispatches: a built-in engine slug
  // ("claude"/"codex"/"kimi"/"opencode") or one of the owner's configured ModelProvider slugs,
  // and a model id inside that provider's space. NULL keeps the historical behaviour — the run
  // inherits whatever its assignee agent is set to. Pinning the provider makes the next run
  // start a fresh session rather than continue the last one, since a session's provider is
  // fixed for its lifetime (see TasksService.runAgentOnTask).
  provider         String?
  model            String?
  // When all prerequisites are DONE, auto-run this task (the dependency "pipeline"
  // default). Turn off to keep the gate but trigger the run manually.
  autoRunWhenReady Boolean     @default(true) @map("auto_run_when_ready")
  /// This task is held: no sweep dispatch, no manual run. The projection of `TaskList.paused`,
  /// written onto every task in a list when the list is paused or resumed.
  ///
  /// It is a column here rather than a join to `task_list.paused` because a join makes the
  /// authority to spend money conditional on a row that can be deleted, and an unexpressible veto
  /// reads as permission. Deleting a paused list used to resume its 55k tasks — the stop existed
  /// only as `NOT EXISTS (... paused = true)`, so removing the list removed the brake. Authority
  /// to run has to be carried by the task and revocable only by writing to the task.
  ///
  /// The cost is real and accepted: pausing is now one UPDATE over the list's tasks instead of a
  /// single flag write. It is a separate column from `autoRunWhenReady` so resuming restores each
  /// task's own setting instead of overwriting it with a guess.
  dispatchHold     Boolean     @default(false) @map("dispatch_hold")
  // This task is a coordination run over its list, not one of the list's units of work. Two
  // consequences: it does not receive the list's standing instructions (those describe how the
  // *work* is done, and the foreman is not doing it), and an unfinished one suppresses further
  // foreman dispatch for that list, so a stall cannot mint a new coordinator every minute.
  isForeman        Boolean     @default(false) @map("is_foreman")
  /// When set, this task exists to check another task's claim of completion, and names the task
  /// it checks. Non-null carries the same two consequences as isForeman — no list instructions,
  /// and never itself verified — plus the thing a boolean could not: it identifies the subject,
  /// so "is this already being checked" and "how many times has this been checked" are exact
  /// rather than inferred.
  verifiesTaskId   String?     @map("verifies_task_id") @db.Uuid
  verifies         Task?       @relation("TaskVerification", fields: [verifiesTaskId], references: [id], onDelete: Cascade)
  verifiedBy       Task[]      @relation("TaskVerification")
  // Best-effort dedup of a redelivered turn's re-created tasks: a hash of (session, turn, title,
  // description), set only when the create happens inside a live turn (see TasksService). @unique
  // gives a Postgres unique index, which by default treats NULLs as distinct — so the many tasks
  // created outside any turn (user API, headless) coexist freely while an in-turn re-run collides.
  idempotencyKey   String?     @unique @map("idempotency_key")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  comments     TaskComment[]
  sessions     Session[]        @relation("SessionTask") // agent sessions run under this task (one Task -> many Session)
  // Dependency edges where THIS task is the dependent: the prerequisites it waits on.
  dependsOn    TaskDependency[] @relation("DependencyFromTask")
  // Dependency edges where THIS task is the prerequisite: tasks blocked until it's DONE.
  dependedOnBy TaskDependency[] @relation("DependencyToTask")

  @@index([ownerId])
  @@index([ownerId, createdAt(sort: Desc), id(sort: Desc)], map: "task_owner_created_id_idx")
  @@index([ownerId, status, createdAt(sort: Desc), id(sort: Desc)], map: "task_owner_status_created_id_idx")
  @@index([ownerId, listId, createdAt(sort: Desc), id(sort: Desc)], map: "task_owner_list_created_id_idx")
  @@index([assigneeId])
  @@index([listId])
  @@index([status])
  @@index([creatorType, creatorId])
  /// Both dispatcher questions about a verification — "is one already in flight for this
  /// subject" and "how many has it had" — key on this column.
  @@index([verifiesTaskId])
  @@map("task")
}

// Comments on a Task (dedicated table; append-only MVP: create/list/delete).
model TaskComment {
  id         String      @id @default(uuid(7)) @db.Uuid
  taskId     String      @map("task_id") @db.Uuid
  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // Polymorphic author (no FK, cf. Task.creatorId): a comment can be written by a
  // user (web) or by an agent (via the runner MCP path). Names are resolved in code.
  authorType CreatorType @map("author_type")
  authorId   String      @map("author_id") @db.Uuid
  body       String
  // Agent ids @-mentioned in this comment (web composer). Each mention notifies and
  // triggers that agent on this task; resolved to names in the UI. No FK (cf. authorId).
  mentions   String[]    @default([]) @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@map("task_comment")
}

// A "B depends on A" edge: the dependent task (`taskId`) may only run once its
// prerequisite (`dependsOnTaskId`) reaches DONE. An explicit join table because the
// relation is many-to-many (a task can wait on several prerequisites and block several
// dependents). Both endpoints cascade-delete with their task; the graph is kept acyclic
// in code (wouldCreateCycle) on insert, so the completion-triggered runner can't loop.
// Tenant scope is the endpoints' owner — both tasks are validated same-owner on insert
// (cf. TaskComment, which likewise carries no own ownerId).
model TaskDependency {
  id              String   @id @default(uuid(7)) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  task            Task     @relation("DependencyFromTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String   @map("depends_on_task_id") @db.Uuid
  dependsOnTask   Task     @relation("DependencyToTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependency")
}

// A control-plane-configured model provider (e.g. DeepSeek) that borrows a built-in
// runtime CLI instead of shipping its own. Sessions/agents keep its `slug` in their
// `provider` column as a first-class identity (shown in pickers). At dispatch the queue
// resolves the slug here and coerces the runner-facing provider to `runtime` (claude|codex),
// and injects baseUrl + the decrypted key into the borrowed CLI's process env so it talks
// to this endpoint. The API key is stored AES-256-GCM encrypted (providers/provider-crypto.ts);
// it is dispatched only over the runner-auth claim channel and NEVER returned to the browser.
model ModelProvider {
  id            String   @id @default(uuid(7)) @db.Uuid
  // Stable identity stored in Agent/Session.provider and shown in pickers, e.g. "deepseek".
  slug          String   @unique
  label         String
  // Which configurable runtime CLI drives it: "claude" (Anthropic-compatible endpoint),
  // "codex" (OpenAI-compatible) or "kimi" (Moonshot's own API, which the Kimi CLI speaks
  // natively). Borrowing the Kimi runtime is not the same as claiming the built-in `kimi`
  // slug, which stays reserved.
  runtime       String   @default("claude")
  baseUrl       String   @map("base_url")
  // AES-256-GCM ciphertext of the provider API key ("iv:tag:ct", each base64). Kept out of
  // every browser-facing payload but one: the owner of a personal row can read their own key
  // back (GET /providers/mine/:id/key).
  apiKeyEnc     String   @map("api_key_enc")
  // Picker model list: [{ value, label, contextWindow? }]. `value` is the runtime model id
  // passed as --model (e.g. "deepseek-chat"). For a preset-backed row this is a snapshot taken
  // at write time; reads serve the preset's current list instead (see presetSlug).
  models        Json     @default("[]")
  defaultModel  String?  @map("default_model")
  // The vendor preset (@orbit/shared PROVIDER_PRESETS) this row was created from — its identity,
  // fixed for life: the logo it shows and the vendor it "is", even when its own slug had to be
  // suffixed. NULL for a custom endpoint.
  presetSlug    String?  @map("preset_slug")
  // Whether the preset also OWNS the model list: true → models and default model resolve from the
  // catalogue on every read, so one added there reaches providers configured long before it
  // existed. Editing the list by hand clears this (the row keeps its identity, and can opt back
  // in); `models` above is then the row's own.
  followsPreset Boolean  @default(false) @map("follows_preset")
  enabled       Boolean  @default(true)
  // Picker display order; NULL sorts last.
  position      Int?
  // NULL = a shared provider (admin-managed, visible to everyone). Set = a personal (BYOK)
  // provider: visible in, and dispatchable for, only its owner's sessions. Slugs stay globally
  // unique either way, so dispatch-by-slug is never ambiguous.
  ownerId       String?  @map("owner_id") @db.Uuid
  owner         User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("model_provider")
}
