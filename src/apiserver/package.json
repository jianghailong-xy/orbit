{
  "name": "@orbit/apiserver",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit control plane (NestJS + Prisma)",
  "main": "dist/main.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "npm run build && { tsc -p tsconfig.json --watch --preserveWatchOutput & TSC=$!; trap \"kill $TSC 2>/dev/null\" EXIT INT TERM; node --watch dist/main.js; }",
    "start:wiki-worker": "node dist/wiki-worker/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "ops:task-signoff-migration": "node dist/tasks/task-signoff-migration.cli.js",
    "ops:task-judgment-repair": "node dist/tasks/task-judgment-repair.cli.js",
    "ops:wiki-backfill": "node dist/wiki/wiki-backfill.cli.js",
    "test": "tsc -p tsconfig.test.json && SPECS=$(ls build/*/*.spec.js | grep -v '\\.pg\\.spec\\.js$') && node --test $SPECS",
    "test:gateway-cli": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-reporter=spec build/providers/anthropic-gateway-cli.e2e.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@nats-io/transport-node": "3.4.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.0",
    "@orbit/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/pg": "^8.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2"
  }
}
