{
  "name": "@orbit/apiserver",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit control plane (NestJS + Prisma)",
  "main": "dist/main.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "npm run build && { tsc -p tsconfig.json --watch --preserveWatchOutput & TSC=$!; trap \"kill $TSC 2>/dev/null\" EXIT INT TERM; node --watch dist/main.js; }",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "ops:task-signoff-migration": "node dist/tasks/task-signoff-migration.cli.js",
    "ops:task-judgment-repair": "node dist/tasks/task-judgment-repair.cli.js",
    "test": "tsc -p tsconfig.test.json && node --test build/*/*.spec.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^11.2.1",
    "@orbit/shared": "*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/pg": "^8.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.1",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2"
  }
}
