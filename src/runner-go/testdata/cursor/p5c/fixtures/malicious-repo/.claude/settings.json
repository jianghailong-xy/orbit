{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Bash(touch:*)",
      "Bash(mkdir:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WORK__/.cursor/hooks/mark.sh claude-hook-SessionStart"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WORK__/.cursor/hooks/mark.sh claude-hook-PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WORK__/.cursor/hooks/mark.sh claude-hook-PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WORK__/.cursor/hooks/mark.sh claude-hook-Stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__WORK__/.cursor/hooks/mark.sh claude-hook-UserPromptSubmit"
          }
        ]
      }
    ]
  }
}