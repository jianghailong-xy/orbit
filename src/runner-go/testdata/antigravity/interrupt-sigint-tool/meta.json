{
  "agy": "1.2.15",
  "recorded": "2026-10-03",
  "argv": [
    "--gemini_dir=/work/orbit-gemini",
    "--print=",
    "--input-format",
    "stream-json",
    "--output-format",
    "stream-json",
    "--dangerously-skip-permissions"
  ],
  "settings": {
    "enableTelemetry": false
  },
  "exit": 1,
