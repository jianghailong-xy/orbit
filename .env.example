# ──────────────────────────── Control plane (orbit server) ────────────────────────────
DATABASE_URL="postgresql://orbit:orbit@localhost:5432/orbit?schema=public"
# Required — no default. Generate a strong secret: openssl rand -base64 32
JWT_SECRET=""
# Optional independent key for runner/session orchestration JWTs. These proofs expire after
# 15 minutes and refresh transparently. Unset derives a domain-separated key from JWT_SECRET.
# RUNNER_ORCHESTRATION_JWT_SECRET=""
# Optional — access-token (JWT) lifetime, any `ms`/jsonwebtoken duration (e.g. 1h, 24h, 7d).
# Clients auto-refresh via a long-lived refresh token, so this can be short. Defaults to 7d;
# shorten (e.g. 1h) once all clients ship refresh support. Refresh-token lifetime is 30d.
# ACCESS_TOKEN_TTL="7d"
# Required by Compose — master key (AES-256-GCM) that encrypts control-plane provider
# credentials at rest. Keep a protected backup; replacing it makes stored credentials
# unreadable. Generate independently of JWT_SECRET: openssl rand -base64 32
PROVIDER_SECRET_KEY=""
PORT=3000
# Public origin users reach this deployment at — shown in the "Add a runner" install
# commands. Baked into the web bundle at build time, so changing it needs a web rebuild
# (the deploy/upgrade already rebuilds). Defaults to the local gateway for self-hosting;
# set it to your public URL (e.g. https://orbit.example.com) when serving behind a domain.
PUBLIC_ORIGIN="http://localhost:2086"

# Postgres backups (docker compose): every finished WAL segment is archived continuously to
# ./data/pg-archive/wal, and the pgbackup sidecar takes a base backup to replay them onto.
# Defaults shown; see docs/postgres-backup-restore.md for the restore runbook.
# ORBIT_BASE_BACKUP_INTERVAL=86400   # seconds between base backups
# ORBIT_BASE_BACKUP_KEEP=2           # base backups to retain
# ORBIT_BACKUP_MIN_FREE_MB=2048      # free disk to leave; a backup needing it is skipped, loudly
# Off-host mirror over ssh (unset = local backups only, which die with the disk). Give it a
# directory of its own: the mirror deletes whatever it did not put there.
# ORBIT_BACKUP_SYNC_TARGET="root@backup-host:/data/backup/orbit-pg-archive"
# ORBIT_BACKUP_SYNC_SSH_PORT=22
# ORBIT_BACKUP_SSH_DIR=/root/.ssh    # mounted read-only at /ssh (id_rsa + known_hosts)

# Optional — the wiki's System model, for the wiki-worker service only (docs/configuration.md): an endpoint
# speaking the Anthropic Messages API (e.g. vLLM), its key and the model name. All three, or none. Use an
# address the wiki-worker container can reach: its own 127.0.0.1 is the container itself.
# ORBIT_WIKI_MODEL_BASE_URL="http://192.168.1.20:8000"
# ORBIT_WIKI_MODEL_API_KEY="<the key the endpoint expects>"
# ORBIT_WIKI_MODEL="<the model name it serves>"
# ORBIT_WIKI_MODEL_CONCURRENCY=4   # model requests in flight at once, across every space

# Optional Android FCM HTTP v1 (independent of APNS_*). See docs/android-push-contract.md.
# FCM_PROJECT_ID="<isolated Firebase project id>"
# FCM_CLIENT_EMAIL="<service account client_email>"
# FCM_PRIVATE_KEY="<base64 of service account private_key PEM>"
# FCM_ANDROID_PACKAGE="io.orbitd.android" # use io.orbitd.android.debug for the debug app

# ──────────────────────────── Runner (set on the user's machine) ───────────────────────
# Written by `orbit register` into ~/.orbit/config.json; shown here for reference only.
# ORBIT_SERVER_URL="http://localhost:3000"
# ORBIT_RUNNER_TOKEN="<long-lived runner credential issued by `orbit register`>"

# Claude Code auth on the runner machine (never sent to the control plane).
# OPTIONAL: if none of these are set, the runner uses `claude -p` with the machine's
# interactive login (run `claude` once and `/login`). Set one for non-interactive auth
# instead:
# ANTHROPIC_API_KEY="<your-anthropic-api-key>"            # usage-based billing
# CLAUDE_CODE_OAUTH_TOKEN="<from `claude setup-token`>"   # subscription billing, non-interactive
