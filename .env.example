# ──────────────────────────── Control plane (orbit server) ────────────────────────────
DATABASE_URL="postgresql://orbit:orbit@localhost:5432/orbit?schema=public"
# Required — no default. Generate a strong secret: openssl rand -base64 32
JWT_SECRET=""
# Optional independent key for runner/session orchestration JWTs. These proofs expire after
# 15 minutes and refresh transparently. Unset derives a domain-separated key from JWT_SECRET.
# RUNNER_ORCHESTRATION_JWT_SECRET=""
# Optional — access-token (JWT) lifetime, any `ms`/jsonwebtoken duration (e.g. 1h, 24h, 7d).
# Clients auto-refresh via a long-lived refresh token, so this can be short. Defaults to 7d;
# shorten (e.g. 1h) once all clients ship refresh support. Refresh-token lifetime is 30d.
# ACCESS_TOKEN_TTL="7d"
# Required by Compose — master key (AES-256-GCM) that encrypts control-plane provider
# credentials at rest. Keep a protected backup; replacing it makes stored credentials
# unreadable. Generate independently of JWT_SECRET: openssl rand -base64 32
PROVIDER_SECRET_KEY=""
PORT=3000
# Public origin users reach this deployment at — shown in the "Add a runner" install
# commands. Baked into the web bundle at build time, so changing it needs a web rebuild
# (the deploy/upgrade already rebuilds). Defaults to the local gateway for self-hosting;
# set it to your public URL (e.g. https://orbit.example.com) when serving behind a domain.
PUBLIC_ORIGIN="http://localhost:2086"
# Optional — the proxies in front of the gateway (docs/configuration.md): addresses and CIDR ranges, separated by
# commas or spaces. Behind Cloudflare, its published ranges (https://www.cloudflare.com/ips/). Orbit then reads each
# visitor's own address through them, as the register approval page shows it; unset, it sees the proxy's.
# TRUSTED_PROXIES="198.51.100.0/24,2001:db8:cf::/48"
# Optional — how many live viewer streams (public links' and guests' pages) one apiserver keeps open at once
# (docs/self-hosting.md). Unset, 2000.
# VIEWER_STREAMS_MAX=2000
# Optional — sign the macOS runner binaries /dl publishes with your Developer ID, so a Mac keeps its
# privacy (TCC) answers across runner updates (docs/release-process.md, "macOS runner signature").
# All three lines or none; keep both files outside this checkout, readable only by the deploying account.
# COMPOSE_FILE=docker-compose.yml:deploy/macos-runner-signing.yml
# ORBIT_MACOS_SIGNING_P12=/root/orbit-signing/developer-id.p12
# ORBIT_MACOS_SIGNING_PASSWORD_FILE=/root/orbit-signing/developer-id.password

# Postgres backups (docker compose): every finished WAL segment is archived continuously to
# ./data/pg-archive/wal, and the pgbackup sidecar takes a base backup to replay them onto.
# Defaults shown; see docs/postgres-backup-restore.md for the restore runbook.
# ORBIT_BASE_BACKUP_INTERVAL=86400   # seconds between base backups
# ORBIT_BASE_BACKUP_KEEP=2           # base backups to retain
#                                    # expired files' bytes wait max(7 days, interval x (keep + 1)): docs/self-hosting.md
# ORBIT_BACKUP_MIN_FREE_MB=2048      # free disk to leave; a backup needing it is skipped, loudly
# Off-host mirror over ssh (unset = local backups only, which die with the disk). Give it a
# directory of its own: the mirror deletes whatever it did not put there. ./data/files is copied
# to <target>-files beside it, so the ssh user must be able to create that directory too.
# ORBIT_BACKUP_SYNC_TARGET="root@backup-host:/data/backup/orbit-pg-archive"
# ORBIT_BACKUP_SYNC_SSH_PORT=22
# ORBIT_BACKUP_SSH_DIR=/root/.ssh    # mounted read-only at /ssh (id_rsa + known_hosts)

# Drive and attachments (docs/drive-design.md §2.10): where their bytes are kept, one copy per content, named
# by its sha256; Postgres keeps only what describes each file. local (the default) keeps them in ./data/files,
# which Compose mounts at /var/lib/orbit/files — back it up with ./data/postgres. s3 keeps them in an
# S3-compatible bucket (AWS S3, MinIO, R2, …), addressed path-style at the endpoint, under files/; uploads
# still arrive in ./data/files/tmp first. Outside Compose, ORBIT_DRIVE_DIR says where the files directory is.
# Each ORBIT_DRIVE_* was ORBIT_DOCUMENTS_* while the drive was called Documents, and ORBIT_FILES_* before that; the older
# names are still read, in that order, when the new one is unset, so an .env written before keeps working.
# ORBIT_DRIVE_BACKEND=local
# ORBIT_DRIVE_DIR=/var/lib/orbit/files
# ORBIT_DRIVE_S3_ENDPOINT="https://s3.eu-west-1.amazonaws.com"
# ORBIT_DRIVE_S3_BUCKET="orbit-drive"
# ORBIT_DRIVE_S3_ACCESS_KEY_ID="<access key id>"
# ORBIT_DRIVE_S3_SECRET_ACCESS_KEY="<secret access key>"
# ORBIT_DRIVE_S3_REGION=us-east-1
# The most one account may keep, in bytes; past it an upload is refused with FILE_QUOTA_EXCEEDED. Unset, there is no limit,
# which is what a self-hosted deployment wants. A hosted instance sets it. 10 GiB here:
# ORBIT_DRIVE_QUOTA_BYTES=10737418240
# Capacity of the shared S3 store in bytes. Files → Storage warns at 80% of this limit.
# ORBIT_DRIVE_STORE_QUOTA_BYTES=1099511627776

# Drive, the drive every account can keep files in and its agents read and write (docs/self-hosting.md,
# "Drive"). Off unless this says true: off, the drive's routes answer 404 DOCUMENTS_DISABLED, the clients show no
# Drive and sessions have no drive tools. Nothing is deleted; turning it on brings everything back. An upgrade
# never writes this line: only you turn Drive on. ORBIT_DOCUMENTS_ENABLED and ORBIT_FILES_ENABLED, its older names, are
# still read when this one is unset.
ORBIT_DRIVE_ENABLED=false

# Optional — the wiki's System model, for the wiki-worker service only (docs/configuration.md): an endpoint
# speaking the Anthropic Messages API (e.g. vLLM), its key and the model name. All three, or none. Use an
# address the wiki-worker container can reach: its own 127.0.0.1 is the container itself.
# ORBIT_WIKI_MODEL_BASE_URL="http://192.168.1.20:8000"
# ORBIT_WIKI_MODEL_API_KEY="<the key the endpoint expects>"
# ORBIT_WIKI_MODEL="<the model name it serves>"
# ORBIT_WIKI_MODEL_CONCURRENCY=4   # model requests in flight at once, across every space
# ORBIT_WIKI_MODEL_THINKING=disabled   # disabled or enabled, sent as every call's thinking; empty sends none. DeepSeek V4: disabled

# Optional Android FCM HTTP v1 (independent of APNS_*). See docs/android-push-contract.md.
# FCM_PROJECT_ID="<isolated Firebase project id>"
# FCM_CLIENT_EMAIL="<service account client_email>"
# FCM_PRIVATE_KEY="<base64 of service account private_key PEM>"
# FCM_ANDROID_PACKAGE="io.orbitd.android" # use io.orbitd.android.debug for the debug app

# Optional browser notifications (Web Push, VAPID). See docs/web-push-design.md. Needs HTTPS and outbound internet.
# Generate the pair once (`npx web-push generate-vapid-keys`) and keep it: a new pair makes every browser subscribe again.
# WEB_PUSH_PUBLIC_KEY="<base64url uncompressed P-256 public key>"
# WEB_PUSH_PRIVATE_KEY="<base64url 32-byte private key>"
# WEB_PUSH_SUBJECT="https://orbitd.io" # a URL or mailto: the push services can reach the sender at

# Managed runners (docs/self-hosting.md, "Managed runners"): every account gets a runner of its own, a container
# on this host's Docker, when it signs in. The fresh install (scripts/install-server.sh) prepares
# ./data/managed-runners and appends these three lines, switched on. An upgrade never writes them, so a deployment
# installed without them keeps managed runners off. ORBIT_MANAGED_RUNNERS_ENABLED=false switches them off: no
# runner is given, started or woken, and nothing is deleted. Apply a change with `docker compose up -d apiserver`.
# The second profile is the managed runners' host firewall ("Isolation and its limits"), which leaves a runner the
# gateway's port, DNS and public addresses only; an install with --no-managed-runner-firewall leaves it out.
# ORBIT_MANAGED_RUNNERS_ENABLED=true
# ORBIT_MANAGED_RUNNERS_DIR=./data/managed-runners
# COMPOSE_PROFILES=managed-runners-docker,managed-runner-firewall
# The managed runner browser (docs/runner-browser-design.md §2): lets the owner watch and take over a managed runner's
# Chrome. Off unless this says exactly `true` and ORBIT_MANAGED_RUNNERS_ENABLED=true; absent, empty or `false` is off,
# and any other value is off with a warning in the apiserver's log. Neither the install nor an upgrade writes it.
# ORBIT_MANAGED_RUNNER_BROWSER_ENABLED=true

# The runner link (docs/self-hosting.md, "Runner link"): the fresh install and /upgrade's script append these below, once,
# with secrets of this deployment's own, and start the link's two services. Nothing here needs setting by hand. Runners reach
# the link through the gateway's port above, at the address they reach this server at, encrypted where that address is.
# RUNNER_LINK_URL=same-origin
# RUNNER_LINK_ENV_FILE=./deploy/runner-link/behind-web-gateway.env
# RUNNER_LINK_BIND=127.0.0.1
# RUNNER_LINK_PORT=0
# RUNNER_LINK_METRICS_PORT=0
# RUNNER_LINK_SIGNING_KEY="<base64 of an Ed25519 private key in PEM>"
# RUNNER_LINK_PUBLIC_KEY="<base64 of its public key in PEM>"
# RUNNER_LINK_GATEWAY_TOKEN="<a secret of at least 32 characters>"
# RUNNER_LINK_NATS_APISERVER_SEED="<SU...>"
# RUNNER_LINK_NATS_APISERVER_KEY="<U...>"
# RUNNER_LINK_NATS_GATEWAY_SEED="<SU...>"
# RUNNER_LINK_NATS_GATEWAY_KEY="<U...>"
# COMPOSE_PROFILES=runner-link

# Monitoring is on for a fresh install and, once, for an upgrade: both append ORBIT_MONITORING=on and a COMPOSE_PROFILES line
# with monitoring. Remove monitoring from COMPOSE_PROFILES to turn it off, and keep ORBIT_MONITORING so no upgrade adds it back.
# ORBIT_MONITORING=on
# Grafana, in the monitoring profile (docs/self-hosting.md, "Monitoring"): published on this host's loopback alone, never on
# the Orbit origin. A fresh install and /upgrade's script generate the admin password; Grafana refuses to start without it.
# GRAFANA_ADMIN_PASSWORD="<generated>"
# GRAFANA_PORT=3030
# GRAFANA_ROOT_URL=http://localhost:3030/

# Alerts to your phone (docs/self-hosting.md, "Monitoring", "Alerts"). ntfy is the default: the public ntfy.sh sees the alert
# text, and the topic is the only secret, so make it long and random. Email and a webhook are the alternatives.
# ORBIT_NTFY_TOPIC=<long random topic>
# ORBIT_NTFY_SERVER=https://ntfy.sh
# ORBIT_ALERT_CONTACT=orbit-ntfy          # or orbit-email (set ORBIT_ALERT_EMAIL and GF_SMTP_*) or orbit-webhook (ORBIT_ALERT_WEBHOOK_URL)
# The always-firing Watchdog is POSTed here every minute; a dead-man's-switch service tells you when it stops, the only way
# to learn that the whole host is down.
# ORBIT_ALERT_HEARTBEAT_URL=https://hc-ping.com/<uuid>
# Alerts in your Orbit app too: a personal access token holding only the Notifications scope (Settings → Access tokens). Every
# alert but the Watchdog is then also pushed to your iPhone or Android phone, through this server's APNs/FCM keys (with none,
# the call is accepted and nothing is pushed). ntfy keeps them all, and is still what tells you the apiserver is down.
# ORBIT_NOTIFY_TOKEN=orbit_pat_...

# ──────────────────────────── Runner (set on the user's machine) ───────────────────────
# Written by `orbit register` into ~/.orbit/config.json; shown here for reference only.
# ORBIT_SERVER_URL="http://localhost:3000"
# ORBIT_RUNNER_TOKEN="<long-lived runner credential issued by `orbit register`>"

# Claude Code auth on the runner machine (never sent to the control plane).
# OPTIONAL: if none of these are set, the runner uses `claude -p` with the machine's
# interactive login (run `claude` once and `/login`). Set one for non-interactive auth
# instead:
# ANTHROPIC_API_KEY="<your-anthropic-api-key>"            # usage-based billing
# CLAUDE_CODE_OAUTH_TOKEN="<from `claude setup-token`>"   # subscription billing, non-interactive
